FROM dunglas/frankenphp:1-php8.4

# Install required system dependencies for Composer
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# The dunglas/frankenphp image comes with a handy install-php-extensions script.
# We install the exact extensions your Aerie Trading stack requires.
RUN install-php-extensions \
    pdo_mysql \
    redis \
    pcntl \
    sockets \
    opcache \
    intl \
    bcmath \
    xdebug

# Configure Xdebug
RUN echo "xdebug.mode=\${XDEBUG_MODE:-off}" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.start_with_request=\${XDEBUG_START_WITH_REQUEST:-trigger}" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.client_host=host.docker.internal" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.client_port=9003" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.output_dir=/app/var/profiling" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini \
    && echo "xdebug.profiler_output_name=cachegrind.out.%t.%p" >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configure Git to trust the mounted /app directory
RUN git config --global --add safe.directory /app

# Copy your application into the container
COPY . /app

# Ensure profiling directory exists
RUN mkdir -p /app/var/profiling

# THE MAGIC: Enable FrankenPHP Worker Mode!
# This tells FrankenPHP to boot Symfony once and keep it in memory, 
# vastly improving response times.
ENV FRANKENPHP_CONFIG="worker ./public/index.php"