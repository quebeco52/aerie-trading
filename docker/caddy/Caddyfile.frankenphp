{
    # Enable the FrankenPHP module in Caddy
    frankenphp
    order php_server before file_server
}

(app_routes) {
    root * /app/public
    encode zstd gzip

    # 1. FORCE WebSocket traffic to Workerman, bypassing Symfony entirely
    route /ws* {
        uri strip_prefix /ws
        reverse_proxy aerie-websocket:8080
    }

    # 2. Route all other normal HTTP traffic to Symfony
    route {
        php_server
    }
}

localhost {
    import app_routes
}

http://aerie-app, http://:80 {
    import app_routes
}