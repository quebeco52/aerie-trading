{# The order ticket a stock or a bond is traded from, run by assets/controllers/trade_form_controller.js. Pass
   ticker, price (the dealing price the estimate is built on), estimate (the figure shown before the script runs,
   default price), dutyRate (stamp duty on each side; leave it out for none), limitLabel, quantityLabel and
   costsLabel. Blocks: choices (the side and order-type controls, and anything above the limit price such as a stop
   price or the borrow panel; import _ui inside it), costs (rows under the estimate) and notes (lines above the
   button). #}
<form action="{{ path('app_trade_execute') }}" method="POST" class="space-y-3"
	data-controller="trade-form"
	data-trade-form-ticker-value="{{ ticker }}"
	data-trade-form-price-value="{{ price }}"
	{% if dutyRate is defined %}data-trade-form-duty-rate-value="{{ dutyRate }}"{% endif %}
	data-action="submit->trade-form#onSubmit">
	<input type="hidden" name="ticker" value="{{ ticker }}">
	<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

	{% block choices %}{% endblock %}

	<div id="limit-price-group" class="hidden space-y-1" data-trade-form-target="limitGroup">
		<label for="limitPrice" class="text-xs font-medium text-on-surface-variant">{{ limitLabel ?? 'Limit price' }}</label>
		<input type="number" step="0.01" min="0.01" id="limitPrice" name="limitPrice" placeholder="{{ price|number_format(2, '.', '') }}" class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none" data-trade-form-target="limitPrice" data-action="input->trade-form#render">
	</div>

	<div class="space-y-1">
		<label for="quantity" class="text-xs font-medium text-on-surface-variant">{{ quantityLabel ?? 'Quantity' }}</label>
		<input type="number" id="quantity" name="quantity" min="1" max="1000000" value="1" required class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none" data-trade-form-target="quantity" data-action="input->trade-form#render">
	</div>

	<div class="p-3 rounded bg-surface-container-lowest/80 border border-outline-variant/20 space-y-1.5 text-xs">
		<div class="flex justify-between items-center">
			<span class="text-on-surface-variant" data-trade-form-target="estimateLabel">Estimated cost</span>
			<span class="font-bold text-on-surface font-mono tabular-nums text-sm" id="estimated-total" data-trade-form-target="estimate" aria-live="polite">{{ (estimate ?? price)|money(2) }}</span>
		</div>
		<div class="flex justify-between items-center text-on-surface-variant" data-trade-form-target="costsRow">
			<span>{{ costsLabel ?? 'Spread' }}</span>
			<span class="font-mono tabular-nums" data-trade-form-target="costs">&mdash;</span>
		</div>
		<p class="hidden text-2xs text-on-surface-variant text-right" data-trade-form-target="costsNote"></p>
		{% block costs %}{% endblock %}
	</div>

	{% block notes %}{% endblock %}

	<button type="submit" data-trade-form-target="submit" class="w-full py-2 px-4 rounded bg-primary text-on-primary font-semibold text-sm hover:bg-primary-container transition-colors cursor-pointer">Place order</button>
</form>
