{# Declared once, rendered twice (desktop bar and mobile panel). The District's pages and the government's
   each sit under one menu. #}
{% set current_path = app.request.pathInfo %}
{% set market_links = [
    { href: '/', label: 'Markets', active: current_path == '/' or current_path starts with '/stock' or current_path starts with '/search' },
    { href: '/screener', label: 'Screener', active: current_path == '/screener' },
    { href: '/bonds', label: 'Bonds', active: current_path starts with '/bond' },
    { href: '/news', label: 'News', active: current_path == '/news' },
    { href: '/leaderboard', label: 'Leaderboard', active: current_path == '/leaderboard' }
] %}
{% set district_links = [
    { href: '/economy', label: 'Economy', active: current_path == '/economy' },
    { href: '/district/glasswater-row', label: 'Glasswater Row', active: current_path starts with '/district' }
] %}
{# The Diet's side first, then the Council and the departments it appoints, split by a rule. #}
{% set government_links = [
    { href: '/government', label: 'Overview', active: current_path == '/government' },
    { href: '/government/diet', label: 'The Diet', active: current_path == '/government/diet' or current_path starts with '/government/parties' },
    { href: '/government/election', label: 'The election', active: current_path == '/government/election' },
    { href: '/government/budget', label: 'The budget', active: current_path == '/government/budget' },
    { href: '/council', label: 'Aerie Council', active: current_path == '/council', rule: true },
    { href: '/authority', label: 'Monetary Authority', active: current_path == '/authority' },
    { href: '/regulator', label: 'Financial Regulator', active: current_path == '/regulator' },
    { href: '/reserve', label: 'Sovereign Reserve Fund', active: current_path == '/reserve' }
] %}
{% set menus = [
    { label: 'The District', links: district_links },
    { label: 'Government', links: government_links }
] %}
{% set portfolio_active = current_path == '/dashboard' %}

<nav class="sticky top-0 z-50 bg-surface border-b border-outline-variant/20 w-full" aria-label="Primary">
    <div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-14">
            <div class="flex items-center gap-8">
                <a href="/" class="flex items-center gap-2.5 text-base font-semibold tracking-tight text-on-surface hover:text-primary transition-colors">
                    <img src="{{ asset('favicon.svg') }}" alt="" width="28" height="28" class="w-7 h-7">
                    <span>Aerie Exchange</span>
                </a>
                <div class="hidden lg:flex items-center gap-6">
                    {% for link in market_links %}
                        <a href="{{ link.href }}"
                           {% if link.active %}aria-current="page"{% endif %}
                           class="text-sm font-medium py-1 border-b-2 transition-colors {{ link.active ? 'text-primary border-primary' : 'text-on-surface-variant hover:text-on-surface border-transparent' }}">{{ link.label }}</a>
                    {% endfor %}

                    {% for menu in menus %}
                        {% set menu_active = menu.links|filter(link => link.active)|length > 0 %}
                        <details class="group relative" data-controller="disclosure">
                            <summary class="list-none cursor-pointer flex items-center gap-0.5 text-sm font-medium py-1 border-b-2 transition-colors {{ menu_active ? 'text-primary border-primary' : 'text-on-surface-variant hover:text-on-surface border-transparent' }}">
                                {{ menu.label }}
                                <span class="material-symbols-outlined text-base leading-none transition-transform group-open:rotate-180" aria-hidden="true">expand_more</span>
                            </summary>
                            <div class="absolute left-0 top-full mt-2 w-60 rounded-lg border border-outline-variant/25 bg-surface-container-high shadow-lg shadow-black/40 p-1.5 z-50">
                                {% for link in menu.links %}
                                    {% if link.rule ?? false %}<div class="my-1.5 border-t border-outline-variant/20" role="separator"></div>{% endif %}
                                    <a href="{{ link.href }}"
                                       {% if link.active %}aria-current="page"{% endif %}
                                       class="block px-3 py-2 rounded text-sm transition-colors {{ link.active ? 'text-primary bg-primary/10' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-bright' }}">{{ link.label }}</a>
                                {% endfor %}
                            </div>
                        </details>
                    {% endfor %}
                </div>
            </div>

            <div class="flex items-center gap-4">
                <div class="relative hidden sm:block" data-controller="navbar-search">
                    <form action="/search" method="GET" id="search-form" role="search">
                        <label for="market-search-input" class="sr-only">Search ticker or company</label>
                        <input id="market-search-input" name="q" type="search" placeholder="Search ticker or company" class="bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1 text-xs focus:ring-1 focus:ring-primary focus:border-primary w-52 xl:w-64 text-on-surface outline-none placeholder:text-on-surface-faint" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-results-dropdown" aria-autocomplete="list" data-navbar-search-target="input" data-action="input->navbar-search#onInput keydown->navbar-search#onKeyDown">
                        <div id="search-results-dropdown" role="listbox" aria-label="Search results" data-navbar-search-target="dropdown" class="absolute left-0 mt-1 w-full bg-surface-container-high border border-outline-variant/30 rounded shadow-md hidden z-50 overflow-hidden text-xs">
                        </div>
                    </form>
                </div>

                {% if app.user %}
                    <a href="/dashboard"
                       {% if portfolio_active %}aria-current="page"{% endif %}
                       class="hidden lg:inline text-sm font-medium py-1 border-b-2 transition-colors {{ portfolio_active ? 'text-primary border-primary' : 'text-on-surface-variant hover:text-on-surface border-transparent' }}">Portfolio</a>
                    {% set unread = unread_notifications() %}
                    <a href="{{ path('app_notifications') }}"
                       data-controller="notifications"
                       data-notifications-count-value="{{ unread }}"
                       data-notifications-url-value="{{ path('api_notifications_unread') }}"
                       aria-label="Notifications{{ unread > 0 ? ', ' ~ unread ~ ' unread' : '' }}"
                       class="relative w-7 h-7 rounded flex items-center justify-center text-on-surface-variant hover:text-on-surface transition-colors {{ current_path starts with '/notifications' ? 'text-primary' : '' }}">
                        <span class="material-symbols-outlined text-lg" aria-hidden="true">notifications</span>
                        <span data-notifications-target="count" {% if unread <= 0 %}hidden{% endif %}
                              class="absolute -top-1 -right-1 min-w-4 h-4 px-1 rounded-full bg-primary text-on-primary text-3xs font-mono font-semibold leading-4 text-center">{{ unread > 99 ? '99+' : unread }}</span>
                    </a>
                    <details class="relative" data-controller="disclosure">
                        <summary class="list-none cursor-pointer w-7 h-7 rounded bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-on-surface border border-outline-variant/20 transition-colors" aria-label="Account">
                            <span class="material-symbols-outlined text-lg" aria-hidden="true">person</span>
                        </summary>
                        <div class="absolute right-0 top-full mt-2 w-60 rounded-lg border border-outline-variant/25 bg-surface-container-high shadow-lg shadow-black/40 p-1.5 z-50">
                            <p class="px-3 pt-2 pb-2.5 mb-1 border-b border-outline-variant/20 text-xs text-on-surface-variant truncate">Signed in as <span class="text-on-surface">{{ app.user.userIdentifier }}</span></p>
                            <a href="/dashboard" class="block px-3 py-2 rounded text-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-bright transition-colors">Portfolio</a>
                            <a href="{{ path('app_notifications') }}" class="block px-3 py-2 rounded text-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-bright transition-colors">Notifications</a>
                            <a href="{{ path('app_guide') }}" class="block px-3 py-2 rounded text-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-bright transition-colors">Investor guide</a>
                            <a href="{{ path('app_logout') }}" class="block px-3 py-2 rounded text-sm text-on-surface-variant hover:text-on-surface hover:bg-surface-bright transition-colors">Sign out</a>
                        </div>
                    </details>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors">Sign in</a>
                    <a href="{{ path('app_register') }}" class="hidden sm:inline-flex px-3 py-1 rounded border border-outline-variant/40 text-sm font-medium text-on-surface hover:bg-surface-container-high transition-colors">Register</a>
                {% endif %}

                {# The link bar is hidden below `lg`, so the same links go here, grouped as on the bar. #}
                <details class="lg:hidden relative" data-controller="disclosure">
                    <summary class="list-none cursor-pointer text-on-surface-variant hover:text-on-surface transition-colors flex items-center" aria-label="Open navigation menu">
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">menu</span>
                    </summary>
                    <div class="absolute right-0 mt-3 w-64 rounded-lg border border-outline-variant/25 bg-surface-container-high shadow-lg shadow-black/40 p-2 z-50">
                        <form action="/search" method="GET" role="search" class="sm:hidden p-1 pb-2">
                            <label for="market-search-input-mobile" class="sr-only">Search ticker or company</label>
                            <input id="market-search-input-mobile" name="q" type="search" placeholder="Search ticker or company" class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-xs text-on-surface outline-none focus:ring-1 focus:ring-primary placeholder:text-on-surface-faint">
                        </form>
                        {% for group in [
                            { heading: null, links: market_links|merge(app.user ? [{ href: '/dashboard', label: 'Portfolio', active: portfolio_active }] : []) },
                            { heading: 'The District', links: district_links },
                            { heading: 'Government', links: government_links }
                        ] %}
                            {% if group.heading %}
                                <p class="mt-1 px-3 pt-3 pb-1 border-t border-outline-variant/20 text-xs text-on-surface-faint">{{ group.heading }}</p>
                            {% endif %}
                            {% for link in group.links %}
                                <a href="{{ link.href }}"
                                   {% if link.active %}aria-current="page"{% endif %}
                                   class="block px-3 py-2 rounded text-sm font-medium transition-colors {{ link.active ? 'text-primary bg-primary/10' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-bright' }}">{{ link.label }}</a>
                            {% endfor %}
                        {% endfor %}
                    </div>
                </details>
            </div>
        </div>
    </div>
</nav>
