<nav class="sticky top-0 z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/10 w-full">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <div class="flex items-center gap-8">
                <a href="/" class="text-xl font-bold tracking-tighter text-primary flex items-center gap-2">
                    <span class="material-symbols-outlined">monitoring</span>
                    Aerie Exchange
                </a>
                <div class="hidden md:flex gap-6 mt-1">
                    {% set current_path = app.request.pathInfo %}
                    
                    <a href="/" class="text-sm font-bold pb-1 border-b-2 transition-colors {{ current_path == '/' ? 'text-primary border-primary' : 'text-on-surface-variant hover:text-on-surface border-transparent hover:border-outline-variant/30' }}">Markets</a>
                    
                    <a href="/dashboard" class="text-sm font-bold pb-1 border-b-2 transition-colors {{ current_path == '/dashboard' ? 'text-primary border-primary' : 'text-on-surface-variant hover:text-on-surface border-transparent hover:border-outline-variant/30' }}">Portfolio</a>
                    
                    <a href="/leaderboard" class="text-sm font-bold pb-1 border-b-2 transition-colors {{ current_path == '/leaderboard' ? 'text-primary border-primary' : 'text-on-surface-variant hover:text-on-surface border-transparent hover:border-outline-variant/30' }}">Leaderboard</a>

                    <a href="/screener" class="text-sm font-bold pb-1 border-b-2 transition-colors {{ current_path == '/screener' ? 'text-primary border-primary' : 'text-on-surface-variant hover:text-on-surface border-transparent hover:border-outline-variant/30' }}">Screener</a>
                </div>
            </div>
            
            <div class="flex items-center gap-4">
                <div class="relative hidden sm:block">
                    <form action="/search" method="GET" id="search-form">
                        <input id="market-search-input" name="q" type="text" placeholder="Search company or ticker..." class="bg-surface-container-lowest border border-outline-variant/20 rounded-lg px-4 py-1.5 text-sm focus:ring-1 focus:ring-primary w-64 text-on-surface outline-none placeholder:text-outline-variant font-mono" autocomplete="off">
                        <div id="search-results-dropdown" class="absolute left-0 mt-1 w-full bg-surface-container-high border border-outline-variant/20 rounded-md shadow-lg hidden z-50 overflow-hidden">
                        </div>
                    </form>
                </div>
                
                {% if app.user %}
                    <a href="/dashboard" class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-primary border border-outline-variant/20 hover:bg-surface-bright transition-colors" title="Logged in as {{ app.user.userIdentifier }}">
                        <span class="material-symbols-outlined text-sm">account_circle</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="material-symbols-outlined text-on-surface-variant hover:text-on-surface transition-colors active:scale-95" title="Sign Out">logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="material-symbols-outlined text-on-surface-variant hover:text-on-surface transition-colors active:scale-95" title="Sign In">account_circle</a>
                {% endif %}
            </div>
        </div>
    </div>

    {# --- MINI TICKER TAPE / MARKET STATUS STRIP --- #}
    <div class="bg-surface-container-lowest/90 border-t border-outline-variant/10 px-4 sm:px-6 lg:px-8 py-1.5 overflow-x-auto text-[11px] font-mono flex items-center justify-between gap-6 custom-scrollbar whitespace-nowrap">
        <div class="flex items-center gap-6">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse shadow-[0_0_6px_rgba(78,222,163,0.8)]"></span>
                <span class="text-secondary font-bold uppercase tracking-wider text-[10px]">Markets Live</span>
            </div>

            <a href="/stock/LBI" class="flex items-center gap-1.5 text-on-surface hover:text-primary transition-colors group">
                <span class="font-bold text-primary">LBI Index:</span>
                <span id="nav-lbi-price" class="font-bold">$100.00</span>
            </a>

            <span class="text-outline-variant/40">|</span>

            <div class="flex items-center gap-4 text-on-surface-variant text-[10px]" id="nav-ticker-items">
                <span>Trading Hours: 24/7 Live Sim</span>
                <span>Accounting: Clean Surplus Model</span>
            </div>
        </div>

        {% if app.user %}
            <a href="/dashboard" class="text-primary hover:underline text-[10px] font-bold uppercase tracking-wider flex items-center gap-1">
                <span>My Portfolio</span>
                <span class="material-symbols-outlined text-[12px]">chevron_right</span>
            </a>
        {% endif %}
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('market-search-input');
        const dropdown = document.getElementById('search-results-dropdown');
        let debounceTimer;
        let currentFocus = -1;

        if (searchInput && dropdown) {
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                const query = this.value.trim();

                if (query.length < 1) {
                    dropdown.classList.add('hidden');
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetch(`/search/autocomplete?q=${encodeURIComponent(query)}`)
                        .then(response => response.json())
                        .then(data => {
                            dropdown.innerHTML = '';
                            currentFocus = -1;
                            if (data.length > 0) {
                                data.forEach(item => {
                                    const a = document.createElement('a');
                                    a.href = `/stock/${item.ticker}`;
                                    a.className = 'block px-4 py-2 text-sm text-on-surface hover:bg-surface-bright transition-colors cursor-pointer';
                                    a.innerHTML = `<span class="font-bold text-primary">${item.ticker}</span> <span class="text-on-surface-variant text-xs ml-2">${item.name}</span>`;
                                    dropdown.appendChild(a);
                                });
                            } else {
                                dropdown.innerHTML = '<div class="px-4 py-2 text-sm text-on-surface-variant">No results found</div>';
                            }
                            dropdown.classList.remove('hidden');
                        });
                }, 250);
            });

            searchInput.addEventListener('keydown', function(e) {
                const items = dropdown.querySelectorAll('a');
                if (!items || items.length === 0) return;

                if (e.key === 'ArrowDown') {
                    currentFocus++;
                    addActive(items);
                } else if (e.key === 'ArrowUp') {
                    currentFocus--;
                    addActive(items);
                } else if (e.key === 'Enter') {
                    if (currentFocus > -1) {
                        e.preventDefault();
                        items[currentFocus].click();
                    }
                }
            });

            function addActive(items) {
                if (!items) return false;
                for (let i = 0; i < items.length; i++) {
                    items[i].classList.remove('bg-surface-bright');
                }
                if (currentFocus >= items.length) currentFocus = 0;
                if (currentFocus < 0) currentFocus = (items.length - 1);
                items[currentFocus].classList.add('bg-surface-bright');
            }

            document.addEventListener('click', function(e) {
                if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.add('hidden');
                }
            });
        }

        // Live LBI price update in ticker tape
        document.addEventListener('market:update', function(e) {
            const payload = e.detail;
            if (payload && payload.stocks) {
                const lbi = payload.stocks.find(s => s.ticker === 'LBI');
                const lbiEl = document.getElementById('nav-lbi-price');
                if (lbi && lbiEl) {
                    lbiEl.innerText = '$' + parseFloat(lbi.price).toFixed(2);
                }
            }
        });
    });
    </script>
</nav>