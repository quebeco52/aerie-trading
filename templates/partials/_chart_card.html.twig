{# One chart card: title and lede, the latest-reading HUD (id "hud-<id>") and the expand button, then the canvas the
   page script draws into (id). `family` names the filter attribute (data-<family>-category); `hud` 'plain' prints the
   reading alone, 'latest' labels it; `wide` spans both grid columns from the `wideAt` breakpoint; `canvas` adds
   attributes to the canvas. Embed it to replace `hud`, fill `controls` (above the canvas) or `canvas_extra` (inside
   the canvas box), or replace `footer`. #}
<div class="chart-card {{ wide|default(false) ? wideAt ~ ':col-span-2 ' }}bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col"{{ wide|default(false) ? ' data-wide' }} data-{{ family }}-category="{{ category }}">
	<div class="flex items-start justify-between gap-4 mb-3">
		<div class="min-w-0">
			<h4 class="text-sm font-semibold text-on-surface">{{ title }}</h4>
			<p class="text-xs text-on-surface-variant mt-0.5">{{ lede }}</p>
		</div>
		<div class="flex items-start gap-3 shrink-0">
			{% block hud %}
				{% if hud == 'latest' %}
					<div class="hidden sm:flex flex-col items-end text-right max-w-64">
						<span class="text-2xs text-on-surface-variant">Latest</span>
						<span class="text-xs font-mono font-bold text-on-surface tabular-nums" id="hud-{{ id }}">—</span>
					</div>
				{% else %}
					<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-{{ id }}">—</p>
				{% endif %}
			{% endblock %}
			<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
				<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
			</button>
		</div>
	</div>
	{% block controls %}{% endblock %}
	<div class="chart-canvas-container h-80 md:h-85 w-full relative">
		<canvas id="{{ id }}"{% for name, value in canvas|default({}) %} {{ name }}="{{ value }}"{% endfor %}></canvas>
		{% block canvas_extra %}{% endblock %}
	</div>
	{% block footer %}
		{% if source|default(null) %}
			<p class="source-note">{{ source }}</p>
		{% endif %}
	{% endblock %}
</div>
