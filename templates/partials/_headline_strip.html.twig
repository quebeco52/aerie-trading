{# The latest headline, under the navigation on every page. Filled and kept live by
   assets/controllers/headline_controller.js; permanent across page visits, hidden until there is a headline. #}
<div id="headline-strip" data-turbo-permanent data-controller="headline" data-headline-url-value="{{ path('api_news_headline') }}" hidden
     class="bg-surface-container-low border-b border-outline-variant/20 w-full">
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 h-9 flex items-center gap-3 text-xs">
		<span data-headline-target="badge" class="badge badge-neutral shrink-0"></span>
		<span data-headline-target="source" class="font-mono font-semibold text-on-surface shrink-0" hidden></span>
		<a data-headline-target="text" href="/news" class="min-w-0 truncate text-on-surface hover:text-primary transition-colors"></a>
		<span data-headline-target="change" class="shrink-0" hidden></span>
		<time data-headline-target="time" class="hidden sm:inline shrink-0 font-mono tabular-nums text-on-surface-variant"></time>
		<div class="ml-auto shrink-0 flex items-center gap-3">
			<a href="/news" class="hidden sm:inline text-on-surface-variant hover:text-primary transition-colors">Newswire</a>
			<button type="button" data-action="headline#dismiss" class="w-6 h-6 -mr-1 flex items-center justify-center rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-bright transition-colors" aria-label="Hide this headline">
				<span class="material-symbols-outlined text-base leading-none" aria-hidden="true">close</span>
			</button>
		</div>
	</div>
</div>
