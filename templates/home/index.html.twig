{% extends 'base.html.twig' %}

{% block title %}The Aerie Exchange | Live Market Overview{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto space-y-8 mt-6 px-4 sm:px-6 lg:px-8 pb-12">
    
    {# Hero Section with Conditional Login/Dashboard Buttons #}
    <div class="flex flex-col md:flex-row justify-between items-center bg-slate-800 shadow-lg rounded-lg p-6 border-t-4 border-indigo-500">
        <div>
            <h1 class="text-3xl font-bold text-white tracking-tight">The Aerie Exchange</h1>
            <p class="text-gray-400 mt-2 text-sm">The central financial hub of the district. All markets are currently open.</p>
        </div>
        <div class="mt-4 md:mt-0 flex space-x-4">
            {% if app.user %}
                <span class="inline-flex items-center text-sm text-gray-400 mr-2">Logged in as {{ app.user.userIdentifier|split('@')[0] }}</span>
                <a href="/dashboard" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition">My Portfolio</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="rounded-md bg-slate-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-600 transition ring-1 ring-inset ring-slate-600">Log in</a>
                <a href="{{ path('app_register') }}" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition">Start Trading</a>
            {% endif %}
        </div>
    </div>

    {# The Market Index Highlight #}
    {% if etf %}
    <a href="/stock/{{ etf.ticker }}" class="block bg-slate-800 shadow-lg rounded-lg p-6 hover:ring-2 hover:ring-indigo-500 transition cursor-pointer group">
        <div class="flex justify-between items-center">
            <div>
                <h2 class="text-3xl font-bold text-white group-hover:text-indigo-300 transition">{{ etf.name }}</h2>
                <span class="inline-flex items-center rounded-md bg-indigo-500/10 px-2 py-1 text-xs font-medium text-indigo-400 ring-1 ring-inset ring-indigo-500/20 mt-2">
                    Market Index ({{ etf.ticker }})
                </span>
            </div>
            <div class="text-right">
                <p class="text-sm font-medium text-gray-400 uppercase tracking-wider mb-1">Live Valuation</p>
                <p id="etf-price" class="text-5xl font-mono font-bold text-white">${{ etf.price|number_format(2) }}</p>
            </div>
        </div>
    </a>
    {% endif %}

    {# The Global Stock Leaderboard #}
    <div class="bg-slate-800 shadow-lg rounded-lg overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-700 bg-slate-800/80">
            <h3 class="text-lg font-semibold text-white">Listed Assets</h3>
            <p class="text-xs text-gray-400 mt-1">Sorted by total market capitalization.</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-700">
                <thead class="bg-slate-900/50">
                    <tr>
                        <th scope="col" class="py-4 pl-6 pr-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Asset</th>
                        <th scope="col" class="px-3 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider hidden sm:table-cell">Sector</th>
                        <th scope="col" class="px-3 py-4 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider">Price</th>
                        <th scope="col" class="py-4 pl-3 pr-6 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider">Market Cap</th>
                    </tr>
                </thead>
                <tbody id="market-table-body" class="divide-y divide-slate-700 bg-slate-800">
                    {% for stock in stocks|default([]) %}
                        <tr class="hover:bg-slate-700/70 transition cursor-pointer group" onclick="window.location.href='/stock/{{ stock.ticker }}'">
                            <td class="whitespace-nowrap py-4 pl-6 pr-3">
                                <div class="flex items-center">
                                    <div>
                                        <div class="font-bold text-white text-base group-hover:text-indigo-300 transition">{{ stock.ticker }}</div>
                                        <div class="text-gray-400 text-xs mt-0.5">{{ stock.name }}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-300 hidden sm:table-cell">
                                <span class="inline-flex items-center rounded-md bg-slate-400/10 px-2 py-1 text-xs font-medium text-slate-400 ring-1 ring-inset ring-slate-400/20">
                                    {{ stock.sector }}
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-right font-mono text-white font-medium">
                                ${{ stock.price|number_format(2) }}
                            </td>
                            <td class="whitespace-nowrap py-4 pl-3 pr-6 text-sm text-right font-mono text-indigo-200">
                                {# Divide by 1 Billion #}
                                ${{ (stock.marketCap / 1000000000)|number_format(2) }}B
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }} 
    
    <script src="{{ asset('js/home.js') }}"></script>
{% endblock %}