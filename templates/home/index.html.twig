{% extends 'base.html.twig' %}

{% block title %}The Aerie Exchange | Live Market Overview
{% endblock %}

{% block body %}
	<div
		class="max-w-[1600px] mx-auto space-y-8 mt-6 px-4 sm:px-6 lg:px-8 pb-12">

		{# Hero Section #}
		<div class="flex flex-col md:flex-row justify-between items-center bg-surface-container-low shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)] rounded-2xl p-8 lg:p-10 border border-outline-variant/15 relative overflow-hidden">
			<div class="absolute -right-20 -top-20 w-64 h-64 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

			<div class="relative z-10">
				<div class="flex items-center gap-2 mb-3">
					<span class="w-2 h-2 rounded-full bg-secondary animate-pulse shadow-[0_0_8px_rgba(78,222,163,0.6)]"></span>
					<span class="text-[10px] font-bold tracking-widest text-secondary uppercase">Live Market Data</span>
				</div>
				<h1 class="text-4xl md:text-5xl font-bold text-on-surface tracking-tight mb-2">The Aerie Exchange</h1>
				<p class="text-on-surface-variant text-sm">The central financial hub. All markets are currently open.</p>
			</div>

			<div class="mt-8 md:mt-0 flex items-center space-x-4 relative z-10">
				{% if app.user %}
					<span class="inline-flex flex-col items-end text-xs text-on-surface-variant mr-2">
						<span>Logged in as</span>
						<strong class="text-on-surface">{{ app.user.userIdentifier|split('@')[0] }}</strong>
					</span>
					<a href="/dashboard" class="rounded-xl bg-primary px-6 py-3 text-sm font-bold text-[#001a42] shadow-lg shadow-primary/20 hover:brightness-110 active:scale-95 transition-all">My Portfolio</a>
				{% else %}
					<a href="{{ path('app_login') }}" class="rounded-xl bg-surface-container-high px-6 py-3 text-sm font-bold text-on-surface hover:bg-surface-bright active:scale-95 transition-all border border-outline-variant/10">Log in</a>
					<a href="{{ path('app_register') }}" class="rounded-xl bg-primary px-6 py-3 text-sm font-bold text-[#001a42] shadow-lg shadow-primary/20 hover:brightness-110 active:scale-95 transition-all">Start Trading</a>
				{% endif %}
			</div>
		</div>

		{# The Market Index Highlight #}
		{% if etf %}
			<a href="/stock/{{ etf.ticker }}" class="block bg-surface-container-low shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)] rounded-2xl p-8 border border-outline-variant/15 hover:border-primary/30 transition-all cursor-pointer group relative overflow-hidden">
				<div class="absolute right-0 top-0 w-48 h-48 bg-primary/5 rounded-full -mr-16 -mt-16 blur-3xl group-hover:bg-primary/10 transition-colors pointer-events-none"></div>

				<div class="flex flex-col md:flex-row justify-between md:items-center relative z-10 gap-4">
					<div>
						<h2 class="text-3xl font-bold text-on-surface group-hover:text-primary transition-colors tracking-tight">{{ etf.name }}</h2>
						<span class="inline-flex items-center rounded bg-primary/10 px-2 py-1 text-[10px] font-bold text-primary border border-primary/20 mt-3 uppercase tracking-widest">
							Market Index ({{ etf.ticker }})
						</span>
					</div>
					<div class="md:text-right">
						<p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest mb-1">Live Valuation</p>
						<p id="etf-price" class="text-5xl font-bold text-on-surface tracking-tighter">${{ etf.price|number_format(2) }}</p>
					</div>
				</div>
			</a>
		{% endif %}

		{# The Global Stock Leaderboard #}
		<div class="bg-surface-container-low shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)] rounded-2xl border border-outline-variant/15 overflow-hidden">
			<div class="px-8 py-6 border-b border-outline-variant/10 flex items-center justify-between">
				<div>
					<h3 class="text-xl font-bold text-on-surface tracking-tight">Market Cap Leaderboard</h3>
					<p class="text-xs text-on-surface-variant mt-1">Sorted by total network valuation.</p>
				</div>
			</div>

			<div class="overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="bg-surface-container-highest/30 text-on-surface-variant text-[10px] font-bold uppercase tracking-widest border-b border-outline-variant/10">
							<th scope="col" class="px-8 py-5">Asset</th>
							<th scope="col" class="px-6 py-5 hidden sm:table-cell">Sector</th>
							<th scope="col" class="px-6 py-5 text-right">Price</th>
							<th scope="col" class="px-8 py-5 text-right">Market Cap</th>
						</tr>
					</thead>
					<tbody id="market-table-body" class="divide-y divide-outline-variant/5 text-sm">
						{% for stock in stocks|default([]) %}
							<tr class="hover:bg-surface-container-high/40 transition-colors cursor-pointer group" onclick="window.location.href='/stock/{{ stock.ticker }}'">
								<td
									class="px-8 py-5">
									<div class="flex flex-col">
										<div class="font-bold text-on-surface text-base group-hover:text-primary transition-colors">{{ stock.name }}</div>
										<div class="text-on-surface-variant text-[10px] uppercase tracking-widest mt-0.5">{{ stock.ticker }}</div>
									</div>
								</td>
								<td class="px-6 py-5 hidden sm:table-cell text-on-surface-variant">
									{{ stock.sector }}
								</td>
								<td class="px-6 py-5 text-right font-bold text-on-surface">
									${{ stock.price|number_format(2) }}
								</td>
								<td class="px-8 py-5 text-right font-medium text-on-surface-variant">
									${{ (stock.marketCap / 1000000000)|number_format(2) }}B
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/home.js') }}"></script>
{% endblock %}
