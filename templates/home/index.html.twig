{% extends 'base.html.twig' %}

{% block page_title %}Markets{% endblock %}

{% block body %}
	<div class="max-w-400 mx-auto space-y-6 pt-8 px-4 sm:px-6 lg:px-8 pb-12">

		<header class="pb-5 border-b border-outline-variant/15">
			<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight">Markets</h1>
			<p class="mt-1.5 text-sm text-on-surface-variant">Live prices on the Aerie Exchange, and the economy they trade on.</p>
		</header>

		{# Macroeconomic Indicators #}
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
			{# Economic Cycle: links through to the economy page, where the full set of series lives. #}
			<a href="/economy" class="block bg-surface-container-low rounded-lg p-4 border border-outline-variant/20 hover:border-primary/50 transition-colors group">
				<p class="text-xs text-on-surface-variant mb-1">Economic cycle</p>
				<p id="macro-cycle" class="text-2xl font-semibold text-on-surface tracking-tight">{{ cycleLabel }}</p>
				<p class="text-xs text-on-surface-variant mt-1">Output gap <span class="font-mono">{{ macro.output_gap|pct(2, true) }}</span> <span class="text-primary group-hover:underline underline-offset-2">&middot; Economy</span></p>
			</a>

			{# Inflation: the economy page holds the CPI series. #}
			<a href="{{ path('app_economy') }}" class="block bg-surface-container-low rounded-lg p-4 border border-outline-variant/20 hover:border-primary/50 transition-colors group">
				{# The quarter's annual rate, as on the economy page, not the instant's noisy reading. #}
				<p class="text-xs text-on-surface-variant mb-1">Inflation (CPI)</p>
				<p class="text-2xl font-semibold text-on-surface tracking-tight font-mono">{{ macro.inflation_ema|pct(2) }}</p>
				<p class="text-xs text-on-surface-variant mt-1">Target <span class="font-mono">{{ inflationTarget|pct(2) }}</span> <span class="text-primary group-hover:underline underline-offset-2">&middot; Economy</span></p>
			</a>

			{# Policy rate: links through to the Monetary Authority, which sets it. #}
			<a href="{{ path('app_authority') }}" class="block bg-surface-container-low rounded-lg p-4 border border-outline-variant/20 hover:border-primary/50 transition-colors group">
				<p class="text-xs text-on-surface-variant mb-1">Policy rate</p>
				<p class="text-2xl font-semibold text-on-surface tracking-tight font-mono">{{ macro.policy_rate|pct(2) }}</p>
				<p class="text-xs text-on-surface-variant mt-1">Overnight target <span class="text-primary group-hover:underline underline-offset-2">&middot; Monetary Authority</span></p>
			</a>

			{# 10Y yield: links through to the bond ladder, where the curve is drawn. #}
			<a href="{{ path('app_bond_ladder') }}" class="block bg-surface-container-low rounded-lg p-4 border border-outline-variant/20 hover:border-primary/50 transition-colors group">
				<p class="text-xs text-on-surface-variant mb-1">10Y yield</p>
				<p class="text-2xl font-semibold text-on-surface tracking-tight font-mono">{{ macro.yield_10y|pct(2) }}</p>
				{% set spread = macro.yield_10y - macro.policy_rate %}
				<p class="text-xs mt-1 {{ spread < 0 ? 'text-warning' : 'text-on-surface-variant' }}">
					Curve <span class="font-mono">{{ spread|bps(0, true) }}</span>{{ spread < 0 ? ', inverted' : '' }} <span class="text-primary group-hover:underline underline-offset-2">&middot; Bonds</span>
				</p>
			</a>
		</div>

		{# The published indices. Read against each other rather than one at a time: the headline against the
		   whole board is breadth, the staples fund against the headline is rotation, and the low-volatility
		   fund against the headline is how much of the move is being paid for in risk. #}
		{% if indices is not empty %}
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				{% for tile in indices %}
					<a href="/stock/{{ tile.ticker }}" class="block bg-surface-container-low rounded-lg p-5 md:p-6 border border-outline-variant/20 hover:border-primary/40 transition-colors group">
						<div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4">
							<div class="min-w-0">
								<h2 class="text-lg font-semibold text-on-surface group-hover:text-primary transition-colors tracking-tight truncate">{{ tile.name }}</h2>
								<p class="mt-1 text-xs text-on-surface-variant">{{ tile.label }} &middot; <span class="font-mono">{{ tile.ticker }}</span></p>
							</div>
							<div class="sm:text-right shrink-0">
								<p id="index-price-{{ tile.ticker }}" class="text-3xl font-semibold text-on-surface tracking-tight font-mono tabular-nums">{{ tile.price|money(2) }}</p>
							</div>
						</div>
					</a>
				{% endfor %}
			</div>
		{% endif %}

		{# The month on the exchange (MarketWrapBuilder): breadth, the largest moves either way, each sector's move and
		   the latest headlines. Read at page load, on the same one-month change the listings table prints. #}
		{% if wrap is defined and wrap %}
			<section class="bg-surface-container-low rounded-lg border border-outline-variant/20 p-5 space-y-5" id="market-wrap">
				<div class="flex flex-wrap items-baseline justify-between gap-3">
					<h2 class="text-base font-semibold text-on-surface">The month on the exchange</h2>
					<p class="text-xs text-on-surface-variant"><span class="font-mono text-secondary">{{ wrap.advancing }}</span> rose, <span class="font-mono text-tertiary">{{ wrap.declining }}</span> fell{% if wrap.unchanged > 0 %}, <span class="font-mono">{{ wrap.unchanged }}</span> unchanged{% endif %} &middot; <a href="{{ path('app_industries') }}" class="text-primary hover:underline">Industries</a></p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
					{% for list in [{title: 'Leaders', rows: wrap.leaders, empty: 'No listing rose.'}, {title: 'Laggards', rows: wrap.laggards, empty: 'No listing fell.'}] %}
						<div>
							<h3 class="text-xs font-semibold text-on-surface-variant mb-2">{{ list.title }}</h3>
							<ul class="divide-y divide-outline-variant/10 text-xs">
								{% for row in list.rows %}
									<li class="py-1.5 flex items-center justify-between gap-3">
										<a href="/stock/{{ row.ticker }}" class="min-w-0 truncate hover:text-primary"><span class="font-mono font-semibold text-on-surface">{{ row.ticker }}</span> <span class="text-on-surface-variant">{{ row.name }}</span></a>
										<span class="font-mono tabular-nums shrink-0 {{ row.change|signed_class }}">{{ row.change|pct(1, true) }}</span>
									</li>
								{% else %}
									<li class="py-1.5 text-on-surface-variant">{{ list.empty }}</li>
								{% endfor %}
							</ul>
						</div>
					{% endfor %}
					<div>
						<h3 class="text-xs font-semibold text-on-surface-variant mb-2">Sectors</h3>
						{% set widest = max(0.0001, wrap.sectors|map(s => s.change|abs)|reduce((a, b) => max(a, b), 0)) %}
						<ul class="space-y-1.5 text-xs" aria-label="Sector moves, weighted by market value">
							{% for sector in wrap.sectors %}
								<li class="flex items-center gap-2">
									<a href="{{ path('app_screener', {sector: sector.name}) }}" class="w-36 shrink-0 truncate text-on-surface-variant hover:text-primary" title="{{ sector.companies }} {{ sector.companies == 1 ? 'listing' : 'listings' }}">{{ sector.name }}</a>
									<span class="flex-1 flex h-1.5" aria-hidden="true">
										<span class="w-1/2 flex justify-end">{% if sector.change < 0 %}<span class="block h-full rounded-l-full bg-tertiary" style="width: {{ (-sector.change / widest * 100)|round(1) }}%"></span>{% endif %}</span>
										<span class="w-1/2 flex border-l border-outline-variant/60">{% if sector.change > 0 %}<span class="block h-full rounded-r-full bg-secondary" style="width: {{ (sector.change / widest * 100)|round(1) }}%"></span>{% endif %}</span>
									</span>
									<span class="w-14 shrink-0 text-right font-mono tabular-nums {{ sector.change|signed_class }}">{{ sector.change|pct(1, true) }}</span>
								</li>
							{% endfor %}
						</ul>
					</div>
					<div>
						<div class="flex items-baseline justify-between mb-2">
							<h3 class="text-xs font-semibold text-on-surface-variant">Headlines</h3>
							<a href="/news" class="text-xs text-primary hover:underline">Newswire</a>
						</div>
						<ul class="space-y-2.5 text-xs">
							{% for story in wrap.headlines %}
								<li>
									<div class="flex items-center gap-2"><span class="badge {{ story.card.badgeClass }}">{{ story.card.badge|lower|capitalize }}</span><a href="/stock/{{ story.source.ticker }}" class="font-mono font-semibold text-on-surface hover:text-primary">{{ story.source.ticker }}</a></div>
									<p class="text-on-surface-variant mt-1 leading-snug">{{ story.card.headline }}</p>
								</li>
							{% else %}
								<li class="text-on-surface-variant">No headlines yet.</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			</section>
		{% endif %}

		{# Every listing, largest first; home.js keeps the order live. #}
		<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden">
			<div class="px-5 py-4 border-b border-outline-variant/15 flex items-baseline justify-between gap-4">
				<h2 class="text-base font-semibold text-on-surface">All listings</h2>
				<p class="text-xs text-on-surface-variant">By market capitalisation</p>
			</div>

			<div class="overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="table-head bg-surface-container-highest/20">
							<th scope="col" class="px-5 py-3">Company</th>
							<th scope="col" class="px-4 py-3 hidden sm:table-cell">Sector</th>
							<th scope="col" class="px-4 py-3 text-right">Price</th>
							<th scope="col" class="px-4 py-3 text-right" title="Change over the trailing one-month buffered window">1M</th>
							<th scope="col" class="px-5 py-3 text-right">Market cap</th>
						</tr>
					</thead>
					<tbody id="market-table-body" class="divide-y divide-outline-variant/10 text-sm relative">
						{% for stock in stocks %}
							<tr id="row-{{ stock.ticker }}" data-mcap="{{ stock.isBankrupt ? 0 : stock.marketCap }}" data-bankrupt="{{ stock.isBankrupt ? 'true' : 'false' }}" class="{{ stock.isBankrupt ? 'bg-tertiary/10' : 'hover:bg-surface-container-high/30' }} transition-colors group focus-within:bg-surface-container-high/30 relative">
								<th scope="row" class="px-5 py-3 text-left font-normal">
									<div class="flex flex-col">
										<div class="flex items-center gap-2">
											{# Stretched over the row, so the whole band is clickable without an onclick. #}
											<a href="/stock/{{ stock.ticker }}" class="font-bold text-on-surface text-sm group-hover:text-primary transition-colors outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:decoration-primary focus-visible:underline-offset-4">{{ stock.name }}</a>
											{% if stock.isBankrupt %}
												<span class="badge badge-down relative z-10">Bankrupt</span>
											{% endif %}
										</div>
										<div class="text-on-surface-variant text-xs font-mono mt-0.5">{{ stock.ticker }}</div>
									</div>
								</th>
								<td class="px-4 py-3 hidden sm:table-cell text-on-surface-variant text-xs">
									{{ stock.sector }}
								</td>
								<td id="price-{{ stock.ticker }}" class="px-4 py-3 text-right font-bold font-mono tabular-nums text-xs sm:text-sm {{ stock.isBankrupt ? 'text-tertiary line-through' : 'text-on-surface' }} transition-colors duration-300">
									{{ (stock.isBankrupt ? 0 : stock.price)|money(2) }}
								</td>
								{% set change = stock.isBankrupt ? null : stock.changePercent %}
								<td id="chg-{{ stock.ticker }}" class="px-4 py-3 text-right font-semibold font-mono tabular-nums text-xs sm:text-sm transition-colors duration-300 {{ change|signed_class }}">
									{{- change|pct(2, true) -}}
								</td>
								<td id="mcap-{{ stock.ticker }}" class="px-5 py-3 text-right font-medium font-mono tabular-nums text-xs sm:text-sm text-on-surface-variant transition-colors duration-300">
									{{ stock.isBankrupt ? 0|money(2) : stock.marketCap|format_large('$') }}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{# Share counts, so live market caps can be recomputed as prices tick. #}
	<script type="application/json" id="market-data">
		{{ {
			shares: stocks|reduce((carry, stock) => carry|merge({ (stock.ticker): stock.shares }), {})
		}|json_encode|raw }}
	</script>

    <script type="module">
        import 'pages/home';
    </script>
{% endblock %}
