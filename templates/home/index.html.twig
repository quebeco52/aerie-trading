{% extends 'base.html.twig' %}

{% block title %}Markets | Aerie Exchange{% endblock %}

{% block body %}
	<div class="max-w-400 mx-auto space-y-6 pt-8 px-4 sm:px-6 lg:px-8 pb-12">

		<header class="pb-5 border-b border-outline-variant/15">
			<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight">Markets</h1>
			<p class="mt-1.5 text-sm text-on-surface-variant">Live prices on the Aerie Exchange, and the economy they trade on.</p>
		</header>

		{# Macroeconomic Indicators #}
		{% if macro is defined %}
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
			{# Economic Cycle: links through to the economy page, where the full set of series lives. #}
			<a href="/economy" class="block bg-surface-container-low rounded-lg p-4 border border-outline-variant/20 hover:border-primary/50 transition-colors group">
				<p class="text-xs text-on-surface-variant mb-1">Economic cycle</p>
				<p id="macro-cycle" class="text-2xl font-semibold text-on-surface tracking-tight">{{ macro.output_gap > 0.01 ? 'Boom' : (macro.output_gap < -0.01 ? 'Bust' : 'Neutral') }}</p>
				<p class="text-xs text-on-surface-variant mt-1">Output gap <span class="font-mono">{{ macro.output_gap >= 0 ? '+' : '' }}{{ (macro.output_gap * 100)|number_format(2) }}%</span> <span class="text-primary group-hover:underline underline-offset-2">&middot; Economy</span></p>
			</a>

			{# Inflation #}
			<div class="bg-surface-container-low rounded-lg p-4 border border-outline-variant/20">
				<p class="text-xs text-on-surface-variant mb-1">Inflation</p>
				<p class="text-2xl font-semibold text-on-surface tracking-tight font-mono">{{ (macro.inflation|default(0) * 100)|number_format(2) }}%</p>
				<p class="text-xs text-on-surface-variant mt-1">Target <span class="font-mono">2.00%</span></p>
			</div>

			{# Policy Rate #}
			<div class="bg-surface-container-low rounded-lg p-4 border border-outline-variant/20">
				<p class="text-xs text-on-surface-variant mb-1">Policy rate</p>
				<p class="text-2xl font-semibold text-on-surface tracking-tight font-mono">{{ (macro.policy_rate|default(0) * 100)|number_format(2) }}%</p>
				<p class="text-xs text-on-surface-variant mt-1">Overnight target</p>
			</div>

			{# 10Y Yield #}
			<div class="bg-surface-container-low rounded-lg p-4 border border-outline-variant/20">
				<p class="text-xs text-on-surface-variant mb-1">10Y yield</p>
				<p class="text-2xl font-semibold text-on-surface tracking-tight font-mono">{{ (macro.yield_10y|default(0) * 100)|number_format(2) }}%</p>
				{% set spread = (macro.yield_10y|default(0) - macro.policy_rate|default(0)) * 10000 %}
				<p class="text-xs mt-1 {{ spread < 0 ? 'text-tertiary' : 'text-on-surface-variant' }}">
					Curve <span class="font-mono">{{ spread >= 0 ? '+' : '' }}{{ spread|number_format(0) }} bps</span>{{ spread < 0 ? ', inverted' : '' }}
				</p>
			</div>
		</div>
		{% endif %}

		{# The published indices. Read against each other rather than one at a time: the headline against the
		   whole board is breadth, the staples fund against the headline is rotation, and the low-volatility
		   fund against the headline is how much of the move is being paid for in risk. #}
		{% if indices|default([])|length > 0 %}
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				{% for tile in indices %}
					<a href="/stock/{{ tile.ticker }}" class="block bg-surface-container-low rounded-lg p-5 md:p-6 border border-outline-variant/20 hover:border-primary/40 transition-colors group">
						<div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4">
							<div class="min-w-0">
								<h2 class="text-lg font-semibold text-on-surface group-hover:text-primary transition-colors tracking-tight truncate">{{ tile.name }}</h2>
								<p class="mt-1 text-xs text-on-surface-variant">{{ tile.label }} &middot; <span class="font-mono">{{ tile.ticker }}</span></p>
							</div>
							<div class="sm:text-right shrink-0">
								<p id="index-price-{{ tile.ticker }}" class="text-3xl font-semibold text-on-surface tracking-tight font-mono tabular-nums">${{ tile.price|number_format(2) }}</p>
							</div>
						</div>
					</a>
				{% endfor %}
			</div>
		{% endif %}

		{# Every listing, largest first; home.js keeps the order live. #}
		<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden">
			<div class="px-5 py-4 border-b border-outline-variant/15 flex items-baseline justify-between gap-4">
				<h2 class="text-base font-semibold text-on-surface">All listings</h2>
				<p class="text-xs text-on-surface-variant">By market capitalisation</p>
			</div>

			<div class="overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="bg-surface-container-highest/20 text-on-surface-variant text-2xs font-semibold uppercase tracking-wide border-b border-outline-variant/15">
							<th scope="col" class="px-5 py-3">Company</th>
							<th scope="col" class="px-4 py-3 hidden sm:table-cell">Sector</th>
							<th scope="col" class="px-4 py-3 text-right">Price</th>
							<th scope="col" class="px-4 py-3 text-right" title="Change over the trailing one-month buffered window">1M</th>
							<th scope="col" class="px-5 py-3 text-right">Market cap</th>
						</tr>
					</thead>
					<tbody id="market-table-body" class="divide-y divide-outline-variant/10 text-sm relative">
						{% for stock in stocks|default([]) %}
							<tr id="row-{{ stock.ticker }}" data-mcap="{{ stock.isBankrupt ? 0 : stock.marketCap }}" data-bankrupt="{{ stock.isBankrupt ? 'true' : 'false' }}" class="{{ stock.isBankrupt ? 'opacity-50 hover:opacity-80 bg-tertiary/10' : 'hover:bg-surface-container-high/30' }} transition-colors group focus-within:bg-surface-container-high/30 relative">
								<th scope="row" class="px-5 py-3 text-left font-normal">
									<div class="flex flex-col">
										<div class="flex items-center gap-2">
											{# Stretched over the row, so the whole band is clickable without an onclick. #}
											<a href="/stock/{{ stock.ticker }}" class="font-bold text-on-surface text-sm group-hover:text-primary transition-colors outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:decoration-primary focus-visible:underline-offset-4">{{ stock.name }}</a>
											{% if stock.isBankrupt %}
												<span class="relative z-10 inline-flex items-center rounded bg-tertiary/10 px-1.5 py-0.5 text-4xs font-bold text-tertiary border border-tertiary/25 uppercase tracking-widest">Bankrupt</span>
											{% endif %}
										</div>
										<div class="text-on-surface-variant text-xs tracking-wide font-mono mt-0.5">{{ stock.ticker }}</div>
									</div>
								</th>
								<td class="px-4 py-3 hidden sm:table-cell text-on-surface-variant text-xs">
									{{ stock.sector }}
								</td>
								<td id="price-{{ stock.ticker }}" class="px-4 py-3 text-right font-bold font-mono tabular-nums text-xs sm:text-sm {{ stock.isBankrupt ? 'text-tertiary line-through' : 'text-on-surface' }} transition-colors duration-300">
									${{ (stock.isBankrupt ? 0.00 : stock.price)|number_format(2) }}
								</td>
								<td id="chg-{{ stock.ticker }}" class="px-4 py-3 text-right font-semibold font-mono tabular-nums text-xs sm:text-sm transition-colors duration-300 {{ stock.changePercent is null or stock.isBankrupt ? 'text-on-surface-faint' : (stock.changePercent >= 0 ? 'text-secondary' : 'text-tertiary') }}">
									{%- if stock.isBankrupt or stock.changePercent is null -%}
										&mdash;
									{%- else -%}
										{{ stock.changePercent >= 0 ? '+' : '' }}{{ (stock.changePercent * 100)|number_format(2) }}%
									{%- endif -%}
								</td>
								<td id="mcap-{{ stock.ticker }}" class="px-5 py-3 text-right font-medium font-mono tabular-nums text-xs sm:text-sm text-on-surface-variant transition-colors duration-300">
									${{ stock.isBankrupt ? '0.00' : ((stock.marketCap / 1000000000)|number_format(2) ~ 'B') }}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{# Share counts, so live market caps can be recomputed as prices tick. #}
	<script type="application/json" id="market-data">
		{{ {
			shares: stocks|default([])|reduce((carry, stock) => carry|merge({ (stock.ticker): stock.shares }), {})
		}|json_encode|raw }}
	</script>

    <script type="module">
        import 'pages/home';
    </script>
{% endblock %}
