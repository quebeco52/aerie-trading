{% extends 'base.html.twig' %}

{% block title %}Aerie Exchange | Live Stock Market Simulator{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="keywords" content="stock market simulator, paper trading, algorithmic trading, financial simulation game, macroeconomic simulator">
{% endblock %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 w-full">

		{# --- Masthead --- #}
		<section class="py-14 md:py-20 border-b border-outline-variant/15">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
				<div class="lg:col-span-7">
					<h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-on-surface leading-tight">
						The Aerie Exchange
					</h1>

					<p class="mt-4 text-sm sm:text-base text-on-surface-variant max-w-2xl leading-relaxed">
						The securities market of the Aerie Autonomous District. Trade its listed companies,
						index funds, bonds and options, priced live against the District's economy: the
						policy rate, the yield curve, credit conditions and the business cycle.
					</p>

					<div class="mt-8 flex flex-col sm:flex-row gap-3">
						<a href="{{ path('app_register') }}" class="inline-flex justify-center items-center rounded bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary transition-colors hover:bg-primary-container focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
							Open an account
						</a>
						<a href="{{ path('app_login') }}" class="inline-flex justify-center items-center rounded border border-outline-variant/30 bg-surface-container-low px-5 py-2.5 text-sm font-semibold text-on-surface transition-colors hover:bg-surface-container-high focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
							Sign in
						</a>
					</div>
				</div>

				{# --- Live index tile: the market's actual state, in place of promotional copy --- #}
				<div class="lg:col-span-5">
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-5 sm:p-6">
						{% if etf %}
							<div class="flex items-baseline justify-between gap-3">
								<div>
									<p class="text-sm font-medium text-on-surface">{{ etf.name }}</p>
									<p class="text-xs text-on-surface-variant mt-0.5"><span class="font-mono">{{ etf.ticker }}</span> &middot; Headline index fund</p>
								</div>
							</div>
							<p class="mt-3 text-3xl sm:text-4xl font-semibold font-mono tabular-nums text-on-surface tracking-tight">
								${{ etf.price|number_format(2) }}
							</p>
						{% endif %}

						{# Market breadth: how the board actually moved over the trailing month. #}
						<p class="mt-5 pt-4 border-t border-outline-variant/15 text-xs text-on-surface-variant">Past month</p>
						<dl class="mt-2 grid grid-cols-3 gap-3">
							<div>
								<dt class="text-xs text-on-surface-variant">Advancing</dt>
								<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-secondary">{{ breadth.advancing }}</dd>
							</div>
							<div>
								<dt class="text-xs text-on-surface-variant">Declining</dt>
								<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-tertiary">{{ breadth.declining }}</dd>
							</div>
							<div>
								<dt class="text-xs text-on-surface-variant">Unchanged</dt>
								<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-on-surface-variant">{{ breadth.unchanged }}</dd>
							</div>
						</dl>

						{% if breadth.topMover %}
							<div class="mt-4 pt-4 border-t border-outline-variant/15 flex items-center justify-between">
								<span class="text-xs text-on-surface-variant">Largest move</span>
								<span class="text-sm font-semibold font-mono tabular-nums {{ breadth.topMover.changePercent >= 0 ? 'text-secondary' : 'text-tertiary' }}">
									{{ breadth.topMover.ticker }}
									{{ breadth.topMover.changePercent >= 0 ? '+' : '' }}{{ (breadth.topMover.changePercent * 100)|number_format(2) }}%
								</span>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</section>

		{# --- Macro conditions strip --- #}
		{% if macro is defined %}
			<section class="py-8 border-b border-outline-variant/15">
				<h2 class="text-base font-semibold text-on-surface mb-4">Current conditions</h2>
				<dl class="grid grid-cols-2 lg:grid-cols-4 gap-4">
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-4">
						<dt class="text-xs text-on-surface-variant">Cycle</dt>
						<dd class="mt-1 text-xl font-semibold text-on-surface tracking-tight">{{ macro.output_gap > 0.01 ? 'Boom' : (macro.output_gap < -0.01 ? 'Bust' : 'Neutral') }}</dd>
					</div>
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-4">
						<dt class="text-xs text-on-surface-variant">Inflation</dt>
						<dd class="mt-1 text-xl font-semibold font-mono tabular-nums text-on-surface">{{ (macro.inflation|default(0) * 100)|number_format(2) }}%</dd>
					</div>
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-4">
						<dt class="text-xs text-on-surface-variant">Policy rate</dt>
						<dd class="mt-1 text-xl font-semibold font-mono tabular-nums text-on-surface">{{ (macro.policy_rate|default(0) * 100)|number_format(2) }}%</dd>
					</div>
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-4">
						<dt class="text-xs text-on-surface-variant">10Y yield</dt>
						<dd class="mt-1 text-xl font-semibold font-mono tabular-nums text-on-surface">{{ (macro.yield_10y|default(0) * 100)|number_format(2) }}%</dd>
					</div>
				</dl>
			</section>
		{% endif %}

		{# --- Largest listings --- #}
		<section class="py-10">
			<div class="flex items-baseline justify-between mb-4">
				<h2 class="text-base font-semibold text-on-surface">Largest listings</h2>
				<a href="/screener" class="text-xs text-primary hover:underline underline-offset-2">All listings</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				{% for stock in top_stocks %}
					<a href="{{ path('app_stock_view', { ticker: stock.ticker }) }}" class="group block bg-surface-container-low border border-outline-variant/25 rounded-lg p-5 transition-colors hover:border-primary/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
						<div class="flex justify-between items-start gap-3">
							<div class="min-w-0">
								<h3 class="text-sm font-semibold text-on-surface group-hover:text-primary transition-colors truncate">{{ stock.name }}</h3>
								<p class="text-xs text-on-surface-variant font-mono mt-0.5">{{ stock.ticker }}</p>
							</div>
							<span class="shrink-0 text-xs text-on-surface-variant">{{ stock.sector }}</span>
						</div>

						<div class="mt-4 pt-3 border-t border-outline-variant/15 flex items-end justify-between gap-3">
							<div>
								<p class="text-xs text-on-surface-variant">Last</p>
								<p class="text-xl font-semibold font-mono tabular-nums text-on-surface mt-0.5">${{ stock.price|number_format(2) }}</p>
							</div>
							<div class="text-right">
								<p class="text-xs text-on-surface-variant">Past month</p>
								<p class="text-sm font-semibold font-mono tabular-nums mt-0.5 {{ stock.changePercent is null ? 'text-on-surface-variant/50' : (stock.changePercent >= 0 ? 'text-secondary' : 'text-tertiary') }}">
									{%- if stock.changePercent is null -%}
										&mdash;
									{%- else -%}
										{{ stock.changePercent >= 0 ? '+' : '' }}{{ (stock.changePercent * 100)|number_format(2) }}%
									{%- endif -%}
								</p>
							</div>
						</div>
					</a>
				{% endfor %}
			</div>
		</section>

		{# --- Disclaimer --- #}
		<section class="pb-12">
			<p class="text-xs text-on-surface-variant/70 leading-relaxed max-w-3xl">
				Aerie Exchange is a fictional market. Its companies, prices and economy are invented, no real
				money is involved, and nothing here is investment advice.
			</p>
		</section>

	</div>
{% endblock %}
