{% extends 'base.html.twig' %}

{% block title %}Aerie Exchange | Live Stock Market Simulator{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="keywords" content="stock market simulator, paper trading, algorithmic trading, financial simulation game, macroeconomic simulator">
{% endblock %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 w-full">

		{# --- Masthead --- #}
		<section class="py-14 md:py-20 border-b border-outline-variant/15">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-2 mb-4">
						<span class="w-2 h-2 rounded-full bg-secondary"></span>
						<span class="text-[11px] font-semibold tracking-wide text-secondary uppercase">Market open</span>
					</div>

					<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-on-surface leading-tight">
						The Aerie Exchange
					</h1>

					<p class="mt-4 text-sm sm:text-base text-on-surface-variant max-w-2xl leading-relaxed">
						A live simulated market for the Aerie Autonomous District. Trade equities and the
						index against a full macroeconomic model &mdash; policy rates, the yield curve,
						credit spreads and the business cycle all price into what you own.
					</p>

					<div class="mt-8 flex flex-col sm:flex-row gap-3">
						<a href="{{ path('app_register') }}" class="inline-flex justify-center items-center rounded bg-primary px-5 py-2.5 text-sm font-semibold text-[#001a42] transition-colors hover:bg-primary-container focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
							Open an account
						</a>
						<a href="{{ path('app_login') }}" class="inline-flex justify-center items-center rounded border border-outline-variant/30 bg-surface-container-low px-5 py-2.5 text-sm font-semibold text-on-surface transition-colors hover:bg-surface-container-high focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
							Sign in
						</a>
					</div>
				</div>

				{# --- Live index tile: the market's actual state, in place of promotional copy --- #}
				<div class="lg:col-span-5">
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-5 sm:p-6">
						{% if etf %}
							<div class="flex items-baseline justify-between gap-3">
								<div>
									<p class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">{{ etf.name }}</p>
									<p class="text-xs text-on-surface-variant/70 font-mono mt-0.5">{{ etf.ticker }} &middot; Market index</p>
								</div>
							</div>
							<p class="mt-3 text-3xl sm:text-4xl font-bold font-mono tabular-nums text-on-surface tracking-tight">
								${{ etf.price|number_format(2) }}
							</p>
						{% endif %}

						{# Market breadth: how the roster actually moved over the trailing month. #}
						<dl class="mt-5 pt-4 border-t border-outline-variant/15 grid grid-cols-3 gap-3 text-center">
							<div>
								<dt class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">Advancing</dt>
								<dd class="mt-1 text-lg font-bold font-mono tabular-nums text-secondary">{{ breadth.advancing }}</dd>
							</div>
							<div>
								<dt class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">Declining</dt>
								<dd class="mt-1 text-lg font-bold font-mono tabular-nums text-tertiary">{{ breadth.declining }}</dd>
							</div>
							<div>
								<dt class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">Unchanged</dt>
								<dd class="mt-1 text-lg font-bold font-mono tabular-nums text-on-surface-variant">{{ breadth.unchanged }}</dd>
							</div>
						</dl>

						{% if breadth.topMover %}
							<div class="mt-4 pt-4 border-t border-outline-variant/15 flex items-center justify-between">
								<span class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">Largest move (1M)</span>
								<span class="text-sm font-bold font-mono tabular-nums {{ breadth.topMover.changePercent >= 0 ? 'text-secondary' : 'text-tertiary' }}">
									{{ breadth.topMover.ticker }}
									{{ breadth.topMover.changePercent >= 0 ? '+' : '' }}{{ (breadth.topMover.changePercent * 100)|number_format(2) }}%
								</span>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</section>

		{# --- Macro conditions strip --- #}
		{% if macro is defined %}
			<section class="py-8 border-b border-outline-variant/15">
				<h2 class="text-[11px] font-semibold uppercase tracking-wide text-on-surface-variant mb-4">Current conditions</h2>
				<dl class="grid grid-cols-2 lg:grid-cols-4 gap-4">
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-4">
						<dt class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">Cycle</dt>
						<dd class="mt-1.5 text-xl font-bold text-on-surface tracking-tight">{{ macro.output_gap > 0.01 ? 'Boom' : (macro.output_gap < -0.01 ? 'Bust' : 'Neutral') }}</dd>
					</div>
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-4">
						<dt class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">Inflation</dt>
						<dd class="mt-1.5 text-xl font-bold font-mono tabular-nums text-on-surface">{{ (macro.inflation|default(0) * 100)|number_format(2) }}%</dd>
					</div>
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-4">
						<dt class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">Policy rate</dt>
						<dd class="mt-1.5 text-xl font-bold font-mono tabular-nums text-on-surface">{{ (macro.policy_rate|default(0) * 100)|number_format(2) }}%</dd>
					</div>
					<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-4">
						<dt class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">10Y yield</dt>
						<dd class="mt-1.5 text-xl font-bold font-mono tabular-nums text-on-surface">{{ (macro.yield_10y|default(0) * 100)|number_format(2) }}%</dd>
					</div>
				</dl>
			</section>
		{% endif %}

		{# --- Largest listings --- #}
		<section class="py-10">
			<div class="flex items-baseline justify-between mb-4">
				<h2 class="text-base font-bold text-on-surface tracking-tight">Largest listings</h2>
				<span class="text-xs text-on-surface-variant">By market capitalisation</span>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				{% for stock in top_stocks %}
					<a href="{{ path('app_stock_view', { ticker: stock.ticker }) }}" class="group block bg-surface-container-low border border-outline-variant/25 rounded-lg p-5 transition-colors hover:border-primary/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
						<div class="flex justify-between items-start gap-3">
							<div class="min-w-0">
								<h3 class="text-sm font-bold text-on-surface group-hover:text-primary transition-colors truncate">{{ stock.name }}</h3>
								<p class="text-xs text-on-surface-variant font-mono mt-0.5">{{ stock.ticker }}</p>
							</div>
							<span class="shrink-0 inline-flex items-center rounded bg-surface-container px-2 py-0.5 text-[10px] text-on-surface-variant border border-outline-variant/20">
								{{ stock.sector }}
							</span>
						</div>

						<div class="mt-4 pt-3 border-t border-outline-variant/15 flex items-end justify-between gap-3">
							<div>
								<p class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">Last</p>
								<p class="text-xl font-bold font-mono tabular-nums text-on-surface mt-0.5">${{ stock.price|number_format(2) }}</p>
							</div>
							<div class="text-right">
								<p class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">1M</p>
								<p class="text-sm font-semibold font-mono tabular-nums mt-0.5 {{ stock.changePercent is null ? 'text-on-surface-variant/50' : (stock.changePercent >= 0 ? 'text-secondary' : 'text-tertiary') }}">
									{%- if stock.changePercent is null -%}
										&mdash;
									{%- else -%}
										{{ stock.changePercent >= 0 ? '+' : '' }}{{ (stock.changePercent * 100)|number_format(2) }}%
									{%- endif -%}
								</p>
							</div>
						</div>
					</a>
				{% endfor %}
			</div>
		</section>

		{# --- Disclaimer --- #}
		<section class="pb-12">
			<p class="text-xs text-on-surface-variant/70 leading-relaxed max-w-3xl">
				Aerie Exchange is a simulated environment. All markets, companies, prices and valuations
				are fictional, no real money is involved, and nothing here is investment advice.
			</p>
		</section>

	</div>
{% endblock %}
