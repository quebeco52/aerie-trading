{% extends 'base.html.twig' %}

{% block title %}Aerie Exchange | Live Stock Market Simulator{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="keywords" content="stock market simulator, paper trading, algorithmic trading, financial simulation game, macroeconomic simulator">
{% endblock %}

{% block body %}
	<div class="bg-slate-950 text-white min-h-screen font-sans selection:bg-blue-500 selection:text-white relative overflow-hidden">

		<div class="absolute inset-0 bg-gradient-to-b from-blue-950/40 via-slate-950 to-slate-950"></div>

		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center z-10">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-900 bg-blue-900/30 text-blue-400 text-xs font-mono uppercase tracking-widest mb-8">
				<span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
				Market Status: Open
			</div>

			<h1 class="text-5xl font-extrabold tracking-tight text-white sm:text-7xl mb-6">
				The Aerie
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-blue-600">Exchange</span>
			</h1>

			<p class="mt-6 text-xl text-slate-400 max-w-3xl mx-auto mb-10 font-light leading-relaxed">
				Welcome to the financial nervous system of the
				<span class="text-blue-400 font-medium">Aerie Autonomous District.</span>
				<br>
				Where capital dictates physics and only the ruthless survive.
			</p>

			<div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
				<a href="{{ path('app_register') }}" class="px-8 py-3 border border-transparent text-base font-bold rounded-md text-slate-900 bg-blue-500 hover:bg-blue-400 uppercase tracking-wider transition-all shadow-[0_0_15px_rgba(59,130,246,0.5)]">
					Register
				</a>
				<a href="{{ path('app_login') }}" class="px-8 py-3 border border-slate-700 text-base font-mono rounded-md text-slate-300 bg-slate-900/50 hover:bg-slate-800 hover:border-slate-500 transition-colors uppercase tracking-widest backdrop-blur-sm">
					Login
				</a>
			</div>

			<!-- Testimonials / Quotes -->
			<div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto text-left">
				<div class="p-6 bg-slate-900/40 border border-slate-800/60 hover:border-slate-700 transition-colors relative group">
					<div class="absolute top-0 left-0 w-1 h-full bg-slate-800 group-hover:bg-blue-500 transition-colors"></div>
					<p class="text-sm text-slate-400 font-light leading-relaxed italic">
						"A bloated balance sheet isn't a legacy, it's prey."
					</p>
					<p class="mt-4 text-[10px] font-mono text-slate-500 uppercase tracking-widest">
						<span class="text-blue-500 mr-2">>></span>CEO of Black Swan Capital
					</p>
				</div>

				<div class="p-6 bg-slate-900/40 border border-slate-800/60 hover:border-slate-700 transition-colors relative group">
					<div class="absolute top-0 left-0 w-1 h-full bg-slate-800 group-hover:bg-blue-500 transition-colors"></div>
					<p class="text-sm text-slate-400 font-light leading-relaxed italic">
						"We don't compete for capital. We are the capital."
					</p>
					<p class="mt-4 text-[10px] font-mono text-slate-500 uppercase tracking-widest">
						<span class="text-blue-500 mr-2">>></span>CEO of Lakebird Bank
					</p>

				</div>
				<div class="p-6 bg-slate-900/40 border border-slate-800/60 hover:border-slate-700 transition-colors relative group">
					<div class="absolute top-0 left-0 w-1 h-full bg-slate-800 group-hover:bg-blue-500 transition-colors"></div>
					<p class="text-sm text-slate-400 font-light leading-relaxed italic">
						"Bulls and bears bleed exactly the same. We simply own the slaughterhouse."
					</p>
					<p class="mt-4 text-[10px] font-mono text-slate-500 uppercase tracking-widest">
						<span class="text-blue-500 mr-2">>></span>CEO of Peregrine Prime Securities
					</p>
				</div>
				<div class="p-6 bg-slate-900/40 border border-slate-800/60 hover:border-slate-700 transition-colors relative group">
					<div class="absolute top-0 left-0 w-1 h-full bg-slate-800 group-hover:bg-blue-500 transition-colors"></div>
					<p class="text-sm text-slate-400 font-light leading-relaxed italic">
						"A market bubble isn't a systemic risk. It's a fee structure."
					</p>
					<p class="mt-4 text-[10px] font-mono text-slate-500 uppercase tracking-widest">
						<span class="text-blue-500 mr-2">>></span>CEO of Kingfisher Capital
					</p>
				</div>
			</div>
		</div>

		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 z-10">
			<div class="flex items-center justify-center gap-4 mb-10">
				<div class="h-px bg-slate-800 flex-1"></div>
				<h2 class="text-2xl font-mono font-bold text-center tracking-widest uppercase text-slate-300">District Titans</h2>
				<div class="h-px bg-slate-800 flex-1"></div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{% for stock in top_stocks %}
					<a href="{{ path('app_stock_view', { ticker: stock.ticker }) }}" class="group block bg-slate-900/80 backdrop-blur-md rounded-none border border-slate-800 hover:border-blue-500/50 transition-all duration-300 relative overflow-hidden">

						<div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-blue-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
						<div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-blue-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>

						<div class="p-6 flex flex-col justify-between h-full">
							<div class="flex justify-between items-start mb-6">
								<div>
									<h3 class="text-2xl font-black text-white tracking-tight group-hover:text-blue-400 transition-colors">{{ stock.ticker }}</h3>
									<p class="text-sm text-slate-500 font-medium">{{ stock.name }}</p>
								</div>
								<span class="inline-flex items-center px-2.5 py-1 text-[10px] font-mono uppercase tracking-widest bg-slate-950 text-blue-400 border border-slate-800 group-hover:border-blue-900 transition-colors">
									{{ stock.sector }}
								</span>
							</div>

							<div class="mt-auto flex justify-between items-end border-t border-slate-800/50 pt-4">
								<div>
									<p class="text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">Live Valuation</p>
									<p class="text-2xl font-mono font-bold text-slate-100">${{ stock.price|number_format(2) }}</p>
								</div>
								<div class="text-right">
									<p class="text-xs font-mono text-emerald-400">ACTIVE</p>
								</div>
							</div>
						</div>
					</a>
				{% endfor %}
			</div>
		</div>

		<!-- Disclaimer -->
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 text-center opacity-50 hover:opacity-100 transition-opacity">
			<p class="text-[10px] font-mono text-slate-500 uppercase tracking-widest">
				Disclaimer: This is a simulated environment. All markets, assets, and valuations are entirely fictional. No real money is involved.
			</p>
		</div>
	</div>
{% endblock %}
