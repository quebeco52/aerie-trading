<!DOCTYPE html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Aerie Exchange
			{% endblock %}
		</title>


		<script>
			window.WS_TICKET = '{{ ws_ticket() }}';
		</script>


		{% block meta %}
			<meta name="description" content="Aerie Exchange is a live financial market and trading platform featuring real-time prices, deep order books, and macroeconomic analytics.">
			<meta property="og:title" content="Aerie Exchange - Live Trading & Market Analytics">
			<meta property="og:description" content="Trade live stocks and market indices with real-time financial data and deep market analytics.">
			<meta property="og:type" content="website">
			<meta name="twitter:card" content="summary_large_image">
			<meta name="google-site-verification" content="zp-MWJxjqDD3nMcN7eRoM30TwI2oAY1I_IxP6EUYjSg"/>

			<script type="application/ld+json">
				{
								            "@context": "https://schema.org",
								            "@type": "WebSite",
								            "name": "Aerie Exchange",
								            "url": "{{ app.request.getSchemeAndHttpHost() }}/",
								            "description": "Live financial market and trading platform featuring real-time prices and market analytics."
								        }
			</script>

			{# Canonical URL to prevent duplicate content indexing #}
			<link rel="canonical" href="{{ app.request.schemeAndHttpHost }}{{ app.request.pathInfo }}">
		{% endblock %}

		{% block favicon %}
			<link rel="icon" href="{{ asset('favicon.svg') }}">
		{% endblock %}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Serif:wght@400&display=swap" rel="stylesheet">
		{# Imported into `vendor` rather than linked: Google's sheet pins `font-size: 24px` on
		   `.material-symbols-outlined`, and unlayered rules outrank every cascade layer, so the
		   `text-*` utilities on icon spans would lose. `display=block` keeps an unloaded icon
		   font from painting its ligature names ("monitoring", "account_circle") first. #}
		<style>
			@import url("https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block") layer(vendor);
		</style>
		<link rel="stylesheet" href="{{ asset('styles/app.css') }}">

		{% block importmap %}
			{{ importmap('app') }}
		{% endblock %}
		{% block stylesheets %}{% endblock %}
	</head>

	<body
		class="bg-surface text-on-surface font-body selection:bg-primary/30 antialiased min-h-screen flex flex-col">

		{# Skips the nav, which is otherwise a fixed preamble in front of every page. #}
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:px-4 focus:py-2 focus:rounded focus:bg-primary focus:text-on-primary focus:font-bold focus:text-sm">Skip to main content</a>

		{# Inject the Site-Wide Navbar #}
		{% include 'partials/_navbar.html.twig' %}

		{# The container is the live region, so appended notices are announced. Successes retire
		   on their own; warnings and errors wait to be dismissed. #}
		<div class="fixed top-20 right-4 z-50 space-y-2 max-w-[calc(100vw-2rem)] sm:max-w-sm" aria-live="polite" aria-atomic="false">
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div
						data-controller="flash"
						data-flash-auto-dismiss-value="{{ label == 'success' ? 8000 : 0 }}"
						role="{{ label == 'success' ? 'status' : 'alert' }}"
						class="p-4 rounded-lg flex items-start gap-3 shadow-lg shadow-black/40 {{ label == 'success' ? 'bg-secondary/10 text-secondary border border-secondary/20' : 'bg-tertiary/10 text-tertiary border border-tertiary/20' }}">
						<span class="material-symbols-outlined shrink-0" aria-hidden="true">{{ label == 'success' ? 'check_circle' : 'warning' }}</span>
						<span class="text-sm font-bold grow">{{ message }}</span>
						<button type="button" data-action="flash#dismiss" class="material-symbols-outlined text-base shrink-0 opacity-60 hover:opacity-100 transition-opacity cursor-pointer" aria-label="Dismiss notification">close</button>
					</div>
				{% endfor %}
			{% endfor %}
		</div>

		{# The Page Content #}
		<main id="main-content" tabindex="-1" class="grow">{% block body %}{% endblock %}</main>

		{% include 'partials/_footer.html.twig' %}

		{# Charting libraries are pulled in per page — see partials/_chart_libraries.html.twig. #}
		{% block javascripts %}{% endblock %}
	</body>
</html>
