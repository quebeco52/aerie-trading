<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Aerie Exchange{% endblock %}</title>
    
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    <style>
        body { background: #121212; color: white; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="p-8">

    <body class="p-8">
    
    {# Display Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-6 p-4 rounded-md {{ label == 'success' ? 'bg-green-800/50 text-green-200 border border-green-500' : 'bg-red-800/50 text-red-200 border border-red-500' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    
    {% block body %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    {% block javascripts %}{% endblock %}
    
</body>
</html>
