{% extends 'base.html.twig' %}

{% block title %}Leaderboard | Aerie Exchange{% endblock %}

{% block body %}
<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-6">

    <header class="pb-5 border-b border-outline-variant/15">
        <h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight">Leaderboard</h1>
        <p class="mt-1.5 text-sm text-on-surface-variant">Accounts on the exchange, ranked by net worth.</p>
    </header>

    {% set me = app.user ? app.user.username : null %}
    <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-150">
                <thead>
                    <tr class="table-head bg-surface-container-highest/20">
                        <th scope="col" class="px-5 py-3 w-16 text-right">Rank</th>
                        <th scope="col" class="px-5 py-3">Trader</th>
                        <th scope="col" class="px-4 py-3 text-right">Cash</th>
                        <th scope="col" class="px-4 py-3 text-right">Holdings</th>
                        <th scope="col" class="px-5 py-3 text-right">Net worth</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10 text-sm">
                    {% for leader in leaders %}
                        {% set isMe = me is not null and leader.username == me %}
                        <tr class="{{ isMe ? 'bg-primary/5' : 'hover:bg-surface-container-high/30' }} transition-colors">
                            <td class="px-5 py-3 text-right font-mono tabular-nums text-on-surface-variant">{{ loop.index }}</td>
                            <th scope="row" class="px-5 py-3 font-medium text-on-surface text-left">
                                {{ leader.username }}
                                {% if isMe %}<span class="ml-2 text-xs font-normal text-primary">You</span>{% endif %}
                            </th>
                            <td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant">{{ leader.cash_balance|money(2) }}</td>
                            <td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant">${{ (leader.stock_value + leader.etf_value)|number_format(2) }}</td>
                            <td class="px-5 py-3 font-mono tabular-nums text-right font-semibold text-on-surface">{{ leader.total_value|money(2) }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-10 text-center text-on-surface-variant text-sm">No accounts have been opened yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
