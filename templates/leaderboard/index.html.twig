{% extends 'base.html.twig' %}

{% block title %}Leaderboard{% endblock %}

{% block body %}
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6">Aerie Exchange Leaderboard</h1>
    
    <table class="min-w-full bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
        <thead class="bg-gray-100 dark:bg-gray-700">
            <tr>
                <th class="py-3 px-4 text-left">Rank</th>
                <th class="py-3 px-4 text-left">Trader</th>
                <th class="py-3 px-4 text-right">Cash</th>
                <th class="py-3 px-4 text-right">Assets Value</th>
                <th class="py-3 px-4 text-right">Total Net Worth</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            {% for leader in leaders %}
                <tr>
                    <td class="py-3 px-4">{{ loop.index }}</td>
                    <td class="py-3 px-4 font-semibold">{{ leader.username }}</td>
                    <td class="py-3 px-4 text-right">${{ leader.cash_balance|number_format(2) }}</td>
                    <td class="py-3 px-4 text-right">${{ (leader.stock_value + leader.etf_value)|number_format(2) }}</td>
                    <td class="py-3 px-4 text-right font-bold text-green-600">${{ leader.total_value|number_format(2) }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
