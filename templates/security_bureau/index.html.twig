{% extends 'base.html.twig' %}

{# The Security Bureau's page, linked from the Council page only. Its cases are District Almanac entries about it. #}

{% block page_title %}Security Bureau{% endblock %}

{% block description %}The District's Security Bureau: its mandate, its director and its cases.{% endblock %}

{% block body %}
<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-6">

	{% embed 'government/_header.html.twig' with {title: 'Security Bureau'} %}{% block lead %}{{ bureau ? bureau.mandate : 'The District\'s state police.' }}{% endblock %}{% endembed %}

	{% if bureau %}
		{% embed 'government/_head.html.twig' with {head: bureau.director, title: 'The director', id: 'director-heading'} %}
			{% block rules %}
				The Council names the director for a single {{ bureau.rules.termYears|number_format(0) }}-year term from a shortlist of {{ bureau.rules.shortlist }}, choosing the candidate it trusts most on the questions it weighs.
				The director answers to the Bureau's mandate, not to the Council or the Diet.
			{% endblock %}
		{% endembed %}
	{% endif %}

	<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="cases-heading">
		<h2 id="cases-heading" class="text-sm font-semibold text-on-surface">From the record</h2>
		<p class="text-2xs text-on-surface-variant mt-0.5">The Bureau's history and cases, as the District Almanac records them.</p>
		<ul class="mt-3 space-y-3">
			{% for entry in entries %}
				<li>
					<a href="{{ path('app_almanac_entry', {slug: entry.slug}) }}" class="text-sm font-semibold text-primary hover:underline underline-offset-2">{{ entry.title }}</a>
					<span class="block text-xs text-on-surface-variant mt-0.5">{{ entry.summary }}</span>
					<span class="block text-2xs text-on-surface-faint mt-0.5">{{ entry.category }}</span>
				</li>
			{% else %}
				<li class="text-sm text-on-surface-variant">Nothing on record yet.</li>
			{% endfor %}
		</ul>
	</section>

	<p class="source-note">{{ source_line('almanac') }}</p>
</div>
{% endblock %}
