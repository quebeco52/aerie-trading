{% extends 'base.html.twig' %}

{# The Security Bureau's page, linked from the Council page only. Its cases are District Almanac entries about it. #}

{% block title %}Security Bureau - Aerie Exchange{% endblock %}

{% block meta %}
	<meta name="description" content="The District's Security Bureau: its mandate, its director and its cases.">
	<meta property="og:title" content="Security Bureau | Aerie Exchange">
	<meta property="og:type" content="website">
{% endblock %}

{% block body %}
<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-6">

	{% include 'government/_breadcrumb.html.twig' with {current: 'Security Bureau'} %}
	<header class="pb-5 border-b border-outline-variant/15">
		<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight">Security Bureau</h1>
		<p class="mt-2 text-sm text-on-surface-variant leading-relaxed max-w-3xl">
			{{ bureau ? bureau.mandate : 'The District\'s state police.' }}
		</p>
	</header>

	{% if bureau %}
		{% set director = bureau.director %}
		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="director-heading">
			<h2 id="director-heading" class="text-sm font-semibold text-on-surface">The director</h2>
			<p class="text-sm font-semibold text-on-surface mt-2">{{ director.name }}</p>
			<p class="text-xs text-on-surface-variant mt-0.5">Age {{ director.age }} · seated {{ director.sinceLabel }} · term ends <span class="font-mono tabular-nums">{{ director.termEndsLabel }}</span></p>
			{% if director.passedOver is not empty %}
				<p class="text-sm text-on-surface mt-2">Chosen over {% for candidate in director.passedOver %}{{ candidate.name }} <span class="text-on-surface-variant">({{ candidate.age }})</span>{{ loop.last ? '' : (loop.revindex == 2 ? ' and ' : ', ') }}{% endfor %}.</p>
			{% endif %}
			<p class="text-xs text-on-surface-variant mt-2 max-w-3xl">
				The Council names the director for a single {{ bureau.rules.termYears|number_format(0) }}-year term from a shortlist of {{ bureau.rules.shortlist }}, choosing the candidate it trusts most on the questions it weighs.
				The director answers to the Bureau's mandate, not to the Council or the Diet.
			</p>
		</section>
	{% endif %}

	<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="cases-heading">
		<h2 id="cases-heading" class="text-sm font-semibold text-on-surface">From the record</h2>
		<p class="text-2xs text-on-surface-variant mt-0.5">The Bureau's history and cases, as the District Almanac records them.</p>
		<ul class="mt-3 space-y-3">
			{% for entry in entries %}
				<li>
					<a href="{{ path('app_almanac_entry', {slug: entry.slug}) }}" class="text-sm font-semibold text-primary hover:underline underline-offset-2">{{ entry.title }}</a>
					<span class="block text-xs text-on-surface-variant mt-0.5">{{ entry.summary }}</span>
					<span class="block text-2xs text-on-surface-faint mt-0.5">{{ entry.category }}</span>
				</li>
			{% else %}
				<li class="text-sm text-on-surface-variant">Nothing on record yet.</li>
			{% endfor %}
		</ul>
	</section>

	<p class="source-note">{{ source_line('almanac') }}</p>
</div>
{% endblock %}
