{% extends 'base.html.twig' %}

{% block title %}Sovereign Reserve Fund - Aerie Exchange{% endblock %}

{% block meta %}
	<meta name="description" content="The District's Sovereign Reserve Fund: its size, the draw it pays the budget, its weights against policy and band, and its stake in every listed company.">
	<meta property="og:title" content="Sovereign Reserve Fund | Aerie Exchange">
	<meta property="og:description" content="A rule-based sovereign fund: it pays part of the budget, holds a slice of every listed company, and trades only to put its weights back inside their bands.">
	<meta property="og:type" content="website">
{% endblock %}

{% block body %}
	{% set programme_months = programme.monthsLeft|number_format(0) %}
	{% set stabilisation = summary.stabilisationToGdp %}
	{# The sleeves take the chart series colours in order, shared with assets/js/reserve/reserve-charts.js. #}
	{% set sleeve_swatch = { 'district': 'bg-series-blue', 'foreign-equities': 'bg-series-orange', 'foreign-bonds': 'bg-series-aqua' } %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-6" id="reservePage">

		<header class="flex flex-col gap-6 pb-6 border-b border-outline-variant/15">
				<div class="min-w-0 max-w-2xl">
					<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight">Sovereign Reserve Fund</h1>
					<p class="text-sm text-on-surface-variant mt-2 leading-relaxed">
						The District's sovereign fund. It pays part of the budget every year, holds the same share of every
						listed company's float beside a foreign portfolio of equities and government bonds, and trades only
						when a weight leaves its band. It runs on published rules, not on a view of the market.
					</p>
					<p class="mt-3 text-sm"><a href="/economy" class="text-primary hover:underline underline-offset-2">The District Economy</a></p>
				</div>

				{# Repainted in place from the live frame by pages/reserve.js. #}
				<dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-5">
					<div>
						<dt class="text-xs text-on-surface-variant">Fund value</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-value">{{ incepted ? summary.value|format_large('$') : '-' }}</dd>
					</div>
					<div>
						<dt class="text-xs text-on-surface-variant">Size</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-to-gdp">{{ incepted ? summary.toGdp|pct(0) ~ ' of GDP' : '-' }}</dd>
					</div>
					{# Needs the recorded history a year back, so pages/reserve.js fills it once the history loads. #}
					<div>
						<dt class="text-xs text-on-surface-variant">Real return</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-return-year">-</dd>
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5" id="reserve-return-year-detail">Last 12 months</p>
					</div>
					<div>
						<dt class="text-xs text-on-surface-variant">Budget draw</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-draw">{{ incepted ? summary.drawToGdp|pct(2) ~ ' of GDP' : '-' }}</dd>
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5" id="reserve-draw-value">{{ incepted ? summary.annualDraw|format_large('$') ~ ' this year' : '' }}</p>
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant" id="reserve-stabilisation" title="Spending the fund pays for above the draw when output is below trend, or the budget's saving paid into it when above">
							{%- if incepted and stabilisation != 0 -%}
								{{ stabilisation > 0 ? 'Slump spending +' : 'Boom saving ' }}{{ (stabilisation|abs * 100)|number_format(2) }}% of GDP
							{%- elseif incepted -%}
								No stabilisation
							{%- endif -%}
						</p>
					</div>
					<div>
						<dt class="text-xs text-on-surface-variant">Stamp duty inflow</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-duty">{{ incepted and summary.stampDutyToGdp > 0 ? summary.stampDutyToGdp|pct(2) ~ ' of GDP' : '-' }}</dd>
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5" id="reserve-duty-ytd">{{ incepted ? (summary.stampDutyToGdp > 0 ? 'Last year · ' : 'First year open · ') ~ summary.stampDutyYearToDate|format_large('$') ~ ' so far' : '' }}</p>
					</div>
					<div>
						<dt class="text-xs text-on-surface-variant">Board ownership</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-ownership">{{ incepted ? summary.ownership|pct(2) ~ ' of float' : '-' }}</dd>
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5">Ceiling {{ mandate.ownershipCeiling|pct(0) }}</p>
					</div>
					<div>
						<dt class="text-xs text-on-surface-variant" title="What bond markets price: the District's debt less the government bonds the fund holds">Net public debt</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-net-debt">{{ summary.netDebtToGdp|pct(0) }} of GDP</dd>
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5" id="reserve-gross-debt">Gross {{ summary.grossDebtToGdp|pct(0) }} less the fund's bonds</p>
					</div>
					<div>
						<dt class="text-xs text-on-surface-variant">Rebalancing</dt>
						<dd class="text-lg font-semibold text-on-surface mt-0.5" id="reserve-programme">
							{% if programme.active %}{{ programme.buying ? 'Buying' : 'Trimming' }}{% else %}None running{% endif %}
						</dd>
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5" id="reserve-programme-detail">
							{%- if programme.active -%}
								{{ programme.share|pct(2) }} of float to go · {{ programme_months }} {{ programme_months == '1' ? 'month' : 'months' }} left
							{%- elseif programme.monthsSinceLast is not null -%}
								Last one {{ programme.monthsSinceLast|number_format(0) }} months ago
							{%- else -%}
								None since inception
							{%- endif -%}
						</p>
					</div>
				</dl>
		</header>

		{% if not incepted %}
			<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/20 flex items-start gap-3" role="status">
				<p class="text-sm text-on-surface-variant">
					The fund opens with the market. It opens holding
					{{ mandate.openingOwnership|pct(1) }} of the board's float, at
					{{ mandate.openingSize|pct(0) }} of the District's GDP.
				</p>
			</div>
		{% else %}

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
			<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="reserve-allocation-heading">
				<h2 id="reserve-allocation-heading" class="text-base font-semibold text-on-surface">Allocation</h2>
				<p class="text-xs text-on-surface-variant mt-0.5">What the fund holds, against the policy split it trades back to.</p>
				{% if head %}
					<p class="text-xs text-on-surface mt-2">
						Run by <span class="font-semibold">{{ head.name }}</span>, {{ head.age }},
						{{ {cautious: 'a cautious investor', balanced: 'a balanced investor', bold: 'a bold investor'}[head.stance] }}, until <span class="font-mono tabular-nums">{{ head.termEndsLabel }}</span>.
						{{ head.opening ? 'Keeps the mix the fund opened with.' : 'Holds ' ~ head.equityShare|pct(0) ~ ' of the fund in equities.' }}
					</p>
				{% endif %}

				{# One bar, the three sleeves end to end; the policy split is marked above it. #}
				<div class="relative mt-5" aria-hidden="true">
					<div class="flex h-4 gap-0.5 rounded overflow-hidden">
						{% for sleeve in sleeves %}
							<div data-sleeve-segment="{{ sleeve.key }}" class="h-full first:rounded-l last:rounded-r {{ sleeve_swatch[sleeve.key] }}" style="width: {{ (sleeve.weight * 100)|number_format(4, '.', '') }}%"></div>
						{% endfor %}
					</div>
					{# The policy edges: the board's policy weight, then the policy equity share. #}
					{% for edge in [bands[0].policy, bands[1].policy] %}
						<div class="absolute -top-1.5 -bottom-1.5 w-px bg-on-surface" style="left: {{ (edge * 100)|number_format(4, '.', '') }}%"></div>
					{% endfor %}
				</div>

				<table class="w-full mt-5 text-xs">
					<thead>
						<tr class="table-head">
							<th scope="col" class="text-left font-semibold pb-2">Sleeve</th>
							<th scope="col" class="text-right font-semibold pb-2">Value</th>
							<th scope="col" class="text-right font-semibold pb-2">Weight</th>
							<th scope="col" class="text-right font-semibold pb-2">Policy</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-outline-variant/10">
						{% for sleeve in sleeves %}
							<tr data-sleeve="{{ sleeve.key }}">
								<th scope="row" class="text-left font-semibold text-on-surface py-2">
									<span class="inline-block w-2.5 h-2.5 rounded-sm mr-1.5 align-middle {{ sleeve_swatch[sleeve.key] }}" aria-hidden="true"></span>{{ sleeve.label }}
								</th>
								<td class="text-right font-mono tabular-nums text-on-surface" data-sleeve-value>{{ sleeve.value|format_large('$') }}</td>
								<td class="text-right font-mono tabular-nums font-bold text-on-surface" data-sleeve-weight>{{ sleeve.weight|pct(2) }}</td>
								<td class="text-right font-mono tabular-nums text-on-surface-variant">{{ sleeve.policy|pct(2) }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
				<p class="text-3xs text-on-surface-variant mt-3">
					<span class="inline-block w-px h-2.5 bg-on-surface align-middle mr-1" aria-hidden="true"></span>
					Policy split. Foreign money is held {{ (mandate.foreignEquityShare * 100)|number_format(0) }}/{{ ((1 - mandate.foreignEquityShare) * 100)|number_format(0) }}
					in equities and government bonds, marked in foreign currency and converted at today's exchange rate.
					The bonds are a {{ mandate.foreignBondDuration|number_format(1) }}-year index of foreign government paper,
					yielding <span class="font-mono tabular-nums" id="reserve-bond-yield">{{ returns.bondYield|pct(2) }}</span>.
				</p>
			</section>

			<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="reserve-bands-heading">
				<h2 id="reserve-bands-heading" class="text-base font-semibold text-on-surface">Rebalancing bands</h2>
				<p class="text-xs text-on-surface-variant mt-0.5">Checked at every month end. A weight outside its band starts a programme back to policy.</p>

				<div class="space-y-6 mt-5">
					{% for gauge in bands %}
						{% set gap = gauge.weight - gauge.policy %}
						<div data-gauge="{{ gauge.key }}" data-policy="{{ gauge.policy }}" data-band="{{ gauge.band }}" data-weight="{{ gauge.weight }}">
							<div class="flex items-baseline justify-between gap-3">
								<h3 class="text-sm font-semibold text-on-surface">{{ gauge.label }}</h3>
								<span class="text-xs font-mono tabular-nums text-on-surface" data-gauge-reading>{{ gauge.weight|pct(2) }}</span>
							</div>
							<div class="relative h-6 mt-2" aria-hidden="true">
								<div class="absolute inset-x-0 top-1/2 h-1 -translate-y-1/2 rounded bg-surface-container-highest"></div>
								<div data-gauge-band class="absolute top-1/2 h-3 -translate-y-1/2 rounded-sm border-x {{ gauge.key == 'district' ? 'bg-series-blue/20 border-series-blue' : 'bg-series-orange/20 border-series-orange' }}"></div>
								<div data-gauge-policy class="absolute top-0 bottom-0 w-px bg-on-surface"></div>
								<div data-gauge-marker class="absolute top-1/2 w-3 h-3 -translate-x-1/2 -translate-y-1/2 rounded-full ring-2 ring-surface-container-low {{ gauge.key == 'district' ? 'bg-series-blue' : 'bg-series-orange' }}"></div>
							</div>
							<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-1">
								Policy {{ gauge.policy|pct(2) }} · band {{ ((gauge.policy - gauge.band) * 100)|number_format(2) }}% to {{ ((gauge.policy + gauge.band) * 100)|number_format(2) }}%
							</p>
							<p class="text-3xs text-on-surface-variant mt-2" data-gauge-status>
								{{ (gap|abs * 100)|number_format(2) }}pp {{ gap < 0 ? 'under' : 'over' }} policy, {{ gap|abs <= gauge.band ? 'inside' : 'outside' }} the ±{{ (gauge.band * 100)|number_format(2) }}pp band.
							</p>
							<p class="text-3xs text-on-surface-faint mt-0.5">
								{% if gauge.key == 'district' %}
									A fall of about {{ gauge.breachingMove|pct(0) }} in the board against the rest of the fund takes it through the bottom of the band.
								{% else %}
									A fall of about {{ gauge.breachingMove|pct(0) }} in all equities against bonds takes it through the bottom of the band.
								{% endif %}
							</p>
						</div>
					{% endfor %}
				</div>
			</section>
		</div>

		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="reserve-returns-heading">
			<h2 id="reserve-returns-heading" class="text-base font-semibold text-on-surface">Returns</h2>
			<p class="text-xs text-on-surface-variant mt-0.5 max-w-3xl">
				Time-weighted and valued continuously, so the stamp duty and dividends paid in and the budget's draw are not
				counted as performance. Real returns are after District inflation. Annualised over the recorded history.
			</p>

			{# Filled by pages/reserve.js from the quarterly history and the live index. #}
			<dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-5 mt-4" id="reserveReturns" data-index-base="{{ mandate.returnIndexBase }}">
				<div>
					<dt class="text-xs text-on-surface-variant">Real, 10 years</dt>
					<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-return-decade">-</dd>
					<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5">A year</p>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">Real, all recorded</dt>
					<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-return-span-real">-</dd>
					<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5" id="reserve-return-span">A year</p>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">Nominal, all recorded</dt>
					<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-return-span-nominal">-</dd>
					<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5">A year, in District dollars</p>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">Spending rule assumes</dt>
					<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5" id="reserve-return-assumed">{{ returns.assumedReal|pct(2) }}</dd>
					<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5">Real a year, compound; the draw is half of it</p>
				</div>
			</dl>

			<div class="mt-5">
				<h3 class="text-sm font-semibold text-on-surface">Return index</h3>
				<p class="text-3xs text-on-surface-variant">Real and nominal, 100 at the first quarter shown</p>
				<div class="h-64 md:h-72 w-full relative mt-3">
					<canvas id="reserveReturnChart"></canvas>
				</div>
				<p id="reserveReturnChartNote" class="hidden text-3xs text-on-surface-variant mt-2" role="status">
					The index draws once two quarters of it are recorded.
				</p>
			</div>
		</section>

		{% if strategic is not empty %}
			<section class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden" aria-labelledby="reserve-strategic-heading">
				<div class="p-5">
					<h2 id="reserve-strategic-heading" class="text-base font-semibold text-on-surface">Strategic holding</h2>
					<p class="text-xs text-on-surface-variant mt-0.5 max-w-3xl">
						Held by the District itself, outside the fund. The stake is off the float,
						is never traded, and sits outside the fund's weights and bands. Its dividends, and its share of any
						buyback, are paid into the fund.
						Values at page load.
					</p>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-xs">
						<thead class="table-head bg-surface-container">
							<tr>
								<th scope="col" class="px-5 py-2.5 text-left font-semibold">Company</th>
								<th scope="col" class="px-4 py-2.5 text-right font-semibold">District stake</th>
								<th scope="col" class="px-4 py-2.5 text-right font-semibold hidden sm:table-cell">With the fund</th>
								<th scope="col" class="px-4 py-2.5 text-right font-semibold hidden md:table-cell">Shares held</th>
								<th scope="col" class="px-4 py-2.5 text-right font-semibold">Value</th>
								<th scope="col" class="px-5 py-2.5 text-right font-semibold">Dividends to the fund</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-outline-variant/10">
							{% for holding in strategic %}
								<tr class="relative hover:bg-surface-container-high/30 transition-colors group">
									<th scope="row" class="px-5 py-2 text-left font-normal">
										<a href="/stock/{{ holding.ticker }}" class="font-bold text-primary font-mono group-hover:underline after:absolute after:inset-0 after:content-['']">{{ holding.ticker }}</a>
										<span class="ml-2 text-on-surface">{{ holding.name }}</span>
									</th>
									<td class="px-4 py-2 text-right font-mono tabular-nums font-bold text-on-surface">{{ holding.stake|pct(2) }}</td>
									<td class="px-4 py-2 text-right font-mono tabular-nums text-on-surface-variant hidden sm:table-cell" title="The District's stake plus the fund's share of the float">{{ ((holding.stake + holding.fundStake) * 100)|number_format(2) }}%</td>
									<td class="px-4 py-2 text-right font-mono tabular-nums text-on-surface-variant hidden md:table-cell">{{ holding.shares|format_large }}</td>
									<td class="px-4 py-2 text-right font-mono tabular-nums text-on-surface">{{ holding.value|format_large('$') }}</td>
									<td class="px-5 py-2 text-right font-mono tabular-nums text-on-surface">{{ holding.annualDividend|format_large('$') }} a year</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				<p class="px-5 py-3 text-3xs text-on-surface-variant border-t border-outline-variant/10">
					Not counted in the fund's value above. Dividends are at the company's current quarterly rate.
				</p>
			</section>
		{% endif %}

		<section class="space-y-4" aria-labelledby="reserve-history-heading">
			<div class="bg-surface-container-low p-5 rounded-lg border border-outline-variant/20">
				<h2 id="reserve-history-heading" class="text-base font-semibold text-on-surface">History</h2>
				<p class="text-xs text-on-surface-variant mt-0.5">Quarterly, since the fund opened (up to 25 years).</p>
			</div>

			<div id="reserveChartsStatus" class="hidden rounded-lg border px-4 py-3 text-sm flex items-center gap-3" role="status" aria-live="polite">
				<span class="material-symbols-outlined text-base shrink-0" data-status-icon aria-hidden="true">hourglass_empty</span>
				<span class="grow" data-status-message></span>
				<button type="button" data-status-retry class="hidden px-3 py-1 rounded text-xs font-bold bg-surface-container-high text-on-surface hover:bg-surface-bright transition-colors cursor-pointer">Retry</button>
			</div>

			<div id="reserveChartsGrid" class="grid grid-cols-1 lg:grid-cols-2 gap-5"
				data-domestic-policy="{{ bands[0].policy }}" data-domestic-band="{{ bands[0].band }}"
				data-equity-policy="{{ bands[1].policy }}" data-equity-band="{{ bands[1].band }}">
				{% for chart in [
					{ id: 'reserveSizeChart', title: 'Fund size', note: 'Percent of GDP' },
					{ id: 'reserveWeightChart', title: 'District equity weight', note: 'Percent of the fund, against policy and band' },
					{ id: 'reserveEquityChart', title: 'Whole equity share', note: 'District and foreign equities, percent of the fund, against policy and band' },
					{ id: 'reserveFlowsChart', title: 'Money out and in', note: 'Budget draw, stabilisation (positive: spent from the fund) and stamp duty, percent of GDP' }
				] %}
					<div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-5">
						<h3 class="text-sm font-semibold text-on-surface">{{ chart.title }}</h3>
						<p class="text-3xs text-on-surface-variant">{{ chart.note }}</p>
						<div class="h-64 md:h-72 w-full relative mt-3">
							<canvas id="{{ chart.id }}"></canvas>
						</div>
					</div>
				{% endfor %}
			</div>
		</section>

		<section class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden" aria-labelledby="reserve-holdings-heading">
			<div class="p-5">
				<h2 id="reserve-holdings-heading" class="text-base font-semibold text-on-surface">District holdings</h2>
				<p class="text-xs text-on-surface-variant mt-0.5">
					The fund holds {{ summary.ownership|pct(2) }} of every listed company's float, so its
					board sleeve is weighted like the float-adjusted market. Values at page load.
				</p>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-xs">
					<thead class="table-head bg-surface-container">
						<tr>
							<th scope="col" class="px-5 py-2.5 text-right font-semibold w-10">#</th>
							<th scope="col" class="px-4 py-2.5 text-left font-semibold">Company</th>
							<th scope="col" class="px-4 py-2.5 text-left font-semibold hidden md:table-cell">Sector</th>
							<th scope="col" class="px-4 py-2.5 text-right font-semibold">Stake</th>
							<th scope="col" class="px-4 py-2.5 text-right font-semibold hidden sm:table-cell">Shares held</th>
							<th scope="col" class="px-5 py-2.5 text-right font-semibold">Of sleeve</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-outline-variant/10">
						{% for holding in holdings %}
							<tr class="relative hover:bg-surface-container-high/30 transition-colors group">
								<td class="px-5 py-2 text-right font-mono tabular-nums text-on-surface-variant">{{ holding.rank }}</td>
								<th scope="row" class="px-4 py-2 text-left font-normal">
									<a href="/stock/{{ holding.ticker }}" class="font-bold text-primary font-mono group-hover:underline after:absolute after:inset-0 after:content-['']">{{ holding.ticker }}</a>
									<span class="ml-2 text-on-surface">{{ holding.name }}</span>
								</th>
								<td class="px-4 py-2 text-on-surface-variant hidden md:table-cell">{{ holding.sector }}</td>
								<td class="px-4 py-2 text-right font-mono tabular-nums text-on-surface">{{ holding.stakeValue|format_large('$') }}</td>
								<td class="px-4 py-2 text-right font-mono tabular-nums text-on-surface-variant hidden sm:table-cell">{{ holding.stakeShares >= 1000000 ? holding.stakeShares|format_large : holding.stakeShares|number_format(0) }}</td>
								<td class="px-5 py-2 text-right font-mono tabular-nums text-on-surface">{{ holding.sleeveWeight|pct(2) }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</section>

		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="reserve-mandate-heading">
			<h2 id="reserve-mandate-heading" class="text-base font-semibold text-on-surface">Mandate</h2>
			<p class="text-sm text-on-surface-variant mt-0.5">Every rule the fund runs on.</p>

			{# Where each rule is taken from (kept for the record, not printed):
			   - Spending rule: Singapore Net Investment Returns framework (2008)
			   - Stabilisation rule: IMF Norway Selected Issues (2025), Table 5: structural balance +0.45 per point of output gap; insulated from the fund's value, as the IMF recommends
			   - Budget rule: Norway's fiscal rule (2001); Singapore's budget surpluses accrue to its reserves
			   - Opening size: GPIF: its assets against Japan's GDP (FY2024) and its share of the Japanese market (2016)
			   - Reference portfolio: GIC Reference Portfolio (2013); duration of the Bloomberg Global Aggregate (2026)
			   - District equity band: GPIF policy asset mix, 5th medium-term plan (FY2025)
			   - Equity band: GPIF policy asset mix, 5th medium-term plan (FY2025)
			   - Rebalancing: Norges Bank Investment Management rebalancing rule (2018)
			   - Ownership ceiling: Government Pension Fund Global mandate (Norway)
			   - Corporate actions: Index-holder practice
			   - Returns: GIPS time-weighted return, as GPFG and GIC report
			   - Stamp duty: District rate; Hong Kong charges 0.1% a side, the UK 0.5% on purchases
			   - Strategic holding: Singapore: SEL Holdings holds about 23% of SGX; Norway: 67% of Equinor, dividends to the GPFG
			#}
			{% set rules = [
				{
					name: 'Who sets the mix',
					text: 'The Council names the fund\'s head for a single term. The head sets how much of the fund is held in equities; the District\'s share of those equities stays as the fund opened, and the rest goes abroad. A new mix puts the foreign money on its new split at once and moves the board to its new weight over ' ~ mandate.transitionMonths|number_format(0) ~ ' months.'
				},
				{
					name: 'Spending rule',
					text: 'Each budget year the fund pays the budget the share of its expected long-term real return on its value that the Diet passes, ' ~ mandate.spendingShare|pct(0) ~ ' now. The Diet may spend up to ' ~ mandate.drawCeiling|pct(0) ~ ' on its own; the fund holds the second key on anything more, and consents only while unemployment shows a recession under way. The return is the compound one, the average less half the variance, so volatility is never spent.'
				},
				{
					name: 'Stabilisation rule',
					text: 'At each budget round, every ' ~ mandate.budgetRoundMonths|number_format(0) ~ ' months, the budget spends ' ~ mandate.stabilisationGapResponse|number_format(2) ~ '% of GDP from the fund, beyond the draw, for each point output is below trend, and pays the same into the fund for each point above it. The cycle is read against the gap\'s own ' ~ mandate.stabilisationTrendYears|number_format(0) ~ '-year average, so over time the spending and the saving balance. The next year ' ~ mandate.stabilisationReversal|pct(0) ~ ' of the year\'s change is given back, and the whole of it fades toward zero by ' ~ mandate.stabilisationPersistence|pct(1) ~ ' a year. Together with tax policy, the budget leans against the business cycle. The fund\'s own market swings never reach the budget.'
				},
				{
					name: 'Budget rule',
					text: 'The budget spends what the fund pays: the structural deficit is the draw, so a fund that grows faster than the economy widens spending with it rather than piling up surpluses. The District keeps at least ' ~ mandate.debtFloor|pct(0) ~ ' of GDP in gross debt outstanding for its benchmark curve, and a surplus that would take debt below that buys bonds for the fund instead.'
				},
				{
					name: 'Opening size',
					text: 'Opened at ' ~ mandate.openingSize|pct(0) ~ ' of GDP, holding ' ~ mandate.openingOwnership|pct(1) ~ ' of the board\'s float.'
				},
				{
					name: 'Reference portfolio',
					text: 'Money off the board is held ' ~ mandate.foreignEquityShare|pct(0) ~ ' in global equities and ' ~ ((1 - mandate.foreignEquityShare) * 100)|number_format(0) ~ '% in foreign government bonds. The bonds are held at a constant duration of ' ~ mandate.foreignBondDuration|number_format(1) ~ ' years, so they earn their yield and roll-down and gain when foreign rates fall.'
				},
				{
					name: 'District equity band',
					text: 'Policy weight ' ~ (bands[0].policy * 100)|number_format(2) ~ '%, band ±' ~ (bands[0].band * 100)|number_format(2) ~ 'pp, so it trips on a relative move of about ' ~ (bands[0].breachingMove * 100)|number_format(0) ~ '%.'
				},
				{
					name: 'Equity band',
					text: 'Policy equity share ' ~ (bands[1].policy * 100)|number_format(2) ~ '%, band ±' ~ (bands[1].band * 100)|number_format(2) ~ 'pp. This is the band a global crash breaches.'
				},
				{
					name: 'Rebalancing',
					text: 'Checked ' ~ (mandate.checkMonths == 1 ? 'at every month end' : 'every ' ~ mandate.checkMonths|number_format(0) ~ ' months') ~ '. A breach puts the foreign sleeves back on policy at once and trades the board back to its policy weight evenly over ' ~ mandate.executionMonths|number_format(0) ~ ' months, sliced across companies by float.'
				},
				{
					name: 'Ownership ceiling',
					text: 'Never more than ' ~ mandate.ownershipCeiling|pct(0) ~ ' of the float. Holding the same share of every company, that keeps it under ' ~ mandate.ownershipCeiling|pct(0) ~ ' of any company\'s voting shares.'
				},
				{
					name: 'Corporate actions',
					text: 'Tenders its share into buybacks and takes up its share of new issues, so a company\'s own flow never changes the fund\'s ownership.'
				},
				{
					name: 'Returns',
					text: 'Reported as a time-weighted return, valued continuously, so money paid in and the budget\'s draw are not performance. The real return is after District inflation, and is set against the return the spending rule assumed.'
				},
				{
					name: 'Stamp duty',
					text: 'Every share trade pays ' ~ mandate.stampDutyRate|pct(2) ~ ' on each side, and the duty is paid into the fund rather than the budget. Index funds are exempt.'
				},
				{
					name: 'Strategic holding',
					text: 'The District holds ' ~ mandate.clearinghouseStake|pct(0) ~ ' of its central counterparty outside the fund. The stake is off the float and never traded. The District tenders into buybacks and takes up new issues pro rata, so the percentage holds. Its dividends and buyback proceeds are paid into the fund, and any subscription is paid out of it.'
				}
			] %}
			<dl class="mt-4 divide-y divide-outline-variant/10">
				{% for rule in rules %}
					<div class="py-3 grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-1 md:gap-4">
						<dt class="text-sm font-semibold text-on-surface">{{ rule.name }}</dt>
						<dd class="text-sm text-on-surface-variant">{{ rule.text }}</dd>
					</div>
				{% endfor %}
			</dl>
		</section>
		{% endif %}
	</div>
{% endblock %}

