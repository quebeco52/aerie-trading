{% extends 'base.html.twig' %}

{% block title %}The District Economy - Aerie Exchange{% endblock %}

{% block meta %}
	<meta name="description" content="Live macroeconomic conditions across the Aerie Autonomous District: monetary policy, the yield curve, inflation, growth, credit, labour and commodities, with twenty-five years of history.">
	<meta property="og:title" content="The District Economy | Aerie Exchange">
	<meta property="og:description" content="Monetary policy, yield curves, risk premia, labour and commodities — the economy every listed company is priced against.">
	<meta property="og:type" content="website">
{% endblock %}

{# A chart card in the economy grid (partials/_chart_card.html.twig). #}
{% macro chart(id, category, title, lede, source, options = {}) %}
	{{ include('partials/_chart_card.html.twig', {id: id, category: category, title: title, lede: lede, source: source, family: 'macro', hud: 'plain', wideAt: 'lg'}|merge(options), with_context = false) }}
{% endmacro %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-8">

		<header class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 pb-6 border-b border-outline-variant/15">
			<div class="min-w-0 max-w-2xl">
				<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight">The District Economy</h1>
				<p class="text-sm text-on-surface-variant mt-2 leading-relaxed">
					The conditions every listed company is priced against. The Monetary Authority sets the policy
					rate by its published rule, the yield curve prices the path it expects, and growth, credit and
					the labour market feed through to every earnings report on the exchange.
				</p>
				<p class="mt-3 text-sm">
					<a href="/government" class="text-primary hover:underline underline-offset-2">The Government</a>
					<span class="mx-2 text-on-surface-variant/40" aria-hidden="true">&middot;</span>
					<a href="/reserve" class="text-primary hover:underline underline-offset-2">Sovereign Reserve Fund</a>
				</p>
			</div>

			{# The readings the ticker publishes on every frame; economy/macro-vitals.js repaints them in place. Inflation is
			   the quarter's annual rate, the same reading the charts below plot, not the instant's noisy one. #}
			<dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-4 shrink-0">
				<div>
					<dt class="text-xs text-on-surface-variant">Economic cycle</dt>
					<dd class="mt-0.5 text-lg font-semibold text-on-surface" id="market-economic-cycle">{{ economic_cycle }}</dd>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">Inflation (CPI)</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-on-surface" id="macro-inflation">{{ macro.inflationEma|pct(2) }}</dd>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">Output gap</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums {{ macro.outputGap * 100 < -1.0 ? 'text-tertiary' : (macro.outputGap * 100 > 1.0 ? 'text-secondary' : 'text-on-surface') }}" id="macro-output-gap">{{ macro.outputGap|pct(2) }}</dd>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">Policy rate</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-on-surface" id="macro-policy-rate">{{ macro.policyRate|pct(2) }}</dd>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">10Y yield</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-on-surface" id="macro-yield">{{ macro.yield10y|pct(2) }}</dd>
				</div>
				<div class="{{ macro.qeActive ? '' : 'hidden' }}" id="qe-status-container">
					<dt class="text-xs text-on-surface-variant">Asset purchases</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-on-surface" id="macro-qe-status">
						{%- if macro.qeActive -%}
							&minus;{{ macro.balanceSheetIntensity|bps }}
						{%- endif -%}
					</dd>
				</div>
			</dl>
		</header>

		<section class="space-y-5" aria-labelledby="macro-series-heading">
			<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
				<div>
					<h2 id="macro-series-heading" class="text-lg font-semibold text-on-surface">History</h2>
					<p class="text-sm text-on-surface-variant mt-0.5">Quarterly readings across rates, prices, growth, credit and trade.</p>
				</div>
				<div class="inline-flex items-center gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5 self-start md:self-auto" role="group" aria-label="History window">
					<button type="button" id="btn-macro-5Y" class="macro-range-btn seg-btn" aria-pressed="false" data-macro-timeframe="5Y">5Y</button>
					<button type="button" id="btn-macro-10Y" class="macro-range-btn seg-btn" aria-pressed="true" data-macro-timeframe="10Y">10Y</button>
					<button type="button" id="btn-macro-25Y" class="macro-range-btn seg-btn" aria-pressed="false" data-macro-timeframe="25Y">25Y</button>
				</div>
			</div>

			<div class="flex flex-col xl:flex-row justify-between items-stretch xl:items-center gap-3">
				<div class="flex items-center flex-wrap gap-1" id="macroCategoryPills" role="group" aria-label="Filter by topic">
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="true" data-category="all">All <span class="ml-0.5 text-on-surface-faint tabular-nums">(32)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="monetary">Rates and yields <span class="ml-0.5 text-on-surface-faint tabular-nums">(5)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="inflation">Inflation and output <span class="ml-0.5 text-on-surface-faint tabular-nums">(5)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="growth">Growth and labour <span class="ml-0.5 text-on-surface-faint tabular-nums">(7)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="credit">Credit and liquidity <span class="ml-0.5 text-on-surface-faint tabular-nums">(6)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="assets">Property and commodities <span class="ml-0.5 text-on-surface-faint tabular-nums">(3)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="public">Trade and public finance <span class="ml-0.5 text-on-surface-faint tabular-nums">(6)</span></button>
				</div>

				<div class="relative w-full xl:w-64">
					<label for="macroIndicatorSearch" class="sr-only">Filter charts</label>
					<input type="search" id="macroIndicatorSearch" placeholder="Filter charts" class="w-full px-3 py-1.5 text-xs bg-surface-container-lowest border border-outline-variant/25 rounded text-on-surface placeholder:text-on-surface-faint focus:outline-none focus:border-primary/60 transition-colors">
				</div>
			</div>

			{# Fetch status for the macro series below. #}
			<div id="macroChartsStatus" class="hidden mb-4 rounded-lg border px-4 py-3 text-sm flex items-center gap-3" role="status" aria-live="polite">
				<span class="material-symbols-outlined text-base shrink-0" data-status-icon aria-hidden="true">hourglass_empty</span>
				<span class="grow" data-status-message></span>
				<button type="button" data-status-retry class="hidden px-3 py-1 rounded text-xs font-bold bg-surface-container-high text-on-surface hover:bg-surface-bright transition-colors cursor-pointer">Retry</button>
			</div>

			<div id="macroChartsGrid" class="space-y-10" data-chart-grid>
				<section class="space-y-4" data-chart-section aria-labelledby="macro-section-monetary">
					<h3 id="macro-section-monetary" class="text-base font-semibold text-on-surface">Rates and yields</h3>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						{{ _self.chart('macroRatesChart', 'monetary', "Policy rate and the yield curve",
							"The policy rate, 2-, 5- and 10-year sovereign yields, the 2s10s spread and the rule's target rate",
							source_line('monetary-authority', 'exchequer'), {wide: true}) }}

						{{ _self.chart('macroPolicyRuleChart', 'monetary', "Policy rate against the rule",
							"The rate the Monetary Authority's published rule calls for, the policy rate, and the gap between them",
							source_line('monetary-authority')) }}

						{{ _self.chart('macroTermPremiumChart', 'monetary', "What is in the 10-year yield",
							"The 10-year yield split into the expected path of the policy rate and the term premium, beside the neutral real rate",
							source_line('monetary-authority')) }}

						{{ _self.chart('macroMortgageChart', 'monetary', "Mortgage rates",
							"The 30-year fixed mortgage rate and its spread over the policy rate",
							source_line('credit-registry'), {canvas: {'data-mortgage-spread': constant('App\\Service\\Math\\MacroConstants::RESIDENTIAL_MORTGAGE_SPREAD')}}) }}

						{% embed 'partials/_chart_card.html.twig' with {id: 'macroBalanceSheetChart', category: 'monetary', title: "Central bank balance sheet",
							lede: "The Monetary Authority's bond holdings, as the basis points they hold the 10-year yield down, and each quarter's purchases (QE) or run-off (QT)",
							source: source_line('monetary-authority'), family: 'macro', hud: 'plain', wideAt: 'lg'} only %}
							{% block canvas_extra %}
								<p id="macroBalanceSheetEmpty" class="absolute inset-0 grid place-items-center text-sm text-on-surface-variant" hidden>The Monetary Authority has held no bonds over this period.</p>
							{% endblock %}
						{% endembed %}
					</div>
				</section>

				<section class="space-y-4" data-chart-section aria-labelledby="macro-section-inflation">
					<h3 id="macro-section-inflation" class="text-base font-semibold text-on-surface">Inflation and output</h3>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						{{ _self.chart('macroEconomyChart', 'inflation', "Inflation and the output gap",
							"Consumer prices, 10-year breakeven inflation, the output gap and excess capital stock",
							source_line('statistical-office')) }}

						{{ _self.chart('macroSectoralInflationChart', 'inflation', "Inflation by component",
							"Headline consumer and producer prices, with core services and core goods",
							source_line('statistical-office')) }}

						{{ _self.chart('macroCostPushChart', 'inflation', "Supply-side cost pressures",
							"What food and energy prices add to headline inflation each quarter, in basis points a year. A price that stays high adds once, then nothing more",
							source_line('statistical-office')) }}

						{{ _self.chart('macroInventoryCycleChart', 'inflation', "Inventories and capacity",
							"Inventory overhang against the output gap, factory capacity utilisation and strategic energy stocks",
							source_line('manufactory-board')) }}

						{{ _self.chart('macroGapBreakdownChart', 'inflation', "What moved the output gap",
							"Each quarter's change in the output gap, split by what drove it: rates, credit, the government and the Fund, wealth, supply, the mainland, and the economy's own pull back to trend",
							source_line('statistical-office'), {wide: true, canvas: {'data-groups': constant('App\\Service\\View\\MacroHistoryPresenter::GAP_GROUP_LABELS')|json_encode}}) }}
					</div>
				</section>

				<section class="space-y-4" data-chart-section aria-labelledby="macro-section-growth">
					<h3 id="macro-section-growth" class="text-base font-semibold text-on-surface">Growth and labour</h3>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						{{ _self.chart('macroGdpGrowthChart', 'growth', "Growth and recession risk",
							"Real and nominal GDP growth, potential growth and the productivity behind it, and the chance of a recession within a year",
							source_line('statistical-office'), {wide: true, canvas: {'data-structural-labor-growth': constant('App\\Service\\Math\\MacroConstants::STRUCTURAL_LABOR_GROWTH_RATE')}}) }}

						{{ _self.chart('macroGdpChart', 'growth', "Output, quarter on quarter",
							"Real output's change on the quarter before; two falling quarters in a row and the statistical office declares a recession, marked here until two quarters of growth end it",
							source_line('statistical-office')) }}

						{{ _self.chart('macroLeadingIndicatorsChart', 'growth', "Leading indicators",
							"Manufacturing PMI, housing starts, money-supply growth, the trade balance and producer prices",
							source_line('manufactory-board', 'statistical-office')) }}

						{{ _self.chart('macroLaborChart', 'growth', "Unemployment and vacancies",
							"Unemployment against its structural rate, and job vacancies as a share of the labour force",
							source_line('statistical-office')) }}

						{{ _self.chart('macroWagesChart', 'growth', "Wages",
							"Wage growth against the inflation workers expect and after consumer prices, and the real wage against productivity",
							source_line('statistical-office')) }}

						{{ _self.chart('macroWealthEffectChart', 'growth', "Household wealth and demand",
							"Stock-market wealth against income and its three-year trend, housing wealth, and the output gap they feed",
							source_line('statistical-office', 'land-registry')) }}

						{{ _self.chart('macroSentimentChart', 'growth', "Sentiment, deal flow and defaults",
							"Consumer sentiment and merger activity, against household and corporate default rates",
							source_line('statistical-office', 'credit-registry')) }}
					</div>
				</section>

				<section class="space-y-4" data-chart-section aria-labelledby="macro-section-credit">
					<h3 id="macro-section-credit" class="text-base font-semibold text-on-surface">Credit and liquidity</h3>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						{{ _self.chart('macroFciChart', 'credit', "Financial conditions and bank lending",
							"A financial conditions index across credit, equities, the currency and rates, and the net share of banks tightening lending standards",
							source_line('monetary-authority', 'financial-regulator')) }}

						{{ _self.chart('macroCreditCliffChart', 'credit', "Corporate credit spreads and defaults",
							"Investment-grade and high-yield spreads, the ratio between them, the corporate default rate, and the excess bond premium: what lenders charge beyond expected defaults",
							source_line('credit-registry')) }}

						{{ _self.chart('macroRiskChart', 'credit', "Risk premia and volatility",
							"The equity risk premium, implied market volatility and what companies pay to borrow",
							source_line('aerie-exchange', 'credit-registry')) }}

						{{ _self.chart('macroHouseholdCreditChart', 'credit', "Household credit and bank buffers",
							"Household debt service and debt-to-income ratios, the credit-to-GDP gap and the countercyclical capital buffer",
							source_line('financial-regulator')) }}

						{{ _self.chart('macroInterbankLiquidityChart', 'credit', "Interbank funding stress",
							"The interbank lending spread against the corporate credit spread, in basis points",
							source_line('monetary-authority', 'credit-registry')) }}

						{{ _self.chart('macroBankingLiquidityChart', 'credit', "Deposits and money-market funds",
							"Money-market funds' share of deposits and the interbank spread. Banks pass on " ~ constant('App\\Service\\Math\\MacroConstants::SYSTEM_DEPOSIT_BETA_BASE')|pct(0) ~ " of a rate change to depositors, so funds gain share as rates rise",
							source_line('financial-regulator', 'monetary-authority')) }}
					</div>
				</section>

				<section class="space-y-4" data-chart-section aria-labelledby="macro-section-assets">
					<h3 id="macro-section-assets" class="text-base font-semibold text-on-surface">Property and commodities</h3>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						{{ _self.chart('macroPropertyChart', 'assets', "Property prices and housing starts",
							"Commercial and residential property indices, and new housing starts",
							source_line('land-registry'), {wide: true}) }}

						{{ _self.chart('macroCommoditiesChart', 'assets', "Commodity prices",
							"Energy, metals, agriculture, gold and natural gas, indexed to 100",
							source_line('commodity-exchange')) }}

						{{ _self.chart('macroEnergySpreadsChart', 'assets', "Refining and power margins",
							"What refiners earn turning crude into fuels ($/bbl), and generators turning gas into power ($/MWh)",
							source_line('commodity-exchange'), {canvas: {'data-power-reference': constant('App\\Service\\Math\\MacroConstants::REFERENCE_POWER_PRICE'), 'data-gas-reference': constant('App\\Service\\Math\\MacroConstants::REFERENCE_GAS_PRICE'), 'data-spark-heat-rate': constant('App\\Service\\Macro\\Subsystem\\CommodityLogisticsSubsystem::SPARK_SPREAD_BENCHMARK_HEAT_RATE')}}) }}
					</div>
				</section>

				<section class="space-y-4" data-chart-section aria-labelledby="macro-section-public">
					<h3 id="macro-section-public" class="text-base font-semibold text-on-surface">Trade and public finance</h3>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						{{ _self.chart('macroTradeLogisticsChart', 'public', "Trade, freight and supply chains",
							"The trade-weighted exchange rate, container freight rates and supply-chain pressure in standard deviations from normal",
							source_line('freight-authority', 'monetary-authority')) }}

						{{ _self.chart('macroGlobalCycleChart', 'public', "The District and the mainland",
							"District and mainland output gaps, the global demand gap and the mainland policy rate",
							source_line('statistical-office')) }}

						{{ _self.chart('macroPublicDebtChart', 'public', "Public debt",
							"Public debt as a share of GDP, and the risk premium lenders add to the District's bond yields for holding it",
							source_line('exchequer')) }}

						{{ _self.chart('macroGovtSpendingChart', 'public', "The budget",
							"Government spending, the corporate tax rate, and the primary deficit: the budget before interest, as a share of GDP",
							source_line('exchequer')) }}

						{{ _self.chart('macroPolicyUncertaintyChart', 'public', "Policy uncertainty",
							"How unsettled the outlook for taxes, spending and rates is, against its long-run average of " ~ constant('App\\Service\\Math\\MacroConstants::EPU_BASELINE')|number_format(0) ~ ". It rises into an election and in a downturn, and holds back investment",
							source_line('statistical-office'), {canvas: {'data-baseline': constant('App\\Service\\Math\\MacroConstants::EPU_BASELINE')}}) }}

						{% embed 'partials/_chart_card.html.twig' with {id: 'macroSovereignFundChart', category: 'public', title: "Sovereign Reserve Fund",
							lede: "District equity weight against the policy weight, and the fund's share of the listed float",
							family: 'macro', hud: 'plain', wideAt: 'lg'} only %}
							{% block footer %}
								{# The fund's size, draw, equity share and stamp duty: scales the chart's single axis cannot carry. #}
								<p class="mt-3 text-2xs font-mono tabular-nums text-on-surface-variant" id="stats-macroSovereignFundChart"></p>
								<div class="mt-1 flex items-baseline justify-between gap-3">
									<p class="source-note mt-0">{{ source_line('sovereign-reserve-fund') }}</p>
									<a href="/reserve" class="shrink-0 text-2xs font-medium text-primary hover:underline">Fund page →</a>
								</div>
							{% endblock %}
						{% endembed %}
					</div>
				</section>

				<p class="hidden py-12 text-center text-sm text-on-surface-variant" data-chart-empty>No charts match the filter.</p>
			</div>
		</section>

		{# Each driver's most exposed listings, read from the per-firm figures their earnings and financing run on (EconomyExposureBuilder). #}
		{% if exposures is defined and exposures is not empty %}
			<section class="space-y-5" aria-labelledby="exposure-heading">
				<div>
					<h2 id="exposure-heading" class="text-lg font-semibold text-on-surface">Who it moves</h2>
					<p class="text-sm text-on-surface-variant mt-0.5">The listed companies with the most at stake in each of the readings above, from their filings.</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
					{% for card in exposures %}
						<div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" id="exposure-{{ card.key }}">
							<h3 class="text-sm font-semibold text-on-surface">{{ card.title }}</h3>
							<p class="text-xs text-on-surface-variant mt-0.5">{{ card.intro }}</p>
							{% for list in card.lists %}
								<table class="w-full mt-4 text-xs">
									<thead class="table-head">
										<tr>
											<th scope="col" class="text-left font-medium pb-1">{{ list.label }}</th>
											<th scope="col" class="sr-only">Exposure</th>
										</tr>
									</thead>
									<tbody>
										{% for row in list.rows %}
											<tr class="border-t border-outline-variant/10 align-baseline">
												<td class="py-1.5 pr-3 min-w-0">
													<a href="{{ path('app_stock_view', {ticker: row.ticker}) }}" class="font-mono font-medium text-primary hover:underline">{{ row.ticker }}</a>
													<span class="text-on-surface-variant">{{ row.name }}</span>
													{% if row.detail is not null and list.detail_unit %}
														<span class="block text-2xs text-on-surface-variant"><span class="font-mono tabular-nums">{{ row.detail|pct(0) }}</span> {{ list.detail_unit }}</span>
													{% endif %}
												</td>
												<td class="py-1.5 text-right whitespace-nowrap">
													<span class="font-mono tabular-nums text-on-surface">
														{{- row.value|figure(list.format, list.decimals) -}}
													</span>
													<span class="text-on-surface-variant">{{ list.unit }}</span>
												</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							{% endfor %}
							<p class="source-note mt-auto pt-3">{{ source_line('aerie-exchange') }}</p>
						</div>
					{% endfor %}
				</div>
			</section>
		{% endif %}
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{% include 'partials/_chart_libraries.html.twig' with { chartjs: true } %}

	<script type="module">
		import 'pages/economy';
	</script>
{% endblock %}
