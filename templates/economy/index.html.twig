{% extends 'base.html.twig' %}

{% block title %}The District Economy - Aerie Exchange{% endblock %}

{% block meta %}
	<meta name="description" content="Live macroeconomic conditions across the Aerie Autonomous District: monetary policy, the yield curve, inflation, growth, credit, labour and commodities, with twenty-five years of history.">
	<meta property="og:title" content="The District Economy | Aerie Exchange">
	<meta property="og:description" content="Monetary policy, yield curves, risk premia, labour and commodities — the economy every listed company is priced against.">
	<meta property="og:type" content="website">
{% endblock %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-8">

		<header class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 pb-6 border-b border-outline-variant/15">
			<div class="min-w-0 max-w-2xl">
				<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight">The District Economy</h1>
				<p class="text-sm text-on-surface-variant mt-2 leading-relaxed">
					The conditions every listed company is priced against. The Monetary Authority sets the policy
					rate by its published rule, the yield curve prices the path it expects, and growth, credit and
					the labour market feed through to every earnings report on the exchange.
				</p>
				<p class="mt-3 text-sm">
					<a href="/government" class="text-primary hover:underline underline-offset-2">The Government</a>
					<span class="mx-2 text-on-surface-variant/40" aria-hidden="true">&middot;</span>
					<a href="/reserve" class="text-primary hover:underline underline-offset-2">Sovereign Reserve Fund</a>
				</p>
			</div>

			{# The readings the ticker publishes on every frame; stats-updater.js repaints them in place. #}
			<dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-4 shrink-0">
				<div>
					<dt class="text-xs text-on-surface-variant">Economic cycle</dt>
					<dd class="mt-0.5 text-lg font-semibold text-on-surface" id="market-economic-cycle">{{ economic_cycle }}</dd>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">Inflation (CPI)</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-on-surface" id="macro-inflation">{{ (macro.inflation * 100)|number_format(2) }}%</dd>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">Output gap</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums {{ macro.outputGap * 100 < -1.0 ? 'text-tertiary' : (macro.outputGap * 100 > 1.0 ? 'text-secondary' : 'text-on-surface') }}" id="macro-output-gap">{{ (macro.outputGap * 100)|number_format(2) }}%</dd>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">Policy rate</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-on-surface" id="macro-policy-rate">{{ (macro.policyRate * 100)|number_format(2) }}%</dd>
				</div>
				<div>
					<dt class="text-xs text-on-surface-variant">10Y yield</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-on-surface" id="macro-yield">{{ (macro.yield10y * 100)|number_format(2) }}%</dd>
				</div>
				<div class="{{ macro.qeActive and macro.qeIntensity > 0.0005 ? '' : 'hidden' }}" id="qe-status-container">
					<dt class="text-xs text-on-surface-variant">Asset purchases</dt>
					<dd class="mt-0.5 text-lg font-semibold font-mono tabular-nums text-on-surface" id="macro-qe-status">
						{%- if macro.qeActive and macro.qeIntensity > 0.0005 -%}
							&minus;{{ (macro.qeIntensity * 10000)|number_format(0) }} bps
						{%- endif -%}
					</dd>
				</div>
			</dl>
		</header>

		<section class="space-y-5" aria-labelledby="macro-series-heading">
			<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
				<div>
					<h2 id="macro-series-heading" class="text-lg font-semibold text-on-surface">History</h2>
					<p class="text-sm text-on-surface-variant mt-0.5">Quarterly readings across rates, prices, growth, credit and trade.</p>
				</div>
				<div class="inline-flex items-center gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5 self-start md:self-auto" role="group" aria-label="History window">
					<button type="button" id="btn-macro-5Y" class="macro-range-btn seg-btn" aria-pressed="false" data-macro-timeframe="5Y">5Y</button>
					<button type="button" id="btn-macro-10Y" class="macro-range-btn seg-btn" aria-pressed="true" data-macro-timeframe="10Y">10Y</button>
					<button type="button" id="btn-macro-25Y" class="macro-range-btn seg-btn" aria-pressed="false" data-macro-timeframe="25Y">25Y</button>
				</div>
			</div>

			<div class="flex flex-col xl:flex-row justify-between items-stretch xl:items-center gap-3">
				<div class="flex items-center flex-wrap gap-1" id="macroCategoryPills" role="group" aria-label="Filter by topic">
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="true" data-category="all">All <span class="ml-0.5 text-on-surface-variant/70 tabular-nums">(27)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="monetary">Rates and yields <span class="ml-0.5 text-on-surface-variant/70 tabular-nums">(5)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="inflation">Inflation and output <span class="ml-0.5 text-on-surface-variant/70 tabular-nums">(4)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="growth">Growth and labour <span class="ml-0.5 text-on-surface-variant/70 tabular-nums">(5)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="credit">Credit and liquidity <span class="ml-0.5 text-on-surface-variant/70 tabular-nums">(6)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="assets">Property and commodities <span class="ml-0.5 text-on-surface-variant/70 tabular-nums">(3)</span></button>
					<button type="button" class="macro-cat-btn seg-btn" aria-pressed="false" data-category="public">Trade and public finance <span class="ml-0.5 text-on-surface-variant/70 tabular-nums">(4)</span></button>
				</div>

				<div class="relative w-full xl:w-64">
					<label for="macroIndicatorSearch" class="sr-only">Filter charts</label>
					<input type="search" id="macroIndicatorSearch" placeholder="Filter charts" class="w-full px-3 py-1.5 text-xs bg-surface-container-lowest border border-outline-variant/25 rounded text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:border-primary/60 transition-colors">
				</div>
			</div>

			{# Fetch status for the macro series below. #}
			<div id="macroChartsStatus" class="hidden mb-4 rounded-lg border px-4 py-3 text-sm flex items-center gap-3" role="status" aria-live="polite">
				<span class="material-symbols-outlined text-base shrink-0" data-status-icon aria-hidden="true">hourglass_empty</span>
				<span class="grow" data-status-message></span>
				<button type="button" data-status-retry class="hidden px-3 py-1 rounded text-xs font-bold bg-surface-container-high text-on-surface hover:bg-surface-bright transition-colors cursor-pointer">Retry</button>
			</div>

			<div id="macroChartsGrid" class="space-y-10" data-chart-grid>
				<section class="space-y-4" data-chart-section aria-labelledby="macro-section-monetary">
					<h3 id="macro-section-monetary" class="text-base font-semibold text-on-surface">Rates and yields</h3>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						<div class="chart-card lg:col-span-2 bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-wide data-macro-category="monetary">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Policy rate and the yield curve</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">The policy rate, 2-, 5- and 10-year sovereign yields, the 2s10s spread and the rule's target rate</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroRatesChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroRatesChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Monetary Authority; Treasury</p>
						</div>

						<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-macro-category="monetary">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Policy rate against the rule</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">The rate the Monetary Authority's published rule calls for, the policy rate, and the gap between them</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroPolicyRuleChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroPolicyRuleChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Monetary Authority</p>
						</div>

						<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-macro-category="monetary">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">What is in the 10-year yield</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">The 10-year yield split into the expected path of the policy rate and the term premium, beside the neutral real rate</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroTermPremiumChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroTermPremiumChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Monetary Authority</p>
						</div>

						<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-macro-category="monetary">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Mortgage rates</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">The 30-year fixed mortgage rate and its spread over the policy rate</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroMortgageChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroMortgageChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Credit Registry</p>
						</div>

						<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-macro-category="monetary">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Central bank balance sheet</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">Asset holdings, indexed, and the pace of asset purchases (QE) or run-off (QT)</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroBalanceSheetChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroBalanceSheetChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Monetary Authority</p>
						</div>
					</div>
				</section>

				<section class="space-y-4" data-chart-section aria-labelledby="macro-section-inflation">
					<h3 id="macro-section-inflation" class="text-base font-semibold text-on-surface">Inflation and output</h3>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-macro-category="inflation">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Inflation and the output gap</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">Consumer prices, 10-year breakeven inflation, the output gap and excess capital stock</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroEconomyChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroEconomyChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Statistical Office</p>
						</div>

						<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-macro-category="inflation">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Inflation by component</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">Headline consumer and producer prices, with services, goods and food</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroSectoralInflationChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroSectoralInflationChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Statistical Office</p>
						</div>

						<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-macro-category="inflation">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Supply-side cost pressures</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">What food, energy and freight costs add to inflation, in basis points</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroCostPushChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroCostPushChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Statistical Office</p>
						</div>

						<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-macro-category="inflation">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Inventories and capacity</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">Inventory overhang against the output gap, factory capacity utilisation and strategic energy stocks</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroInventoryCycleChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroInventoryCycleChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Manufactory Board</p>
						</div>
					</div>
				</section>

				<section class="space-y-4" data-chart-section aria-labelledby="macro-section-growth">
					<h3 id="macro-section-growth" class="text-base font-semibold text-on-surface">Growth and labour</h3>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						<div class="chart-card lg:col-span-2 bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-wide data-macro-category="growth">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Growth and recession risk</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">Real and nominal GDP growth, potential growth and the productivity behind it, and the chance of a recession within a year</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroGdpGrowthChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroGdpGrowthChart" data-structural-labor-growth="{{ constant('App\\Service\\Macro\\MacroEngine::STRUCTURAL_LABOR_GROWTH_RATE') }}"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Statistical Office</p>
						</div>

						<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-macro-category="growth">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div class="min-w-0">
									<h4 class="text-sm font-semibold text-on-surface">Leading indicators</h4>
									<p class="text-xs text-on-surface-variant mt-0.5">Manufacturing PMI, housing starts, money-supply growth, the trade balance and producer prices</p>
								</div>
								<div class="flex items-start gap-3 shrink-0">
									<p class="hidden sm:block max-w-64 text-right text-xs font-mono font-semibold text-on-surface tabular-nums" id="hud-macroLeadingIndicatorsChart">-</p>
									<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
										<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container h-80 md:h-85 w-full relative">
								<canvas id="macroLeadingIndicatorsChart"></canvas>
							</div>
							<p class="mt-3 text-2xs text-on-surface-variant/70">Source: Manufactory Board; Statistical Office</p>
						</div>

