{% extends 'base.html.twig' %}

{% block title %}Stock Screener | Aerie Exchange{% endblock %}

{% block body %}
<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-5" data-controller="screener">

    <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 border-b border-outline-variant/15">
        <div>
            <h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight">Stock screener</h1>
            <p class="mt-1.5 text-sm text-on-surface-variant">Every listing on the exchange with its latest fundamentals. Select a column to sort.</p>
        </div>
        <div class="w-full md:w-72">
            <label for="screener-search" class="sr-only">Filter by ticker or name</label>
            <input type="search" id="screener-search" placeholder="Filter by ticker or name" class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm text-on-surface focus:border-primary/60 outline-none placeholder:text-on-surface-faint" data-screener-target="searchInput" data-action="input->screener#onSearch">
        </div>
    </header>

    {% set sectors = [] %}
    {% for stock in stocks %}
        {% if stock.sector and stock.sector not in sectors %}
            {% set sectors = sectors|merge([stock.sector]) %}
        {% endif %}
    {% endfor %}
    <div class="flex items-center gap-1 overflow-x-auto pb-1 custom-scrollbar" id="sector-filters" role="group" aria-label="Filter by sector">
        <button type="button" class="sector-filter-btn seg-btn" aria-pressed="true" data-sector="ALL" data-screener-target="sectorBtn" data-action="click->screener#filterSector">All sectors</button>
        {% for sec in sectors|sort %}
            <button type="button" class="sector-filter-btn seg-btn" aria-pressed="false" data-sector="{{ sec }}" data-screener-target="sectorBtn" data-action="click->screener#filterSector">{{ sec }}</button>
        {% endfor %}
    </div>

    <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-225" id="screener-table">
                <thead>
                    <tr class="table-head bg-surface-container-highest/20">
                        <th scope="col" class="px-5 py-3 cursor-pointer select-none hover:text-primary transition-colors" data-col="ticker" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">Ticker</th>
                        <th scope="col" class="px-4 py-3 cursor-pointer select-none hover:text-primary transition-colors" data-col="name" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">Company</th>
                        <th scope="col" class="px-4 py-3 cursor-pointer select-none hover:text-primary transition-colors" data-col="sector" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">Sector</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="price" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">Price</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="mcap" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">Market cap</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="pe" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">P/E</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="yield" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort" title="Annualized dividend yield">Div yield</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="eps" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">EPS</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="roic" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">ROIC</th>
                        <th scope="col" class="px-4 py-3 text-center cursor-pointer select-none hover:text-primary transition-colors" data-col="rating" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort" title="Credit rating from rating agency">Rating</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="equity" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">Equity</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="de" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort">D/E</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="ndebt" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort" title="Net debt over annualized EBITDA">ND/EBITDA</th>
                        <th scope="col" class="px-4 py-3 text-right cursor-pointer select-none hover:text-primary transition-colors" data-col="fcfconv" role="columnheader" aria-sort="none" tabindex="0" data-screener-target="header" data-action="click->screener#sort" title="Free cash flow over trailing net income">FCF conv.</th>
                        <th class="px-5 py-3"><span class="sr-only">Open</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm" id="screener-tbody" data-screener-target="tbody">
                    {% for stock in stocks %}
                        <tr class="relative hover:bg-surface-container-high/30 focus-within:bg-surface-container-high/30 transition-colors group screener-row {{ stock.isBankrupt ? 'opacity-50 bg-tertiary/10' : '' }}" data-ticker="{{ stock.ticker }}" data-name="{{ stock.name|lower }}" data-sector="{{ stock.sector }}" data-screener-target="row">
                            <th scope="row" class="px-5 py-2.5 text-left font-normal" data-value="{{ stock.ticker }}">
                                <div class="flex items-center gap-1.5">
                                    <a href="/stock/{{ stock.ticker }}" class="font-bold text-primary font-mono group-hover:underline outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:underline-offset-4">{{ stock.ticker }}</a>
                                    {% if stock.dividendAristocrat|default(false) %}
                                        <span class="badge badge-up relative z-10" title="Dividend Aristocrat: 25+ consecutive years of dividend increases">Aristocrat</span>
                                    {% endif %}
                                    {% if stock.isBankrupt %}
                                        <span class="badge badge-down relative z-10">Bankrupt</span>
                                    {% endif %}
                                </div>
                            </th>
                            <td class="px-4 py-2.5 font-medium text-on-surface max-w-55 truncate" data-value="{{ stock.name }}">{{ stock.name }}</td>
                            <td class="px-4 py-2.5 text-on-surface-variant text-xs" data-value="{{ stock.sector }}">
                                {{ stock.sector }}
                            </td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right font-bold {{ stock.isBankrupt ? 'text-tertiary line-through' : 'text-on-surface' }}" data-value="{{ stock.isBankrupt ? 0 : stock.price }}">${{ (stock.isBankrupt ? 0.00 : stock.price)|number_format(2) }}</td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right text-on-surface" data-value="{{ stock.isBankrupt ? 0 : stock.marketCap }}">{{ stock.isBankrupt ? '$0.00' : stock.marketCap|format_large('$') }}</td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right text-on-surface" data-value="{{ stock.isBankrupt ? 0 : (stock.peRatio ?? 0) }}">
                                {{ not stock.isBankrupt and stock.peRatio is not null ? stock.peRatio|number_format(2) ~ 'x' : '-' }}
                            </td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right text-on-surface" data-value="{{ stock.dividendYield ?? 0 }}">
                                {{ not stock.isBankrupt and stock.dividendYield > 0 ? (stock.dividendYield)|number_format(2) ~ '%' : '-' }}
                            </td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right text-on-surface" data-value="{{ stock.eps }}">{{ stock.eps|money(2) }}</td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right font-bold {{ stock.currentRoic|signed_class }}" data-value="{{ stock.currentRoic }}">
                                {{ stock.currentRoic|pct(2) }}
                            </td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-center text-on-surface" data-value="{{ stock.creditRating|default('BBB') }}">
                                <span class="px-1.5 py-0.5 rounded text-2xs font-semibold border border-outline-variant/30 text-on-surface-variant">{{ stock.creditRating|default('—') }}</span>
                            </td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right text-on-surface" data-value="{{ stock.equity }}">{{ stock.equity|format_large('$') }}</td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right text-on-surface" data-value="{{ stock.debtToEquity ?? 0 }}">
                                {{ stock.debtToEquity is not null ? stock.debtToEquity|number_format(2) ~ 'x' : '-' }}
                            </td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right {{ stock.netDebtToEbitda is not null and stock.netDebtToEbitda > 4 ? 'text-tertiary' : 'text-on-surface' }}" data-value="{{ stock.netDebtToEbitda ?? 0 }}">
                                {{ stock.netDebtToEbitda is not null ? stock.netDebtToEbitda|number_format(2) ~ 'x' : '-' }}
                            </td>
                            <td class="px-4 py-2.5 font-mono tabular-nums text-right {{ stock.fcfConversion is not null and stock.fcfConversion < 0.8 ? 'text-tertiary' : 'text-on-surface' }}" data-value="{{ stock.fcfConversion ?? 0 }}">
                                {{ stock.fcfConversion is not null ? stock.fcfConversion|pct(0) : '-' }}
                            </td>
                            <td class="px-5 py-2.5 text-right">
                                <span class="material-symbols-outlined text-base leading-none text-on-surface-variant group-hover:text-primary transition-colors" aria-hidden="true">chevron_right</span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="15" class="px-6 py-10 text-center text-on-surface-variant text-sm">No companies are listed yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}