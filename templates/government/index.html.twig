{% extends 'base.html.twig' %}

{% block title %}The Government - Aerie Exchange{% endblock %}

{% block meta %}
	<meta name="description" content="The Aerie District's government at a glance: the cabinet, the next election, the budget, the Council and the departments it appoints.">
	<meta property="og:title" content="The Government | Aerie Exchange">
	<meta property="og:description" content="Eight parties, a 300-seat Diet elected every four years, and a thirteen-member Council that renews itself.">
	<meta property="og:type" content="website">
{% endblock %}

{% import 'partials/_ui.html.twig' as ui %}
{% import 'government/_macros.html.twig' as gov %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5" id="governmentPage">

		<header class="pb-6 border-b border-outline-variant/15">
			<div class="flex flex-col gap-6">
				<div class="min-w-0 max-w-3xl">
					<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight leading-tight">The Government</h1>
					<p class="text-sm text-on-surface-variant mt-2 max-w-2xl">
						The District is governed by two institutions that share no members and answer to no one but themselves.
						The Diet is elected every {{ rules.termYears|number_format(0) }} years and passes the budget and the laws.
						The Council is {{ rules.councilSeats }} leaders who choose their own successors, appoint the heads of the departments,
						and hold a veto they almost never use.
					</p>
					<p class="mt-3 text-sm text-on-surface-variant">As of {{ simDate }}</p>
				</div>

				<dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-5">
					<div class="col-span-2">
						<dt class="text-xs text-on-surface-variant">{{ government.caretaker ? 'Caretaker cabinet' : 'Cabinet' }}</dt>
						<dd class="text-base font-semibold text-on-surface mt-1 flex flex-wrap gap-x-3 gap-y-1">
							{% for member in government.members %}
								<span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full" style="background-color: {{ member.color }}" aria-hidden="true"></span>{{ member.name }}</span>
							{% endfor %}
						</dd>
						{% if government.support is not empty %}
							<p class="text-2xs text-on-surface-variant mt-1">Supported from outside by {% for member in government.support %}<span class="font-semibold text-on-surface">{{ member.name }}</span>{{ not loop.last ? ', ' : '' }}{% endfor %}</p>
						{% endif %}
						{% if government.primeMinister %}
							<p class="text-2xs text-on-surface-variant mt-1">{{ government.caretaker ? 'Caretaker prime minister' : 'Prime minister' }} <span class="font-semibold text-on-surface">{{ government.primeMinister.name }}</span>, {{ government.primeMinister.age }}, leader of {{ government.primeMinister.party }}</p>
						{% endif %}
						<p class="text-2xs font-mono tabular-nums text-on-surface-variant mt-1">{{ government.caretaker ? 'Stays in office until the talks produce a government · formed ' : 'Formed ' }}{{ government.formed }}</p>
					</div>
					<div>
						<dt class="text-xs text-on-surface-variant">Cabinet seats</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5">{{ government.seats }} / {{ rules.seats }}</dd>
						<p class="text-2xs font-mono tabular-nums text-on-surface-variant mt-0.5">
							{%- if government.minority %}Minority · {{ government.supportedSeats }} with supporters{% else %}Majority {{ rules.majority }}{% endif %}{{ government.supermajority ? ' · three quarters held' : '' -}}
						</p>
					</div>
					<div>
						<dt class="text-xs text-on-surface-variant">Next election</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5">{{ election.next }}</dd>
						<p class="text-2xs font-mono tabular-nums text-on-surface-variant mt-0.5">
							{{ election.campaign ? 'Campaign under way · ' : '' }}in {{ election.yearsLeft|number_format(1) }} {{ election.yearsLeft|number_format(1) == '1.0' ? 'year' : 'years' }}
						</p>
					</div>
					<div class="col-span-2">
						<dt class="text-xs text-on-surface-variant" title="An index of uncertainty about economic policy, 100 on average">Policy uncertainty</dt>
						<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5">{{ election.policyUncertainty|number_format(0) }}</dd>
						<p class="text-2xs text-on-surface-variant mt-0.5">Rises into a vote and stays high through the talks, as firms put off investment until they know who governs</p>
					</div>
					<div class="col-span-2">
						<dt class="text-xs text-on-surface-variant">Next Council term to end</dt>
						<dd class="text-base font-semibold text-on-surface mt-0.5">Seat {{ council.nextVacancy.seat }} · {{ council.nextVacancy.termEndsLabel }}</dd>
						<p class="text-2xs text-on-surface-variant mt-0.5">{{ council.nextVacancy.name }}'s term ends; the Council elects the successor</p>
					</div>
				</dl>
			</div>
		</header>


		{# One headline from each institution, with a link to its own page. #}
		<section aria-labelledby="elected-heading">
			<h2 id="elected-heading" class="text-sm font-semibold text-on-surface">The Diet and its budget</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-3">
				<section class="bg-surface-container-low rounded-lg p-5 border {{ talks and talks.underWay ? 'border-primary/40' : 'border-outline-variant/20' }} flex flex-col" aria-labelledby="hub-diet-heading">
					<h3 id="hub-diet-heading" class="text-sm font-semibold text-on-surface"><a href="{{ path('app_government_diet') }}" class="hover:underline">The Diet</a></h3>
					<svg viewBox="-108 -106 216 114" class="w-full mt-3 max-h-40" role="img" aria-label="Diet seats by party: {% for party in parties %}{{ party.name }} {{ party.seats }}{{ not loop.last ? ', ' : '' }}{% endfor %}">
						{% for seat in hemicycle %}
							<circle cx="{{ seat.x * 100 }}" cy="{{ -seat.y * 100 }}" r="2.5" fill="{{ seat.color }}" fill-opacity="{{ seat.governing ? 1 : (seat.supporting ? 0.6 : 0.3) }}"{% if seat.supporting %} stroke="{{ seat.color }}" stroke-width="0.6"{% endif %}></circle>
						{% endfor %}
						<text x="0" y="-13" text-anchor="middle" class="fill-on-surface font-semibold" font-size="15">{{ government.supportedSeats }}</text>
						<text x="0" y="-4" text-anchor="middle" class="fill-on-surface-variant" font-size="5.5">of {{ rules.majority }} needed</text>
					</svg>
					<p class="text-xs text-on-surface mt-3">
						{% if talks and talks.underWay %}
							<span class="font-semibold text-primary">{{ talks.afterFall ? 'The cabinet has fallen' : 'Coalition talks under way' }}</span>, day <span class="font-mono tabular-nums">{{ talks.day|number_format(0) }}</span>{% if talks.leading %}: {{ talks.leading.name }} is trying to form a government{% endif %}.
						{% else %}
							{% set largest = parties|sort((a, b) => b.seats <=> a.seats)|first %}
							{{ largest.name }} is the largest party with <span class="font-mono tabular-nums">{{ largest.seats }}</span> seats; the cabinet {{ government.minority ? 'governs as a minority' : 'holds a majority' }}.
						{% endif %}
					</p>
					<p class="mt-auto pt-3 text-xs"><a href="{{ path('app_government_diet') }}" class="text-primary hover:underline underline-offset-2">Seats, talks, where the parties stand and past elections</a></p>
				</section>

				<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20 flex flex-col" aria-labelledby="hub-election-heading">
					<h3 id="hub-election-heading" class="text-sm font-semibold text-on-surface"><a href="{{ path('app_government_election') }}" class="hover:underline">The election</a></h3>
					<p class="mt-2 text-2xl font-semibold font-mono tabular-nums text-on-surface">{{ election.next }}</p>
					<p class="text-xs text-on-surface-variant">{{ election.campaign ? 'Campaign under way, ' : '' }}in {{ election.yearsLeft|number_format(1) }} {{ election.yearsLeft|number_format(1) == '1.0' ? 'year' : 'years' }}</p>
					{% if polls %}
						{% set front = polls.parties|first %}
						<p class="text-xs text-on-surface mt-3">
							<span class="inline-block w-2 h-2 rounded-full mr-1" style="background-color: {{ front.color }}" aria-hidden="true"></span>{{ front.name }} leads the polls at <span class="font-mono tabular-nums">{{ front.average|pct(1) }}</span>, against <span class="font-mono tabular-nums">{{ front.vote|pct(1) }}</span> at the last vote.
						</p>
					{% endif %}
					{% if market and market.leaders is not empty %}
						{% set favourite = market.leaders|first %}
						<p class="text-xs text-on-surface mt-1">
							Traders give {{ favourite.name }} a <span class="font-mono tabular-nums">{{ favourite.chance|pct(0) }}</span> chance of leading {{ market.talks ? 'the government the talks produce' : 'the next government' }}.
						</p>
					{% endif %}
					{% if not polls and not market %}
						<p class="text-xs text-on-surface-variant mt-3">No poll has been taken since the last vote.</p>
					{% endif %}
					<p class="mt-auto pt-3 text-xs"><a href="{{ path('app_government_election') }}" class="text-primary hover:underline underline-offset-2">The polls and the market's odds</a></p>
				</section>

				<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20 flex flex-col" aria-labelledby="hub-budget-heading">
					<h3 id="hub-budget-heading" class="text-sm font-semibold text-on-surface"><a href="{{ path('app_government_budget') }}" class="hover:underline">The budget</a></h3>
					<p class="mt-2 text-2xl font-semibold font-mono tabular-nums {{ budget.braking ? 'text-warning' : 'text-on-surface' }}">{{ budget.debt|pct(1) }}</p>
					<p class="text-xs text-on-surface-variant">of GDP in debt; the Council's line is {{ rules.debtBrake|pct(0) }}{{ budget.braking ? ', and its brake is on' : '' }}</p>
					{% set changing = budget.levers|filter(lever => lever.status in ['pending', 'partial'])|length %}
					{% set held = budget.levers|filter(lever => lever.status in ['held', 'fund', 'blocked'])|length %}
					<p class="text-xs text-on-surface mt-3">
						{% if government.caretaker %}
							No budget passes until the talks produce a government.
						{% else %}
							Next round <span class="font-mono tabular-nums">{{ budget.nextRound }}</span>:
							{{ changing == 0 ? 'no law changes' : (changing == 1 ? 'one law changes' : changing ~ ' laws change') }}{% if held > 0 %}, and {{ held == 1 ? 'one is' : held ~ ' are' }} held back{% endif %}.
						{% endif %}
					</p>
					<p class="mt-auto pt-3 text-xs"><a href="{{ path('app_government_budget') }}" class="text-primary hover:underline underline-offset-2">The laws, their history and the firms they reach</a></p>
				</section>
			</div>
		</section>

		<section aria-labelledby="appointed-heading">
			<h2 id="appointed-heading" class="text-sm font-semibold text-on-surface">The Council and the departments it appoints</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mt-3">
				<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20 flex flex-col" aria-labelledby="hub-council-heading">
					<h3 id="hub-council-heading" class="text-sm font-semibold text-on-surface"><a href="{{ path('app_council') }}" class="hover:underline">Aerie Council</a></h3>
					{% if council.lean %}
						<p class="mt-2 text-2xl font-semibold text-on-surface">{{ council.lean.median == 'hawk' ? 'Hawkish' : (council.lean.median == 'dove' ? 'Dovish' : 'Middle') }}</p>
						<p class="text-xs text-on-surface-variant">
							<span class="font-mono tabular-nums">{{ council.lean.hawk }}</span> {{ council.lean.hawk == 1 ? 'hawk' : 'hawks' }},
							<span class="font-mono tabular-nums">{{ council.lean.swing }}</span> {{ council.lean.swing == 1 ? 'swing vote' : 'swing votes' }},
							<span class="font-mono tabular-nums">{{ council.lean.dove }}</span> {{ council.lean.dove == 1 ? 'dove' : 'doves' }}
						</p>
					{% endif %}
					{% if council.lean and council.lean.banks is not null %}
						<p class="text-xs text-on-surface mt-3">
							Its middle councillor would ask the banks for <span class="font-mono tabular-nums">{{ council.lean.banks|pct(1) }}</span> core capital{% if council.lean.reserves is not null %} and keep <span class="font-mono tabular-nums">{{ council.lean.reserves|pct(0) }}</span> of the reserves in shares{% endif %}.
						</p>
					{% endif %}
					<p class="mt-auto pt-3 text-xs"><a href="{{ path('app_council') }}" class="text-primary hover:underline underline-offset-2">Councillors, departments and powers</a></p>
				</section>

				<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20 flex flex-col" aria-labelledby="hub-authority-heading">
					<h3 id="hub-authority-heading" class="text-sm font-semibold text-on-surface"><a href="{{ path('app_authority') }}" class="hover:underline">Monetary Authority</a></h3>
					{% if authority and authority.meeting %}
						{% set meeting = authority.meeting %}
						<p class="mt-2 text-2xl font-semibold font-mono tabular-nums text-on-surface">{{ meeting.rate|pct(2) }}</p>
						<p class="text-xs text-on-surface-variant">policy rate</p>
						<p class="text-xs text-on-surface mt-3">
							{%- set bp = meeting.moveBp -%}
							{%- set points = bp|abs == 1 ? ' basis point' : ' basis points' -%}
							{{ bp == 0 ? 'Held' : (bp > 0 ? 'Raised ' ~ bp ~ points : 'Cut ' ~ bp|abs ~ points) }} on <span class="font-mono tabular-nums">{{ meeting.date }}</span>, voting <span class="font-mono tabular-nums">{{ meeting.split }}</span>. Next meeting <span class="font-mono tabular-nums">{{ authority.nextMeeting }}</span>.
						</p>
					{% elseif authority %}
						<p class="text-xs text-on-surface mt-2">The committee has not met yet. Its first meeting is <span class="font-mono tabular-nums">{{ authority.nextMeeting }}</span>.</p>
					{% endif %}
					{% if authority %}
						<p class="text-xs text-on-surface-variant mt-1">Governor {{ authority.governor.name }}, {{ {hawk: 'a hawk', swing: 'a swing vote', dove: 'a dove'}[authority.governor.stance] }}</p>
					{% endif %}
					<p class="mt-auto pt-3 text-xs"><a href="{{ path('app_authority') }}" class="text-primary hover:underline underline-offset-2">The governor, the committee and every decision</a></p>
				</section>

				<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20 flex flex-col" aria-labelledby="hub-regulator-heading">
					<h3 id="hub-regulator-heading" class="text-sm font-semibold text-on-surface"><a href="{{ path('app_regulator') }}" class="hover:underline">Financial Regulator</a></h3>
					{% if regulator %}
						<p class="mt-2 text-2xl font-semibold font-mono tabular-nums text-on-surface">{{ regulator.inForce|pct(2) }}</p>
						<p class="text-xs text-on-surface-variant">core capital, with a <span class="font-mono tabular-nums">{{ regulator.buffer|pct(2) }}</span> buffer on top</p>
						<p class="text-xs text-on-surface mt-3">
							{{ mortgageLtvCap is null ? 'No limit on mortgage borrowing.' : 'Mortgages capped at ' ~ mortgageLtvCap|pct(0) ~ ' of a home\'s price.' }}
							{% if regulator.phasing %}Capital rising to <span class="font-mono tabular-nums">{{ regulator.phasing.target|pct(1) }}</span> by <span class="font-mono tabular-nums">{{ regulator.phasing.completeLabel }}</span>.{% endif %}
						</p>
						<p class="text-xs text-on-surface-variant mt-1">Head {{ regulator.head.name }}, {{ {light: 'light-touch', middle: 'moderate', strict: 'strict'}[regulator.head.stance] }}</p>
					{% endif %}
					<p class="mt-auto pt-3 text-xs"><a href="{{ path('app_regulator') }}" class="text-primary hover:underline underline-offset-2">Both rules and the banks it supervises</a></p>
				</section>

				<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20 flex flex-col" aria-labelledby="hub-fund-heading">
					<h3 id="hub-fund-heading" class="text-sm font-semibold text-on-surface"><a href="{{ path('app_reserve') }}" class="hover:underline">Sovereign Reserve Fund</a></h3>
					{% if fundHead %}
						{% if fundHead.inForce is not null %}
							<p class="mt-2 text-2xl font-semibold font-mono tabular-nums text-on-surface">{{ fundHead.inForce|pct(1) }}</p>
							<p class="text-xs text-on-surface-variant">of the fund in equities</p>
						{% endif %}
						<p class="text-xs text-on-surface mt-3">Head {{ fundHead.name }}, {{ {cautious: 'a cautious investor', balanced: 'a balanced investor', bold: 'a bold investor'}[fundHead.stance] }}{{ fundHead.opening ? ', keeping the mix the fund opened with' : '' }}.</p>
					{% endif %}
					<p class="mt-auto pt-3 text-xs"><a href="{{ path('app_reserve') }}" class="text-primary hover:underline underline-offset-2">Holdings, weights and bands</a></p>
				</section>
			</div>
		</section>

		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="how-heading">
			<h2 id="how-heading" class="text-sm font-semibold text-on-surface">How the District is governed</h2>
			<p class="text-2xs text-on-surface-variant mt-0.5">A short guide to the Diet, its governments and its budgets.</p>

			{% set guide = [
				{
					heading: 'Elections',
					items: [
						{name: 'The vote', text: 'The Diet\'s ' ~ rules.seats ~ ' seats are elected every ' ~ rules.termYears|number_format(0) ~ ' years on a fixed date. It cannot be dissolved early, so a government that loses its majority is replaced without an election.'},
						{name: 'Seats', text: 'Seats are shared out in proportion to the vote across the whole District by the D\'Hondt method, with no threshold.'},
						{name: 'The economy', text: 'Voters punish inflation, whoever governs. A party governing alone is also rewarded for growth; when several parties share the cabinet, none of them gets the credit.'},
						{name: 'Wear and tear', text: 'Governing costs votes. Most governments end their term weaker than they began it, and a party that keeps a minority government in office from outside pays part of that price.'},
						{name: 'Loyal voters', text: 'Every party has a core vote it returns to. Landslides fade, and a party that collapses usually recovers over the following elections.'}
					]
				},
				{
					heading: 'Forming a government',
					items: [
						{name: 'Majority', text: 'A party that wins ' ~ rules.majority ~ ' seats governs alone. Otherwise the parties negotiate, and the outgoing cabinet stays on as caretaker, passing no budget, until a new one takes office.'},
						{name: 'Two blocs', text: 'Before each election the parties declare for one of two blocs, each led by its largest party going into the vote, today ' ~ rules.blocLeaders|join(' and ') ~ '. The two leaders compete for the premiership and will not govern together.'},
						{name: 'Minority government', text: 'Most governments hold fewer than ' ~ rules.majority ~ ' seats and rely on support parties that vote for their budgets without joining the cabinet.'},
						{name: 'The Council question', text: 'Parties at either end of the argument over the Council rarely join a cabinet; they back one from outside instead.'},
						{name: 'Falls', text: 'A cabinet can fall between elections when a partner walks out or its supporters withdraw. The parties then negotiate a new government in the same Diet.'}
					]
				},
				{
					heading: 'The budget',
					items: [
						{name: 'Budget rounds', text: 'The Diet passes a budget every ' ~ rules.budgetRoundMonths|number_format(0) ~ ' months. A new government\'s first budget is the round after it takes office.'},
						{name: 'What it decides', text: 'The corporate tax rate, the tariff on imports, the immigration regime, how strictly mergers are reviewed, how much housing the planning system lets through, the carbon price on power, the rules on offshore drilling and mining, the stamp duty on share trades, which is paid into the Sovereign Reserve, and the levy on banks\' balance sheets. Public spending follows the Exchequer\'s long-term plan, which no government has rewritten.'},
						{name: 'Supporters\' veto', text: 'A minority cabinet needs its supporters\' votes. They will not back a change that moves a policy further from their own, so they can stop a government but not steer it.'},
						{name: 'The debt brake', text: 'Above ' ~ rules.debtBrake|pct(0) ~ ' of GDP in debt, the Council would veto any budget that cuts revenue, so the Diet does not table one.'},
						{name: 'Removing councillors', text: 'The Diet can remove a councillor with ' ~ rules.supermajority ~ ' of its ' ~ rules.seats ~ ' seats. It never has, and ' ~ rules.loyalists|join(', ') ~ ' never would.'}
					]
				}
			] %}
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mt-4">
				{% for part in guide %}
					<div>
						<h3 class="text-xs font-semibold text-primary">{{ part.heading }}</h3>
						<dl class="mt-2 space-y-2.5">
							{% for item in part.items %}
								<div>
									<dt class="text-xs font-semibold text-on-surface">{{ item.name }}</dt>
									<dd class="text-xs text-on-surface-variant mt-0.5 leading-relaxed">{{ item.text }}</dd>
								</div>
							{% endfor %}
						</dl>
					</div>
				{% endfor %}
			</div>
		</section>
	</div>
{% endblock %}

