{% extends 'base.html.twig' %}

{% block title %}The Government - Aerie Exchange{% endblock %}

{% block meta %}
	<meta name="description" content="The Aerie District's government: the Diet and the cabinet that governs it, the parties, the coalition talks, the Council, and every election on record.">
	<meta property="og:title" content="The Government | Aerie Exchange">
	<meta property="og:description" content="Six parties, a 300-seat Diet elected every four years, and a thirteen-member Council that renews itself.">
	<meta property="og:type" content="website">
{% endblock %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5" id="governmentPage">

		{# --- HEADER: THE GOVERNMENT AT A GLANCE --- #}
		<div class="bg-surface-container-low rounded-lg p-6 lg:p-7 border border-outline-variant/15">
			<div class="flex flex-col xl:flex-row xl:justify-between xl:items-start gap-6">
				<div class="min-w-0">
					<div class="flex items-center gap-2 mb-2">
						<span class="w-2 h-2 rounded-full bg-secondary"></span>
						<span class="text-2xs font-semibold tracking-wide text-secondary uppercase">{{ simDate }}</span>
					</div>
					<h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-on-surface tracking-tight leading-tight">The Government</h1>
					<p class="text-sm text-on-surface-variant mt-2 max-w-2xl">
						The District is governed by two institutions that share no members and answer to no one but themselves.
						The Diet is elected every {{ rules.termYears|number_format(0) }} years and passes the budget and the laws.
						The Council is {{ rules.councilSeats }} technocrats who choose their own successors, run the departments,
						and hold a veto they almost never use.
					</p>
					<a href="/economy" class="inline-flex items-center gap-1 mt-3 text-xs font-bold text-primary hover:underline">
						<span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_back</span>
						The District Economy
					</a>
				</div>

				<dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 shrink-0 xl:min-w-[46rem]">
					<div class="bg-surface-container-lowest rounded border border-outline-variant/20 px-4 py-3 col-span-2">
						<dt class="text-2xs font-bold uppercase tracking-wider text-on-surface-variant">{{ government.caretaker ? 'Caretaker cabinet' : 'Cabinet' }}</dt>
						<dd class="text-base font-bold text-on-surface mt-1 flex flex-wrap gap-x-3 gap-y-1">
							{% for member in government.members %}
								<span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full" style="background-color: {{ member.color }}" aria-hidden="true"></span>{{ member.name }}</span>
							{% endfor %}
						</dd>
						{% if government.support is not empty %}
							<p class="text-3xs text-on-surface-variant mt-1">Supported from outside by {% for member in government.support %}<span class="font-bold text-on-surface">{{ member.name }}</span>{{ not loop.last ? ', ' : '' }}{% endfor %}</p>
						{% endif %}
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-1">{{ government.caretaker ? 'Stays in office until the talks produce a government · formed ' : 'Formed ' }}{{ government.formed }}</p>
					</div>
					<div class="bg-surface-container-lowest rounded border border-outline-variant/20 px-4 py-3">
						<dt class="text-2xs font-bold uppercase tracking-wider text-on-surface-variant">Cabinet seats</dt>
						<dd class="text-lg font-bold font-mono tabular-nums text-on-surface mt-0.5">{{ government.seats }} / {{ rules.seats }}</dd>
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5">
							{%- if government.minority %}Minority · {{ government.supportedSeats }} with supporters{% else %}Majority {{ rules.majority }}{% endif %}{{ government.supermajority ? ' · three quarters held' : '' -}}
						</p>
					</div>
					<div class="bg-surface-container-lowest rounded border border-outline-variant/20 px-4 py-3">
						<dt class="text-2xs font-bold uppercase tracking-wider text-on-surface-variant">Next election</dt>
						<dd class="text-lg font-bold font-mono tabular-nums text-on-surface mt-0.5">{{ election.next }}</dd>
						<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5">
							{{ election.campaign ? 'Campaign under way · ' : '' }}in {{ election.yearsLeft|number_format(1) }} {{ election.yearsLeft|number_format(1) == '1.0' ? 'year' : 'years' }}
						</p>
					</div>
					<div class="bg-surface-container-lowest rounded border border-outline-variant/20 px-4 py-3 col-span-2">
						<dt class="text-2xs font-bold uppercase tracking-wider text-on-surface-variant" title="Baker, Bloom and Davis economic policy uncertainty: it builds into each election and falls back once a government takes office">Policy uncertainty</dt>
						<dd class="text-lg font-bold font-mono tabular-nums text-on-surface mt-0.5">{{ election.policyUncertainty|number_format(0) }}</dd>
						<p class="text-3xs text-on-surface-variant mt-0.5">Rises into a vote and stays high through the talks, as firms put off investment until they know who governs</p>
					</div>
					<div class="bg-surface-container-lowest rounded border border-outline-variant/20 px-4 py-3 col-span-2">
						<dt class="text-2xs font-bold uppercase tracking-wider text-on-surface-variant">Next Council vacancy</dt>
						<dd class="text-base font-bold text-on-surface mt-0.5">Seat {{ council.nextVacancy.seat }} · {{ council.nextVacancy.termEndsLabel }}</dd>
						<p class="text-3xs text-on-surface-variant mt-0.5">{{ council.nextVacancy.name }}'s term ends; the Council elects the successor</p>
					</div>
				</dl>
			</div>
		</div>

		{# --- THE TALKS AFTER THE LAST VOTE --- #}
		{% if talks %}
			<section class="bg-surface-container-low rounded-lg p-5 border {{ talks.underWay ? 'border-primary/40' : 'border-outline-variant/15' }}" aria-labelledby="talks-heading">
				<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
					<div>
						<h2 id="talks-heading" class="text-sm font-bold text-on-surface">{{ talks.underWay ? (talks.afterFall ? 'The cabinet has fallen: talks under way' : 'Coalition talks under way') : 'The last coalition talks' }}</h2>
						<p class="text-3xs text-on-surface-variant mt-0.5">
							{% if talks.underWay %}
								Day {{ talks.day|number_format(0) }}{{ talks.afterFall ? ' since the cabinet fell on ' ~ talks.startedOn : '' }}. The {{ talks.afterFall ? 'cabinet that fell' : 'outgoing cabinet' }} stays on as caretaker and passes no budget until a new government takes office{{ talks.afterFall ? '; no election is called' : '' }}.
							{% else %}
								A government took office after {{ talks.day|number_format(0) }} days and {{ talks.attempts }} {{ talks.attempts == 1 ? 'attempt' : 'attempts' }}.
							{% endif %}
						</p>
					</div>
					{% if talks.leading %}
						<div class="shrink-0 rounded border border-primary/30 bg-primary/5 px-3 py-2">
							<p class="text-2xs font-bold uppercase tracking-wider text-primary">Attempt {{ talks.leading.attempt }}</p>
							<p class="text-xs text-on-surface mt-0.5"><span class="inline-block w-2 h-2 rounded-full mr-1" style="background-color: {{ talks.leading.color }}" aria-hidden="true"></span><span class="font-bold">{{ talks.leading.name }}</span> is trying to form a government</p>
						</div>
					{% endif %}
				</div>
				{% if talks.entries is not empty %}
					<ol class="mt-4 divide-y divide-outline-variant/10">
						{% for entry in talks.entries %}
							<li class="py-2 grid grid-cols-[4rem_1fr] gap-3 text-xs">
								<span class="font-mono tabular-nums text-on-surface-variant">Day {{ entry.day|number_format(0) }}</span>
								<span>
									<span class="inline-block w-2 h-2 rounded-full mr-1" style="background-color: {{ entry.color }}" aria-hidden="true"></span><span class="font-bold text-on-surface">{{ entry.formateur }}</span>
									{% if entry.formed %}
										<span class="text-secondary font-bold">formed a government:</span> {{ entry.cabinet|join(', ') }}{% if entry.support is not empty %}, supported by {{ entry.support|join(', ') }}{% endif %}.
									{% else %}
										<span class="text-error font-bold">failed</span> to form a cabinet of {{ entry.cabinet|join(', ') }}{% if entry.support is not empty %} with {{ entry.support|join(', ') }} in support{% endif %}.
									{% endif %}
								</span>
							</li>
						{% endfor %}
					</ol>
				{% endif %}
			</section>
		{% endif %}

		{# --- THE DIET AND THE POLICY SPACE --- #}
		{# The chamber's seat positions are unit-radius; they are drawn at 100 units so text sizes stay whole. #}
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
			<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/15" aria-labelledby="diet-heading">
				<h2 id="diet-heading" class="text-sm font-bold text-on-surface">The Diet</h2>
				<p class="text-3xs text-on-surface-variant mt-0.5">{{ rules.seats }} seats, from the largest state on the left to the smallest on the right. The cabinet's seats are solid, its supporters' half-filled.
					The blocs: {% for bloc in rules.blocSeats %}<span class="inline-block w-1.5 h-1.5 rounded-full mx-0.5 align-middle" style="background-color: {{ bloc.color }}" aria-hidden="true"></span>{{ bloc.name }}'s {{ bloc.seats }}{{ not loop.last ? ', ' : '.' }}{% endfor %}</p>

				<svg viewBox="-108 -106 216 114" class="w-full mt-4 max-h-72" role="img" aria-label="Diet seats by party: {% for party in parties %}{{ party.name }} {{ party.seats }}{{ not loop.last ? ', ' : '' }}{% endfor %}">
					{% for seat in hemicycle %}
						<circle cx="{{ seat.x * 100 }}" cy="{{ -seat.y * 100 }}" r="2.5" fill="{{ seat.color }}" fill-opacity="{{ seat.governing ? 1 : (seat.supporting ? 0.6 : 0.3) }}"{% if seat.supporting %} stroke="{{ seat.color }}" stroke-width="0.6"{% endif %}></circle>
					{% endfor %}
					<text x="0" y="-13" text-anchor="middle" class="fill-on-surface font-bold" font-size="15">{{ government.supportedSeats }}</text>
					<text x="0" y="-4" text-anchor="middle" class="fill-on-surface-variant" font-size="5.5">of {{ rules.majority }} needed</text>
				</svg>

				<table class="w-full mt-4 text-xs">
					<thead>
						<tr class="text-3xs uppercase tracking-wider text-on-surface-variant border-b border-outline-variant/15">
							<th scope="col" class="text-left font-bold pb-2">Party</th>
							<th scope="col" class="text-right font-bold pb-2">Seats</th>
							<th scope="col" class="text-right font-bold pb-2">Vote</th>
							<th scope="col" class="text-right font-bold pb-2">Change</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-outline-variant/10">
						{% for party in parties %}
							<tr>
								<th scope="row" class="py-2 text-left font-normal">
									<span class="inline-flex items-center gap-2">
										<span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: {{ party.color }}" aria-hidden="true"></span>
										<span class="font-bold text-on-surface">{{ party.name }}</span>
										<span class="text-3xs uppercase tracking-wider text-on-surface-variant" title="{{ party.leadsBloc ? 'Leads a bloc as its largest party and rules out governing with the other leader' : 'Declared before the vote for the bloc whose centre it stands nearer' }}"><span class="inline-block w-1.5 h-1.5 rounded-full mr-0.5 align-middle" style="background-color: {{ party.blocColor }}" aria-hidden="true"></span>{{ party.leadsBloc ? 'Leads a bloc' : 'Backs ' ~ party.bloc }}</span>
										{% if party.governing %}<span class="text-3xs font-bold uppercase tracking-wider text-secondary">{{ government.caretaker ? 'Caretaker' : 'In government' }}</span>{% elseif party.supporting %}<span class="text-3xs font-bold uppercase tracking-wider text-primary">Supports</span>{% endif %}
									</span>
								</th>
								<td class="py-2 text-right font-mono tabular-nums text-on-surface">{{ party.seats }}</td>
								<td class="py-2 text-right font-mono tabular-nums text-on-surface">{{ (party.share * 100)|number_format(1) }}%</td>
								<td class="py-2 text-right font-mono tabular-nums {{ party.swing is null ? 'text-on-surface-variant' : (party.swing >= 0 ? 'text-secondary' : 'text-error') }}">
									{{- party.swing is null ? '-' : (party.swing >= 0 ? '+' : '') ~ (party.swing * 100)|number_format(1) ~ 'pp' -}}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</section>

			<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/15" aria-labelledby="compass-heading">
				<h2 id="compass-heading" class="text-sm font-bold text-on-surface">The parties</h2>
				<p class="text-3xs text-on-surface-variant mt-0.5">
					Each party is fixed on the question it was founded on. On the other two it strays between elections and is pulled back toward
					where it stood at the founding. The cabinet is joined by dashed lines; the diamond is its own position, its parties weighted by
					their seats. Faint trails are past positions. The strip beneath is the third question: how far to trust the Council's technocrats.
				</p>

				{% set w = compass.halfWidth %}
				{% set f = compass.fontSize %}
				<svg viewBox="{{ compass.viewBox|join(' ') }}" class="w-full mt-4 max-h-[28rem]" role="img" aria-label="Party positions: openness across and size of state up, and beneath them the Council axis, populist on the left and technocratic on the right">
					<rect x="{{ -w }}" y="{{ -w }}" width="{{ 2 * w }}" height="{{ 2 * w }}" fill="none" class="stroke-outline-variant" stroke-opacity="0.4" stroke-width="0.6"></rect>
					<line x1="{{ -w }}" y1="0" x2="{{ w }}" y2="0" class="stroke-outline-variant" stroke-opacity="0.6" stroke-width="0.6"></line>
					<line x1="0" y1="{{ -w }}" x2="0" y2="{{ w }}" class="stroke-outline-variant" stroke-opacity="0.6" stroke-width="0.6"></line>
					{% for axis in compass.axes %}
						<text x="{{ axis.x }}" y="{{ axis.y }}" text-anchor="{{ axis.anchor }}" font-size="{{ f }}" class="fill-on-surface-variant">{{ axis.text }}</text>
					{% endfor %}

					{% for party in compass.parties %}
						{% if party.trail|length > 1 %}
							<polyline points="{% for p in party.trail %}{{ p.x }},{{ p.y }} {% endfor %}" fill="none" stroke="{{ party.color }}" stroke-opacity="0.35" stroke-width="1.2"></polyline>
						{% endif %}
					{% endfor %}
					{% for link in compass.links %}
						<line x1="{{ link.x1 }}" y1="{{ link.y1 }}" x2="{{ link.x2 }}" y2="{{ link.y2 }}" class="stroke-on-surface" stroke-width="1" stroke-dasharray="3 2" stroke-opacity="0.7"></line>
					{% endfor %}
					{% for party in compass.parties %}
						<circle cx="{{ party.x }}" cy="{{ party.y }}" r="{{ party.r }}" fill="{{ party.color }}" fill-opacity="{{ party.governing ? 1 : 0.55 }}" class="stroke-surface" stroke-width="1"></circle>
					{% endfor %}
					{% for party in compass.parties %}
						<text x="{{ party.labelX }}" y="{{ party.labelY }}" text-anchor="{{ party.labelAnchor }}" font-size="{{ f }}" font-weight="bold" class="fill-on-surface">{{ party.label }}</text>
					{% endfor %}
					<rect x="{{ compass.government.x - 3.5 }}" y="{{ compass.government.y - 3.5 }}" width="7" height="7" transform="rotate(45 {{ compass.government.x }} {{ compass.government.y }})" class="fill-on-surface"></rect>

					<g transform="translate(0 {{ compass.stripY }})">
						<line x1="{{ -w }}" y1="0" x2="{{ w }}" y2="0" class="stroke-outline-variant" stroke-opacity="0.6" stroke-width="0.6"></line>
						<line x1="0" y1="-4" x2="0" y2="4" class="stroke-outline-variant" stroke-opacity="0.6" stroke-width="0.6"></line>
						{% for axis in compass.stripAxes %}
							<text x="{{ axis.x }}" y="{{ axis.y }}" text-anchor="{{ axis.anchor }}" font-size="{{ f }}" class="fill-on-surface-variant">{{ axis.text }}</text>
						{% endfor %}
						{% for party in compass.parties %}
							{% for x in party.councilTrail %}
								<circle cx="{{ x }}" cy="0" r="1.2" fill="{{ party.color }}" fill-opacity="0.25"></circle>
							{% endfor %}
						{% endfor %}
						{% for party in compass.parties %}
							<circle cx="{{ party.councilX }}" cy="0" r="{{ party.councilR }}" fill="{{ party.color }}" fill-opacity="{{ party.governing ? 1 : 0.55 }}" class="stroke-surface" stroke-width="1"></circle>
						{% endfor %}
						{% for party in compass.parties %}
							<text x="{{ party.stripLabelX }}" y="{{ party.stripLabelY }}" text-anchor="middle" font-size="{{ f }}" font-weight="bold" class="fill-on-surface">{{ party.label }}</text>
						{% endfor %}
						<rect x="{{ compass.government.councilX - 3 }}" y="-3" width="6" height="6" transform="rotate(45 {{ compass.government.councilX }} 0)" class="fill-on-surface"></rect>
					</g>
				</svg>

				<table class="w-full mt-3 text-xs">
					<caption class="sr-only">Party positions</caption>
					<thead>
						<tr class="text-3xs uppercase tracking-wider text-on-surface-variant border-b border-outline-variant/15">
							<th scope="col" class="text-left font-bold pb-2">Party</th>
							<th scope="col" class="text-right font-bold pb-2">Size of state</th>
							<th scope="col" class="text-right font-bold pb-2">Openness</th>
							<th scope="col" class="text-right font-bold pb-2">Council</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-outline-variant/10">
						{% for party in parties %}
							<tr>
								<th scope="row" class="py-1.5 text-left font-normal text-on-surface">{{ party.name }}</th>
								<td class="py-1.5 text-right font-mono tabular-nums {{ 'state' in party.fixedAxes ? 'text-on-surface font-bold' : 'text-on-surface-variant' }}">{{ (party.state >= 0 ? '+' : '') ~ party.state|number_format(2) }}</td>
								<td class="py-1.5 text-right font-mono tabular-nums {{ 'openness' in party.fixedAxes ? 'text-on-surface font-bold' : 'text-on-surface-variant' }}">{{ (party.openness >= 0 ? '+' : '') ~ party.openness|number_format(2) }}</td>
								<td class="py-1.5 text-right font-mono tabular-nums {{ 'council' in party.fixedAxes ? 'text-on-surface font-bold' : 'text-on-surface-variant' }}">{{ (party.council >= 0 ? '+' : '') ~ party.council|number_format(2) }}</td>
							</tr>
						{% endfor %}
						<tr>
							<th scope="row" class="py-1.5 text-left font-bold text-on-surface">Cabinet</th>
							<td class="py-1.5 text-right font-mono tabular-nums text-on-surface">{{ (government.state >= 0 ? '+' : '') ~ government.state|number_format(2) }}</td>
							<td class="py-1.5 text-right font-mono tabular-nums text-on-surface">{{ (government.openness >= 0 ? '+' : '') ~ government.openness|number_format(2) }}</td>
							<td class="py-1.5 text-right font-mono tabular-nums text-on-surface">{{ (government.council >= 0 ? '+' : '') ~ government.council|number_format(2) }}</td>
						</tr>
					</tbody>
				</table>
				<p class="text-3xs text-on-surface-variant mt-2">Bold is an axis a party is defined by and never leaves.</p>
			</section>
		</div>

		{# --- THE BUDGET: WHAT THE GOVERNMENT HAS ENACTED --- #}
		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/15" aria-labelledby="budget-heading">
			<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
				<div>
					<h2 id="budget-heading" class="text-sm font-bold text-on-surface">The budget</h2>
					<p class="text-3xs text-on-surface-variant mt-0.5">
						The cabinet legislates its platform at the budget rounds, every {{ rules.budgetRoundMonths|number_format(0) }} months, starting with the round after it takes office.
						A minority cabinet gets only what its supporters will vote for.
						Next round: <span class="font-mono tabular-nums">{{ budget.nextRound }}</span>{% if budget.lastBudget %} · last change <span class="font-mono tabular-nums">{{ budget.lastBudget }}</span>{% endif %}.
					</p>
				</div>
				<div class="shrink-0 rounded border px-3 py-2 {{ budget.braking ? 'border-error/40 bg-error/5' : 'border-outline-variant/20 bg-surface-container-lowest' }}">
					<p class="text-2xs font-bold uppercase tracking-wider {{ budget.braking ? 'text-error' : 'text-on-surface-variant' }}">Council debt brake {{ budget.braking ? 'on' : 'off' }}</p>
					<p class="text-3xs font-mono tabular-nums text-on-surface-variant mt-0.5">
						Debt {{ (budget.debt * 100)|number_format(1) }}% of GDP · line {{ (rules.debtBrake * 100)|number_format(0) }}%{% if budget.lastBrake %} · last held a bill {{ budget.lastBrake }}{% endif %}
					</p>
				</div>
			</div>

			<div class="overflow-x-auto mt-4">
				<table class="w-full text-xs">
					<thead>
						<tr class="text-3xs uppercase tracking-wider text-on-surface-variant border-b border-outline-variant/15">
							<th scope="col" class="text-left font-bold pb-2">Lever</th>
							<th scope="col" class="text-right font-bold pb-2">Platform</th>
							<th scope="col" class="text-right font-bold pb-2">In force</th>
							<th scope="col" class="text-left font-bold pb-2 pl-4">Status</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-outline-variant/10">
						{% for lever in budget.levers %}
							<tr>
								<th scope="row" class="py-2 text-left">
									<span class="font-bold text-on-surface">{{ lever.name }}</span>
									<span class="block text-3xs font-normal text-on-surface-variant">{{ lever.note }}</span>
								</th>
								<td class="py-2 text-right font-mono tabular-nums text-on-surface-variant">{{ _self.lever_value(lever, lever.platform) }}</td>
								<td class="py-2 text-right font-mono tabular-nums font-bold text-on-surface">{{ _self.lever_value(lever, lever.enacted) }}</td>
								<td class="py-2 pl-4 text-3xs">
									{% if lever.status == 'caretaker' %}
										<span class="font-bold text-on-surface-variant">Waits on the talks</span>
										<span class="block text-on-surface-variant">A caretaker cabinet passes no budget</span>
									{% elseif lever.status == 'held' %}
										<span class="font-bold text-error">Held by the Council</span>
										<span class="block text-on-surface-variant">A cut in revenue while debt is above the line</span>
									{% elseif lever.status == 'blocked' %}
										<span class="font-bold text-error">Blocked by its supporters</span>
										<span class="block text-on-surface-variant">They will not vote to move it further from their own policy</span>
									{% elseif lever.status == 'partial' %}
										<span class="font-bold text-primary">To {{ _self.lever_value(lever, lever.target) }} at the next budget</span>
										<span class="block text-on-surface-variant">As far as its supporters will go</span>
									{% elseif lever.status == 'pending' %}
										<span class="font-bold text-primary">At the next budget</span>
									{% else %}
										<span class="text-on-surface-variant">Enacted</span>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</section>

		{# --- THE COUNCIL --- #}
		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/15" aria-labelledby="council-heading">
			<h2 id="council-heading" class="text-sm font-bold text-on-surface">The Aerie Council</h2>
			<p class="text-3xs text-on-surface-variant mt-0.5">
				{{ rules.councilSeats }} seats on staggered {{ rules.councilTermYears|number_format(0) }}-year terms. When a term ends, the sitting members elect the successor.
			</p>

			<div class="grid grid-cols-1 lg:grid-cols-[1fr_22rem] gap-5 mt-4">
				<div class="overflow-x-auto">
					<table class="w-full text-xs">
						<thead>
							<tr class="text-3xs uppercase tracking-wider text-on-surface-variant border-b border-outline-variant/15">
								<th scope="col" class="text-right font-bold pb-2 w-10">Seat</th>
								<th scope="col" class="text-left font-bold pb-2 pl-4">Councillor</th>
								<th scope="col" class="text-left font-bold pb-2">Seated</th>
								<th scope="col" class="text-left font-bold pb-2">Term ends</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-outline-variant/10">
							{% for seat in council.roster %}
								<tr>
									<td class="py-1.5 text-right font-mono tabular-nums text-on-surface-variant">{{ seat.seat }}</td>
									<th scope="row" class="py-1.5 pl-4 text-left font-bold text-on-surface">{{ seat.name }}</th>
									<td class="py-1.5 text-on-surface-variant font-mono tabular-nums">{{ seat.sinceLabel }}</td>
									<td class="py-1.5 text-on-surface-variant font-mono tabular-nums {{ seat.seat == council.nextVacancy.seat ? 'text-primary font-bold' : '' }}">{{ seat.termEndsLabel }}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<div class="space-y-4">
					<div>
						<h3 class="text-xs font-bold text-on-surface">Departments</h3>
						<p class="text-3xs text-on-surface-variant mt-0.5">The Council appoints each head; the departments then act on their own mandates.</p>
						<ul class="mt-2 space-y-2">
							{% for department in council.departments %}
								<li class="text-xs">
									{% if department.href %}
										<a href="{{ department.href }}" class="font-bold text-primary hover:underline">{{ department.name }}</a>
									{% else %}
										<span class="font-bold text-on-surface">{{ department.name }}</span>
									{% endif %}
									<span class="block text-3xs text-on-surface-variant">{{ department.mandate }}</span>
								</li>
							{% endfor %}
						</ul>
					</div>
					<div>
						<h3 class="text-xs font-bold text-on-surface">Powers</h3>
						<ul class="mt-2 space-y-2 text-3xs text-on-surface-variant">
							<li><span class="font-bold text-on-surface">Veto.</span> The Council can veto any budget or law the Diet passes. It almost never does: the threat is enough. Its red line is the debt: above {{ (rules.debtBrake * 100)|number_format(0) }}% of GDP it would veto any bill that cuts revenue, so the Diet tables none.</li>
							<li><span class="font-bold text-on-surface">Removal.</span> The Diet can remove a councillor with {{ rules.supermajority }} of its {{ rules.seats }} seats, three quarters. It never has, and {{ rules.loyalists|join(', ') }} never would.</li>
							<li><span class="font-bold text-on-surface">Independence.</span> No party sits on the Council, and no councillor sits in the Diet. What passes between them runs on gentlemen's agreements.</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		{# --- ELECTION HISTORY --- #}
		<section class="bg-surface-container-low rounded-lg border border-outline-variant/15 overflow-hidden" aria-labelledby="history-heading">
			<div class="p-5 pb-3">
				<h2 id="history-heading" class="text-sm font-bold text-on-surface">Elections</h2>
				<p class="text-3xs text-on-surface-variant mt-0.5">Every vote on record, newest first, with the economy it was cast on and the government the talks produced.</p>
			</div>
			{% if history is empty %}
				<p class="px-5 pb-5 text-xs text-on-surface-variant">No election has been held yet. The founding Diet sits until {{ election.next }}.</p>
			{% else %}
				<div class="overflow-x-auto">
					<table class="w-full text-xs">
						<thead class="bg-surface-container text-3xs uppercase tracking-wider text-on-surface-variant">
							<tr>
								<th scope="col" class="px-5 py-2.5 text-left font-bold">Held</th>
								{% for party in parties %}
									<th scope="col" class="px-3 py-2.5 text-right font-bold" title="{{ party.name }}"><span class="inline-block w-2 h-2 rounded-full mr-1" style="background-color: {{ party.color }}" aria-hidden="true"></span>{{ party.label }}</th>
								{% endfor %}
								<th scope="col" class="px-3 py-2.5 text-left font-bold">Government</th>
								<th scope="col" class="px-3 py-2.5 text-right font-bold hidden md:table-cell" title="The outgoing government's change in combined vote share">Incumbent swing</th>
								<th scope="col" class="px-3 py-2.5 text-right font-bold hidden md:table-cell" title="Growth over the campaign against trend, and inflation over the term against target">Growth / inflation</th>
								<th scope="col" class="px-5 py-2.5 text-right font-bold hidden sm:table-cell" title="Pedersen index: the share of voters who changed party, net">Volatility</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-outline-variant/10">
							{% for row in history %}
								<tr>
									<th scope="row" class="px-5 py-2 text-left font-mono tabular-nums font-normal text-on-surface">
										{{ row.date }}
									</th>
									{% for cell in row.seats %}
										<td class="px-3 py-2 text-right font-mono tabular-nums text-on-surface">
											{{ cell.seats }}
											<span class="block text-3xs {{ cell.swing >= 0 ? 'text-secondary' : 'text-error' }}">{{ (cell.swing >= 0 ? '+' : '') ~ (cell.swing * 100)|number_format(1) }}</span>
										</td>
									{% endfor %}
									<td class="px-3 py-2">
										{% if not row.formed %}
											<span class="text-3xs font-bold uppercase tracking-wider text-primary">Talks under way</span>
										{% else %}
											<span class="flex flex-wrap gap-x-2 gap-y-0.5">
												{% for member in row.coalition %}
													<span class="inline-flex items-center gap-1 text-on-surface"><span class="w-2 h-2 rounded-full" style="background-color: {{ member.color }}" aria-hidden="true"></span>{{ member.name }}</span>
												{% endfor %}
											</span>
											{% if row.support is not empty %}
												<span class="block text-3xs text-on-surface-variant">Supported by {% for member in row.support %}{{ member.name }}{{ not loop.last ? ', ' : '' }}{% endfor %}</span>
											{% endif %}
											<span class="block text-3xs font-mono tabular-nums text-on-surface-variant">
												{%- if row.attempts == 0 %}A majority of its own{% else %}{{ row.formationDays|number_format(0) }} days, {{ row.attempts }} {{ row.attempts == 1 ? 'attempt' : 'attempts' }}{% endif -%}
											</span>
											{% if row.changed %}<span class="text-3xs font-bold uppercase tracking-wider text-primary">New government</span>{% endif %}
											{% for fall in row.falls %}
												<span class="block mt-1 pt-1 border-t border-outline-variant/15">
													<span class="block text-3xs font-bold uppercase tracking-wider text-error">Fell {{ fall.date }}</span>
													{% if not fall.formed %}
														<span class="text-3xs font-bold uppercase tracking-wider text-primary">Talks under way</span>
													{% else %}
														<span class="flex flex-wrap gap-x-2 gap-y-0.5">
															{% for member in fall.coalition %}
																<span class="inline-flex items-center gap-1 text-on-surface"><span class="w-2 h-2 rounded-full" style="background-color: {{ member.color }}" aria-hidden="true"></span>{{ member.name }}</span>
															{% endfor %}
														</span>
														{% if fall.support is not empty %}
															<span class="block text-3xs text-on-surface-variant">Supported by {% for member in fall.support %}{{ member.name }}{{ not loop.last ? ', ' : '' }}{% endfor %}</span>
														{% endif %}
														<span class="block text-3xs font-mono tabular-nums text-on-surface-variant">{{ fall.formationDays|number_format(0) }} days, {{ fall.attempts }} {{ fall.attempts == 1 ? 'attempt' : 'attempts' }}</span>
													{% endif %}
												</span>
											{% endfor %}
										{% endif %}
									</td>
									<td class="px-3 py-2 text-right font-mono tabular-nums hidden md:table-cell {{ row.incumbentSwing >= 0 ? 'text-secondary' : 'text-error' }}">{{ (row.incumbentSwing >= 0 ? '+' : '') ~ (row.incumbentSwing * 100)|number_format(1) }}pp</td>
									<td class="px-3 py-2 text-right font-mono tabular-nums text-on-surface-variant hidden md:table-cell">{{ (row.growthGap >= 0 ? '+' : '') ~ (row.growthGap * 100)|number_format(1) }} / {{ (row.inflationGap >= 0 ? '+' : '') ~ (row.inflationGap * 100)|number_format(1) }}</td>
									<td class="px-5 py-2 text-right font-mono tabular-nums text-on-surface-variant hidden sm:table-cell">{{ (row.volatility * 100)|number_format(1) }}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}
		</section>

		{# --- HOW THE DIET IS ELECTED --- #}
		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/15" aria-labelledby="rules-heading">
			<h2 id="rules-heading" class="text-sm font-bold text-on-surface">How the Diet is elected</h2>
			<p class="text-3xs text-on-surface-variant mt-0.5">Every rule the vote runs on, and the evidence it is taken from.</p>

			{% set rules_list = [
				{
					name: 'The economic vote',
					text: 'The governing parties lose ' ~ rules.inflationSlope|number_format(2) ~ ' points of the vote for each point of inflation above target over the term. A party governing alone also gains ' ~ rules.growthSlope|number_format(2) ~ ' points for each point of growth above trend over the final ' ~ rules.campaignMonths|number_format(0) ~ ' months; a coalition gets no credit for growth, as voters cannot tell which partner earned it. Everything else voters weigh moves the result by about ' ~ (rules.residual * 100)|number_format(1) ~ ' points either way.',
					source: 'Votes in 21 proportional-representation democracies since 1971 (ParlGov, World Bank); Powell & Whitten (1993) on clarity of responsibility; Fair (2020) for the residual'
				},
				{
					name: 'The cost of ruling',
					text: 'Governing costs the governing parties ' ~ (rules.costOfRuling * 100)|number_format(1) ~ ' points of the vote each term, whatever the economy did. They are seen to lose more: governments are formed by the parties riding a good vote, a short-term swing that runs off by the next or a lasting lead that drifts back. With both, the Diet\'s governing parties lose about what real ones have, ' ~ (rules.recordedCostOfRuling * 100)|number_format(2) ~ ' points a term.',
					source: 'Nannestad & Paldam (2002): 282 elections in 19 democracies'
				},
				{
					name: 'Who gains',
					text: 'What the governing parties lose, the opposition gains, each party in proportion to its own vote. A party that supports a minority cabinet from outside shares ' ~ (rules.supportAccountability * 100)|number_format(0) ~ '% of the government\'s fortunes: voters hold it to account, though less than the cabinet\'s own parties.',
					source: 'Proportional swing; Thürk & Klüver (2024): support parties lose 2.0 points at the next election against 2.8 for cabinet parties, 304 elections in 31 democracies'
				},
				{
					name: 'Short-term forces',
					text: 'Each party also has a swing of its own at every vote: its candidates, its campaign, its scandals. It does not carry into the next vote. Small parties swing more, as real ones do: about ' ~ (rules.shortSwingQuarter * 100)|number_format(0) ~ '% of the vote of a party with a quarter of it, ' ~ (rules.shortSwingTwentieth * 100)|number_format(0) ~ '% of one with a twentieth.',
					source: 'Converse (1966) on short-term forces; ParlGov, Nordic parliaments since 1945: vote shares vary in proportion to their size'
				},
				{
					name: 'The normal vote',
					text: 'Each party has a normal vote, the share it won at the founding. Its lasting support strays from it, with a new generation of voters or a realignment, and drifts back, half the gap closing in about ' ~ rules.normalVoteHalfLifeYears|number_format(0) ~ ' years. The Diet\'s parties stray as far from their normal votes as the Nordic parties have from theirs, so no party is doomed to fade and none grows without end.',
					source: 'Converse (1966) on the normal vote; ParlGov, Denmark, Finland, Iceland, Norway and Sweden since 1945'
				},
				{
					name: 'Seats',
					text: rules.seats ~ ' seats, allocated by the D\'Hondt method over the whole District.',
					source: 'D\'Hondt highest averages'
				},
				{
					name: 'Party positions',
					text: 'A party never moves on the question it was founded on. On the other two it moves between elections by as much as real parties revise their manifestos.',
					source: 'Somer-Topcu (2009): 10 to 16 points on the 200-point left-right scale per election'
				}
			] %}
			{{ _self.rules_table(rules_list) }}
		</section>

		{# --- HOW GOVERNMENTS FORM --- #}
		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/15" aria-labelledby="formation-heading">
			<h2 id="formation-heading" class="text-sm font-bold text-on-surface">How governments form</h2>
			<p class="text-3xs text-on-surface-variant mt-0.5">No party ever has a red line written for it: who will govern with whom comes out of where the parties stand.</p>

			{% set formation_list = [
				{
					name: 'Which cabinet',
					text: 'A party with ' ~ rules.majority ~ ' seats of its own governs alone. Otherwise every cabinet the Diet could seat is weighed as real ones have been chosen, a minority cabinet with the support parties that would carry it. Holding the Diet\'s largest party adds ' ~ rules.largestPartyUtility|number_format(2) ~ ' to its odds on the log scale, needing every member for the majority ' ~ rules.minimalWinningUtility|number_format(2) ~ ', being the outgoing cabinet ' ~ rules.statusQuoUtility|number_format(2) ~ '; each party in it costs ' ~ (-rules.partyUtility)|number_format(2) ~ ', lacking a majority ' ~ (-rules.minorityUtility)|number_format(2) ~ ', and each unit of distance between the two furthest parties of its majority, supporters included ' ~ (-rules.rangeUtility)|number_format(2) ~ '. A random draw on every cabinet stands for everything else that sways the talks.',
					source: 'Martin & Stevenson (2010), Table 1: 256 formations in 17 West European democracies, a unit read as ' ~ rules.manifestoPointsPerUnit|number_format(0) ~ ' points of their left-right scale, fitted so a third of cabinets are minority cabinets, as in Western Europe since 1945 (ParlGov); Benoit & Laver (2007) put it at 30'
				},
				{
					name: 'Blocs',
					text: 'The Diet votes in two blocs. Before each vote every party declares for the bloc whose centre stands nearer on the economic questions, the size of the state and openness: a bloc\'s centre is its parties\' positions weighted by their seats, where a government of the bloc would set policy. The declarations start from the blocs of the last vote and are counted again until no party would change sides, so a party that drifts across changes sides, and a party whose platform moves far enough can take its bloc with it; the Council question cuts across both. Each bloc is led by its largest party going into the vote, now ' ~ rules.blocLeaders|join(' and ') ~ ', rivals for the premiership who rule out governing together. A cabinet of one bloc\'s parties is a pact, ' ~ rules.pactUtility|number_format(2) ~ ' on the log scale; one holding both leaders is ruled out, ' ~ rules.antipactUtility|number_format(2) ~ ', and neither leader will support the other\'s cabinet from outside.',
					source: 'Martin & Stevenson (2010), Table 1: pre-electoral pacts and anti-pacts; the red and blue blocs of Denmark, Sweden and Norway; Lloyd (1982): two-means'
				},
				{
					name: 'The firewall',
					text: 'The Council axis asks about the constitutional order itself. Each unit a cabinet party stands from the Diet\'s middle on it costs ' ~ (-rules.antisystemUtility)|number_format(2) ~ ' on the log scale, so the parties at its ends seldom enter a cabinet and usually support one from outside instead. A party that moves toward the middle becomes a partner again. The cost falls on both ends: a party that would make the Diet answer to the Council is as hard to govern with as one that would tear the Council down.',
					source: 'Martin & Stevenson (2010): anti-system parties in coalition; the strength fitted so the axis\'s ends sit in cabinet as seldom as Scandinavia\'s radical parties since 1945 (ParlGov: 4 in 70). On the populist side, real parties govern less the more anti-elite they are (Chapel Hill expert survey, 2014-2024); the technocratic side is the District\'s own'
				},
				{
					name: 'Who leads',
					text: 'Each attempt tries one cabinet, drawn by those odds, and its largest party leads the talks for it. So the Diet\'s largest party leads most attempts, but not when the cabinet likeliest to form leaves it out.',
					source: 'Diermeier & Merlo (2004): no evidence that the lead passes down the parties in order of size'
				},
				{
					name: 'Talks that fail',
					text: 'An attempt succeeds only if its cabinet clears the bar of no deal at all, ' ~ rules.reservation|number_format(2) ~ ' on the same scale; otherwise the talks try again, and each failure lowers the bar by ' ~ rules.reservationStep|number_format(2) ~ ' as patience runs out. An attempt lasts ' ~ rules.attemptDays|number_format(0) ~ ' days on average, drawn at random, and talks average ' ~ rules.formationMeanDays|number_format(0) ~ ' days.',
					source: 'Fitted to Golder (2010): nearly a third of formations need more than one attempt; and Bäck, Hellström, Lindvall & Teorell (2023): 34 days on average, with a spread about as wide, which is what sets how fast the bar falls'
				},
				{
					name: 'Support parties',
					text: 'A minority cabinet\'s supporters are the parties outside it that give it a majority, each of them needed, spanning the narrowest range with it, and never a party that ruled out governing with one of its parties. The cabinet proposes the budget and each supporter accepts only a lever that is no further from its own policy than the one in force. A supporter can stop the cabinet moving policy away from it, but cannot pull policy its way.',
					source: 'de Swaan (1973); Romer & Rosenthal (1978), the agenda setter and the veto player'
				},
				{
					name: 'The caretaker',
					text: 'Until the talks produce a government, the outgoing cabinet stays on and passes no budget, and the policy uncertainty that built into the vote stays at its peak.',
					source: 'Caretaker conventions; Bernhard & Leblang (2006): returns fall and volatility rises through cabinet formations markets cannot call'
				},
				{
					name: 'When a cabinet falls',
					text: 'Between votes a cabinet can lose the Diet: a partner walks out, or its supporters stop voting its budgets. Over a term, a single-party minority cabinet falls ' ~ (rules.fallSingleMinority * 100)|number_format(0) ~ '% of the time, a minority coalition ' ~ (rules.fallMinorityCoalition * 100)|number_format(0) ~ '%, and a majority coalition ' ~ (rules.fallMajorityCoalition * 100)|number_format(0) ~ '%; a party governing alone with its own majority has no one to lose. No election is called, since the Diet sits its fixed term: the fallen cabinet stays on as caretaker and the parties talk again on the seats they hold, for any cabinet but the one that fell.',
					source: 'ParlGov, West European cabinets since 1945: cabinets replaced without an election (var/harness/politics/termination_fit.py); King, Alt, Burns & Laver (1990), a constant hazard; Norway, whose Storting cannot be dissolved'
				}
			] %}
			{{ _self.rules_table(formation_list) }}
		</section>

		{# --- HOW THE DIET LEGISLATES --- #}
		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/15" aria-labelledby="levers-heading">
			<h2 id="levers-heading" class="text-sm font-bold text-on-surface">How the Diet legislates</h2>
			<p class="text-3xs text-on-surface-variant mt-0.5">Each party at the end of an axis stands for a policy real parties have enacted; a cabinet sits between them, where its members' seats put it.</p>

			{% set levers_list = [
				{
					name: 'Corporate tax',
					text: 'The Civic Front\'s manifesto rate is ' ~ (rules.manifestoTaxGap * 100)|number_format(0) ~ ' points above the Vanguard\'s, centred on ' ~ (rules.neutralTaxRate * 100)|number_format(0) ~ '%. A cabinet legislates its place between them. The change is levied on corporate profits, ' ~ (rules.profitsToGdp * 100)|number_format(1) ~ '% of GDP, so a point on the rate is about a tenth of a point of GDP in revenue. Firms pay it on their earnings, and a cut lifts demand as corporate tax cuts have.',
					source: 'US 2020 Democratic platform 28% vs the 2017 act\'s 21%; UK 2019 Labour 26% vs Conservatives 19%; Osterloh & Debus (2012); Mertens & Ravn (2013); BEA corporate profits 1985-2019'
				},
				{
					name: 'Spending',
					text: 'Neither side moves government purchases. In the US record the District\'s purchases are fitted to, the party in power shifted civilian purchases the wrong way. In Europe\'s parliaments, left cabinets held government consumption higher before 1990, but since then a cabinet\'s economic stance has moved neither its consumption nor its total spending.',
					source: 'Engine fit on US civilian purchases 1985-2019 (var/harness/partisan_fit.py); 21 European PR democracies 1971-2020, ParlGov cabinets and World Bank government consumption (var/harness/politics/spend_europe_fit.py); Potrafke (2017), about 100 OECD panel studies'
				},
				{
					name: 'Tariffs',
					text: 'The Iron Harbor Coalition\'s platform raises the average tariff by ' ~ (rules.protectionistTariff * 100)|number_format(1) ~ ' points over the free port; an open cabinet levies none. The duty passes into import prices in full, imports fall with their price, and trading partners answer with ' ~ (rules.retaliation * 100)|number_format(0) ~ '% of it on the District\'s civilian exports. Each point of tariff costs about ' ~ (rules.tariffOutputLoss)|number_format(2) ~ '% of output through productivity over the following years.',
					source: 'Yale Budget Lab (2025): the US rise from 2.5% to 17.9%; Amiti, Redding & Weinstein (2019); Fajgelbaum, Goldberg, Kennedy & Khandelwal (2020); Furceri, Hannan, Ostry & Rose (2018)'
				},
				{
					name: 'Immigration',
					text: 'A closed regime admits ' ~ (rules.migrationClosed * 100)|number_format(2) ~ '% of the population a year, an open one ' ~ (rules.migrationOpen * 100)|number_format(2) ~ '%. The District opens between them, with its labour force growing ' ~ (rules.structuralLaborGrowth * 100)|number_format(2) ~ '% a year. Faster labour growth raises potential output and the natural rate of interest, and every point of population it adds raises house prices ' ~ rules.housingElasticity|number_format(0) ~ '%.',
					source: 'World Bank net migration 2000-2019: Japan (closed), Canada and Australia (open); Holston, Laubach & Williams (2017); Saiz (2007)'
				},
				{
					name: 'Merger review',
					text: 'The Common Lot\'s review blocks a merger that adds more than ' ~ (rules.strictReviewDelta * 10000)|number_format(0) ~ ' points to a market\'s HHI and leaves it above ' ~ (rules.strictReviewLine * 10000)|number_format(0) ~ ', or makes a firm of more than ' ~ (rules.strictReviewShare * 100)|number_format(0) ~ '% of its market; the Chartists\' lets through all but a deal adding ' ~ (rules.lenientReviewDelta * 10000)|number_format(0) ~ ' points in a market above ' ~ (rules.lenientReviewLine * 10000)|number_format(0) ~ ', with no test of share. A cabinet reviews between them, where its place on the Council axis puts it. The line caps how much of its market a firm can buy.',
					source: 'US Merger Guidelines (2023), the populist turn in antitrust; US Horizontal Merger Guidelines (2010); Philadelphia National Bank (1963)'
				},
				{
					name: 'The Council\'s brake',
					text: 'Above ' ~ (rules.debtBrake * 100)|number_format(0) ~ '% of GDP in debt, the Council would veto any bill that cuts revenue: a lower tax rate or a lower tariff. The Diet knows it and tables none, so the veto is never cast and the lever stays where it stands. A government whose cabinet and supporters hold three quarters of the Diet, enough to remove councillors, is not held; the Council\'s loyalists do not count toward it.',
					source: 'Romer & Rosenthal (1978), the agenda setter and the veto player; Reinhart & Rogoff (2010), the 90% line'
				}
			] %}
			{{ _self.rules_table(levers_list) }}
		</section>
	</div>
{% endblock %}

{% macro lever_value(lever, value) %}{{ (lever.unit ?? '') == 'hhi' ? (value * 10000)|number_format(0) ~ ' HHI' : (value * 100)|number_format(2) ~ '%' }}{% endmacro %}

{% macro rules_table(rules_list) %}
			<dl class="mt-4 divide-y divide-outline-variant/10">
				{% for rule in rules_list %}
					<div class="py-3 grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-1 md:gap-4">
						<dt class="text-xs font-bold text-on-surface">{{ rule.name }}</dt>
						<dd class="text-xs text-on-surface-variant">
							{{ rule.text }}
							<span class="block text-3xs font-mono text-primary/80 mt-1">{{ rule.source }}</span>
						</dd>
					</div>
				{% endfor %}
			</dl>
{% endmacro %}
