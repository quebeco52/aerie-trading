{% extends 'base.html.twig' %}

{% block title %}The election - Aerie Exchange{% endblock %}

{% block meta %}
	<meta name="description" content="The Aerie District's next election: the polls since the last vote, the market's odds on the next government, and the laws it would pass.">
	<meta property="og:title" content="The election | Aerie Exchange">
	<meta property="og:type" content="website">
{% endblock %}

{% import 'partials/_ui.html.twig' as ui %}
{% import 'government/_macros.html.twig' as gov %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5" id="electionPage">

		{% embed 'government/_header.html.twig' with {title: 'The election'} %}{% block lead %}The Diet is next elected on {{ election.next }}{{ election.campaign ? ', and the campaign is under way' : '' }}. What the polls say, and what traders expect the vote to bring.{% endblock %}{% endembed %}

		{% if polls %}
			<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="polls-heading">
				<h2 id="polls-heading" class="text-sm font-semibold text-on-surface">The polls</h2>
				<p class="text-2xs text-on-surface-variant mt-0.5">
					How the District says it would vote, polled every month since the vote of {{ polls.since }}; the latest poll is from {{ polls.latest }}.
					Each poll is a sample, a point or two off the truth either way, so the line is the traders' average of them, which weighs each new poll against those before it.
					The shaded band is where a party's support lies 19 times in 20; the dots are the polls.
				</p>
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mt-4">
					<svg viewBox="0 0 600 210" class="w-full lg:col-span-2" role="img" aria-label="Poll average since the vote of {{ polls.since }}: {% for party in polls.parties %}{{ party.name }} {{ party.average|pct(1) }}{{ not loop.last ? ', ' : '' }}{% endfor %}">
						{% for line in polls.gridlines %}
							<line x1="{{ polls.plot[0] }}" y1="{{ line.y }}" x2="{{ polls.plot[1] }}" y2="{{ line.y }}" class="stroke-outline-variant" stroke-opacity="{{ loop.first ? 1 : 0.3 }}" stroke-dasharray="{{ loop.first ? '' : '2 3' }}" stroke-width="{{ loop.first ? 1 : 0.6 }}"></line>
							<text x="{{ polls.plot[0] - 5 }}" y="{{ line.y + 3 }}" text-anchor="end" font-size="8" class="fill-on-surface-variant">{{ line.label }}</text>
						{% endfor %}
						{% for year in polls.years %}
							<line x1="{{ year.x }}" y1="{{ polls.plot[3] }}" x2="{{ year.x }}" y2="{{ polls.plot[3] + 4 }}" class="stroke-outline-variant" stroke-width="0.8"></line>
							<text x="{{ year.x }}" y="{{ polls.plot[3] + 15 }}" text-anchor="{{ loop.first ? 'start' : (loop.last ? 'end' : 'middle') }}" font-size="8" class="fill-on-surface-variant">{{ year.label }}</text>
						{% endfor %}
						<line x1="{{ polls.today }}" y1="{{ polls.plot[2] }}" x2="{{ polls.today }}" y2="{{ polls.plot[3] }}" class="stroke-outline-variant" stroke-width="0.8" stroke-dasharray="1.5 2"><title>The latest poll</title></line>
						{% for party in polls.parties|reverse %}
							<polygon points="{{ party.band }}" fill="{{ party.color }}" fill-opacity="0.12" stroke="none"></polygon>
						{% endfor %}
						{% for party in polls.parties|reverse %}
							{% for dot in party.dots %}
								<circle cx="{{ dot.x }}" cy="{{ dot.y }}" r="1.3" fill="{{ party.color }}" fill-opacity="0.45"></circle>
							{% endfor %}
						{% endfor %}
						{% for party in polls.parties|reverse %}
							<polyline points="{{ party.line }}" fill="none" stroke="{{ party.color }}" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><title>{{ party.name }}</title></polyline>
							<circle cx="{{ party.last.x }}" cy="{{ party.last.y }}" r="2.4" fill="{{ party.color }}"><title>{{ party.name }}: average {{ party.average|pct(1) }}, latest poll {{ party.poll|pct(1) }}</title></circle>
						{% endfor %}
					</svg>
					<div>
						<table class="w-full text-xs">
							<thead>
								<tr class="table-head">
									<th scope="col" class="text-left font-semibold pb-2">Party</th>
									<th scope="col" class="text-right font-semibold pb-2" title="The traders' average of the polls">Average</th>
									<th scope="col" class="text-right font-semibold pb-2" title="Support lies this close to the average 19 times in 20">Margin</th>
									<th scope="col" class="text-right font-semibold pb-2" title="The average against the last vote">Change</th>
									<th scope="col" class="text-right font-semibold pb-2" title="{{ polls.marketSeats ? 'Seats the traders expect each party to win at the vote' : 'Seats the average would win' }}">Seats</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-outline-variant/10">
								{% for party in polls.parties %}
									<tr>
										<th scope="row" class="py-1.5 text-left font-normal"><span class="inline-flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: {{ party.color }}" aria-hidden="true"></span><span class="font-semibold text-on-surface">{{ party.name }}</span></span></th>
										<td class="py-1.5 text-right font-mono tabular-nums text-on-surface" title="Latest poll {{ party.poll|pct(1) }}">{{ party.average|pct(1) }}</td>
										<td class="py-1.5 text-right font-mono tabular-nums text-on-surface-variant">±{{ party.margin|pct(1) }}</td>
										<td class="py-1.5 text-right font-mono tabular-nums {{ party.change|signed_class }}">{{ (party.change > 0 ? '+' : '') ~ (party.change * 100)|number_format(1) }}pp</td>
										<td class="py-1.5 text-right font-mono tabular-nums text-on-surface">{{ party.seats }}</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
						<p class="text-2xs text-on-surface-variant mt-3">
							{{ polls.marketSeats ? 'Traders expect' : 'On the poll average' }} the {{ government.caretaker ? 'caretaker cabinet' : 'cabinet' }}'s parties {{ polls.marketSeats ? 'to win' : 'would win' }} <span class="font-semibold font-mono tabular-nums text-on-surface">{{ polls.cabinet.seats }}</span> of {{ rules.seats }} seats{% if polls.cabinet.hasSupport %}, <span class="font-mono tabular-nums">{{ polls.cabinet.supportedSeats }}</span> with their supporters{% endif %}{{ polls.marketSeats ? ' at the vote' : '' }}. {{ rules.majority }} make a majority.
						</p>
					</div>
				</div>
			</section>
		{% endif %}

		{% if market %}
			<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" aria-labelledby="market-heading">
				<h2 id="market-heading" class="text-sm font-semibold text-on-surface">What the market expects</h2>
				<p class="text-2xs text-on-surface-variant mt-0.5">
					{% if market.talks %}
						Traders' odds on the government the talks will produce, and the laws it would pass at its first budget, {{ market.takesEffect }}.
					{% else %}
						Traders' odds on the government the vote of {{ market.vote }} will seat, read from the polls, and the laws they expect at its first budget, {{ market.takesEffect }}.
					{% endif %}
					Share prices carry them: a firm is valued on the taxes it expects to pay, a bank on the levy it expects to owe, a miner or driller on the extraction rules it expects to work under, a broker on the trading the stamp duty will leave it, and a power producer on what the carbon price will add to the price of power, not only on what each pays or earns today.
				</p>
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-4">
					<div>
						<h3 class="text-xs font-semibold text-on-surface">Leads the next government</h3>
						<ul class="mt-2 space-y-2">
							{% for leader in market.leaders %}
								<li class="text-xs">
									<div class="flex justify-between gap-3"><span class="inline-flex items-center gap-2 text-on-surface"><span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: {{ leader.color }}" aria-hidden="true"></span>{{ leader.name }}</span><span class="font-mono tabular-nums text-on-surface">{{ leader.chance|pct(0) }}</span></div>
									<div class="h-1.5 rounded-full bg-surface-container-high mt-1" aria-hidden="true"><div class="h-1.5 rounded-full" style="width: {{ (leader.chance * 100)|number_format(1, '.', '') }}%; background-color: {{ leader.color }}"></div></div>
								</li>
							{% endfor %}
						</ul>
					</div>
					<div>
						<h3 class="text-xs font-semibold text-on-surface">Likeliest governments</h3>
						<ol class="mt-2 divide-y divide-outline-variant/10">
							{% for option in market.cabinets %}
								<li class="py-1.5 text-xs flex justify-between gap-3">
									<span class="text-on-surface">{{ option.cabinet|join(', ') }}{% if option.support is not empty %}<span class="block text-2xs text-on-surface-variant">Supported by {{ option.support|join(', ') }}</span>{% endif %}</span>
									<span class="font-mono tabular-nums text-on-surface shrink-0">{{ option.chance|pct(0) }}</span>
								</li>
							{% endfor %}
						</ol>
					</div>
					<div>
						<h3 class="text-xs font-semibold text-on-surface">Laws to expect</h3>
						<table class="w-full text-xs mt-2">
							<thead>
								<tr class="table-head">
									<th scope="col" class="text-left font-semibold pb-2">Law</th>
									<th scope="col" class="text-right font-semibold pb-2">In force</th>
									<th scope="col" class="text-right font-semibold pb-2">Expected</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-outline-variant/10">
								{% for lever in market.levers %}
									<tr>
										<th scope="row" class="py-1.5 text-left font-normal text-on-surface">{{ lever.name }}</th>
										<td class="py-1.5 text-right font-mono tabular-nums text-on-surface-variant">{{ gov.lever_value(lever, lever.enacted) }}</td>
										<td class="py-1.5 text-right font-mono tabular-nums {{ lever.moves ? 'font-semibold text-on-surface' : 'text-on-surface-variant' }}">{{ gov.lever_value(lever, lever.expected) }}</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
				{% if odds %}
					<figure class="mt-5">
						<figcaption>
							<h3 class="text-xs font-semibold text-on-surface">How the odds have moved</h3>
							<p class="text-2xs text-on-surface-variant mt-0.5">Each party's chance of leading the next government as traders priced it, poll by poll since {{ odds.since }}{% if odds.vote %}, up to the vote of {{ odds.vote.date }}{% endif %}.</p>
						</figcaption>
						<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mt-2">
							<svg viewBox="0 0 600 160" class="w-full lg:col-span-2" role="img" aria-label="Chance of leading the next government since {{ odds.since }}: {% for party in odds.parties %}{{ party.name }} {{ party.chance|pct(0) }}{{ not loop.last ? ', ' : '' }}{% endfor %}">
								{% for line in odds.gridlines %}
									<line x1="{{ odds.plot[0] }}" y1="{{ line.y }}" x2="{{ odds.plot[1] }}" y2="{{ line.y }}" class="stroke-outline-variant" stroke-opacity="{{ loop.first ? 1 : 0.3 }}" stroke-dasharray="{{ loop.first ? '' : '2 3' }}" stroke-width="{{ loop.first ? 1 : 0.6 }}"></line>
									<text x="{{ odds.plot[0] - 5 }}" y="{{ line.y + 3 }}" text-anchor="end" font-size="8" class="fill-on-surface-variant">{{ line.label }}</text>
								{% endfor %}
								{% for year in odds.years %}
									<line x1="{{ year.x }}" y1="{{ odds.plot[3] }}" x2="{{ year.x }}" y2="{{ odds.plot[3] + 4 }}" class="stroke-outline-variant" stroke-width="0.8"></line>
									<text x="{{ year.x }}" y="{{ odds.plot[3] + 15 }}" text-anchor="{{ year.x > odds.plot[1] - 20 ? 'end' : (year.x < odds.plot[0] + 20 ? 'start' : 'middle') }}" font-size="8" class="fill-on-surface-variant">{{ year.label }}</text>
								{% endfor %}
								<line x1="{{ odds.today }}" y1="{{ odds.plot[2] }}" x2="{{ odds.today }}" y2="{{ odds.plot[3] }}" class="stroke-outline-variant" stroke-width="0.8" stroke-dasharray="1.5 2"><title>Today</title></line>
								{% if odds.vote %}
									<line x1="{{ odds.vote.x }}" y1="{{ odds.plot[2] }}" x2="{{ odds.vote.x }}" y2="{{ odds.plot[3] }}" class="stroke-on-surface-variant" stroke-width="0.8" stroke-dasharray="3 2"><title>The vote, {{ odds.vote.date }}</title></line>
								{% endif %}
								{% for party in odds.parties|reverse %}
									<polyline points="{{ party.line }}" fill="none" stroke="{{ party.color }}" stroke-width="1.6" stroke-linejoin="round"><title>{{ party.name }}</title></polyline>
									<circle cx="{{ party.last.x }}" cy="{{ party.last.y }}" r="2.4" fill="{{ party.color }}"><title>{{ party.name }}: {{ party.chance|pct(0) }}, from {{ party.first|pct(0) }} at the first forecast</title></circle>
								{% endfor %}
							</svg>
							<table class="w-full text-xs self-start">
								<thead>
									<tr class="table-head">
										<th scope="col" class="text-left font-semibold pb-2">Party</th>
										<th scope="col" class="text-right font-semibold pb-2" title="At the first forecast of this vote">{{ odds.since }}</th>
										<th scope="col" class="text-right font-semibold pb-2">Now</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-outline-variant/10">
									{% for party in odds.parties %}
										<tr>
											<th scope="row" class="py-1.5 text-left font-normal"><span class="inline-flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: {{ party.color }}" aria-hidden="true"></span><span class="text-on-surface">{{ party.name }}</span></span></th>
											<td class="py-1.5 text-right font-mono tabular-nums text-on-surface-variant">{{ party.first|pct(0) }}</td>
											<td class="py-1.5 text-right font-mono tabular-nums text-on-surface">{{ party.chance|pct(0) }}</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</figure>
				{% endif %}
			</section>
		{% endif %}
	</div>
{% endblock %}
