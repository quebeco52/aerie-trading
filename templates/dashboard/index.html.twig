{% extends 'base.html.twig' %}

{% block title %}My Portfolio | Aerie Exchange{% endblock %}

{% block body %}
    <div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-6">

        <header class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-end pb-6 border-b border-outline-variant/15">
            <div class="lg:col-span-7">
                <p class="text-sm text-on-surface-variant">Portfolio value</p>
                <div class="mt-1 flex flex-wrap items-baseline gap-x-4 gap-y-1">
                    <h1 id="portfolio-total-value" class="text-3xl sm:text-4xl font-semibold tracking-tight text-on-surface font-mono tabular-nums transition-colors duration-300">
                        ${{ portfolioValue|number_format(2) }}
                    </h1>
                    <p class="text-sm font-mono tabular-nums">
                        <span id="portfolio-pnl-badge" class="font-semibold {{ totalUnrealizedPnL >= 0 ? 'text-secondary' : 'text-tertiary' }}">
                            <span id="portfolio-pnl-val">{{ totalUnrealizedPnL >= 0 ? '+' : '' }}${{ totalUnrealizedPnL|number_format(2) }}</span>
                            <span id="portfolio-pnl-pct">({{ totalUnrealizedPnL >= 0 ? '+' : '' }}{{ totalUnrealizedPnLPercent|number_format(2) }}%)</span>
                        </span>
                        <span class="font-sans text-xs text-on-surface-variant">unrealised</span>
                    </p>
                </div>
            </div>

            <dl class="lg:col-span-5 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4 gap-x-6 gap-y-3">
                <div>
                    <dt class="text-xs text-on-surface-variant">Cash</dt>
                    <dd id="available-cash" class="mt-0.5 text-sm font-semibold text-on-surface font-mono tabular-nums">${{ cashBalance|number_format(2) }}</dd>
                </div>
                <div>
                    <dt class="text-xs text-on-surface-variant">Invested</dt>
                    <dd id="total-invested" class="mt-0.5 text-sm font-semibold text-on-surface font-mono tabular-nums">${{ totalInvested|number_format(2) }}</dd>
                </div>
                <div>
                    <dt class="text-xs text-on-surface-variant">In open orders</dt>
                    <dd class="mt-0.5 text-sm font-semibold text-on-surface font-mono tabular-nums">${{ escrowedCash|number_format(2) }}</dd>
                </div>
                <div>
                    <dt class="text-xs text-on-surface-variant">Dividends</dt>
                    <dd id="dividend-income" class="mt-0.5 text-sm font-semibold text-on-surface font-mono tabular-nums">${{ totalDividendIncome|number_format(2) }}</dd>
                </div>
            </dl>
        </header>

        <div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
                <h2 class="text-sm font-semibold text-on-surface">Value over time</h2>

                <div class="inline-flex items-center gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5" role="group" aria-label="Chart range">
                    <button type="button" class="portfolio-range-btn seg-btn" aria-pressed="false" data-range="1w">1W</button>
                    <button type="button" class="portfolio-range-btn seg-btn" aria-pressed="true" data-range="1m">1M</button>
                    <button type="button" class="portfolio-range-btn seg-btn" aria-pressed="false" data-range="1y">1Y</button>
                    <button type="button" class="portfolio-range-btn seg-btn" aria-pressed="false" data-range="max">Max</button>
                </div>
            </div>

            <div class="w-full h-65 sm:h-80 relative rounded overflow-hidden">
                <div id="portfolio-chart-spinner" class="hidden absolute inset-0 z-20 items-center justify-center bg-surface-container-low/80">
                    <svg class="animate-spin h-7 w-7 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
                <div id="portfolioChartContainer" class="w-full h-full"></div>
            </div>
        </div>

        <div class="space-y-5" data-controller="tabs" data-tabs-default-tab-value="holdings">
            <div class="flex border-b border-outline-variant/20 overflow-x-auto gap-5 sm:gap-7 pb-px custom-scrollbar" role="tablist">
                <button class="portfolio-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-primary border-primary cursor-pointer" data-tab="holdings" data-tabs-target="tab" data-action="click->tabs#select">
                    Holdings
                    <span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ holdings|length }}</span>
                </button>
                <button class="portfolio-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="orders" data-tabs-target="tab" data-action="click->tabs#select">
                    Orders
                    {% if openOrders|length > 0 %}
                        <span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ openOrders|length }}</span>
                    {% endif %}
                </button>
                <button class="portfolio-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="analytics" data-tabs-target="tab" data-action="click->tabs#select">
                    Allocation
                </button>
                <button class="portfolio-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="account" data-tabs-target="tab" data-action="click->tabs#select">
                    Account
                </button>
            </div>

            <div id="tab-content-holdings" class="portfolio-tab-panel space-y-5" data-tabs-target="panel" data-tab-panel="holdings">
            
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-3.5 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-2.5 h-2.5 rounded-full bg-series-blue" aria-hidden="true"></div>
                        <div>
                            <p class="text-xs text-on-surface-variant">Stocks</p>
                            <p class="text-sm font-bold text-on-surface font-mono tabular-nums">${{ allocation.stocks|number_format(2) }}</p>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-on-surface font-mono tabular-nums">{{ allocation.stocksPercent|number_format(1) }}%</span>
                </div>
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-3.5 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-2.5 h-2.5 rounded-full bg-series-orange" aria-hidden="true"></div>
                        <div>
                            <p class="text-xs text-on-surface-variant">Index funds</p>
                            <p class="text-sm font-bold text-on-surface font-mono tabular-nums">${{ allocation.etfs|number_format(2) }}</p>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-on-surface font-mono tabular-nums">{{ allocation.etfsPercent|number_format(1) }}%</span>
                </div>
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-3.5 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-2.5 h-2.5 rounded-full bg-on-surface-faint" aria-hidden="true"></div>
                        <div>
                            <p class="text-xs text-on-surface-variant">Cash</p>
                            <p class="text-sm font-bold text-on-surface font-mono tabular-nums">${{ allocation.cash|number_format(2) }}</p>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-on-surface font-mono tabular-nums">{{ allocation.cashPercent|number_format(1) }}%</span>
                </div>
            </div>

            <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-175">
                        <thead>
                            <tr class="bg-surface-container-highest/20 text-on-surface-variant text-2xs uppercase tracking-wide font-semibold border-b border-outline-variant/15">
                                <th class="px-5 py-3">Asset</th>
                                <th class="px-4 py-3 text-right">Shares</th>
                                <th class="px-4 py-3 text-right">Avg cost</th>
                                <th class="px-4 py-3 text-right">Market price</th>
                                <th class="px-5 py-3 text-right">Market value</th>
                                <th class="px-5 py-3 text-right">Total return</th>
                                <th class="px-4 py-3 text-right">Weight</th>
                                <th class="px-5 py-3 text-right">Trade</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
                            {% for holding in holdings %}
                                <tr class="relative hover:bg-surface-container-high/30 focus-within:bg-surface-container-high/30 transition-colors group">
                                    <td class="px-5 py-3">
                                        <div class="flex items-center gap-3">
                                            <img class="w-7 h-7 rounded shrink-0 border border-outline-variant/20 p-0.5 bg-surface-container-lowest" src="{{ asset('icons/' ~ (holding.underlying|default(holding.ticker)) ~ '.svg') }}" onerror="this.onerror=null; this.src='{{ asset('icons/default.svg') }}';" alt="{{ holding.ticker }} logo">
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    {% if holding.type == 'BOND' %}
                                                        <a href="{{ path('app_bond_view', { ticker: holding.ticker }) }}" class="font-bold text-on-surface text-sm group-hover:text-primary transition-colors outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:decoration-primary focus-visible:underline-offset-4">{{ holding.name }}</a>
                                                        <span class="relative z-10 px-1.5 py-0.5 rounded bg-primary/10 text-primary text-2xs font-medium border border-primary/25">Bond</span>
                                                    {% elseif holding.type == 'OPTION' %}
                                                        {# The contract has no page of its own: its chain lives on the underlying. #}
                                                        <a href="/stock/{{ holding.underlying }}" class="font-bold text-on-surface text-sm group-hover:text-primary transition-colors outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:decoration-primary focus-visible:underline-offset-4">{{ holding.name }}</a>
                                                        {% if holding.quantity < 0 %}
                                                            <span class="relative z-10 px-1.5 py-0.5 rounded bg-tertiary/10 text-tertiary text-2xs font-medium border border-tertiary/25" title="Written: the premium was received, and the loss on a call has no ceiling">Written</span>
                                                        {% else %}
                                                            <span class="relative z-10 px-1.5 py-0.5 rounded bg-primary/10 text-primary text-2xs font-medium border border-primary/25">Option</span>
                                                        {% endif %}
                                                    {% else %}
                                                        <a href="/stock/{{ holding.ticker }}" class="font-bold text-on-surface text-sm group-hover:text-primary transition-colors outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:decoration-primary focus-visible:underline-offset-4">{{ holding.name }}</a>
                                                    {% endif %}
                                                    {% if holding.isShort|default(false) %}
                                                        <span class="relative z-10 px-1.5 py-0.5 rounded bg-tertiary/10 text-tertiary text-2xs font-medium border border-tertiary/25" title="Sold short: the position profits when the price falls, and its loss has no ceiling">Short</span>
                                                    {% endif %}
                                                    {% if holding.isBankrupt %}
                                                        <span class="relative z-10 px-1.5 py-0.5 rounded bg-tertiary/10 text-tertiary text-2xs font-medium border border-tertiary/25">Bankrupt</span>
                                                    {% endif %}
                                                </div>
                                                <div class="flex items-center gap-2 mt-0.5">
                                                    <span class="text-xs text-on-surface-variant font-mono">{{ holding.ticker }}</span>
                                                    <span class="text-xs text-on-surface-variant">{{ holding.sector }}</span>
                                                    {% if holding.type == 'BOND' %}
                                                        <span class="text-xs text-on-surface-variant font-mono" title="Yield to maturity and modified duration">{{ (holding.yieldToMaturity * 100)|number_format(2) }}% YTM · {{ holding.modifiedDuration|number_format(1) }}y dur</span>
                                                    {% elseif holding.type == 'OPTION' %}
                                                        <span class="text-xs text-on-surface-variant font-mono" title="Implied volatility, delta and expiry">{{ (holding.impliedVolatility * 100)|number_format(1) }}% IV · {{ holding.delta|number_format(2) }}Δ · exp. {{ holding.expiresAtTime|sim_date }}</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface">
                                        {{ holding.quantity|number_format }}{% if holding.type == 'OPTION' %}<span class="block text-3xs font-normal text-on-surface-variant">contracts</span>{% endif %}
                                    </td>
                                    <td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant">${{ holding.avgCost|number_format(2) }}</td>
                                    <td class="px-4 py-3 font-mono tabular-nums text-right font-bold text-on-surface" id="price-{{ holding.ticker }}">${{ holding.price|number_format(2) }}</td>
                                    <td class="px-5 py-3 font-mono tabular-nums text-right font-bold text-on-surface" id="value-{{ holding.ticker }}">${{ holding.marketValue|number_format(2) }}</td>
                                    <td class="px-5 py-3 font-mono tabular-nums text-right font-bold {{ holding.unrealizedPnL >= 0 ? 'text-secondary' : 'text-tertiary' }}" id="pnl-{{ holding.ticker }}">
                                        <div>{{ holding.unrealizedPnL >= 0 ? '+' : '' }}${{ holding.unrealizedPnL|number_format(2) }}</div>
                                        <div class="text-2xs font-normal opacity-80">({{ holding.unrealizedPnL >= 0 ? '+' : '' }}{{ holding.unrealizedPnLPercent|number_format(2) }}%)</div>
                                        {% if holding.borrowAccrued|default(0) > 0 %}
                                            <div class="text-2xs font-normal text-tertiary mt-0.5" title="Borrow fees paid to keep this short open">
                                                &minus;${{ holding.borrowAccrued|number_format(2) }} borrow
                                            </div>
                                        {% endif %}
                                        {% if holding.dividendsReceived > 0 %}
                                            <div class="text-2xs font-normal text-on-surface-variant mt-0.5" title="{{ holding.type == 'BOND' ? 'Coupon cash received from ' ~ holding.ticker : 'Dividend cash received from ' ~ holding.ticker ~ ', including from shares since sold' }}">
                                                +${{ holding.dividendsReceived|number_format(2) }} {{ holding.type == 'BOND' ? 'cpn' : 'div' }}
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant text-xs">{{ holding.weight|number_format(1) }}%</td>
                                    <td class="px-5 py-3 text-right">
                                        <a href="{{ holding.type == 'BOND' ? path('app_bond_view', { ticker: holding.ticker }) : '/stock/' ~ (holding.underlying|default(holding.ticker)) }}" class="relative z-10 inline-flex items-center px-2.5 py-1 rounded border border-outline-variant/30 text-on-surface hover:bg-surface-container-high text-xs font-medium transition-colors">
                                            Trade
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8" class="px-6 py-10 text-center text-on-surface-variant text-xs">
                                        You don't hold anything yet.
                                        <a href="/" class="text-primary hover:underline underline-offset-2 ml-1">Browse the markets</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="tab-content-orders" class="portfolio-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="orders">
            
            <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-5">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold text-on-surface">Open orders</h3>
                    <span class="text-xs text-on-surface-variant">{{ openOrders|length }} open</span>
                </div>

                {% if openOrders|length > 0 %}
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-150">
                            <thead>
                                <tr class="text-2xs text-on-surface-variant uppercase tracking-wide border-b border-outline-variant/15 font-semibold">
                                    <th class="py-2.5">Order ID</th>
                                    <th class="py-2.5">Type</th>
                                    <th class="py-2.5">Action</th>
                                    <th class="py-2.5">Asset</th>
                                    <th class="py-2.5 text-right">Shares</th>
                                    <th class="py-2.5 text-right">Limit price</th>
                                    <th class="py-2.5 text-right">Current price</th>
                                    <th class="py-2.5 text-right">Cancel</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
                                {% for order in openOrders %}
                                    <tr class="hover:bg-surface-container-high/30 transition-colors">
                                        <td class="py-2.5 text-xs font-mono text-on-surface-variant">#{{ order.id }}</td>
                                        <td class="py-2.5 text-xs text-on-surface-variant uppercase">{{ order.orderType }}</td>
                                        <td class="py-2.5 font-bold {{ order.action in ['BUY', 'COVER'] ? 'text-secondary' : 'text-tertiary' }}">{{ order.action|lower|capitalize }}</td>
                                        <td class="py-2.5">
                                            <a href="/stock/{{ order.ticker }}" class="font-bold text-on-surface hover:text-primary transition-colors">{{ order.ticker }}</a>
                                        </td>
                                        <td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ order.quantity|number_format }}</td>
                                        <td class="py-2.5 text-right font-mono tabular-nums text-primary font-bold">${{ order.limitPrice|number_format(2) }}</td>
                                        <td class="py-2.5 text-right font-mono tabular-nums text-on-surface">${{ (livePrices[order.ticker] ?? 0.00)|number_format(2) }}</td>
                                        <td class="py-2.5 text-right">
                                            <form action="{{ path('app_trade_cancel', {'id': order.id}) }}" method="POST" onsubmit="return confirm('Cancel this limit order?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_trade_' ~ order.id) }}">
                                                <button type="submit" class="cursor-pointer px-2.5 py-1 rounded border border-outline-variant/30 text-on-surface-variant hover:text-tertiary hover:border-tertiary/40 text-xs font-medium transition-colors">
                                                    Cancel
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="py-6 text-center text-on-surface-variant text-xs">
                        No open orders.
                    </div>
                {% endif %}
            </div>

            <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-5">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold text-on-surface">Trade history</h3>
                    <span class="text-xs text-on-surface-variant">Last {{ tradeHistory|length }} trades</span>
                </div>

                {% if tradeHistory|length > 0 %}
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-150">
                            <thead>
                                <tr class="text-2xs text-on-surface-variant uppercase tracking-wide border-b border-outline-variant/15 font-semibold">
                                    <th class="py-2.5">Execution date</th>
                                    <th class="py-2.5">Type</th>
                                    <th class="py-2.5">Action</th>
                                    <th class="py-2.5">Asset</th>
                                    <th class="py-2.5 text-right">Shares</th>
                                    <th class="py-2.5 text-right">Executed price</th>
                                    <th class="py-2.5 text-right">Total amount</th>
                                    <th class="py-2.5 text-right">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
                                {% for trade in tradeHistory %}
                                    <tr>
                                        <td class="py-2.5 text-xs text-on-surface-variant font-mono">{{ (trade.filledAt ?? trade.createdAt)|date('Y-m-d H:i') }}</td>
                                        <td class="py-2.5 text-xs text-on-surface-variant uppercase">{{ trade.orderType }}</td>
                                        <td class="py-2.5 font-bold {{ trade.action in ['BUY', 'COVER'] ? 'text-secondary' : 'text-tertiary' }}">{{ trade.action|lower|capitalize }}</td>
                                        <td class="py-2.5">
                                            <a href="/stock/{{ trade.ticker }}" class="font-bold text-on-surface hover:text-primary transition-colors">{{ trade.ticker }}</a>
                                        </td>
                                        <td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity)|number_format }}</td>
                                        <td class="py-2.5 text-right font-mono tabular-nums text-on-surface">${{ (trade.executionPrice ?? trade.limitPrice ?? 0.00)|number_format(2) }}</td>
                                        <td class="py-2.5 text-right font-mono tabular-nums font-bold text-on-surface">
                                            ${{ ((trade.executionPrice ?? trade.limitPrice ?? 0.00) * (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity))|number_format(2) }}
                                        </td>
                                        <td class="py-2.5 text-right">
                                            <span class="text-xs {{ trade.status == 'FILLED' ? 'text-on-surface' : 'text-on-surface-variant' }}">{{ trade.status|lower|capitalize }}</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="py-6 text-center text-on-surface-variant text-xs">
                        No trades yet.
                    </div>
                {% endif %}
            </div>

            <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-5">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h3 class="text-sm font-semibold text-on-surface">Dividend income</h3>
                        <p class="text-xs text-on-surface-variant mt-0.5">Credited to your cash on each ex-date</p>
                    </div>
                    <span class="text-xs font-mono font-bold {{ totalDividendIncome > 0 ? 'text-secondary' : 'text-on-surface-variant' }}">${{ totalDividendIncome|number_format(2) }} lifetime</span>
                </div>

                {% if dividendPayments|length > 0 %}
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-100">
                            <thead>
                                <tr class="text-2xs text-on-surface-variant uppercase tracking-wide border-b border-outline-variant/15 font-semibold">
                                    <th class="py-2.5">Ex-Date</th>
                                    <th class="py-2.5">Asset</th>
                                    <th class="py-2.5 text-right">Shares held</th>
                                    <th class="py-2.5 text-right">Rate/Share</th>
                                    <th class="py-2.5 text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
                                {% for payment in dividendPayments %}
                                    <tr>
                                        <td class="py-2.5 text-xs text-on-surface-variant font-mono">{{ payment.paidAt|date('Y-m-d H:i') }}</td>
                                        <td class="py-2.5">
                                            <a href="/stock/{{ payment.ticker }}" class="font-bold text-on-surface hover:text-primary transition-colors">{{ payment.ticker }}</a>
                                        </td>
                                        <td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ payment.sharesHeld|number_format }}</td>
                                        <td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">${{ payment.dividendPerShare|number_format(4) }}</td>
                                        <td class="py-2.5 text-right font-mono tabular-nums font-bold text-secondary">+${{ payment.amount|number_format(2) }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="py-6 text-center text-on-surface-variant text-xs">
                        No dividends received yet.
                    </div>
                {% endif %}
            </div>
        </div>

        <div id="tab-content-analytics" class="portfolio-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="analytics">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                <div class="lg:col-span-7 bg-surface-container-low border border-outline-variant/20 rounded-lg p-5">
                    <h3 class="text-sm font-semibold text-on-surface mb-3">By sector</h3>
                    <div class="space-y-3">
                        {% for sec in sectorBreakdown %}
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="text-on-surface">{{ sec.name }}</span>
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono tabular-nums text-on-surface">${{ sec.value|number_format(2) }}</span>
                                        <span class="text-on-surface-variant font-mono tabular-nums text-xs">{{ sec.percent|number_format(1) }}%</span>
                                    </div>
                                </div>
                                <div class="w-full bg-surface-container-lowest h-1.5 rounded overflow-hidden">
                                    <div class="bg-primary h-full rounded transition-all duration-500" style="width: {{ sec.percent }}%;"></div>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-xs text-on-surface-variant">No sector allocations available.</p>
                        {% endfor %}
                    </div>
                </div>

                <div class="lg:col-span-5 bg-surface-container-low border border-outline-variant/20 rounded-lg p-5">
                    <div>
                        <h3 class="text-sm font-semibold text-on-surface mb-3">Concentration</h3>
                        <dl class="divide-y divide-outline-variant/15 text-sm">
                            <div class="py-2.5 flex justify-between">
                                <dt class="text-on-surface-variant">Positions</dt>
                                <dd class="font-bold text-on-surface font-mono tabular-nums">{{ holdings|length }}</dd>
                            </div>
                            <div class="py-2.5 flex justify-between">
                                <dt class="text-on-surface-variant">Largest position</dt>
                                <dd class="font-bold text-on-surface font-mono tabular-nums">{{ holdings|length > 0 ? holdings[0].weight|number_format(1) ~ '%' : '0.0%' }}</dd>
                            </div>
                            <div class="py-2.5 flex justify-between">
                                <dt class="text-on-surface-variant">Cash share</dt>
                                <dd class="font-bold text-on-surface font-mono tabular-nums">{{ allocation.cashPercent|number_format(1) }}%</dd>
                            </div>
                            <div class="py-2.5 flex justify-between">
                                <dt class="text-on-surface-variant">Sectors held</dt>
                                <dd class="font-bold text-on-surface font-mono tabular-nums">{{ sectorBreakdown|length }}</dd>
                            </div>
                        </dl>
                    </div>

                </div>
            </div>
        </div>

        <div id="tab-content-account" class="portfolio-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="account">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-5">
                    <span class="text-xs text-on-surface-variant">Available cash</span>
                    <p class="text-2xl font-semibold text-on-surface font-mono tabular-nums mt-1">${{ cashBalance|number_format(2) }}</p>
                    
                </div>
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-5">
                    <span class="text-xs text-on-surface-variant">Held for open orders</span>
                    <p class="text-2xl font-semibold text-on-surface font-mono tabular-nums mt-1">${{ escrowedCash|number_format(2) }}</p>
                    <p class="text-xs text-on-surface-variant mt-1.5">Released when an order fills or is cancelled.</p>
                </div>
                <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-5">
                    <span class="text-xs text-on-surface-variant">Buying power</span>
                    <p class="text-2xl font-semibold text-on-surface font-mono tabular-nums mt-1">${{ margin.buyingPower|number_format(2) }}</p>
                    <p class="text-xs text-on-surface-variant mt-1.5">{{ app.user.marginEnabled ? 'Free equity, geared by the initial margin requirement.' : 'Settled cash. Enable margin to borrow against the account.' }}</p>
                </div>
            </div>

            <div class="bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 space-y-4">
                <div class="flex flex-wrap items-start justify-between gap-4">
                    <div>
                        <h3 class="text-sm font-semibold text-on-surface">Margin</h3>
                        <p class="text-xs text-on-surface-variant mt-1 max-w-xl">
                            Borrowing lets a position lose more than the cash behind it. A short's loss has no
                            ceiling at all, and stock that has been lent out can be recalled whether the
                            position is winning or not.
                        </p>
                    </div>

                    <form action="{{ path('app_trade_margin') }}" method="POST">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_margin') }}">
                        <input type="hidden" name="enable" value="{{ app.user.marginEnabled ? '0' : '1' }}">
                        <button type="submit" class="cursor-pointer px-3 py-1.5 rounded text-sm font-medium transition-colors {{ app.user.marginEnabled ? 'text-tertiary border border-tertiary/30 hover:bg-tertiary/10' : 'bg-primary text-on-primary hover:bg-primary-container' }}">
                            {{ app.user.marginEnabled ? 'Disable margin' : 'Enable margin' }}
                        </button>
                    </form>
                </div>

                {% if app.user.marginEnabled %}
                    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
                        <div>
                            <dt class="text-xs text-on-surface-variant">Margin loan</dt>
                            <dd class="text-lg font-bold font-mono tabular-nums mt-0.5 {{ marginDebit > 0 ? 'text-tertiary' : 'text-on-surface' }}">${{ marginDebit|number_format(2) }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs text-on-surface-variant">Short exposure</dt>
                            <dd class="text-lg font-bold font-mono tabular-nums mt-0.5 text-on-surface">${{ margin.shortMarketValue|number_format(2) }}</dd>
                        </div>
                        {% if margin.optionShortValue > 0 %}
                            <div>
                                <dt class="text-xs text-on-surface-variant">Written contracts</dt>
                                <dd class="text-lg font-bold font-mono tabular-nums mt-0.5 text-on-surface" title="What buying the written contracts back would cost at the current mark">${{ margin.optionShortValue|number_format(2) }}</dd>
                            </div>
                        {% endif %}
                        <div>
                            <dt class="text-xs text-on-surface-variant">Account equity</dt>
                            <dd class="text-lg font-bold font-mono tabular-nums mt-0.5 text-on-surface">${{ margin.equity|number_format(2) }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs text-on-surface-variant">Maintenance</dt>
                            <dd class="text-lg font-bold font-mono tabular-nums mt-0.5 {{ margin.isCalled ? 'text-tertiary' : 'text-on-surface' }}">${{ margin.maintenanceRequirement|number_format(2) }}</dd>
                        </div>
                    </dl>

                    {% if margin.isCalled %}
                        <div class="rounded border border-tertiary/30 bg-tertiary/10 px-4 py-3">
                            <p class="text-sm font-semibold text-tertiary">Margin call</p>
                            <p class="text-xs text-tertiary mt-1 leading-relaxed">
                                Equity is ${{ margin.callAmount|number_format(2) }} below the maintenance requirement.
                                Positions will be sold at the market on the next sweep unless the account is
                                brought back into compliance.
                                {% if margin.optionShortValue > 0 %}
                                    Written contracts are bought back first: selling the stock behind a covered
                                    call would uncover it and raise the requirement.
                                {% endif %}
                            </p>
                        </div>
                    {% elseif margin.shortMarketValue > 0 or margin.optionShortValue > 0 or marginDebit > 0 %}
                        <p class="text-2xs text-on-surface-variant">
                            Equity is {{ (margin.equityRatio * 100)|number_format(1) }}% of gross exposure.
                        </p>
                    {% endif %}
                {% endif %}
            </div>
        </div>
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {# Portfolio value chart only — no Chart.js or ECharts on this page. #}
    {% include 'partials/_chart_libraries.html.twig' with { lightweight: true } %}

    {# Page data for assets/js/pages/dashboard.js. See the note in templates/stock/index.html.twig. #}
    <script type="application/json" id="portfolio-data">
        {{ {
            holdings: holdings|reduce((carry, h) => carry|merge({ (h.ticker): {
                quantity: h.quantity,
                avgCost: h.avgCost,
                price: h.price
            } }), {}),
            cash: cashBalance|default(0),
            initialPortfolioValue: portfolioValue|default(0),
            totalInvestedCost: totalInvestedCost|default(0)
        }|json_encode|raw }}
    </script>

    <script type="module">
        import 'pages/dashboard';
    </script>
{% endblock %}