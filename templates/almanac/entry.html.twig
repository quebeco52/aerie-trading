{% extends 'base.html.twig' %}

{# One District Almanac entry, its Markdown rendered by App\Service\Lore\Almanac. #}

{% block title %}{{ entry.title }} | District Almanac{% endblock %}

{% block meta %}
	<meta name="description" content="{{ entry.summary }}">
{% endblock %}

{% block body %}
<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full">
	<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_18rem] gap-8 lg:gap-12">
		<article class="min-w-0 max-w-3xl">
			<header class="pb-6 border-b border-outline-variant/15">
				<a href="{{ path('app_almanac') }}" class="text-sm text-on-surface-variant hover:text-primary transition-colors">District Almanac</a>
				<h1 class="mt-3 text-2xl md:text-3xl font-semibold text-on-surface tracking-tight leading-tight">{{ entry.title }}</h1>
				<p class="mt-3 text-base md:text-lg text-on-surface-variant leading-relaxed">{{ entry.summary }}</p>
				<p class="mt-4 text-sm text-on-surface-variant">{{ entry.category }}</p>
			</header>

			<div class="almanac-prose pt-6">{{ entry.html|raw }}</div>
		</article>

		<aside class="space-y-4" aria-label="Related">
			{% if pages is not empty %}
				<section class="bg-surface-container-low rounded-lg p-4 border border-outline-variant/20">
					<h2 class="text-xs font-semibold text-on-surface">On the District's sites</h2>
					<ul class="mt-2 space-y-1.5 text-sm">
						{% for page in pages %}
							<li><a href="{{ page.href }}" class="text-primary hover:underline underline-offset-2">{{ page.name }}</a></li>
						{% endfor %}
					</ul>
				</section>
			{% endif %}
			{% if linkedFrom is not empty %}
				<section class="bg-surface-container-low rounded-lg p-4 border border-outline-variant/20">
					<h2 class="text-xs font-semibold text-on-surface">Mentioned in</h2>
					<ul class="mt-2 space-y-1.5 text-sm">
						{% for other in linkedFrom %}
							<li><a href="{{ path('app_almanac_entry', {slug: other.slug}) }}" class="text-primary hover:underline underline-offset-2">{{ other.title }}</a></li>
						{% endfor %}
					</ul>
				</section>
			{% endif %}
		</aside>
	</div>

	<p class="source-note mt-10">{{ source_line('almanac') }}</p>
</div>
{% endblock %}
