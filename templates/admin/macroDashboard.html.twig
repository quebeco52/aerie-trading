{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Macroeconomic Control Center{% endblock %}

{% block main %}
<div class="container-fluid">
    
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-info">
                <strong><i class="fas fa-info-circle"></i> Live Simulation Data:</strong> This data is actively managed by the MacroEngine and updates every tick.
            </div>
        </div>
    </div>

    <h4 class="mb-3">The Central Bank (Taylor Rule)</h4>
    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">Inflation</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.inflation|default(0) * 100)|number_format(2) }}%</h2>
                    <p class="card-text small">Target: 2.00%</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card text-white {{ macro_state.output_gap|default(0) >= 0 ? 'bg-success' : 'bg-danger' }} mb-3">
                <div class="card-header">Output Gap</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.output_gap|default(0) * 100)|number_format(2) }}%</h2>
                    <p class="card-text small">
                        {{ macro_state.output_gap|default(0) >= 0 ? 'Economy is Booming' : 'Economy in Recession' }}
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-dark mb-3">
                <div class="card-header">Policy Rate (Short)</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.policy_rate|default(0) * 100)|number_format(2) }}%</h2>
                    <p class="card-text small">Target Rate: {{ (macro_state.target_rate|default(0) * 100)|number_format(2) }}%</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-secondary mb-3">
                <div class="card-header">10-Year Yield (Long)</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.yield_10y|default(0) * 100)|number_format(2) }}%</h2>
                    <p class="card-text small">Curve Slope: {{ (macro_state.ns_slope|default(0) * 100)|number_format(2) }}%</p>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Interbank Plumbing & Systemic Risk</h4>
    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card text-white {{ macro_state.interbank_liquidity_spread|default(0.0015) > 0.005 ? 'bg-danger' : 'bg-info' }} mb-3">
                <div class="card-header">TED / Interbank Spread</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.interbank_liquidity_spread|default(0.0015) * 10000)|number_format(0) }} bps</h2>
                    <p class="card-text small">Baseline: 15 bps (CIR Drift)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning text-dark mb-3">
                <div class="card-header">Corporate Credit Spread</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.macro_credit_spread|default(0.02) * 10000)|number_format(0) }} bps</h2>
                    <p class="card-text small">Merton IG Spread</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3">
                <div class="card-header">Market Volatility (VIX)</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.market_volatility|default(0.15) * 100)|number_format(2) }}%</h2>
                    <p class="card-text small">Macro Vol Anchor: 15.0%</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">Retail Default Rate</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.retail_default_rate|default(0.025) * 100)|number_format(2) }}%</h2>
                    <p class="card-text small">Vasicek ASRF Consumer PD</p>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Solow-Swan Neoclassical Growth & Technology</h4>
    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-header">TFP Index (Live)</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.total_factor_productivity_index|default(100.0))|number_format(2) }}</h2>
                    <p class="card-text small">Secular Innovation Drift</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">TFP Index (EMA)</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.total_factor_productivity_index_ema|default(100.0))|number_format(2) }}</h2>
                    <p class="card-text small">Smoothed Tech Frontier</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">Potential GDP Index</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.potential_gdp_index|default(1.0))|number_format(3) }}x</h2>
                    <p class="card-text small">Real Labor (0.5%) + TFP Growth</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-dark mb-3">
                <div class="card-header">District Nominal GDP</div>
                <div class="card-body">
                    <h2 class="card-title">${{ (50.00 * macro_state.nominal_gdp_index|default(1.0))|number_format(2) }}T</h2>
                    <p class="card-text small">Potential * (1 + Output Gap)</p>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Structural Macro & Financial Conditions</h4>
    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card text-white bg-warning text-dark mb-3">
                <div class="card-header">NAIRU (Structural)</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.nairu|default(0.04) * 100)|number_format(2) }}%</h2>
                    <p class="card-text small">Unemployment: {{ (macro_state.unemployment_rate|default(0.04) * 100)|number_format(2) }}%</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3">
                <div class="card-header">Sovereign Debt / GDP</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.sovereign_debt_to_gdp|default(1.0) * 100)|number_format(1) }}%</h2>
                    <p class="card-text small">Neutral Baseline: 100.0%</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white {{ macro_state.financial_conditions_index|default(0) > 0 ? 'bg-danger' : 'bg-success' }} mb-3">
                <div class="card-header">Financial Conditions (FCI)</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.financial_conditions_index|default(0))|number_format(2) }} σ</h2>
                    <p class="card-text small">{{ macro_state.financial_conditions_index|default(0) > 0 ? 'Restrictive (Tight)' : 'Accommodative (Loose)' }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-header">10Y TIPS Breakeven</div>
                <div class="card-body">
                    <h2 class="card-title">{{ (macro_state.tips_breakeven|default(0.02) * 100)|number_format(2) }}%</h2>
                    <p class="card-text small">Forward Expected Inflation</p>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Live Sector Multiples (P/E)</h4>
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sector</th>
                        <th>Live Target P/E</th>
                        <th>Discount Rate Impact</th>
                    </tr>
                </thead>
                <tbody>
                    {% for sector, pe in live_sectors %}
                        <tr>
                            <td class="fw-bold">{{ sector }}</td>
                            <td><span class="badge bg-primary fs-6">{{ pe|number_format(2) }}x</span></td>
                            <td class="text-muted small">Adjusted dynamically by 10Y Yield</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">No sector data available. Start the Market Ticker.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}