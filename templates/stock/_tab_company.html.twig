{# The company tab of the stock page (stock/index.html.twig). #}
{% import 'partials/_ui.html.twig' as ui %}

<div id="stock-tab-content-sector" class="stock-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="sector"> {# Sector Profile & Business Model Details #}
<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
	<h3 class="text-sm font-semibold text-on-surface mb-3">Sector and industry</h3>
	<div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs mt-3">
		{{ ui.tile('Sector', asset.sector, null, {mono: false}) }}
		{{ ui.tile('Industry', asset.industry|default('General'), null, {mono: false}) }}
		{% set reach %}of its addressable market{% if industry and industry.rosterShare is not null %} · {{ industry.rosterShare|pct(1) }} of sales among {{ industry.rosterSize }} listed peers{% endif %}{% endset %}
		{{ ui.tile('Market share', marketShare|pct(2), reach, {id: 'stat-market-share'}) }}
	</div>
</div>

{# A drug company's late-stage pipeline, patent expiry ladder and cash runway as the last report left them (BiotechPipelineBuilder). #}
{% if pipeline %}
	<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" id="pipeline-card">
		<h3 class="text-sm font-semibold text-on-surface">Pipeline and patents</h3>
		<p class="text-xs text-on-surface-variant mt-1">Late-stage trials decide what the company sells next, and patent expiries decide when what it sells now goes generic. As of the last quarterly report.</p>
		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 text-xs mt-4">
			{% set readouts %}about <span class="font-mono tabular-nums">{{ pipeline.readoutsPerYear|number_format(1) }}</span> pivotal readouts a year{% endset %}
			{{ ui.tile('Late-stage programmes', pipeline.lateStageAssets|number_format(1), readouts, {vpos: 'bottom', tip: 'Programmes in their final trials before approval, counted by value, so a smaller one counts as part of a programme. Each reads out when its trial ends; an approval joins the marketed book and a failure is gone until research replaces it.'}) }}
			{{ ui.tile('Sales under patent', pipeline.protectedShare|pct(1), 'of marketed sales') }}
			{{ ui.tile('Marketed book', pipeline.franchiseChange|pct(1, true), 'since listing', {tone: pipeline.franchiseChange|signed_class}) }}
			{{ ui.tile('Research spending', pipeline.rndReplacement|multiple, 'of replacement', {tone: pipeline.rndReplacement < 1.0 ? 'text-warning' : 'text-on-surface', vpos: 'bottom', tip: 'Research spending against the level that refills the late-stage pipeline as fast as trials read out. Below 1.0× the pipeline thins and fewer launches replace the patents that expire.'}) }}
			{% set runwayTip = {position: 'right', width: 'w-64', vpos: 'bottom', tip: 'How long cash on hand lasts at the last quarter\'s free cash outflow. Research is the company\'s capital spending, so it counts against the cash.'} %}
			{% if pipeline.runway is null %}
				{{ ui.tile('Cash runway', '—', 'no cash flow reported yet', runwayTip|merge({mono: false, tone: 'text-on-surface-faint'})) }}
			{% elseif pipeline.runway.years is null %}
				{{ ui.tile('Cash runway', 'Cash generative', 'last quarter', runwayTip|merge({mono: false})) }}
			{% else %}
				{% set burn %}at <span class="font-mono tabular-nums">{{ pipeline.runway.quarterlyBurn|format_large('$') }}</span> a quarter{% endset %}
				{{ ui.tile('Cash runway', pipeline.runway.years|figure('years', 1), burn, runwayTip) }}
			{% endif %}
		</div>
		<div class="overflow-x-auto mt-5">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="table-head">
						<th class="py-2">Exclusivity left</th>
						<th class="py-2 text-right">Share of marketed sales</th>
						<th class="py-2 text-right">Medicines</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-outline-variant/10 text-xs">
					{% for rung in pipeline.ladder %}
						<tr>
							<td class="py-2 text-on-surface">{{ rung.label }}</td>
							<td class="py-2 text-right font-mono tabular-nums text-on-surface">{{ rung.share|pct(1) }}</td>
							<td class="py-2 text-right font-mono tabular-nums {{ rung.count is null ? 'text-on-surface-faint' : 'text-on-surface' }}">{{ rung.count ?? '—' }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		{% if pipeline.ramping > 0 %}
			<p class="text-2xs text-on-surface-variant mt-3"><span class="font-mono tabular-nums">{{ pipeline.ramping }}</span> {{ pipeline.ramping == 1 ? 'medicine is' : 'medicines are' }} still building toward peak sales.</p>
		{% endif %}
	</div>
{% endif %}

{# Management: the archetype running the firm's capital, and how long it has been in post.
   Bertrand & Schoar (2003) manager fixed effects, surfaced because the market knows who is
   in the chair. The dials themselves are deliberately not shown — the policy is meant to be
   read off the payout, the capital budget and the deals. #}
{% if management %}
	<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" id="management-card">
		<div class="flex items-start justify-between gap-4">
			<div>
				<h3 class="text-sm font-semibold text-on-surface">Management</h3>
				<p class="text-xs text-on-surface-variant mt-1">Two companies with the same numbers can be run very differently depending on who runs them. The board replaces a manager whose capital stops earning its cost, and the successor need not share the approach.</p>
			</div>
			<span class="shrink-0 badge badge-{{ management.tone }}">{{ management.conviction|capitalize }}</span>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs mt-4">
			{{ ui.tile('Style', management.label, 'Capital is ' ~ management.mandate ~ '.', {mono: false}) }}
			{{ ui.tile('Tenure', management.tenureYears|figure('years', 1), 'in post') }}
		</div>
	</div>
{% endif %}

{# Industry Position: the industry ledger's roster and capacity balance, and the last report's price response #}
{% if industry %}
	<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" id="industry-position-card">
		<div class="flex items-start justify-between gap-3 mb-4">
			<div>
				<h3 class="text-sm font-semibold text-on-surface">Industry position</h3>
				<p class="text-xs text-on-surface-variant mt-1">Capacity built ahead of demand across the industry sets the price every producer realises, and when one company beats or misses, its rivals lose or gain share.</p>
			</div>
			{% if industry.pricesCapacity %}
				<span class="shrink-0 badge badge-{{ industry.balanceTone }}">{{ industry.balance == 'unknown' ? 'No reading yet' : industry.balance|capitalize }}</span>
			{% endif %}
		</div>

		{# Scale & saturation: the addressable share the physics is struck on, and the penalty it carries #}
		{% set sat = industry.saturation %}
		{% set saturated = industry.addressableShare > sat.threshold %}
		<div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs mb-3">
			{{ ui.tile('Addressable share', industry.addressableShare|pct(2), (saturated ? 'past' : 'under') ~ ' the ' ~ sat.threshold|pct(0) ~ ' saturation line', {tone: saturated ? 'text-warning' : 'text-on-surface'}) }}
			{{ ui.tile('Drag from size', (-sat.penalty)|pp(2), 'margin lost to the friction of size · ' ~ sat.severity|pct(0) ~ ' of return', {tone: sat.penalty > 0.0005 ? 'text-warning' : 'text-on-surface'}) }}
			{{ ui.tile('Marginal return', sat.marginalReturn|pct(2), 'next dollar of capital' ~ (sat.trailingReturn is null ? '' : ' · trailing ' ~ sat.trailingReturn|pct(2)), {tone: sat.marginalReturn < sat.trueReturn - 0.0005 ? 'text-warning' : 'text-on-surface'}) }}
			{{ ui.tile('Moat', sat.moatFactor|multiple, asset.systemicImportance ~ ' · offsets the drag from size') }}
		</div>

		{# The industry's outlook: what the public expects of its long-run demand, never the truth behind it. #}
		{% set outlook = industry.outlook %}
		{% if outlook %}
			<div class="grid grid-cols-2 gap-3 text-xs mb-3" id="industry-outlook">
				{% set outlookNote %}expected long-run demand, 1.00 when trading opened · give or take {{ outlook.doubt|pct(0) }}{% endset %}
				{{ ui.tile('Demand outlook', outlook.level|figure('index', 2), outlookNote, {tone: (outlook.level - 1)|signed_class, tip: 'What industry data lead the market to expect of demand for the whole industry in the long run, against what it expected when trading opened. Companies build plant for this demand, so a revision changes what they plan to build. The range is how unsure the estimate still is.'}) }}
				{{ ui.tile('Last revision', outlook.revision|pct(1, true), 'at the quarter\'s turn, from industry data', {tone: outlook.revision|signed_class}) }}
			</div>
		{% endif %}

		{% if not industry.pricesCapacity %}
			<p class="text-xs text-on-surface-variant leading-relaxed">Not priced on capacity: {{ isFinancial ? 'a lender sells a yield on its book, not a unit of output, so there is no plant to overbuild.' : 'this industry\'s output is not substitutable enough for rivals\' plant to move its price.' }}</p>
		{% else %}
			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 text-xs">
				{{ ui.tile('Capacity against demand', industry.capacityRatio|pct(1), industry.installedCapacity is not null ? industry.installedCapacity|format_large('$') ~ ' plant · ' ~ industry.trendCapacity|format_large('$') ~ ' for expected demand' : 'anchored at first report', {tone: industry.balance in ['overbuilt', 'tight'] ? 'text-warning' : 'text-on-surface'}) }}
				{{ ui.tile('Idle plant', industry.idlePlant|pct(1), 'of its plant switched off, last report', {tone: industry.idlePlant is null ? 'text-on-surface-faint' : (industry.idlePlant > 0.0005 ? 'text-warning' : 'text-on-surface'), tip: 'Plant switched off because, at the industry\'s price, its output would not cover the cost of running it. It goes back to work as demand catches up.'}) }}
				{# A move under five basis points reads as none. #}
				{% for move in [
					{label: 'Realised price', value: industry.priceMove, note: 'against a balanced industry, last report'},
					{label: 'Share moved by rivals', value: industry.rivalShareDrain, note: 'of demand, from rivals\' beats and misses'},
					{label: 'Volume from own pricing', value: industry.ownPriceVolumeShift, note: 'volume won or lost on its own real price change'},
				] %}
					{{ ui.tile(move.label, move.value|pct(2, true), move.note, {tone: move.value is null ? 'text-on-surface-faint' : (move.value|abs > 0.0005 ? 'text-warning' : 'text-on-surface')}) }}
				{% endfor %}
			</div>
		{% endif %}

		{% if industry.rosterShare is not null %}
			<div class="mt-4 pt-4 border-t border-outline-variant/15">
				<p class="text-xs font-semibold text-on-surface-variant mb-2">Share of industry sales among listed peers</p>
				<ul class="space-y-1.5" aria-label="Industry revenue shares">
					{% for peerTicker, share in industry.peerShares %}
						{% set isSelf = peerTicker == asset.ticker %}
						<li class="flex items-center gap-3 text-xs">
							<span class="w-14 shrink-0 font-mono {{ isSelf ? 'text-primary font-bold' : 'text-on-surface-variant' }}">{% if isSelf %}{{ peerTicker }}{% else %}<a href="/stock/{{ peerTicker }}" class="hover:underline">{{ peerTicker }}</a>{% endif %}</span>
							<span class="flex-1 h-1.5 rounded-full bg-surface-container-highest overflow-hidden"><span class="block h-full rounded-full {{ isSelf ? 'bg-primary' : 'bg-outline-variant' }}" style="width: {{ (share * 100)|round(1) }}%"></span></span>
							<span class="w-14 shrink-0 text-right font-mono tabular-nums {{ isSelf ? 'text-primary font-bold' : 'text-on-surface-variant' }}">{{ share|pct(1) }}</span>
						</li>
					{% endfor %}
				</ul>
			</div>
		{% elseif industry.rosterSize > 1 %}
			<p class="mt-4 pt-4 border-t border-outline-variant/15 text-xs text-on-surface-variant leading-relaxed">Its listed peers sell into different markets, so no share among them is shown.</p>
		{% elseif industry.tracked %}
			<p class="mt-4 pt-4 border-t border-outline-variant/15 text-xs text-on-surface-variant leading-relaxed">The only listed company in its industry, so no peer share is shown. The capacity figures above take the unlisted rest of the industry as building toward the same outlook.</p>
		{% endif %}

		{# Merger review: the same ledger reading the M&A engine sizes this firm's deals on. #}
		{% set review = industry.mergerReview %}
		{% if review %}
			<div class="mt-4 pt-4 border-t border-outline-variant/15" id="merger-review">
				<div class="flex items-start justify-between gap-3 mb-3">
					<div>
						<p class="text-xs font-semibold text-on-surface-variant">Merger review</p>
						<p class="text-xs text-on-surface-variant mt-1 leading-relaxed">Under the Fair Trading Board's guidelines, a deal is presumed to lessen competition when it raises the HHI by more than <span class="font-mono tabular-nums">{{ review.screens.delta|hhi }}</span> points and leaves the market above <span class="font-mono tabular-nums">{{ review.screens.concentrated|hhi }}</span>{% if review.screens.shareCeiling < 1 %}, or creates a company with more than <span class="font-mono tabular-nums">{{ review.screens.shareCeiling|pct(0) }}</span> of it{% endif %}. Targets come from the unlisted fringe.</p>
					</div>
					{# A concentrated market is a caution for the next deal, amber; red stays the colour of a fall. #}
					<span class="shrink-0 badge badge-{{ review.highlyConcentrated ? 'warn' : 'neutral' }}">{{ review.highlyConcentrated ? 'Highly concentrated' : 'Below ' ~ review.screens.concentrated|hhi }}</span>
				</div>
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
					{{ ui.tile('HHI', review.herfindahl|hhi, 'sum of listed peers\' squared market shares') }}
					{{ ui.tile('Own share', review.acquirerShare|pct(1), 'trend share of its market') }}
					{{ ui.tile('Fringe', review.fringeShare|pct(1), 'unlisted competitors, available to buy') }}
					{{ ui.tile('Largest deal', review.clearedShare|pct(1), 'of the market · ' ~ (review.reviewBinds ? 'capped by review' : 'capped by the fringe'), {tone: review.clearedShare < 0.005 ? 'text-warning' : 'text-on-surface'}) }}
				</div>
			</div>
		{% endif %}
	</div>
{% endif %}

{# Corporate Life-Cycle (Dickinson 2011). The bar under the current stage takes its badge's colour. #}
{% set stageBar = {accent: 'bg-primary', up: 'bg-secondary', neutral: 'bg-on-surface', warn: 'bg-warning', down: 'bg-tertiary'} %}
<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" id="lifecycle-card">
	<div class="flex items-start justify-between gap-3 mb-4">
		<div>
			<h3 class="text-sm font-semibold text-on-surface">Life-cycle stage</h3>
			<p class="text-xs text-on-surface-variant mt-1">Classified each quarter from the signs of operating, investing and financing cash flow.</p>
		</div>
		{% if lifecycleStage is not null and not asset.isBankrupt %}
			<span class="shrink-0 badge badge-{{ lifecycleStage.tone }}">{{ lifecycleStage.label }}</span>
		{% endif %}
	</div>

	<ol class="grid grid-cols-5 gap-2" aria-label="Life-cycle stages">
		{% for stage in lifecycleStages %}
			{% set isCurrent = lifecycleStage is not null and not asset.isBankrupt and stage.value == lifecycleStage.value %}
			<li class="flex flex-col gap-2 min-w-0" {% if isCurrent %}aria-current="step"{% endif %}>
				<span class="h-1.5 rounded-full {{ isCurrent ? stageBar[stage.tone] : 'bg-surface-container-highest' }}"></span>
				<span class="text-xs font-medium truncate {{ isCurrent ? 'text-on-surface' : 'text-on-surface-faint' }}">{{ stage.label }}</span>
				<span class="hidden sm:block text-2xs font-mono tabular-nums whitespace-nowrap {{ isCurrent ? 'text-on-surface-variant' : 'text-on-surface-faint' }}">{{ stage.cashFlowSignature }}</span>
			</li>
		{% endfor %}
	</ol>
	<p class="hidden sm:block mt-2 text-2xs text-on-surface-faint">Sign of operating / investing / financing cash flow</p>

	<div class="mt-4 pt-4 border-t border-outline-variant/15 text-xs text-on-surface-variant leading-relaxed">
		{% if asset.isBankrupt %}
			Delisted. Life-cycle classification stopped with the last filed report.
		{% elseif lifecycleStage is null %}
			Not yet classified. The stage is assigned with the first quarterly report.
		{% else %}
			<span class="text-on-surface font-semibold">{{ lifecycleStage.label }}.</span> {{ lifecycleStage.description }}
			{% if not lifecycleStage.initiatesDistributions %}
				<span class="block mt-1">Dividends are withheld at this stage: every dollar is reinvested until operations turn cash positive.</span>
			{% endif %}
		{% endif %}
	</div>
</div>
{# Sector Peer Comparison Table #}
<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden p-5">
	<h3 class="text-sm font-semibold text-on-surface mb-3">Peers in {{ asset.sector }}</h3>

	<div class="overflow-x-auto">
		<table class="w-full text-left border-collapse min-w-162.5">
			<thead>
				<tr class="table-head">
					<th class="py-2.5">Company</th>
					<th class="py-2.5 text-right">Price</th>
					<th class="py-2.5 text-right">Market cap</th>
					<th class="py-2.5 text-right">P/E ratio</th>
					<th class="py-2.5 text-right">ROIC / ROE</th>
					<th class="py-2.5 text-right">Ind. share</th>
					<th class="py-2.5 text-right">Total equity</th>
					<th class="py-2.5 text-right">Action</th>
				</tr>
			</thead>
			<tbody
				class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
				{# Current Stock Highlighted #}
				<tr class="bg-primary/5 font-bold">
					<td class="py-2.5 flex items-center gap-2">
						<span class="text-primary font-mono">{{ asset.ticker }}</span>
						<span class="text-on-surface text-xs">{{ asset.name }}</span>
						<span class="badge badge-accent">Current</span>
					</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ asset.price|money(2) }}</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ marketCap|format_large('$') }}</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ (peRatio ?: null)|multiple }}</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ displayReturn|pct(2) }}</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ (industry ? industry.rosterShare : null)|pct(1) }}</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ asset.totalEquity|format_large('$') }}</td>
					<td class="py-2.5 text-right text-xs text-on-surface-variant">—</td>
				</tr>

				{# Peer Companies #}
				{% for peer in peers %}
					{# One divider where the direct competitors end and the rest of the sector begins. #}
					{% if not peer.sameIndustry and (loop.first or peers[loop.index0 - 1].sameIndustry) %}
						<tr>
							<td colspan="8" class="pt-3 pb-1 text-xs font-semibold text-on-surface-faint">Elsewhere in {{ asset.sector }}</td>
						</tr>
					{% endif %}
					<tr class="relative hover:bg-surface-container-high/30 focus-within:bg-surface-container-high/30 transition-colors group">
						<th scope="row" class="py-2.5 flex items-center gap-2 text-left font-normal">
							<a href="/stock/{{ peer.ticker }}" class="font-mono text-primary font-bold group-hover:underline outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:underline-offset-4">{{ peer.ticker }}</a>
							<span class="text-on-surface-variant text-xs">{{ peer.name }}</span>
						</th>
						<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.price|money(2) }}</td>
						<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.marketCap|format_large('$') }}</td>
						<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ (peer.peRatio ?: null)|multiple }}</td>
						<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.roic|pct(2) }}</td>
						<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ (industry ? industry.peerShares[peer.ticker] ?? null : null)|pct(1) }}</td>
						<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.totalEquity|format_large('$') }}</td>
						<td class="py-2.5 text-right">
							{# The row's ticker already links here; this button is for the pointer only. #}
							<a href="/stock/{{ peer.ticker }}" aria-hidden="true" tabindex="-1" class="relative z-10 px-2 py-0.5 text-xs font-semibold text-primary bg-primary/10 rounded hover:bg-primary/20 transition-colors">
								View
							</a>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="8" class="py-4 text-center text-xs text-on-surface-variant">No peer companies found in this sector.</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>

				</div>
