{# The overview tab of the stock page (stock/index.html.twig). #}
{% import 'partials/_ui.html.twig' as ui %}

<div id="stock-tab-content-overview" class="stock-tab-panel" data-tabs-target="panel" data-tab-panel="overview"> <div
	class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

	{# Left column: chart, about, news #}
	<div
		class="lg:col-span-8 space-y-6">
								<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
			<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
				<div class="flex overflow-x-auto gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5 w-full sm:w-auto [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none;" role="group" aria-label="Chart range">
					<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="1w">1W</button>
					<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="1m">1M</button>
					<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="6m">6M</button>
					<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="true" data-range="1y">1Y</button>
					<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="3y">3Y</button>
					<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="5y">5Y</button>
					<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="10y">10Y</button>
					<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="max">Max</button>
				</div>

				{# Line or candles over the same bars. Candles only carry a real range on rows written
				   since bars existed; older rows render flat, which is what actually happened. #}
				{% if not isEtf %}
					<div class="inline-flex gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5" role="group" aria-label="Chart style">
						<button type="button" class="chart-style-btn seg-btn" aria-pressed="true" data-style="area">Line</button>
						<button type="button" class="chart-style-btn seg-btn" aria-pressed="false" data-style="candles">Candles</button>
					</div>
				{% endif %}
			</div>

			<div class="w-full h-75 md:h-112.5 relative rounded overflow-hidden">
				<div id="chart-spinner" class="hidden absolute inset-0 z-50 items-center justify-center bg-surface-container-low/80 transition-opacity duration-300">
					{% include 'partials/_spinner.html.twig' with { size: 'h-8 w-8' } only %}
				</div>
				<div id="mainChartContainer" class="w-full h-full"></div>
			</div>
		</div>

								<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
			<h2 class="text-sm font-semibold text-on-surface mb-2">About {{ asset.name }}</h2>
			<div class="text-sm text-on-surface-variant leading-relaxed space-y-3">
				{% for paragraph in (generalInfo ?? '')|split("\n\n") %}
					<p>{{ paragraph }}</p>
				{% endfor %}
			</div>
			{% if hasProfile %}
				<a href="{{ path('app_stock_profile', { ticker: asset.ticker }) }}" class="inline-block mt-3 text-sm text-primary hover:underline">Read the full company profile</a>
			{% endif %}
		</div>

		{# Corporate news, one partials/_event_card.html.twig row per story. #}
		<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
			<h2 class="text-sm font-semibold text-on-surface mb-1">News and corporate events</h2>
			<div class="divide-y divide-outline-variant/10" id="events-feed">
				{% for rawEvent in events %}
					{% include 'partials/_event_card.html.twig' with { event: present_event(rawEvent) } only %}
				{% else %}
					<p id="no-events-msg" class="py-6 text-center text-sm text-on-surface-variant">No news for {{ asset.ticker }} yet.</p>
				{% endfor %}
			</div>
		</div>
	</div>

	{# Right column: trade ticket and statistics #}
	<div
		class="lg:col-span-4 space-y-6">

								<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
			<h3 class="text-sm font-semibold text-on-surface mb-3">
				Trade {{ asset.ticker }}
			</h3>

			{% if not isEtf and asset.isBankrupt %}
				<div class="p-3 bg-tertiary/10 border border-tertiary/25 rounded space-y-1.5">
					<p class="text-tertiary font-semibold text-sm">Trading halted</p>
					<p class="text-xs text-on-surface-variant leading-relaxed">
						This corporation is in bankruptcy liquidation. Trading is permanently halted.
					</p>
				</div>
			{% else %}
				{# Shown when the user holds shares OR has ever been paid by this ticker: dividend cash
				   received survives selling out of the position, so it stays visible afterwards. #}
				{% if userQuantity != 0 or userDividendIncome > 0 or userRealised != 0 %}
					<div class="mb-4 p-3 bg-surface-container-lowest/80 rounded border border-outline-variant/20 space-y-1.5">
						{% if userQuantity != 0 %}
							<div class="flex justify-between items-center text-xs">
								<span class="text-on-surface-variant">Your position</span>
								<span class="flex items-center gap-2">
									{% if userQuantity < 0 %}<span class="badge badge-down">Short</span>{% endif %}
									<span class="font-bold text-on-surface font-mono tabular-nums">{{ userQuantity|abs|number_format }} shares</span>
								</span>
							</div>
							<div class="flex justify-between items-center text-xs">
								<span class="text-on-surface-variant">{{ userQuantity < 0 ? 'Avg sale price' : 'Avg cost basis' }}</span>
								<span class="font-mono tabular-nums text-on-surface-variant">{{ userAvgCost|money(2) }}</span>
							</div>
							<div class="flex justify-between items-center text-xs">
								<span class="text-on-surface-variant">{{ userQuantity < 0 ? 'Cost to cover' : 'Market value' }}</span>
								<span class="font-bold text-on-surface font-mono tabular-nums" id="user-holding-value">{{ (userQuantity|abs * asset.price)|money(2) }}</span>
							</div>
							<div class="flex justify-between items-center text-xs pt-1.5 border-t border-outline-variant/15">
								<span class="text-on-surface-variant">Unrealised return</span>
								<span class="font-mono tabular-nums font-bold {{ userUnrealizedPnL|signed_class }}">
									{{ userUnrealizedPnL|money(2, true) }}
									({{ userUnrealizedReturn|pct(2, true) }})
								</span>
							</div>
							{% if userBorrowAccrued > 0 %}
								<div class="flex justify-between items-center text-xs">
									<span class="text-on-surface-variant">Borrow fees paid</span>
									<span class="font-mono tabular-nums text-tertiary">{{ (-userBorrowAccrued)|money(2) }}</span>
								</div>
							{% endif %}
						{% endif %}
						{% if userRealised != 0 %}
							<div class="flex justify-between items-center text-xs {{ userQuantity != 0 ? 'pt-1.5 border-t border-outline-variant/15' : '' }}">
								<span class="text-on-surface-variant">Realised return</span>
								<span class="font-mono tabular-nums font-bold {{ userRealised|signed_class }}">{{ userRealised|money(2, true) }}</span>
							</div>
						{% endif %}
						{% if userDividendIncome > 0 %}
							<div class="flex justify-between items-center text-xs {{ userQuantity != 0 or userRealised != 0 ? 'pt-1.5 border-t border-outline-variant/15' : '' }}">
								<span class="text-on-surface-variant">Dividends received</span>
								<span class="font-mono tabular-nums font-bold text-secondary">{{ userDividendIncome|money(2, true) }}</span>
							</div>
						{% endif %}
					</div>
				{% endif %}

				{% embed 'partials/_trade_ticket.html.twig' with {ticker: asset.ticker, price: asset.price, dutyRate: isEtf ? 0 : macro.stampDutyRate, costsLabel: 'Spread and impact'} %}
					{% block choices %}
						{% import 'partials/_ui.html.twig' as ui %}
						{{ ui.choices('action', [{value: 'BUY', label: 'Buy', tone: 'up', checked: true}, {value: 'SELL', label: 'Sell', tone: 'down'}], {label: 'Side'}) }}

						{# Borrowed sides, shown only on a margin account and only for equities. #}
						{% if not isEtf and app.user and app.user.marginEnabled %}
							{{ ui.choices('action', [{value: 'SHORT', label: 'Short', tone: 'down'}, {value: 'COVER', label: 'Cover', tone: 'up'}], {label: 'Borrowed side'}) }}

							<div class="p-3 rounded bg-surface-container-lowest/80 border border-outline-variant/20 space-y-1.5 text-xs">
								<div class="flex justify-between items-center">
									<span class="text-on-surface-variant">Borrow fee</span>
									<span class="font-mono tabular-nums font-bold {{ borrowFee > borrowWarnings.expensiveFee ? 'text-warning' : 'text-on-surface' }}">{{ borrowFee|pct(2) }}/yr</span>
								</div>
								<div class="flex justify-between items-center">
									<span class="text-on-surface-variant">Available to borrow</span>
									<span class="font-mono tabular-nums font-bold text-on-surface">{{ availableToBorrow|format_large }}</span>
								</div>
								{% if shortUtilization >= borrowWarnings.scarceUtilization %}
									<p class="text-2xs text-warning leading-relaxed pt-1 border-t border-outline-variant/15">
										{{ shortUtilization|pct(0) }} of lendable stock is out on loan.
										{{ shortUtilization >= borrowWarnings.recallUtilization ? 'Lenders are recalling: open shorts can be bought in whether or not the account is in good standing.' : 'The borrow is getting expensive.' }}
									</p>
								{% endif %}
							</div>
						{% endif %}

						{{ ui.choices('orderType', [{value: 'MARKET', label: 'Market', checked: true}, {value: 'LIMIT', label: 'Limit'}, {value: 'STOP', label: 'Stop'}, {value: 'STOP_LIMIT', label: 'Stop limit'}], {label: 'Order type', pad: 'py-1', action: 'change->trade-form#onOrderTypeChange'}) }}

						<div id="stop-price-group" class="hidden space-y-1" data-trade-form-target="stopGroup">
							<label for="stopPrice" class="text-xs font-medium text-on-surface-variant">Stop price</label>
							<input type="number" step="0.01" min="0.01" id="stopPrice" name="stopPrice" placeholder="{{ asset.price|number_format(2, '.', '') }}" class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none" data-trade-form-target="stopPrice" data-action="input->trade-form#render">
							<p class="text-3xs text-on-surface-faint leading-4">
								A sell stop sits below the market and fires when the price falls to it. A plain stop then takes whatever the book quotes, which on a fast tape can be well through the trigger.
							</p>
						</div>
					{% endblock %}
					{% block costs %}
						{% if not isEtf %}
							{# Listed shares carry the District's stamp duty on both sides; funds are exempt. #}
							<div class="flex justify-between items-center text-on-surface-variant">
								<span>Stamp duty ({{ macro.stampDutyRate|pct(2) }}, to the Sovereign Reserve Fund)</span>
								<span class="font-mono tabular-nums" data-trade-form-target="duty">—</span>
							</div>
						{% endif %}
					{% endblock %}
				{% endembed %}
			{% endif %}
		</div>

		{% if app.user and not (not isEtf and asset.isBankrupt) %}
			{% include 'stock/_price_alerts.html.twig' with { ticker: asset.ticker, price: asset.price, alerts: priceAlerts } only %}
		{% endif %}

								{% if not isEtf %}
			<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
				<h3 class="text-sm font-semibold text-on-surface mb-3">
					Key statistics
				</h3>

				<dl class="divide-y divide-outline-variant/15 text-sm">
					{{ ui.stat('Market cap', marketCap|format_large('$'), {id: 'stat-mkt-cap'}) }}
					{{ ui.stat('Shares out', asset.sharesOutstanding|number_format, {id: 'stat-shares'}) }}
					{% if strategicStake > 0 and not asset.bankrupt %}
						{# The District's own stake, off the float and outside the fund; its dividends are paid into the fund. #}
						{% set stake %}<a href="/reserve" class="text-on-surface hover:text-primary hover:underline">{{ strategicStake|pct(2) }} of shares</a>{% endset %}
						{{ ui.stat('District strategic stake', stake, {tip: 'The District holds this stake itself, outside the Sovereign Reserve Fund. It is off the float and never traded, and its dividends are paid into the fund.', width: 'w-64'}) }}
					{% endif %}
					{% if fundStake > 0 %}
						{% set stake %}<a href="/reserve" class="text-on-surface hover:text-primary hover:underline">{{ fundStake|pct(2) }} of shares</a>{% endset %}
						{{ ui.stat('Sovereign Reserve Fund', stake, {tip: 'The district\'s sovereign fund holds the same share of every listed company\'s float and trades only when its board weight, or its whole equity share, leaves its band around policy.', width: 'w-64'}) }}
					{% endif %}
					{{ ui.stat('P/E ratio', (peRatio ?: null)|multiple, {id: 'stat-pe'}) }}
					{{ ui.stat('EPS (TTM)', asset.earningsPerShare|money(2), {id: 'stat-eps'}) }}
					{{ ui.stat('Dividend yield', dividendYield > 0 ? dividendYield|pct(2) : '—', {id: 'stat-div-yield'}) }}
					{% if netAssetValue %}
						{# A closed-end structure is quoted against its assets, never against its earnings. #}
						{{ ui.stat('NAV / share', netAssetValue.perShare|money(2), {id: 'stat-nav'}) }}
						{{ ui.stat(netAssetValue.premium < 0 ? 'Discount to NAV' : 'Premium to NAV', netAssetValue.premium|pct(1), {id: 'stat-nav-premium', tone: netAssetValue.premium|signed_class}) }}
					{% endif %}
					{{ ui.stat('Avg daily volume', advShares|format_large, {id: 'stat-adv'}) }}
					{% if shortInterest %}
						{{ ui.stat('Short interest', shortInterest.floatShare|pct(2), {sub: shortInterest.daysToCover is null ? null : shortInterest.daysToCover|number_format(1) ~ ' days to cover', tip: 'Shares sold short, as a share of the float, and the days of average volume it would take to buy them back.', width: 'w-64'}) }}
					{% endif %}
					{% if nextReport %}
						{% set dateline %}{{ nextReport.dateline }} <span class="text-on-surface-variant font-normal font-sans text-2xs">{{ nextReport.quarter }}</span>{% endset %}
						{{ ui.stat('Next results', dateline) }}
					{% endif %}
					{{ ui.stat('Bid-ask spread', (halfSpread * 2)|bps(1), {id: 'stat-spread'}) }}
					{{ ui.stat('Volatility', (asset.currentVolatility ?? asset.volatility)|pct(2), {id: 'stat-volatility'}) }}
					{{ ui.stat('Beta', asset.beta|number_format(2)) }}
					{{ ui.stat(isFinancial ? 'ROE' : 'ROIC', displayReturn|pct(2), {id: 'stat-roic'}) }}
					{{ ui.stat('Book value (equity)', asset.totalEquity|format_large('$'), {id: 'stat-equity'}) }}
					{% if capital %}
						{# A firm the regulator governs is quoted on tangible book and judged on its capital ratio;
						   debt-to-equity with deposits in the numerator says nothing about a bank. A ratio under the
						   warning line is a caution, so both lower zones read amber. #}
						{% set zoneLabel = {'Safe': 'well capitalised', 'Grey': 'grey zone', 'Distress': 'distressed'} %}
						{{ ui.stat('Tangible book / share', capital.tangibleBookPerShare|money(2), {id: 'stat-tbvps', tip: 'Book equity less goodwill, per share. The Financial Regulator deducts goodwill from capital, so this is the book a financial firm is valued and judged on.'}) }}
						{{ ui.stat('Price / tangible book', capital.priceToTangibleBook|multiple, {id: 'stat-ptbv', attrs: {'data-tbvps': capital.tangibleBookPerShare}}) }}
						{{ ui.stat('Return on tangible equity', capital.returnOnTangibleEquity|pct(2), {tip: 'Trailing twelve months of net income over tangible equity. It exceeds ROE by the goodwill the firm carries: the same earnings over the capital that actually backs them.'}) }}
						{% set zone %}{{ capital.ratio|pct(2) }} <span class="font-normal text-2xs">{{ zoneLabel[capital.zone] ?? capital.zone }}</span>{% endset %}
						{{ ui.stat('Capital ratio', zone, {tone: capital.zone == 'Safe' ? 'text-secondary' : 'text-warning', tip: 'Tangible equity over tangible assets, the ratio the regulator closes the firm on. Well capitalised above ' ~ capitalThresholds.warning|pct(1) ~ ', distressed below ' ~ capitalThresholds.distress|pct(1) ~ ', closed below ' ~ capitalThresholds.bankrupt|pct(1) ~ '.'}) }}
						{% if capital.cet1 is not null %}
							{{ ui.stat('CET1 ratio', capital.cet1|pct(2), {tip: 'Common equity tier 1 less goodwill, over risk-weighted assets (Basel III). Payouts are restricted when it runs below the regulatory buffer.'}) }}
						{% endif %}
						{% if capital.goodwillShare %}
							{{ ui.stat('Goodwill / book', capital.goodwillShare|pct(1)) }}
						{% endif %}
					{% else %}
						{# No ratio on negative equity: debt over nothing is not a leverage figure. #}
						{{ ui.stat('Debt to equity', asset.debtToEquity|multiple, {id: 'stat-debt-ratio', tone: asset.debtToEquity is null ? 'text-on-surface-faint' : 'text-on-surface'}) }}
					{% endif %}
					{% set rating %}<span class="text-primary" id="stat-credit-rating">{{ asset.creditRating }}</span> <span class="text-on-surface-variant font-normal text-2xs tabular-nums" id="stat-credit-spread">{{ asset.dynamicCreditSpread|bps(0, true) }}</span>{% endset %}
					{{ ui.stat('Credit rating', rating, {tip: 'The rating, and the spread the company\'s credit trades at today over the District\'s own bond curve. Its listed bonds are priced at this spread.', width: 'w-64'}) }}
					{{ ui.stat('Accruals / assets', asset.accrualsRatio|pct(2, true), {id: 'stat-accruals', tip: 'Accruals ratio: (net income − free cash flow) / total assets, annualised. Cash-backed earnings sit near zero; a high positive reading means reported profit is running ahead of cash and tends to reverse.'}) }}
				</dl>
			</div>
		{% endif %}

		{# Credit & Solvency: what would put an operating company into bankruptcy, as its lenders see it.
		   An operating firm files when it cannot pay, not when a score turns (FailureSweep). #}
		{% if creditHealth %}
			{% set credit = creditHealth %}
			<div class="bg-surface-container-low rounded-lg p-6 border {{ credit.inDefault ? 'border-tertiary/40' : 'border-outline-variant/15 hover:border-outline-variant/30' }} transition-all" id="credit-health-card">
				<div class="flex items-center justify-between gap-3 mb-3">
					<h3 class="text-sm font-semibold text-on-surface">Credit and solvency</h3>
					{% if credit.inDefault %}
						<span class="badge badge-down">In default</span>
					{% elseif not credit.hasCovenantHeadroom %}
						<span class="badge badge-warn">Covenant breached</span>
					{% else %}
						<span class="badge badge-neutral">Current</span>
					{% endif %}
				</div>

				{% if credit.inDefault %}
					<p class="mb-3 p-3 rounded bg-tertiary/10 border border-tertiary/25 text-xs text-on-surface leading-relaxed">
						Missed a principal payment {{ credit.quartersInDefault }} {{ credit.quartersInDefault == 1 ? 'quarter' : 'quarters' }} running.
						{% if credit.cureDueNextReport %}
							The grace period has run: unless it funds the payment by the next report, its lenders accelerate and it files, for a court-supervised reorganisation if the business still covers its cash costs, otherwise for liquidation.
						{% else %}
							It is inside the grace period and can still cure by funding the payment.
						{% endif %}
					</p>
				{% endif %}

				<dl class="divide-y divide-outline-variant/15 text-sm">
					{% set revolver %}
						{%- if credit.revolverUtilization is null -%}
							{{ ui.missing() }}
						{%- else -%}
							{{ credit.revolverDrawn|format_large('$') }} <span class="text-on-surface-variant font-normal text-2xs">of {{ credit.revolverCommitment|format_large('$') }} ({{ credit.revolverUtilization|pct(0) }})</span>
						{%- endif -%}
					{% endset %}
					{{ ui.stat('Revolver drawn', revolver, {tip: 'The committed credit line, and how much of it is drawn. The undrawn part is the cash the firm can reach in a bad quarter without going to the market.'}) }}
					{# A breached covenant or thin coverage is a caution, amber like the badge above; red stays the colour of a fall. #}
					{{ ui.stat('Net debt / EBITDA', credit.netDebtToEbitda|multiple, {tone: credit.hasCovenantHeadroom ? 'text-on-surface' : 'text-warning', sub: credit.covenantLimit is null ? null : 'limit ' ~ credit.covenantLimit|multiple(1), tip: 'Funded net debt over trailing EBITDA, the leverage an incurrence covenant is tested on. Past the limit the firm may not take on new discretionary debt.'}) }}
					{% set coverage %}{{ credit.interestCoverage|multiple(1) }}{% if credit.coverageState != 'adequate' %} <span class="font-normal text-2xs">{{ credit.coverageState }}</span>{% endif %}{% endset %}
					{{ ui.stat('Interest coverage', coverage, {tone: credit.coverageState == 'adequate' ? 'text-on-surface' : 'text-warning', tip: 'How many times operating income covers the interest bill. Below the sector minimum the firm pays down debt before it pays out.'}) }}
					{{ ui.stat('Distance to default', credit.distanceToDefault|number_format(2) ~ 'σ', {tip: 'How many standard deviations of asset value stand between the firm and its debt over five years. The rating agency grades on it: below ' ~ credit.investmentGradeDistance|number_format(1) ~ ' is speculative grade.'}) }}
				</dl>
			</div>
		{% endif %}

		{# Corporate Debt Issues #}
		{% if corporateBonds|length > 0 %}
			<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/15 hover:border-outline-variant/30 transition-all" id="corporate-debt-section">
				<div class="flex items-center justify-between gap-3 mb-3">
					<div>
						<h2 class="text-sm font-semibold text-on-surface">Listed debt issues</h2>
						<p class="text-2xs text-on-surface-variant mt-0.5">Corporate bonds trading on the exchange</p>
					</div>
					<a href="/bonds" class="text-xs text-primary hover:underline flex items-center gap-0.5">
						<span>Bond ladder</span>
						<span class="material-symbols-outlined text-xs" aria-hidden="true">arrow_forward</span>
					</a>
				</div>
				<div class="divide-y divide-outline-variant/10">
					{% for bond in corporateBonds %}
						<a href="/bond/{{ bond.ticker }}" class="py-2.5 flex items-center justify-between group hover:bg-surface-bright/50 -mx-2 px-2 rounded transition-colors">
							<div class="min-w-0">
								<div class="flex items-center gap-2">
									<span class="font-mono font-semibold text-xs text-primary group-hover:underline">{{ bond.ticker }}</span>
									<span class="text-2xs text-on-surface-variant font-mono tabular-nums">{{ bond.couponRate|pct(3) }}</span>
								</div>
								<p class="text-3xs text-on-surface-variant mt-0.5 font-mono tabular-nums">Matures in {{ bond.yearsToMaturity|number_format(1) }}y &middot; {{ bond.modifiedDuration|number_format(2) }} duration</p>
							</div>
							<div class="text-right shrink-0">
								<p class="text-sm font-semibold font-mono tabular-nums text-on-surface">{{ bond.cleanPrice|money(2) }}</p>
								<p class="text-2xs text-on-surface-variant font-mono tabular-nums">YTM {{ bond.yieldToMaturity|pct(2) }}</p>
							</div>
						</a>
					{% endfor %}
				</div>
			</div>
		{% endif %}

		{# Wall Street Analyst Consensus & Price Targets Card #}
		{% if not isEtf and not asset.isBankrupt %}
			<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
				<div class="flex items-center justify-between gap-3 mb-3">
					<h2 class="text-sm font-semibold text-on-surface">Analyst targets</h2>

					<span id="analyst-consensus-badge" class="badge badge-{{ analystTargets.tone }}">{{ analystTargets.rating }}</span>
				</div>

				<div class="pb-3 mb-1 border-b border-outline-variant/15">
					<p class="text-xs text-on-surface-variant">12-month consensus</p>
					{# A missing target prints the dash: falling back to the price or to zero would publish a call nobody made. #}
					{% set upside = analystTargets.upside %}
					<p class="mt-0.5 flex items-baseline gap-3">
						<span class="text-2xl font-semibold font-mono tabular-nums tracking-tight text-on-surface" id="target-consensus">{{ analystTargets.consensus|money(2) }}</span>
						{% if upside is not null %}
							<span id="target-upside" class="text-sm font-mono tabular-nums {{ upside > 0.05 ? 'text-secondary' : (upside < -0.05 ? 'text-tertiary' : 'text-on-surface-variant') }}">{{ upside|pct(1, true) }} to target</span>
						{% else %}
							<span id="target-upside" class="text-sm font-mono tabular-nums text-on-surface-faint">&mdash;</span>
						{% endif %}
					</p>
				</div>

				{# Three desks, each pricing the stock its own way. #}
				<dl class="divide-y divide-outline-variant/10 text-sm">
					<div class="py-2.5 flex items-start justify-between gap-3">
						<dt>
							<span class="text-on-surface">Growth desk</span>
							<span class="block text-xs text-on-surface-variant">Discounted cash flow on forward earnings</span>
						</dt>
						<dd class="font-mono tabular-nums text-on-surface" id="target-growth">{{ analystTargets.growth_analyst|money(2) }}</dd>
					</div>
					<div class="py-2.5 flex items-start justify-between gap-3">
						<dt>
							<span class="text-on-surface">Value desk</span>
							<span class="block text-xs text-on-surface-variant">Justified price to book: return over hurdle</span>
						</dt>
						<dd class="font-mono tabular-nums text-on-surface" id="target-value">{{ analystTargets.value_analyst|money(2) }}</dd>
					</div>
					<div class="py-2.5 flex items-start justify-between gap-3">
						<dt>
							<span class="text-on-surface">Income desk</span>
							<span class="block text-xs text-on-surface-variant">Dividend discount, with a cash-yield floor</span>
						</dt>
						<dd class="font-mono tabular-nums text-on-surface" id="target-income">{{ analystTargets.income_analyst|money(2) }}</dd>
					</div>
				</dl>
			</div>
		{% endif %}

		{% if isEtf %}
			{# Index Facts Card: what the level is struck on and when its membership is next reviewed. #}
			<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
				<h3 class="text-sm font-semibold text-on-surface mb-3">
					Index facts
				</h3>
				<dl class="divide-y divide-outline-variant/15 text-sm">
					{% set members %}{{ indexFacts.memberCount }}{% if indexFacts.constituentCount is not null %} <span class="text-on-surface-variant font-normal text-2xs">of {{ indexFacts.constituentCount }} seats</span>{% else %} <span class="text-on-surface-variant font-normal text-2xs">whole board</span>{% endif %}{% endset %}
					{{ ui.stat('Constituents', members) }}
					{{ ui.stat('Float-adjusted cap', indexFacts.totalFloatCap|format_large('$'), {tip: 'The part of each constituent that actually trades, summed. The level is struck on this, not on total market capitalisation: weighting on the whole would have the fund holding stock that is not for sale.'}) }}
					{% if macro.sovereignFundOwnershipShare > 0 %}
						{% set stake %}<a href="/reserve" class="text-on-surface hover:text-primary hover:underline">{{ macro.sovereignFundOwnershipShare|pct(2) }} of float</a>{% endset %}
						{{ ui.stat('Sovereign Reserve Fund', stake, {tip: 'The district\'s sovereign fund holds the same share of every constituent\'s float, and so of this float-adjusted cap. It buys after a fall and trims after a run only when its board weight, or its whole equity share, leaves its band.'}) }}
					{% endif %}
					{{ ui.stat('Top ' ~ indexFacts.topN ~ ' weight', indexFacts.topWeight|pct(1), {tip: 'Share of the index carried by its largest constituents. The higher it runs, the more the level is a handful of names rather than the market.', width: 'w-64'}) }}
					{% if indexFacts.largest %}
						{% set largest %}<a href="/stock/{{ indexFacts.largest.ticker }}" class="text-primary hover:underline">{{ indexFacts.largest.ticker }}</a> <span class="text-on-surface">{{ indexFacts.largest.weight|pct(1) }}</span>{% endset %}
						{{ ui.stat('Largest holding', largest) }}
					{% endif %}
					{{ ui.stat('Next review', 'in ' ~ indexFacts.daysUntilReconstitution|round ~ ' days') }}
					<div class="py-2 flex justify-between items-center">
						<dt class="text-on-surface-variant">Last review</dt>
						<dd class="font-medium text-on-surface font-mono tabular-nums text-right">
							{% if not indexFacts.hasRoster %}
								<span class="text-on-surface-variant font-normal">pending</span>
							{% elseif indexFacts.added|length == 0 and indexFacts.deleted|length == 0 %}
								<span class="text-on-surface-variant font-normal">no change</span>
							{% else %}
								{% if indexFacts.added|length > 0 %}<span class="text-secondary">+{{ indexFacts.added|length }}</span>{% endif %}
								{% if indexFacts.deleted|length > 0 %}<span class="text-tertiary">&minus;{{ indexFacts.deleted|length }}</span>{% endif %}
							{% endif %}
						</dd>
					</div>
					{{ ui.stat('Reviews per year', indexFacts.reconstitutionsPerYear) }}
					{{ ui.stat('Divisor', indexFacts.divisor|format_large, {tip: 'Level = float-adjusted cap of the members / divisor. Restated at every review and every fund split so that a change of composition or of units never moves the level; only prices do.'}) }}
					{{ ui.stat('Passive money', indexFacts.carriesPassiveBook ? 'tracks this index' : 'benchmark only') }}
					{% if indexFacts.navPremium is not null %}
						{{ ui.stat('Premium to NAV', indexFacts.navPremium|pct(3, true), {tone: indexFacts.navPremium >= 0 ? 'text-on-surface' : 'text-on-surface-variant', tip: 'What the fund trades at against what it owns. The two are set by different crowds and only agree because an authorised participant is paid to make them agree — and only to within what that trade costs. Past the band below, creating or redeeming shares turns a profit and somebody closes the gap.'}) }}
						{{ ui.stat('Arbitrage band', '±' ~ indexFacts.arbitrageBand|pct(3), {tip: 'How far the fund may drift from its basket before the arbitrage pays. It is the round-trip cost of assembling the basket, read off the live book — so a fund whose constituents have become expensive to trade is allowed to drift further, which is why a credit fund and an equity fund behave differently in the same stressed week.'}) }}
						{{ ui.stat('Shares in issue', indexFacts.sharesOutstanding|format_large('')) }}
					{% endif %}
					{% if indexFacts.expenseRatio is not null %}
						{{ ui.stat('Expense ratio', indexFacts.expenseRatio|pct(2), {tip: 'The annual fee, accrued continuously against net assets. It is met out of the dividend income the fund collects; anything income cannot cover is met by selling holdings, which is what makes the fund fall behind its index.'}) }}
						{{ ui.stat('Distribution yield', indexFacts.distributionYield|pct(2), {tip: 'Paid out over the trailing year, as a share of the current price. The index is a PRICE index and has no yield of its own; this is the dividend cash the fund collected from its constituents and passed on.'}) }}
						{{ ui.stat('Fees charged', indexFacts.feesPaidPerShare|money(2), {tip: 'What the fee has come to since the fund opened, per share. It is taken out of the dividend income before that income is distributed, so it never appears as a fall in the price — the holder simply receives less every quarter.'}) }}
						{% if indexFacts.tradingCostsPerShare > 0.005 %}
							{{ ui.stat('Trading costs', indexFacts.tradingCostsPerShare|money(2), {tip: 'The spread the fund has crossed rebalancing itself, per share. An index changes its weights by arithmetic; a fund has to trade to follow it. A fund weighted by size pays almost none of this, because its weights maintain themselves as prices move.'}) }}
						{% endif %}
						{% if indexFacts.trackingDifference > 0.00005 %}
							{{ ui.stat('Tracking difference', (-indexFacts.trackingDifference)|pct(2), {tip: 'How far the basket has fallen behind the one index unit a share started with. It only ever grows: a fund never buys back what it sold to pay for itself, whether that was a fee income could not cover or the spread on a rebalance.'}) }}
						{% endif %}
						{% if indexFacts.accruedIncome > 0 %}
							{{ ui.stat('Income accrued', indexFacts.accruedIncome|money(2), {tip: 'Dividend cash the fund has collected and not yet distributed, per share. It is already in the price and leaves it at the next distribution — the drop is the payment, not a loss.'}) }}
						{% endif %}
					{% endif %}
				</dl>
			</div>

			{# Weightings Card #}
			<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
				<h3 class="text-sm font-semibold text-on-surface mb-3">
					Constituent weightings
				</h3>

				<div class="h-64 relative w-full mb-4">
					<canvas id="etfPieChart"></canvas>
				</div>

				{% if components|length > 0 %}
					<div class="space-y-2 mt-4 max-h-56 overflow-y-auto custom-scrollbar">
						{% for comp in components %}
							<div class="flex justify-between items-center text-xs p-2 rounded-lg bg-surface-container-lowest/60 border border-outline-variant/5">
								<div class="flex items-center gap-2 min-w-0">
									<span class="text-3xs font-mono text-on-surface-faint w-5 text-right shrink-0">{{ comp.rank }}</span>
									<a href="/stock/{{ comp.ticker }}" class="font-bold text-primary hover:underline font-mono">{{ comp.ticker }}</a>
									<span class="text-on-surface-variant truncate max-w-30">{{ comp.name }}</span>
									{% if comp.isNew %}<span class="badge badge-up shrink-0">New</span>{% endif %}
								</div>
								<span class="font-bold text-on-surface font-mono tabular-nums" id="idx-weight-{{ comp.ticker }}">{{ comp.weight|pct(2) }}</span>
							</div>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		{% endif %}

	</div>
</div>
			</div>
