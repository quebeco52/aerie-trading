{% extends 'base.html.twig' %}

{# --- TOOLTIP MACRO --- #}
{% macro tooltip(text, position = 'left', width = 'w-48', vpos = 'top') %}
	{% set arrowPosition = position == 'right' ? 'right-4' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-4') %}
	{% set alignClass = position == 'right' ? 'right-0' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-0') %}
	{% set verticalClass = vpos == 'bottom' ? 'top-full mt-2.5' : 'bottom-full mb-2.5' %}
	{% set arrowVerticalClass = vpos == 'bottom' ? '-top-[5px] border-t border-l' : '-bottom-[5px] border-b border-r' %}

	<span role="tooltip" class="block pointer-events-none absolute {{ alignClass }} {{ verticalClass }} {{ width }} p-2.5 bg-surface-container-high text-on-surface text-2xs leading-relaxed rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 group-focus:opacity-100 group-focus:translate-y-0 transition-all duration-200 z-50 normal-case tracking-normal font-normal border border-outline-variant/40">
		{{ text }}
		<span class="block absolute {{ arrowVerticalClass }} {{ arrowPosition }} w-2.5 h-2.5 bg-surface-container-high border-outline-variant/40 transform rotate-45"></span>
	</span>
{% endmacro %}

{% block title %}
	{{ asset.ticker }}
	Stock Price & Analysis |
	{{ asset.name }}
	- Aerie Exchange
{% endblock %}

{% block meta %}
	<meta name="description" content="View live stock prices, market cap, financial statements, and fundamental valuation metrics for {{ asset.name }} ({{ asset.ticker }}).">
	<meta property="og:title" content="{{ asset.ticker }} Stock Price & Financials | Aerie Exchange">
	<meta property="og:description" content="Live financial data and analytics for {{ asset.name }} ({{ isEtf ? indexFacts.label : asset.industry|default('General') }}).">
	<meta property="og:type" content="website">
{% endblock %}

{% block favicon %}
	<link rel="icon" href="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" type="image/svg+xml">
{% endblock %}

{% block body %}
	{# Life-cycle stage tones (Dickinson 2011): reused by the hero badge and the Company & Sector card. #}
	{% set stageTone = {
		'introduction': 'bg-primary/10 text-primary border-primary/25',
		'growth': 'bg-secondary/10 text-secondary border-secondary/25',
		'mature': 'bg-surface-container-highest text-on-surface border-outline-variant/40',
		'shake_out': 'bg-tertiary/10 text-tertiary border-tertiary/25',
		'decline': 'bg-tertiary/20 text-tertiary border-tertiary/40',
	} %}
	{% set stageBar = {
		'introduction': 'bg-primary',
		'growth': 'bg-secondary',
		'mature': 'bg-on-surface',
		'shake_out': 'bg-tertiary/60',
		'decline': 'bg-tertiary',
	} %}

	<div
		class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5">

		{# --- TOP ASSET HERO BANNER --- #}
		<div class="bg-surface-container-low rounded-lg p-6 lg:p-7 border border-outline-variant/15 relative z-20">
			<div
				class="flex flex-col md:flex-row md:justify-between md:items-center gap-6 relative z-10">
				{# Left: Identity & Sector #}
				<div class="flex items-center gap-4 sm:gap-5 min-w-0">
					<img class="w-16 h-16 sm:w-20 sm:h-20 rounded border border-outline-variant/20 bg-surface-container-lowest p-2 shrink-0 object-contain" src="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" onerror="this.onerror=null; this.src='{{ asset('icons/default.svg') }}';" alt="{{ asset.ticker }} icon">

					<div class="flex flex-col gap-1 min-w-0">
						<h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-on-surface tracking-tight wrap-break-word leading-tight">{{ asset.name }}</h1>

						<div class="flex flex-wrap items-center gap-2 md:gap-3">
							<span class="text-sm font-bold text-primary font-mono tracking-wider">{{ asset.ticker }}</span>

							<span class="group relative cursor-help inline-flex items-center rounded bg-surface-container-highest px-2 py-0.5 text-sm font-semibold text-on-surface-variant focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">{{ isEtf ? indexFacts.indexName : asset.industry|default('General') }}</span>
								{% set bmMap = constant('App\\Data\\Sectors::BUSINESS_MODEL_DESCRIPTIONS') %}
								{% set bmDesc = isEtf ? indexFacts.mandate : (bmMap[businessModel|default('none')] ?? bmMap['none']) %}
								{{ _self.tooltip(bmDesc, 'left', 'w-72', 'bottom') }}
							</span>

							{% if lifecycleStage is not null and not asset.isBankrupt %}
								<span class="group relative cursor-help inline-flex items-center rounded border px-2 py-0.5 text-xs font-bold uppercase tracking-wide {{ stageTone[lifecycleStage.value] }} focus-visible:outline-none" tabindex="0" id="lifecycle-badge">
									<span class="border-b border-dotted border-current/60 pb-0.5">{{ lifecycleStage.label }}</span>
									{{ _self.tooltip('Corporate life-cycle stage (Dickinson 2011), read from the cash-flow signs in the last quarterly report. ' ~ lifecycleStage.description ~ ' Pattern CFO / CFI / CFF: ' ~ lifecycleStage.cashFlowSignature ~ '.', 'left', 'w-80', 'bottom') }}
								</span>
							{% endif %}
							{% if not isEtf and asset.isBankrupt %}
								<span class="inline-flex items-center rounded bg-tertiary/10 px-2 py-0.5 text-xs font-bold uppercase tracking-wide text-tertiary border border-tertiary/25">
									BANKRUPT / DELISTED
								</span>
							{% endif %}
						</div>
					</div>
				</div>

				{# Right: Large Price & Status #}
				<div class="md:text-right shrink-0 flex flex-col md:items-end">
					<div class="flex items-center md:justify-end gap-2 mb-1">
						{% if not isEtf and asset.isBankrupt %}
							<span class="w-2 h-2 rounded-full bg-tertiary"></span>
							<span class="text-2xs font-semibold tracking-wide text-tertiary uppercase" id="live-indicator">BANKRUPT / DELISTED</span>
						{% else %}
							<span class="w-2 h-2 rounded-full bg-secondary"></span>
							<span class="text-2xs font-semibold tracking-wide text-secondary uppercase" id="live-indicator">Live Market</span>
						{% endif %}
					</div>
					<span class="block text-3xl sm:text-4xl md:text-5xl font-bold font-mono tabular-nums {{ not isEtf and asset.isBankrupt ? 'text-tertiary line-through' : 'text-on-surface' }} tracking-tight transition-colors duration-300" id="big-price">
						${{ (not isEtf and asset.isBankrupt ? 0.00 : asset.price)|number_format(2) }}
					</span>

					{# Trailing month, per the price buffer: the schema carries no session open or
					   previous close to compute a daily move from. Labelled accordingly. #}
					<div class="flex items-center md:justify-end gap-2 mt-1.5" id="big-change-row">
						{% if changePercent is not null %}
							<span id="big-change" class="inline-flex items-center gap-1 text-sm sm:text-base font-semibold font-mono tabular-nums {{ changePercent >= 0 ? 'text-secondary' : 'text-tertiary' }}">
								<span class="material-symbols-outlined text-base leading-none" aria-hidden="true">{{ changePercent >= 0 ? 'trending_up' : 'trending_down' }}</span>
								{{ changePercent >= 0 ? '+' : '' }}{{ (changePercent * 100)|number_format(2) }}%
							</span>
						{% else %}
							<span id="big-change" class="text-sm sm:text-base font-semibold font-mono tabular-nums text-on-surface-variant/50">&mdash;</span>
						{% endif %}
						<span class="text-2xs font-semibold uppercase tracking-wide text-on-surface-variant/70">1M</span>
					</div>
				</div>
			</div>
		</div>

		{# --- TAB NAVIGATION BAR (ALL ENGLISH) --- #}
		<div class="space-y-5" data-controller="tabs" data-tabs-default-tab-value="overview">
			<div class="flex border-b border-outline-variant/20 overflow-x-auto gap-2 sm:gap-6 pb-px custom-scrollbar">
				<button class="stock-tab-btn pb-2.5 px-1 text-sm font-medium border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-primary border-primary cursor-pointer" data-tab="overview" data-tabs-target="tab" data-action="click->tabs#select">
					Overview
				</button>
				{% if isEtf %}
					<button class="stock-tab-btn pb-2.5 px-1 text-sm font-medium border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="constituents" data-tabs-target="tab" data-action="click->tabs#select">
						Constituents & Methodology
						<span class="px-2 py-0.5 rounded-full text-3xs bg-primary/20 text-primary font-mono font-bold">{{ indexFacts.memberCount }}</span>
					</button>
				{% else %}
					<button class="stock-tab-btn pb-2.5 px-1 text-sm font-medium border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="financials" data-tabs-target="tab" data-action="click->tabs#select">
						Financials & Fundamentals
					</button>
					<button class="stock-tab-btn pb-2.5 px-1 text-sm font-medium border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="sector" data-tabs-target="tab" data-action="click->tabs#select">
						Company & Sector
					</button>
					<button class="stock-tab-btn pb-2.5 px-1 text-sm font-medium border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="options" data-tabs-target="tab" data-action="click->tabs#select">
						Options
						{% if optionsListed %}
							<span class="px-2 py-0.5 rounded-full text-3xs bg-primary/20 text-primary font-mono font-bold">{{ optionExpiries|length }}</span>
						{% endif %}
					</button>
				{% endif %}
				<button class="stock-tab-btn pb-2.5 px-1 text-sm font-medium border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="orders" data-tabs-target="tab" data-action="click->tabs#select">
					Orders & Trades
					{% if openOrders|length > 0 %}
						<span class="px-2 py-0.5 rounded-full text-3xs bg-primary/20 text-primary font-mono font-bold">{{ openOrders|length }}</span>
					{% endif %}
				</button>
			</div>

			{# ========================================================================= #}
			{# TAB 1: OVERVIEW #}
			{# ========================================================================= #}
				<div id="stock-tab-content-overview" class="stock-tab-panel" data-tabs-target="panel" data-tab-panel="overview"> <div
					class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

					{# Left Column: Chart & About #}
					<div
						class="lg:col-span-8 space-y-6">
						{# Main Price Chart Card #}
						<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
							<div class="flex overflow-x-auto gap-1 sm:gap-2 mb-4 bg-surface-container-lowest p-1.5 rounded border border-outline-variant/15 w-full md:w-max [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1.5 sm:px-3 py-1 text-xs font-bold rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center cursor-pointer" data-range="1w">1W</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1.5 sm:px-3 py-1 text-xs font-bold rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center cursor-pointer" data-range="1m">1M</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1.5 sm:px-3 py-1 text-xs font-bold rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center cursor-pointer" data-range="6m">6M</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1.5 sm:px-3 py-1 text-xs font-bold rounded-lg bg-primary text-on-primary shadow-primary/20 transition-colors text-center cursor-pointer" data-range="1y">1Y</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1.5 sm:px-3 py-1 text-xs font-bold rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center cursor-pointer" data-range="3y">3Y</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1.5 sm:px-3 py-1 text-xs font-bold rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center cursor-pointer" data-range="5y">5Y</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1.5 sm:px-3 py-1 text-xs font-bold rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center cursor-pointer" data-range="10y">10Y</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1.5 sm:px-3 py-1 text-xs font-bold rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center cursor-pointer" data-range="max">MAX</button>
							</div>

							{# Line or candles over the same bars. Candles only carry a real range on rows written
							   since bars existed; older rows render flat, which is what actually happened. #}
							{% if not isEtf %}
								<div class="flex gap-1 mb-4 bg-surface-container-lowest p-1.5 rounded border border-outline-variant/15 w-max" role="group" aria-label="Chart style">
									<button type="button" class="chart-style-btn shrink-0 px-3 py-1 text-xs font-bold rounded-lg bg-primary text-on-primary transition-colors cursor-pointer" data-style="area">Line</button>
									<button type="button" class="chart-style-btn shrink-0 px-3 py-1 text-xs font-bold rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors cursor-pointer" data-style="candles">Candles</button>
								</div>
							{% endif %}

							<div class="w-full h-75 md:h-112.5 relative rounded overflow-hidden">
								<div id="chart-spinner" class="hidden absolute inset-0 z-50 items-center justify-center bg-surface-container-low/80 transition-opacity duration-300">
									<svg class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
										<circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
										<path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
									</svg>
								</div>
								<div id="mainChartContainer" class="w-full h-full"></div>
							</div>
						</div>

						{# About Card #}
						<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
							<h3 class="text-sm font-semibold text-primary mb-3">
								About {{ asset.name }}
							</h3>
							<div class="text-xs font-serif text-on-surface-variant leading-relaxed tracking-wide">
								<p>{{ generalInfo|nl2br }}</p>
							</div>
						</div>

						{# Corporate News / Events Feed #}
						<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
							<div class="flex items-center justify-between mb-4">
								<h3 class="text-sm font-semibold text-on-surface">
									Recent Corporate Events & News
								</h3>
								{% if events|length > 0 %}
									<span class="text-3xs font-mono px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant border border-outline-variant/20">
										{{ events|length }}
										{{ events|length == 1 ? 'Event' : 'Events' }}
									</span>
								{% endif %}
							</div>
							<div class="space-y-3.5" id="events-feed">
								{% for rawEvent in events %}
									{% set event = present_event(rawEvent) %}
									<div
										class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15 border-l-4 {{ event.borderClass }} hover:border-outline-variant/40 transition-all duration-200 space-y-2.5">

										{# Top Header Row: Icon + Badge + Headline / EPS + Surprise + EVA + Timestamp #}
										<div class="flex items-start justify-between gap-3">
											<div class="flex items-center flex-wrap gap-2 min-w-0">
												<div class="w-6 h-6 rounded-lg flex items-center justify-center shrink-0 {{ event.iconClass }}">
													<span class="material-symbols-outlined text-sm">{{ event.icon }}</span>
												</div>
												<span class="inline-flex items-center rounded-md px-2 py-0.5 text-3xs font-bold font-mono uppercase tracking-wider border {{ event.badgeClass }}">
													{{ event.badge }}
												</span>
												{% if event.isEarnings and event.eps %}
													<span class="text-xs font-bold font-mono text-on-surface tracking-tight">
														EPS
														{{ event.eps }}
													</span>
												{% endif %}
												{% if event.isEarnings and event.surpriseType != 'met' and event.surpriseAmount %}
													<span class="text-2xs font-bold font-mono {{ event.surpriseType == 'beat' ? 'text-secondary' : 'text-tertiary' }}">
														({{ event.surpriseText }})
													</span>
												{% elseif event.isEarnings and event.surpriseType == 'met' %}
													<span class="text-2xs font-bold font-mono text-on-surface-variant/80">
														(In-Line)
													</span>
												{% endif %}
												{% if event.isEarnings and event.eva %}
													<span class="inline-flex items-center rounded px-1.5 py-0.5 text-3xs font-bold font-mono {{ event.evaPositive ? 'bg-secondary/10 text-secondary' : 'bg-tertiary/10 text-tertiary' }}">
														{{ event.eva }}
													</span>
												{% endif %}
											</div>

											<div class="text-right shrink-0 flex items-center gap-2">
												{% if event.changePercent is not null and event.changePercent != 0 %}
													<span class="inline-flex items-center rounded px-1.5 py-0.5 text-3xs font-mono font-bold {{ event.changePercent > 0 ? 'bg-secondary/10 text-secondary' : 'bg-tertiary/10 text-tertiary' }}">
														{{ event.changePercent > 0 ? '+' : '' }}{{ event.changePercent|number_format(2) }}%
													</span>
												{% endif %}
												<span class="text-3xs text-on-surface-variant font-mono whitespace-nowrap">
													{{ event.recordedAt|date('Y-m-d H:i') }}
												</span>
											</div>
										</div>

										{# Body Description (For non-earnings or additional narrative) #}
										{% if not event.isEarnings and event.headline %}
											<p class="text-xs text-on-surface font-medium leading-relaxed pl-8">
												{{ event.headline }}
											</p>
										{% endif %}

										{# Corporate Action Sub-Pills (Dividends, Buybacks, Debt, Lore) #}
										{% if event.pills is defined and event.pills|length > 0 %}
											<div class="flex flex-wrap gap-2 pt-1 pl-8">
												{% for pill in event.pills %}
													<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-mono {{ pill.pillClass }}">
														<span class="material-symbols-outlined text-sm shrink-0">{{ pill.icon }}</span>
														<span class="leading-none">{{ pill.text }}</span>
													</div>
												{% endfor %}
											</div>
										{% endif %}
									</div>
								{% else %}
									<div id="no-events-msg" class="p-8 rounded bg-surface-container-lowest/40 border border-outline-variant/10 text-center space-y-2">
										<span class="material-symbols-outlined text-3xl text-on-surface-variant/40">event_busy</span>
										<p class="text-xs text-on-surface-variant font-serif">No recent corporate events logged for this asset.</p>
									</div>
								{% endfor %}
							</div>
						</div>
					</div>

					{# Right Column: Trading Box, Position & Fundamentals #}
					<div
						class="lg:col-span-4 space-y-6">

						{# Trading Widget #}
						<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
							<h3 class="text-sm font-semibold text-on-surface mb-3">
								Trade {{ asset.ticker }}
							</h3>

							{% if not isEtf and asset.isBankrupt %}
								<div class="p-3 bg-tertiary/10 border border-tertiary/25 rounded space-y-1.5">
									<div class="flex items-center gap-2 text-tertiary font-bold text-xs uppercase tracking-wider">
										<span class="material-symbols-outlined text-base">block</span>
										Trading Halted
									</div>
									<p class="text-xs text-on-surface-variant leading-relaxed">
										This corporation is in bankruptcy liquidation. Trading is permanently halted.
									</p>
								</div>
							{% else %}
								{# Shown when the user holds shares OR has ever been paid by this ticker: dividend cash
								   received survives selling out of the position, so it stays visible afterwards. #}
								{% if userQuantity > 0 or userDividendIncome > 0 %}
									<div class="mb-4 p-3 bg-surface-container-lowest/80 rounded border border-outline-variant/20 space-y-1.5">
										{% if userQuantity > 0 %}
											<div class="flex justify-between items-center text-xs">
												<span class="text-on-surface-variant uppercase tracking-wide text-2xs font-semibold">Your Position</span>
												<span class="font-bold text-on-surface font-mono tabular-nums">{{ userQuantity|number_format }} Shares</span>
											</div>
											<div class="flex justify-between items-center text-xs">
												<span class="text-on-surface-variant uppercase tracking-wide text-2xs font-semibold">Avg Cost Basis</span>
												<span class="font-mono tabular-nums text-on-surface-variant">${{ userAvgCost|number_format(2) }}</span>
											</div>
											<div class="flex justify-between items-center text-xs">
												<span class="text-on-surface-variant uppercase tracking-wide text-2xs font-semibold">Market Value</span>
												<span class="font-bold text-on-surface font-mono tabular-nums" id="user-holding-value">${{ (userQuantity * asset.price)|number_format(2) }}</span>
											</div>
											<div class="flex justify-between items-center text-xs pt-1.5 border-t border-outline-variant/15">
												<span class="text-on-surface-variant uppercase tracking-wide text-2xs font-semibold">Unrealized Return</span>
												<span class="font-mono tabular-nums font-bold {{ userUnrealizedPnL >= 0 ? 'text-secondary' : 'text-tertiary' }}">
													{{ userUnrealizedPnL >= 0 ? '+' : '' }}${{ userUnrealizedPnL|number_format(2) }}
													({{ userUnrealizedPnL >= 0 ? '+' : '' }}{{ userUnrealizedPnLPercent|number_format(2) }}%)
												</span>
											</div>
										{% endif %}
										{% if userDividendIncome > 0 %}
											<div class="flex justify-between items-center text-xs {{ userQuantity > 0 ? 'pt-1.5 border-t border-outline-variant/15' : '' }}">
												<span class="text-on-surface-variant uppercase tracking-wide text-2xs font-semibold">Dividends Received</span>
												<span class="font-mono tabular-nums font-bold text-secondary">+${{ userDividendIncome|number_format(2) }}</span>
											</div>
										{% endif %}
									</div>
								{% endif %}

								<form action="/trade/execute" method="POST" class="space-y-3"
											  data-controller="trade-form"
											  data-trade-form-ticker-value="{{ asset.ticker }}"
											  data-trade-form-price-value="{{ asset.price }}"
											  data-action="submit->trade-form#onSubmit">
									<input type="hidden" name="ticker" value="{{ asset.ticker }}">
									<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

									<div class="flex gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20">
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="action" value="BUY" class="peer sr-only" checked>
											<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">
												Buy
											</div>
										</label>
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="action" value="SELL" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">
												Sell
											</div>
										</label>
									</div>

									{# Borrowed sides, shown only on a margin account and only for equities. #}
									{% if not isEtf and app.user and app.user.marginEnabled %}
										<div class="flex gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20">
											<label class="flex-1 cursor-pointer">
												<input type="radio" name="action" value="SHORT" class="peer sr-only">
												<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">
													Short
												</div>
											</label>
											<label class="flex-1 cursor-pointer">
												<input type="radio" name="action" value="COVER" class="peer sr-only">
												<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">
													Cover
												</div>
											</label>
										</div>

										<div class="p-3 rounded bg-surface-container-lowest/80 border border-outline-variant/20 space-y-1.5 text-xs">
											<div class="flex justify-between items-center">
												<span class="text-on-surface-variant uppercase tracking-wide text-2xs font-semibold">Borrow Fee</span>
												<span class="font-mono tabular-nums font-bold {{ borrowFee > 0.05 ? 'text-tertiary' : 'text-on-surface' }}">{{ (borrowFee * 100)|number_format(2) }}%/yr</span>
											</div>
											<div class="flex justify-between items-center">
												<span class="text-on-surface-variant uppercase tracking-wide text-2xs font-semibold">Available to Borrow</span>
												<span class="font-mono tabular-nums font-bold text-on-surface">{{ availableToBorrow|format_large }}</span>
											</div>
											{% if shortUtilization >= 0.90 %}
												<p class="text-2xs text-tertiary leading-relaxed pt-1 border-t border-outline-variant/15">
													{{ (shortUtilization * 100)|number_format(0) }}% of lendable stock is out on loan.
													{{ shortUtilization >= 0.97 ? 'Lenders are recalling: open shorts can be bought in whether or not the account is in good standing.' : 'The borrow is getting expensive.' }}
												</p>
											{% endif %}
										</div>
									{% endif %}

									<div class="flex gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20">
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="orderType" value="MARKET" class="peer sr-only" checked data-action="change->trade-form#onOrderTypeChange">
											<div class="py-1 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-surface-container-high peer-checked:text-primary transition-all">
												Market
											</div>
										</label>
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="orderType" value="LIMIT" class="peer sr-only" data-action="change->trade-form#onOrderTypeChange">
											<div class="py-1 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-surface-container-high peer-checked:text-primary transition-all">
												Limit
											</div>
										</label>
									</div>

									<div id="limit-price-group" class="hidden space-y-1" data-trade-form-target="limitGroup">
										<label for="limitPrice" class="text-sm font-semibold text-on-surface-variant">Limit Price ($)</label>
										<input type="number" step="0.01" min="0.01" id="limitPrice" name="limitPrice" placeholder="{{ asset.price|number_format(2, '.', '') }}" class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none" data-trade-form-target="limitPrice" data-action="input->trade-form#render">
									</div>

									<div class="space-y-1">
										<label for="quantity" class="text-sm font-semibold text-on-surface-variant">Quantity (Shares)</label>
										<input type="number" id="quantity" name="quantity" min="1" max="1000000" value="1" required class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none" data-trade-form-target="quantity" data-action="input->trade-form#render">
									</div>

									<div class="p-3 rounded bg-surface-container-lowest/80 border border-outline-variant/20 flex justify-between items-center text-xs">
										<span class="text-on-surface-variant uppercase tracking-wider font-bold">Estimated Cost</span>
										<span class="font-bold text-on-surface font-mono tabular-nums text-sm" id="estimated-total" data-trade-form-target="estimate" aria-live="polite">${{ asset.price|number_format(2) }}</span>
									</div>

									<button type="submit" data-trade-form-target="submit" class="w-full py-2 px-4 rounded bg-primary text-on-primary font-bold text-xs uppercase tracking-wider hover:brightness-110 active:scale-98 transition-all cursor-pointer disabled:hover:brightness-100 disabled:active:scale-100">Submit Order</button>
								</form>
							{% endif %}
						</div>

						{# Key Fundamentals Grid Card #}
						{% if not isEtf %}
							<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
								<h3 class="text-sm font-semibold text-on-surface mb-3">
									Key Statistics
								</h3>

								<dl class="divide-y divide-outline-variant/15 text-xs">
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Market Cap</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-mkt-cap">{{ marketCap|format_large('$') }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Shares Out</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-shares">{{ asset.sharesOutstanding|number_format }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">P/E Ratio</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-pe">{{ peRatio ? peRatio|number_format(2) ~ 'x' : '-' }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">EPS (TTM)</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-eps">${{ asset.earningsPerShare|number_format(2) }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Dividend Yield</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-div-yield">{{ dividendYield > 0 ? (dividendYield * 100)|number_format(2) ~ '%' : '-' }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Avg Daily Volume</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-adv">{{ advShares|format_large }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Bid-Ask Spread</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-spread">{{ (halfSpread * 20000)|number_format(1) }} bps</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Volatility</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-volatility">{{ ((asset.currentVolatility is not null ? asset.currentVolatility : asset.volatility) * 100)|number_format(2) }}%</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Beta</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums">{{ asset.beta|number_format(2) }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">{{ isFinancial ? 'ROE' : 'ROIC' }}</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-roic">
											{% if isFinancial %}
												{{ ((asset.currentRoe != 0 ? asset.currentRoe : asset.baselineRoe) * 100)|number_format(2) }}%
											{% else %}
												{{ ((asset.currentRoic != 0 ? asset.currentRoic : asset.baselineRoic) * 100)|number_format(2) }}%
											{% endif %}
										</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Book Value (Equity)</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-equity">{{ asset.totalEquity|format_large('$') }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Debt-to-Equity</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-debt-ratio">{{ asset.debtToEquityRatio|number_format(2) }}x</dd>
									</div>
									{% if asset.creditRating is defined %}
										<div class="py-2 flex justify-between items-center">
											<dt class="text-sm font-semibold text-on-surface-variant">Credit Rating</dt>
											<dd class="font-bold text-primary font-mono" id="stat-credit-rating">{{ asset.creditRating }} <span class="text-on-surface-variant font-normal text-2xs">+{{ (asset.creditSpread * 10000)|number_format(0) }} bps</span></dd>
										</div>
									{% endif %}
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
											<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Accruals / Assets</span>
											{{ _self.tooltip('Sloan (1996) accruals ratio: (net income − free cash flow) / total assets, annualised. Cash-backed earnings sit near zero; a high positive reading means reported profit is running ahead of cash and tends to reverse.', 'left', 'w-72') }}
										</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-accruals">{{ asset.accrualsRatio is null ? '-' : ((asset.accrualsRatio >= 0 ? '+' : '') ~ (asset.accrualsRatio * 100)|number_format(2) ~ '%') }}</dd>
									</div>
								</dl>
							</div>
						{% endif %}

						{# Wall Street Analyst Consensus & Price Targets Card #}
						{% if not isEtf and not asset.isBankrupt %}
							<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
								{# Card Header: Title + Recommendation Badge #}
								<div class="flex items-center justify-between gap-3 mb-4">
									<h3 class="text-sm font-semibold text-on-surface">
										Analyst Consensus & Targets
									</h3>

									{% set rating = analystTargets.rating|default('Neutral') %}
									{% set ratingBg = rating == 'Outperform' ? 'bg-secondary/10 border-secondary/20 text-secondary' : (rating == 'Underperform' ? 'bg-tertiary/10 border-tertiary/20 text-tertiary' : 'bg-surface-container-highest border-outline-variant/20 text-on-surface-variant') %}

									<span id="analyst-consensus-badge" class="inline-flex items-center rounded px-2 py-0.5 text-xs font-bold font-mono uppercase tracking-wider border {{ ratingBg }}">
										{{ rating }}
									</span>
								</div>

								{# Main Consensus Target Display #}
								<div class="p-3.5 rounded bg-surface-container-lowest/80 border border-outline-variant/20 mb-3">
									<div class="flex justify-between items-baseline mb-1">
										<span class="text-sm font-semibold text-on-surface-variant">Consensus 12M Target</span>
										{% set upside = analystTargets.upside_pct|default(0) %}
										<span id="target-upside" class="text-xs font-mono tabular-nums font-bold {{ upside > 5 ? 'text-secondary' : (upside < -5 ? 'text-tertiary' : 'text-on-surface-variant') }}">
											{{ upside >= 0 ? '+' : '' }}{{ upside|number_format(1) }}% Implied
										</span>
									</div>

									<div class="flex items-baseline gap-3">
										<span class="text-2xl sm:text-3xl font-bold font-mono tabular-nums tracking-tight text-on-surface" id="target-consensus">
											${{ analystTargets.consensus|default(asset.price)|number_format(2) }}
										</span>
									</div>
								</div>

								{# 3 Distinct Analyst Desk Price Targets #}
								<div class="space-y-2">
									{# 1. Growth & DCF Desk #}
									<div class="p-3 rounded bg-surface-container-lowest/50 border border-outline-variant/10 flex items-center justify-between hover:border-outline-variant/25 transition-all">
										<div class="flex items-center gap-2.5 min-w-0">
											<div class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0">
												<span class="material-symbols-outlined text-sm">trending_up</span>
											</div>
											<div>
												<div class="text-xs font-bold text-on-surface tracking-tight">Growth & DCF Model</div>
												<div class="text-3xs text-on-surface-variant">Forward Earnings & Free Cash Flow DCF</div>
											</div>
										</div>
										<div class="text-right shrink-0">
											<span class="text-sm font-bold font-mono text-on-surface" id="target-growth">
												${{ analystTargets.growth_analyst|default(0)|number_format(2) }}
											</span>
										</div>
									</div>

									{# 2. Value & Book Asset Desk #}
									<div class="p-3 rounded bg-surface-container-lowest/50 border border-outline-variant/10 flex items-center justify-between hover:border-outline-variant/25 transition-all">
										<div class="flex items-center gap-2.5 min-w-0">
											<div class="w-7 h-7 rounded-lg bg-sky-500/10 text-sky-400 flex items-center justify-center shrink-0">
												<span class="material-symbols-outlined text-sm">account_balance</span>
											</div>
											<div>
												<div class="text-xs font-bold text-on-surface tracking-tight">Value & Book Multiple</div>
												<div class="text-3xs text-on-surface-variant">Tangible Equity & Replacement Value</div>
											</div>
										</div>
										<div class="text-right shrink-0">
											<span class="text-sm font-bold font-mono text-on-surface" id="target-value">
												${{ analystTargets.value_analyst|default(0)|number_format(2) }}
											</span>
										</div>
									</div>

									{# 3. Income & DDM Desk #}
									<div class="p-3 rounded bg-surface-container-lowest/50 border border-outline-variant/10 flex items-center justify-between hover:border-outline-variant/25 transition-all">
										<div class="flex items-center gap-2.5 min-w-0">
											<div class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0">
												<span class="material-symbols-outlined text-sm">savings</span>
											</div>
											<div>
												<div class="text-xs font-bold text-on-surface tracking-tight">Income & Yield (DDM)</div>
												<div class="text-3xs text-on-surface-variant">Dividend Discount & Cash Yield Floor</div>
											</div>
										</div>
										<div class="text-right shrink-0">
											<span class="text-sm font-bold font-mono text-on-surface" id="target-income">
												${{ analystTargets.income_analyst|default(0)|number_format(2) }}
											</span>
										</div>
									</div>
								</div>
							</div>
						{% endif %}

						{% if isEtf %}
							{# Index Facts Card: what the level is struck on and when its membership is next reviewed. #}
							<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
								<h3 class="text-sm font-semibold text-on-surface mb-3">
									Index Facts
								</h3>
								<dl class="divide-y divide-outline-variant/15 text-xs">
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Constituents</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums">
											{{ indexFacts.memberCount }}{% if indexFacts.constituentCount is not null %} <span class="text-on-surface-variant font-normal text-2xs">of {{ indexFacts.constituentCount }} seats</span>{% else %} <span class="text-on-surface-variant font-normal text-2xs">whole board</span>{% endif %}
										</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
											<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Float-adjusted cap</span>
											{{ _self.tooltip('The part of each constituent that actually trades, summed. The level is struck on this, not on total market capitalisation: weighting on the whole would have the fund holding stock that is not for sale.', 'left', 'w-72') }}
										</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums">{{ indexFacts.totalFloatCap|format_large('$') }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
											<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Top {{ indexFacts.topN }} weight</span>
											{{ _self.tooltip('Share of the index carried by its largest constituents. The higher it runs, the more the level is a handful of names rather than the market.', 'left', 'w-64') }}
										</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums">{{ indexFacts.topWeight|number_format(1) }}%</dd>
									</div>
									{% if indexFacts.largest %}
										<div class="py-2 flex justify-between items-center">
											<dt class="text-sm font-semibold text-on-surface-variant">Largest holding</dt>
											<dd class="font-bold font-mono tabular-nums"><a href="/stock/{{ indexFacts.largest.ticker }}" class="text-primary hover:underline">{{ indexFacts.largest.ticker }}</a> <span class="text-on-surface">{{ indexFacts.largest.weight|number_format(1) }}%</span></dd>
										</div>
									{% endif %}
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Next review</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums">in {{ indexFacts.daysUntilReconstitution|round }} days</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Last review</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums text-right">
											{% if not indexFacts.hasRoster %}
												<span class="text-on-surface-variant font-normal">pending</span>
											{% elseif indexFacts.added|length == 0 and indexFacts.deleted|length == 0 %}
												<span class="text-on-surface-variant font-normal">no change</span>
											{% else %}
												{% if indexFacts.added|length > 0 %}<span class="text-secondary">+{{ indexFacts.added|length }}</span>{% endif %}
												{% if indexFacts.deleted|length > 0 %}<span class="text-tertiary">&minus;{{ indexFacts.deleted|length }}</span>{% endif %}
											{% endif %}
										</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Reviews per year</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums">{{ indexFacts.reconstitutionsPerYear }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
											<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Divisor</span>
											{{ _self.tooltip('Level = float-adjusted cap of the members / divisor. Restated at every review and every fund split so that a change of composition or of units never moves the level; only prices do.', 'left', 'w-72') }}
										</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums">{{ indexFacts.divisor is null ? '-' : indexFacts.divisor|format_large }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-sm font-semibold text-on-surface-variant">Passive money</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums">{{ indexFacts.carriesPassiveBook ? 'tracks this index' : 'benchmark only' }}</dd>
									</div>
									{% if indexFacts.expenseRatio is not null %}
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
												<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Expense ratio</span>
												{{ _self.tooltip('The annual fee, accrued continuously against net assets. It is met out of the dividend income the fund collects; anything income cannot cover is met by selling holdings, which is what makes the fund fall behind its index.', 'left', 'w-72') }}
											</dt>
											<dd class="font-bold text-on-surface font-mono tabular-nums">{{ indexFacts.expenseRatio|number_format(2) }}%</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
												<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Distribution yield</span>
												{{ _self.tooltip('Paid out over the trailing year, as a share of the current price. The index is a PRICE index and has no yield of its own; this is the dividend cash the fund collected from its constituents and passed on.', 'left', 'w-72') }}
											</dt>
											<dd class="font-bold text-on-surface font-mono tabular-nums">{{ indexFacts.distributionYield|number_format(2) }}%</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
												<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Fees charged</span>
												{{ _self.tooltip('What the fee has come to since the fund opened, per share. It is taken out of the dividend income before that income is distributed, so it never appears as a fall in the price — the holder simply receives less every quarter.', 'left', 'w-72') }}
											</dt>
											<dd class="font-bold text-on-surface font-mono tabular-nums">${{ indexFacts.feesPaidPerShare|number_format(2) }}</dd>
										</div>
										{% if indexFacts.tradingCostsPerShare > 0.005 %}
											<div class="py-2 flex justify-between items-center">
												<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
													<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Trading costs</span>
													{{ _self.tooltip('The spread the fund has crossed rebalancing itself, per share. An index changes its weights by arithmetic; a fund has to trade to follow it. A fund weighted by size pays almost none of this, because its weights maintain themselves as prices move.', 'left', 'w-72') }}
												</dt>
												<dd class="font-bold text-on-surface font-mono tabular-nums">${{ indexFacts.tradingCostsPerShare|number_format(2) }}</dd>
											</div>
										{% endif %}
										{% if indexFacts.trackingDifference > 0.005 %}
											<div class="py-2 flex justify-between items-center">
												<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
													<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Tracking difference</span>
													{{ _self.tooltip('How far the basket has fallen behind the one index unit a share started with. It only ever grows: a fund never buys back what it sold to pay for itself, whether that was a fee income could not cover or the spread on a rebalance.', 'left', 'w-72') }}
												</dt>
												<dd class="font-bold text-on-surface font-mono tabular-nums">&minus;{{ indexFacts.trackingDifference|number_format(2) }}%</dd>
											</div>
										{% endif %}
										{% if indexFacts.accruedIncome > 0 %}
											<div class="py-2 flex justify-between items-center">
												<dt class="group relative cursor-help text-sm font-semibold text-on-surface-variant" tabindex="0">
													<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Income accrued</span>
													{{ _self.tooltip('Dividend cash the fund has collected and not yet distributed, per share. It is already in the price and leaves it at the next distribution — the drop is the payment, not a loss.', 'left', 'w-72') }}
												</dt>
												<dd class="font-bold text-on-surface font-mono tabular-nums">${{ indexFacts.accruedIncome|number_format(2) }}</dd>
											</div>
										{% endif %}
									{% endif %}
								</dl>
							</div>

							{# Weightings Card #}
							<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
								<h3 class="text-sm font-semibold text-on-surface mb-3">
									Constituent Weightings
								</h3>

								<div class="h-64 relative w-full mb-4">
									<canvas id="etfPieChart"></canvas>
								</div>

								{% if components is defined and components|length > 0 %}
									<div class="space-y-2 mt-4 max-h-56 overflow-y-auto custom-scrollbar">
										{% for comp in components %}
											<div class="flex justify-between items-center text-xs p-2 rounded-lg bg-surface-container-lowest/60 border border-outline-variant/5">
												<div class="flex items-center gap-2 min-w-0">
													<span class="text-3xs font-mono text-on-surface-variant/70 w-5 text-right shrink-0">{{ comp.rank }}</span>
													<a href="/stock/{{ comp.ticker }}" class="font-bold text-primary hover:underline font-mono">{{ comp.ticker }}</a>
													<span class="text-on-surface-variant truncate max-w-30">{{ comp.name|default('') }}</span>
													{% if comp.isNew %}<span class="inline-flex items-center rounded bg-secondary/10 px-1.5 py-0.5 text-4xs font-bold text-secondary border border-secondary/25 uppercase tracking-widest shrink-0">New</span>{% endif %}
												</div>
												<span class="font-bold text-on-surface font-mono tabular-nums" id="idx-weight-{{ comp.ticker }}">{{ comp.weight|default(0)|number_format(2) }}%</span>
											</div>
										{% endfor %}
									</div>
								{% endif %}
							</div>
						{% endif %}

					</div>
				</div>
			</div>

			{# ========================================================================= #}
			{# TAB 2 (INDEX): CONSTITUENTS & METHODOLOGY #}
			{# ========================================================================= #}
				{% if isEtf %}
					<div
					id="stock-tab-content-constituents" class="stock-tab-panel hidden space-y-6" data-tabs-target="panel" data-tab-panel="constituents">
					{# Header: what the index is for #}
					<div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-surface-container-low p-6 rounded-lg border border-outline-variant/15 gap-4">
						<div>
							<div class="flex items-center gap-2 mb-1">
								<span class="material-symbols-outlined text-primary text-base">checklist</span>
								<span class="text-3xs font-bold tracking-widest text-primary uppercase font-mono">{{ indexFacts.label }}</span>
							</div>
							<h2 class="text-xl md:text-2xl font-bold text-on-surface">{{ indexFacts.indexName }} constituents</h2>
							<p class="text-xs text-on-surface-variant mt-0.5 text-on-surface-variant/80">{{ asset.name }} tracks the {{ indexFacts.indexName }}, published by <a href="/stock/{{ indexFacts.indexProviderTicker }}" class="text-primary hover:underline">{{ indexFacts.indexProvider }}</a>.</p>
							<p class="text-xs text-on-surface-variant mt-1 max-w-3xl">{{ indexFacts.mandate }}</p>
						</div>
						<div class="grid grid-cols-3 gap-3 shrink-0">
							<div class="bg-surface-container-lowest rounded border border-outline-variant/20 px-4 py-3 text-center">
								<div class="text-2xs font-bold uppercase tracking-wider text-on-surface-variant">Members</div>
								<div class="text-lg font-bold font-mono tabular-nums text-on-surface mt-0.5">{{ indexFacts.memberCount }}</div>
							</div>
							<div class="bg-surface-container-lowest rounded border border-outline-variant/20 px-4 py-3 text-center">
								<div class="text-2xs font-bold uppercase tracking-wider text-on-surface-variant">Listed</div>
								<div class="text-lg font-bold font-mono tabular-nums text-on-surface mt-0.5">{{ indexFacts.listedCount }}</div>
							</div>
							<div class="bg-surface-container-lowest rounded border border-outline-variant/20 px-4 py-3 text-center">
								<div class="text-2xs font-bold uppercase tracking-wider text-on-surface-variant">Next review</div>
								<div class="text-lg font-bold font-mono tabular-nums text-on-surface mt-0.5">{{ indexFacts.daysUntilReconstitution|round }}d</div>
							</div>
						</div>
					</div>

					<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
						{# Left: the full constituent table #}
						<div class="lg:col-span-8 space-y-6">
							<div class="bg-surface-container-low rounded-lg border border-outline-variant/15 overflow-hidden">
								<div class="px-5 py-4 border-b border-outline-variant/15 flex items-center justify-between">
									<div>
										<h3 class="text-sm font-semibold text-on-surface">Constituents</h3>
										<p class="text-xs text-on-surface-variant mt-0.5">Ranked on {{ indexFacts.rankingLabel|lower }} across {{ indexFacts.universe }}, weighted by {{ indexFacts.weightingLabel|lower }}. Weights repaint live and drift with prices between reviews.</p>
									</div>
								</div>
								<div class="overflow-x-auto">
									<table class="w-full text-left border-collapse">
										<thead>
											<tr class="bg-surface-container-highest/20 text-on-surface-variant text-2xs font-semibold uppercase tracking-wide border-b border-outline-variant/15">
												<th scope="col" class="px-4 py-3 text-right w-12">#</th>
												<th scope="col" class="px-4 py-3">Company</th>
												<th scope="col" class="px-4 py-3 hidden md:table-cell">Sector</th>
												<th scope="col" class="px-4 py-3 text-right">Price</th>
												<th scope="col" class="px-4 py-3 text-right hidden sm:table-cell" title="Change over the trailing one-month buffered window">1M</th>
												<th scope="col" class="px-4 py-3 text-right hidden sm:table-cell">Float cap</th>
												<th scope="col" class="px-5 py-3 text-right w-40">Weight</th>
											</tr>
										</thead>
										<tbody class="divide-y divide-outline-variant/10 text-sm">
											{% for comp in components %}
												<tr id="idx-row-{{ comp.ticker }}" data-float-cap="{{ comp.adjustedCap }}" class="hover:bg-surface-container-high/30 transition-colors group relative">
													<td class="px-4 py-3 text-right font-mono text-xs text-on-surface-variant tabular-nums">{{ comp.rank }}</td>
													<th scope="row" class="px-4 py-3 text-left font-normal">
														<div class="flex items-center gap-2">
															<a href="/stock/{{ comp.ticker }}" class="font-bold text-on-surface text-sm group-hover:text-primary transition-colors outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:decoration-primary focus-visible:underline-offset-4">{{ comp.name }}</a>
															{% if comp.isNew %}<span class="relative z-10 inline-flex items-center rounded bg-secondary/10 px-1.5 py-0.5 text-4xs font-bold text-secondary border border-secondary/25 uppercase tracking-widest">New</span>{% endif %}
														</div>
														<div class="text-on-surface-variant text-xs tracking-wide font-mono mt-0.5">{{ comp.ticker }}</div>
													</th>
													<td class="px-4 py-3 hidden md:table-cell text-on-surface-variant text-xs">{{ comp.sector }}</td>
													<td class="px-4 py-3 text-right font-bold font-mono tabular-nums text-xs sm:text-sm text-on-surface" id="idx-price-{{ comp.ticker }}">${{ comp.price|number_format(2) }}</td>
													<td class="px-4 py-3 text-right font-semibold font-mono tabular-nums text-xs sm:text-sm hidden sm:table-cell {{ comp.changePercent is null ? 'text-on-surface-variant/50' : (comp.changePercent >= 0 ? 'text-secondary' : 'text-tertiary') }}">
														{%- if comp.changePercent is null -%}&mdash;{%- else -%}{{ comp.changePercent >= 0 ? '+' : '' }}{{ (comp.changePercent * 100)|number_format(2) }}%{%- endif -%}
													</td>
													<td class="px-4 py-3 text-right font-mono tabular-nums text-xs sm:text-sm text-on-surface-variant hidden sm:table-cell">{{ comp.floatCap|format_large('$') }}</td>
													<td class="px-5 py-3 text-right">
														<div class="flex items-center justify-end gap-3">
															<div class="h-1.5 w-20 bg-surface-container-highest rounded overflow-hidden hidden sm:block" aria-hidden="true">
																<div id="idx-bar-{{ comp.ticker }}" class="h-1.5 bg-primary rounded" style="width: {{ comp.weight|number_format(2, '.', '') }}%"></div>
															</div>
															<div class="w-16 text-right">
												<span class="font-bold font-mono tabular-nums text-xs sm:text-sm text-on-surface block" id="idx-weight-{{ comp.ticker }}">{{ comp.weight|number_format(2) }}%</span>
												{# Where the review set it, shown only once the live weight has drifted off it. A capped name
												   above its cap is the commonest case and the one most likely to read as a broken cap: the
												   fund holds the shares it bought at the review and does not trade again until the next one. #}
												{% if comp.targetWeight is not null and (comp.weight - comp.targetWeight)|abs >= 0.05 %}
													<span class="group relative cursor-help text-4xs font-mono text-on-surface-variant/70 block" tabindex="0">
														{{ comp.targetWeight|number_format(2) }}% set
														{{ _self.tooltip('The weight the last review set. Weights drift with prices between reviews because the fund holds a fixed number of shares &mdash; it does not trade again until the next review pulls it back to target.', 'left', 'w-64') }}
													</span>
												{% endif %}
											</div>
														</div>
													</td>
												</tr>
											{% else %}
												<tr>
													<td colspan="7" class="px-5 py-8 text-center text-xs text-on-surface-variant font-serif">No membership has been taken yet. The committee meets on the first tick of a fresh market.</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>
						</div>

						{# Right: sectors, the last review, the boundary, the method #}
						<div class="lg:col-span-4 space-y-6">
							{# Sector weights #}
							<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
								<h3 class="text-sm font-semibold text-on-surface mb-3">Sector Weights</h3>
								<div class="space-y-2.5">
									{% for row in indexFacts.sectorWeights %}
										<div>
											<div class="flex justify-between items-center text-xs mb-1">
												<span class="text-on-surface-variant">{{ row.sector }} <span class="text-3xs font-mono text-on-surface-variant/60">({{ row.count }})</span></span>
												<span class="font-bold font-mono tabular-nums text-on-surface">{{ row.weight|number_format(1) }}%</span>
											</div>
											<div class="h-1.5 bg-surface-container-highest rounded overflow-hidden" aria-hidden="true">
												<div class="h-1.5 bg-primary/70 rounded" style="width: {{ row.weight|number_format(2, '.', '') }}%"></div>
											</div>
										</div>
									{% else %}
										<p class="text-xs text-on-surface-variant font-serif">No constituents.</p>
									{% endfor %}
								</div>
							</div>

							{# Last review #}
							<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
								<div class="flex items-center justify-between mb-3">
									<h3 class="text-sm font-semibold text-on-surface">Last Review</h3>
									{% if indexFacts.daysSinceReconstitution is not null %}
										<span class="text-3xs font-mono text-on-surface-variant">{{ indexFacts.daysSinceReconstitution|round }} days ago</span>
									{% endif %}
								</div>
								{% if not indexFacts.hasRoster %}
									<p class="text-xs text-on-surface-variant font-serif">No review has been held yet.</p>
								{% elseif indexFacts.added|length == 0 and indexFacts.deleted|length == 0 %}
									<p class="text-xs text-on-surface-variant font-serif">The membership was confirmed unchanged.</p>
								{% else %}
									<div class="space-y-3 text-xs">
										{% if indexFacts.added|length > 0 %}
											<div>
												<div class="text-2xs font-semibold uppercase tracking-wide text-secondary mb-1.5">Admitted</div>
												<div class="flex flex-wrap gap-1.5">
													{% for t in indexFacts.added %}<a href="/stock/{{ t }}" class="inline-flex items-center rounded bg-secondary/10 px-2 py-0.5 font-mono font-bold text-secondary border border-secondary/25 hover:bg-secondary/20">{{ t }}</a>{% endfor %}
												</div>
											</div>
										{% endif %}
										{% if indexFacts.deleted|length > 0 %}
											<div>
												<div class="text-2xs font-semibold uppercase tracking-wide text-tertiary mb-1.5">Dropped</div>
												<div class="flex flex-wrap gap-1.5">
													{% for t in indexFacts.deleted %}<a href="/stock/{{ t }}" class="inline-flex items-center rounded bg-tertiary/10 px-2 py-0.5 font-mono font-bold text-tertiary border border-tertiary/25 hover:bg-tertiary/20">{{ t }}</a>{% endfor %}
												</div>
											</div>
										{% endif %}
									</div>
								{% endif %}
							</div>

							{# The boundary, for a selective index #}
							{% if indexFacts.isSelective %}
								<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
									<div class="flex items-center justify-between mb-1">
										<h3 class="text-sm font-semibold text-on-surface">The Boundary</h3>
										{% if indexFacts.bands %}
											<span class="text-3xs font-mono text-on-surface-variant">bands #{{ indexFacts.bands.inner }} / #{{ indexFacts.bands.outer }}</span>
										{% endif %}
									</div>
									<p class="text-xs text-on-surface-variant font-serif leading-relaxed mb-4">
										A member keeps its seat until it ranks past #{{ indexFacts.bands ? indexFacts.bands.outer : '?' }}; an outsider is admitted once it ranks inside #{{ indexFacts.bands ? indexFacts.bands.inner : '?' }}, displacing the weakest member. Between the two nothing happens, which is what stops the boundary churning every quarter.
									</p>
									<div class="space-y-4 text-xs">
										<div>
											<div class="text-2xs font-semibold uppercase tracking-wide text-tertiary mb-1.5">Exposed members</div>
											{% for row in indexFacts.atRisk %}
												<div class="flex justify-between items-center py-1.5 border-b border-outline-variant/10 last:border-0">
													<div class="flex items-center gap-2 min-w-0">
														<span class="font-mono text-on-surface-variant/70 w-8 text-right shrink-0">#{{ row.rank }}</span>
														<a href="/stock/{{ row.ticker }}" class="font-bold font-mono text-primary hover:underline">{{ row.ticker }}</a>
														<span class="text-on-surface-variant truncate">{{ row.name }}</span>
													</div>
													{% if row.exits %}<span class="inline-flex items-center rounded bg-tertiary/10 px-1.5 py-0.5 text-4xs font-bold text-tertiary border border-tertiary/25 uppercase tracking-widest shrink-0">Drops next review</span>{% endif %}
												</div>
											{% else %}
												<p class="text-on-surface-variant font-serif">None. Every member ranks inside the inner band.</p>
											{% endfor %}
										</div>
										<div>
											<div class="text-2xs font-semibold uppercase tracking-wide text-secondary mb-1.5">In contention</div>
											{% for row in indexFacts.contenders %}
												<div class="flex justify-between items-center py-1.5 border-b border-outline-variant/10 last:border-0">
													<div class="flex items-center gap-2 min-w-0">
														<span class="font-mono text-on-surface-variant/70 w-8 text-right shrink-0">#{{ row.rank }}</span>
														<a href="/stock/{{ row.ticker }}" class="font-bold font-mono text-primary hover:underline">{{ row.ticker }}</a>
														<span class="text-on-surface-variant truncate">{{ row.name }}</span>
													</div>
													{% if row.qualifies %}<span class="inline-flex items-center rounded bg-secondary/10 px-1.5 py-0.5 text-4xs font-bold text-secondary border border-secondary/25 uppercase tracking-widest shrink-0">Joins next review</span>{% endif %}
												</div>
											{% else %}
												<p class="text-on-surface-variant font-serif">None. No outsider ranks inside the outer band.</p>
											{% endfor %}
										</div>
									</div>
								</div>
							{% endif %}

							{# Method #}
							<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
								<h3 class="text-sm font-semibold text-on-surface mb-3">Methodology</h3>
								<dl class="space-y-3 text-xs">
									<div>
										<dt class="font-semibold text-on-surface">Index</dt>
										<dd class="text-on-surface-variant font-serif leading-relaxed">{{ asset.name }} is the fund; the {{ indexFacts.indexName }} is the index it tracks, published by <a href="/stock/{{ indexFacts.indexProviderTicker }}" class="text-primary hover:underline">{{ indexFacts.indexProvider }}</a>. They are separate things and the fund does not decide the index &mdash; it licenses it, out of the fee below.{% if indexFacts.providerIsConstituent %} The publisher is also the largest company in the index it publishes, which is a conflict the methodology discloses rather than resolves.{% endif %}</dd>
									</div>
									<div>
										<dt class="font-semibold text-on-surface">Universe</dt>
										<dd class="text-on-surface-variant font-serif leading-relaxed">{{ indexFacts.universe }}, ranked on: {{ indexFacts.rankingLabel|lower }}. Everything below applies to that universe and nothing outside it.{% if indexFacts.screensEarnings %} Admission additionally requires profitability &mdash; trailing twelve-month earnings and the most recent quarter both positive &mdash; and that test governs joining, never staying: a member that falls into losses keeps its seat until the bands take it.{% endif %}</dd>
									</div>
									<div>
										<dt class="font-semibold text-on-surface">Weighting</dt>
										<dd class="text-on-surface-variant font-serif leading-relaxed">{{ indexFacts.weightingLabel }}. {{ indexFacts.weightingDescription }}{% if indexFacts.isCapped %} Capped at each review at {{ indexFacts.maxConstituentWeight|number_format(1) }}% per constituent, with the excess redistributed across the rest &mdash; between reviews a constituent that outruns the index carries more than the cap, because the fund holds the shares it bought and does not trade until the next review{% if indexFacts.appliesConcentrationBudget %} &mdash; a sector this narrow cannot be sold as a diversified fund otherwise{% endif %}.{% endif %}</dd>
									</div>
									<div>
										<dt class="font-semibold text-on-surface">Level</dt>
										<dd class="text-on-surface-variant font-serif leading-relaxed">Members' float-adjusted cap, each carrying the weight factor fixed at the last review, divided by a divisor. The divisor is restated at every review and every fund split, so composition and re-weighting never move the level; only prices do. Between reviews the weights drift with prices, as a real fund's holdings do. A fresh market opens at {{ constant('App\\Service\\Math\\FinancialConstants::INDEX_BASE_LEVEL')|number_format(0) }}.</dd>
									</div>
									<div>
										<dt class="font-semibold text-on-surface">Review</dt>
										<dd class="text-on-surface-variant font-serif leading-relaxed">{{ indexFacts.reconstitutionsPerYear }} times a year. {% if indexFacts.isSelective %}Membership is banded: a &plusmn;{{ (constant('App\\Service\\Math\\FinancialConstants::INDEX_MEMBERSHIP_BUFFER') * 100)|number_format(0) }}% buffer around the cut, so a marginal overtake buys nothing and a clear one gets in.{% else %}Every name in the universe is a member; the review only removes what has been delisted or has left it.{% endif %} A bankrupt shell leaves at the first review after it dies.</dd>
									</div>
									{% if indexFacts.expenseRatio is not null %}
										<div>
											<dt class="font-semibold text-on-surface">Fees and income</dt>
											<dd class="text-on-surface-variant font-serif leading-relaxed">The fund holds the basket, so it receives the dividends its constituents pay and passes them on {{ constant('App\\Service\\Math\\FinancialConstants::FUND_DISTRIBUTIONS_PER_YEAR') }} times a year; the level above is a price index and shows none of that. Its {{ indexFacts.expenseRatio|number_format(2) }}% fee is charged against net assets and met out of that income first, so a distribution is net of what the fund costs to run. Only where income falls short does the fund sell holdings, which is why its price can track the index exactly while its holders are still paying for it: the cost is the ${{ indexFacts.feesPaidPerShare|number_format(2) }} a share that never reached a distribution.{% if indexFacts.tradingCostsPerShare > 0.005 %} The fee is not the only cost. This index restrikes its weights at every review, and the fund has to trade to follow it: ${{ indexFacts.tradingCostsPerShare|number_format(2) }} a share has gone in spread doing so, out of the basket rather than out of income, because a spread is paid inside the trade.{% endif %}</dd>
