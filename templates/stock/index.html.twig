{% extends 'base.html.twig' %}

{# --- TOOLTIP MACRO --- #}
{% macro tooltip(text, position = 'left', width = 'w-48') %}
	{% set arrowPosition = position == 'right' ? 'right-4' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-4') %}
	{% set alignClass = position == 'right' ? 'right-0' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-0') %}

	<span role="tooltip" class="block pointer-events-none absolute {{ alignClass }} bottom-full mb-2.5 {{ width }} p-2.5 bg-[#0f172a] text-white text-[11px] leading-relaxed rounded-lg shadow-2xl opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 group-focus:opacity-100 group-focus:translate-y-0 transition-all duration-200 z-[100] normal-case tracking-normal font-normal border border-slate-700">
		{{ text }}
		<span class="block absolute -bottom-[5px] {{ arrowPosition }} w-2.5 h-2.5 bg-[#0f172a] border-b border-r border-slate-700 transform rotate-45"></span>
	</span>
{% endmacro %}


{% block title %}
	{{ asset.ticker }}
	Stock Price & Analysis |
	{{ asset.name }}
	- Aerie Exchange
{% endblock %}

{% block meta %}
	<meta name="description" content="View live stock prices, market cap, and fundamental Clean Surplus accounting data for {{ asset.name }} ({{ asset.ticker }}). See the latest quarterly earnings reports and historical charts.">
	<meta property="og:title" content="{{ asset.ticker }} Stock Price | Aerie Exchange">
	<meta property="og:description" content="Live financial data and economic simulation for {{ asset.name }} ({{ isEtf ? 'Market Index' : asset.industry|default('General') }}).">
	<meta property="og:type" content="website">

	<script type="application/ld+json">
		{
		            "@context": "https://schema.org",
		            "@type": "{{ isEtf ? 'InvestmentFund' : 'Corporation' }}",
		            "name": "{{ asset.name }}",
		            "tickerSymbol": "{{ asset.ticker }}",
		            "description": "Live financial data and economic simulation for
		{{ asset.name }}.",
		            "url": "{{ app.request.uri }}"
		{% if isEtf and allAssets is defined %},
			                "hasPart": [
			{% for a in allAssets %}
				{
				                            "@type": "Corporation",
				                            "name": "{{ a.name }}",
				                            "tickerSymbol": "{{ a.ticker }}"
				                        }{{ not loop.last ? ',' : '' }}
			{% endfor %}
			]
		{% endif %}
		}
	</script>
{% endblock %}

{% block favicon %}
	<link rel="icon" href="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" type="image/svg+xml">
{% endblock %}

{% block body %}

	<div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-4 lg:py-8 w-full">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

			<div class="lg:col-span-8 space-y-6 lg:space-y-8">

				<div class="bg-surface-container-low shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)] rounded-2xl p-6 lg:p-8 border border-outline-variant/15">
					<div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 mb-8">
						<div>
							<div class="flex items-center gap-3 mb-2">
								<h1 class="text-3xl font-bold text-on-surface tracking-tight">{{ asset.name }}</h1>
								<img class="w-14 h-14 rounded-full" src="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" onerror="this.onerror=null; this.src='{{ asset('icons/default.svg') }}';" alt="{{ asset.ticker }} icon">
								<span class="inline-flex items-center rounded-md bg-surface-container-highest px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
									{{ isEtf ? 'Market Index' : asset.industry|default('General') }}
								</span>

							</div>
							<p class="text-lg text-on-surface-variant">{{ asset.ticker }}</p>


						</div>
						<div class="md:text-right">
							<div class="flex items-center md:justify-end gap-2 mb-1">
								<span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
								<span class="text-[10px] font-bold tracking-widest text-secondary uppercase" id="live-indicator">Live Market</span>
							</div>
							<span class="block text-4xl md:text-5xl font-bold text-on-surface tracking-tighter transition-colors duration-300" id="big-price">
								${{ asset.price|number_format(2) }}
							</span>
						</div>
					</div>

					<div class="flex overflow-x-auto gap-1 sm:gap-2 mb-4 bg-surface-container-lowest p-1 rounded-lg w-full md:w-max [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="1w">1W</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="1m">1M</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="6m">6M</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-primary text-[#001a42] shadow-md shadow-primary/20 transition-colors text-center" data-range="1y">1Y</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="3y">3Y</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="5y">5Y</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="10y">10Y</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="max">MAX</button>
					</div>

					<div
						class="w-full h-[300px] md:h-[450px] relative rounded-xl overflow-hidden">

						{#SPINNER#}
						<div id="chart-spinner" class="hidden absolute inset-0 z-50 flex items-center justify-center bg-surface-container-low/60 backdrop-blur-sm transition-opacity duration-300">
							<svg class="animate-spin h-12 w-12 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24">
								<circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</div>

						<div id="mainChartContainer" class="w-full h-full"></div>
					</div>
				</div>

				<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 lg:p-8 border border-outline-variant/15">
					<h3 class="text-sm font-bold uppercase tracking-widest text-primary mb-4">About
						{{ asset.name }}</h3>
					<div class="text-base font-serif text-on-surface-variant leading-relaxed tracking-wide">
						<p>{{ generalInfo|nl2br }}</p>
					</div>
				</div>

				{# --- FUNDAMENTALS DASHBOARD --- #}
				{% if not isEtf %}
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-2">

						<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Net Income Trend</span>
									{{ _self.tooltip('Tracks the total Revenue and Net Income generated each quarter.', 'left', 'w-64') }}
								</h3>
								<div class="flex space-x-2 bg-surface-container-lowest p-1 rounded-lg">
									<button onclick="updateCharts('12Q')" id="btn-12Q" class="px-3 py-1 text-[10px] font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors uppercase tracking-widest">12Q</button>
									<button onclick="updateCharts('5Y')" id="btn-5Y" class="px-3 py-1 text-[10px] font-bold rounded-md bg-primary text-[#001a42] shadow-lg shadow-primary/20 transition-colors uppercase tracking-widest">12Y</button>
								</div>
							</div>
							<div class="relative h-48 w-full">
								<canvas id="netIncomeChart"></canvas>
							</div>
						</div>

						<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Debt vs Equity</span>
									{{ _self.tooltip("Visualizes the company's capital structure. Total Equity (Book Value) compared against Total Debt.", 'right', 'w-64') }}
								</h3>
							</div>
							<div class="relative h-48 w-full">
								<canvas id="debtEquityChart"></canvas>
							</div>
						</div>

						<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Credit Health & Maturity Wall</span>
									{{ _self.tooltip('Displays the Interest Coverage Ratio (ability to pay interest from operating profit) and the Blended Interest Rate on existing debt.', 'left', 'w-64') }}
								</h3>
							</div>
							<div class="relative h-48 w-full">
								<canvas id="creditHealthChart"></canvas>
							</div>
						</div>

						<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Capital Efficiency</span>
									{{ _self.tooltip('Shows Economic Value Added (EVA) and Return on Invested Capital (ROIC). Positive EVA means the company is creating true wealth above its capital costs.', 'right', 'w-64') }}
								</h3>
							</div>
							<div class="relative h-48 w-full">
								<canvas id="capitalEfficiencyChart"></canvas>
							</div>
						</div>

						<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Shareholder Yield</span>
									{{ _self.tooltip('Tracks capital returned to shareholders via Cash Dividends and Share Buybacks each quarter.', 'left', 'w-64') }}
								</h3>
							</div>
							<div class="relative h-48 w-full">
								<canvas id="capitalReturnChart"></canvas>
							</div>
						</div>

						<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Leveraged Metrics</span>
									{{ _self.tooltip('Displays Return on Equity (ROE) and the Capital Ratio (Equity vs Total Assets). Critical health indicators for banks and financial institutions.', 'right', 'w-64') }}
								</h3>
							</div>
							<div class="relative h-48 w-full">
								<canvas id="leveragedHealthChart"></canvas>
							</div>
						</div>

					</div>
				{% endif %}
			</div>

			<div class="lg:col-span-4 space-y-6 lg:space-y-8">

				<div class="glass-panel rounded-2xl p-6 lg:p-8 border border-primary/20 shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)] relative overflow-hidden">
					<div class="absolute -right-10 -top-10 w-40 h-40 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

					<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface mb-6 flex items-center gap-2">
						<span class="material-symbols-outlined text-primary text-sm">swap_horiz</span>
						Execute Trade
					</h3>

					{% if userQuantity > 0 %}
						<div class="mb-6 p-4 bg-surface-container-lowest/50 rounded-xl border border-outline-variant/10">
							<div class="flex justify-between items-center">
								<span class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Your Position</span>
								<span class="text-sm font-bold text-on-surface">{{ userQuantity|number_format }}
									Shares</span>
							</div>
							<div class="flex justify-between items-center mt-2">
								<span class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Market Value</span>
								<span class="text-sm font-bold text-secondary" id="user-holding-value">${{ (userQuantity * asset.price)|number_format(2) }}</span>
							</div>
						</div>
					{% endif %}

					<form action="/trade/execute" method="POST" class="space-y-5 relative z-10">
						<input type="hidden" name="ticker" value="{{ asset.ticker }}">

						<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

						<div>
							<label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2">Quantity ({{ asset.ticker }})</label>
							<div class="relative">
								<input type="number" name="quantity" min="1" value="10" class="w-full bg-surface-container-highest border-none rounded-xl text-lg font-bold text-on-surface focus:ring-1 focus:ring-primary py-4 px-4 transition-all">
							</div>
						</div>

						<div class="grid grid-cols-2 gap-3 pt-2">
							<button type="submit" name="action" value="BUY" class="flex w-full justify-center rounded-xl bg-secondary px-3 py-3.5 text-sm font-bold text-[#002113] shadow-lg shadow-secondary/20 hover:brightness-110 active:scale-95 transition-all">
								BUY
							</button>
							<button type="submit" name="action" value="SELL" class="flex w-full justify-center rounded-xl bg-surface-container-high px-3 py-3.5 text-sm font-bold text-on-surface hover:bg-surface-bright active:scale-95 transition-all">
								SELL
							</button>
						</div>
					</form>
				</div>

				{% if not isEtf %}
					<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15">
						<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface mb-6">Market Fundamentals</h3>


						<dl class="divide-y divide-outline-variant/5">
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Market Cap</span>
									{{ _self.tooltip("The total valuation of the company's outstanding equity. (Price × Shares)") }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-mkt-cap">${{ marketCap|format_large }}</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Shares Out</span>
									{{ _self.tooltip('The total number of shares currently issued and held by the market.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-shares">{{ asset.sharesOutstanding|number_format }}</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">P/E Ratio</span>
									{{ _self.tooltip('Price-to-Earnings. Measures the share price relative to the per-share profits.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-pe">{{ peRatio|number_format(2) }}</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">EPS (TTM)</span>
									{{ _self.tooltip("Earnings Per Share (Trailing 12 Months). The company's total net income divided by its shares.") }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-eps">${{ asset.earningsPerShare|number_format(2) }}</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Volatility</span>
									{{ _self.tooltip('A statistical measure of the dispersion of returns. Higher values indicate a riskier stock.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-volatility">{{ ((asset.currentVolatility ?? asset.volatility) * 100)|number_format(2) }}%</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Beta</span>
									{{ _self.tooltip('Measures volatility relative to the market (LBI). > 1.0 is more volatile, < 1.0 is defensive.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface">{{ asset.beta|number_format(2) }}</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">ROIC</span>
									{{ _self.tooltip('Return on Invested Capital. How efficiently the company utilizes capital to generate profit.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-roic">{{ (asset.currentRoic|default(0) * 100)|number_format(2) }}%</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Total Cash</span>
									{{ _self.tooltip('Corporate Treasury. The total cash and liquid reserves sitting on the balance sheet.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-treasury">${{ asset.corporateTreasury|format_large }}</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Book Value</span>
									{{ _self.tooltip('Total Equity. The absolute net value of the company if all debts were paid and assets liquidated.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-equity">${{ asset.totalEquity|format_large }}</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">D/E</span>
									{{ _self.tooltip('Debt-to-Equity Ratio. Measures financial leverage. A higher ratio indicates dangerous debt levels.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-debt-ratio">{{ asset.debtToEquityRatio|number_format(2) }}x</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Market Share</span>
									{{ _self.tooltip("The company's dominance of its sector, measured against the broader District GDP (Evaluates Equity for Banks).") }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-market-share">{{ (marketShare * 100)|number_format(2) }}%</dd>
							</div>
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Jump Intensity</span>
									{{ _self.tooltip('The frequency of sudden, massive price shocks caused by corporate events or systemic panics.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface">{{ asset.jumpIntensity }}</dd>
							</div>
						</dl>

						{% if isLeveraged|default(false) %}
							{# DEDICATED ASSET BREAKDOWN VISUALIZATION FOR BANKS #}
							<div class="mt-6 p-4 bg-surface-container-highest rounded-xl border border-outline-variant/20 shadow-inner">
								<div class="flex justify-between items-center mb-3">
									<h4 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant flex items-center gap-1.5">
										<span class="material-symbols-outlined text-[14px]">account_balance</span>
										Asset Breakdown</h4>
									<span class="text-[10px] font-bold text-on-surface-variant">Total Assets: $<span id="stat-total-assets">{{ (asset.corporateTreasury + investedCapital)|format_large }}</span>
									</span>
								</div>

								{% set totalAssets = asset.corporateTreasury + investedCapital %}
								{% set loanPct = totalAssets > 0 ? (investedCapital / totalAssets) * 100 : 0 %}
								{% set cashPct = totalAssets > 0 ? (asset.corporateTreasury / totalAssets) * 100 : 0 %}

								<div class="w-full h-2.5 flex rounded-full overflow-hidden mb-3 bg-surface-container-low border border-outline-variant/10">
									<div id="bar-loan-book" class="bg-primary transition-all duration-500" style="width: {{ loanPct }}%;" title="Loan Book: {{ loanPct|number_format(1) }}%"></div>
									<div id="bar-cash" class="bg-secondary transition-all duration-500" style="width: {{ cashPct }}%;" title="Vault Cash: {{ cashPct|number_format(1) }}%"></div>
								</div>

								<div class="flex justify-between items-start text-[10px] font-bold uppercase tracking-widest mt-2">
									<div class="text-primary group relative cursor-help">
										<span class="border-b border-dotted border-primary/50">Loan Book ({{ loanPct|number_format(1) }}%)</span>
										<div class="text-sm font-bold text-on-surface mt-1">$<span id="stat-loan-book">{{ investedCapital|format_large }}</span></div>
										{{ _self.tooltip('The total value of active loans and credit facilities generating interest income. This is the core engine', 'left', 'w-56') }}
									</div>
									<div class="text-secondary group relative cursor-help text-right">
										<span class="border-b border-dotted border-secondary/50">Vault Cash ({{ cashPct|number_format(1) }}%)</span>
										<div class="text-sm font-bold text-on-surface mt-1">$<span id="stat-vault-cash">{{ asset.corporateTreasury|format_large }}</span></div>
										{{ _self.tooltip('Fractional reserve cash held at the Central Bank to safely cover customer deposit withdrawals.', 'right', 'w-56') }}
									</div>
								</div>
							</div>
						{% endif %}
					</div>

					<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15">
						<div class="flex justify-between items-center mb-6">
							<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface flex items-center gap-2">
								<span class="material-symbols-outlined text-sm">query_stats</span>
								Analyst Consensus
							</h3>
							<span id="analyst-consensus-badge" class="hidden px-2 py-1 text-[10px] font-bold rounded-md uppercase tracking-widest"></span>
						</div>

						{# Add this new Blended Fair Value Box #}
						<div class="flex justify-between items-center pb-4 mb-4 border-b border-outline-variant/20 bg-surface-container-highest p-4 rounded-xl">
							<div>
								<p class="text-xs font-bold uppercase tracking-widest text-primary">Consensus Fair Value</p>
								<p class="text-[10px] text-on-surface-variant mt-1">Blended Target</p>
							</div>
							<div class="text-right">
								<p class="text-xl font-bold text-on-surface" id="target-consensus">--</p>
							</div>
						</div>

						<div class="space-y-4">

							<div class="space-y-4">
								<div class="flex justify-between items-center pb-4 border-b border-outline-variant/10">
									<div>
										<p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Growth Analyst</p>
										<p class="text-xs text-on-surface-variant mt-0.5">DCF & Earnings</p>
									</div>
									<div class="text-right">
										<p class="text-sm font-bold text-on-surface" id="target-growth">--</p>
									</div>
								</div>
								<div class="flex justify-between items-center pb-4 border-b border-outline-variant/10">
									<div>
										<p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Income Analyst</p>
										<p class="text-xs text-on-surface-variant mt-0.5">Dividend Yield</p>
									</div>
									<div class="text-right">
										<p class="text-sm font-bold text-on-surface" id="target-income">--</p>
									</div>
								</div>
								<div class="flex justify-between items-center">
									<div>
										<p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Value Analyst</p>
										<p class="text-xs text-on-surface-variant mt-0.5">Liquidation Floor</p>
									</div>
									<div class="text-right">
										<p class="text-sm font-bold text-on-surface" id="target-value">--</p>
									</div>
								</div>
							</div>
						</div>
					</div>

				{% else %}
					<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15">

						<div class="flex justify-between items-center mb-6 pb-4 border-b border-outline-variant/10">
							<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Index Composition</span>
								{{ _self.tooltip('The percentage weight of each company in the index, based on their live Market Capitalization.', 'left', 'w-64') }}
							</h3>

							<div class="flex items-center gap-2">
								<span class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">District Volatility (VIX):</span>
								<span id="district-vix" class="text-sm font-bold text-on-surface transition-colors">15.00%</span>
							</div>
						</div>

						{# DISTRICT MACROECONOMICS DASHBOARD #}
						<div class="bg-surface-container-lowest rounded-xl p-4 border border-outline-variant/10 mb-6">
							<h4 class="text-[10px] font-bold uppercase tracking-widest text-primary mb-4 flex items-center gap-2">
								<span class="material-symbols-outlined text-sm">monitoring</span>
								Real-Time Macroeconomics
							</h4>

							<div
								class="grid grid-cols-2 gap-4">
								{# INFLATION #}
								<div>
									<div class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
										<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Inflation</span>
										{{ _self.tooltip('The rate at which the general level of prices for goods and services is rising in the District.') }}
									</div>
									<p class="text-lg font-bold text-on-surface" id="macro-inflation">
										{{ (macro.inflation * 100)|number_format(2) }}%
									</p>
								</div>

								{# OUTPUT GAP #}
								<div>
									<div class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
										<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Output Gap</span>
										{{ _self.tooltip('The difference between actual economic output and potential. Positive indicates an overheated boom.', 'right') }}
									</div>
									<p class="text-lg font-bold text-on-surface" id="macro-output-gap">
										{{ (macro.output_gap * 100)|number_format(2) }}%
									</p>
								</div>

								{# POLICY RATE #}
								<div>
									<div class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
										<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Policy Rate</span>
										{{ _self.tooltip('The baseline interest rate set by central authorities, dictating borrowing costs for the entire District.') }}
									</div>
									<p class="text-lg font-bold text-on-surface" id="macro-policy-rate">
										{{ (macro.policy_rate * 100)|number_format(2) }}%
									</p>
								</div>

								{# YIELD CURVE #}
								<div>
									<div class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help inline-flex items-center gap-1 focus-visible:outline-none" tabindex="0">
										<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">10-Yr Yield</span>
										{% if macro.qe_active|default(false) %}
											<span class="inline-flex w-2 h-2 rounded-full bg-secondary animate-pulse" title="Quantitative Easing Active"></span>
										{% endif %}
										{{ _self.tooltip("The interest rate on Safe Harbor's 10-year catastrophe bonds. The ultimate risk-free baseline.", 'right') }}
									</div>
									<p class="text-lg font-bold {% if macro.qe_active|default(false) %}text-secondary{% else %}text-on-surface{% endif %}" id="macro-yield">
										{{ (macro.yield_10y * 100)|number_format(2) }}%
									</p>
								</div>
							</div>

							{# THE ECONOMIC STATUS BADGE #}
							<div class="mt-4 pt-3 border-t border-outline-variant/10 flex justify-between items-center">
								<span class="text-[10px] text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">District GDP:</span>
									{{ _self.tooltip('Gross Domestic Product. The total nominal value of all goods and services produced in the Aerie.') }}
								</span>
								<span id="macro-gdp" class="text-xs font-bold text-on-surface">
									${{ (25.00 * macro.nominal_gdp_index|default(1.0))|number_format(2) }}T
								</span>
							</div>

							<div class="mt-2 pt-2 flex justify-between items-center">
								<span class="text-[10px] text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Current Cycle:</span>
									{{ _self.tooltip('The prevailing macroeconomic state of the District. Determines systemic trends and baseline inflation.') }}
								</span>
								<span id="market-economic-cycle" class="text-xs font-bold uppercase tracking-widest text-primary">
									{{ economic_cycle }}
								</span>
							</div>
						</div>

						<div class="relative h-72 w-full flex justify-center">
							<canvas id="etfPieChart"></canvas>
						</div>
					</div>
				{% endif %}

				<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15">
					<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface mb-6 flex items-center gap-2">
						<span class="material-symbols-outlined text-sm">feed</span>
						Live Events
					</h3>

					<p id="no-events-msg" class="text-xs text-on-surface-variant {{ events is not empty ? 'hidden' : '' }}">No recent news reported.</p>
					<ul id="events-list" role="list" class="divide-y divide-outline-variant/10">
						{% for event in events %}
							{% set isPositive = event.changePercent >= 0 %}
							<li class="py-3">
								<div class="flex items-start justify-between">
									<div class="flex items-start gap-3 flex-1 min-w-0">
										<div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 {{ isPositive ? 'bg-secondary/10 text-secondary' : 'bg-tertiary/10 text-tertiary' }}">
											<span class="material-symbols-outlined text-sm">{{ event.eventType == 'SHOCK' ? 'bolt' : 'campaign' }}</span>
										</div>
										<div class="flex-1 min-w-0">
											<p class="text-xs font-bold text-on-surface">{{ event.eventType }}</p>
											<p class="text-[11px] text-on-surface-variant mt-1 leading-relaxed whitespace-pre-line">
												{{ event.description }}
											</p>
										</div>
									</div>

									<div class="text-right flex-shrink-0 ml-2">
										<span class="inline-flex items-center rounded bg-transparent px-1 py-0.5 text-xs font-bold {{ isPositive ? 'text-secondary' : 'text-tertiary' }}">
											{{ isPositive ? '+' : '' }}{{ event.changePercent|number_format(2) }}%
										</span>
										<p class="text-[10px] text-on-surface-variant mt-1">
											{{ event.recordedAt|date('H:i') }}
										</p>
									</div>
								</div>
							</li>
						{% endfor %}
					</ul>
				</div>
			</div>

		</div>
	</div>
{% endblock %}

{% block javascripts %}
	<script>
		window.AERIE_DATA = {
ticker: "{{ asset.ticker }}",
isEtf: {{ isEtf ? 'true' : 'false' }},
sharesOutstanding: {{ isEtf ? 0 : asset.sharesOutstanding }},
userQuantity: {{ userQuantity|default(0) }},
eps: {{ isEtf ? 0 : asset.earningsPerShare|default(0) }},
baselineVol: {{ isEtf ? 0.15 : asset.volatility }},
pieLabels: [{% if isEtf and allAssets is defined %}{% for a in allAssets %}"{{ a.ticker }}"{{ not loop.last ? ',' : '' }}{% endfor %}{% endif %}],
pieData: [{% if isEtf and allAssets is defined %}{% for a in allAssets %}{{ a.price * a.sharesOutstanding }}{{ not loop.last ? ',' : '' }}{% endfor %}{% endif %}],
sharesMap: {
{% if isEtf and allAssets is defined %}
{% for a in allAssets %}
"{{ a.ticker }}" : {{ a.sharesOutstanding }}
{{ not loop.last ? ',' : '' }}{% endfor %}
{% endif %}
},
ticksPerYear: {{ ticksPerYear }}
};
	</script>

	<script src="{{ asset('js/colors.js') }}"></script>
	<script src="{{ asset('js/stock.js') }}"></script>
{% endblock %}
