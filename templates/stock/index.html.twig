										{{ _self.tooltip('Return on Equity. Measures how effectively the company utilizes shareholders\' equity to generate profit.') }}
								{% elseif businessModel|default('none') == 'reit' %}
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Cap Rate</span>
									{{ _self.tooltip('Capitalization Rate (NOI / Property Value). Evaluates true real estate yield before debt service.') }}
								{% else %}
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">ROIC</span>
									{{ _self.tooltip('Return on Invested Capital. How efficiently the company utilizes capital to generate profit.') }}
								{% endif %}
							</dt>
							<dd class="text-sm font-semibold text-on-surface" id="stat-roic">
								{% if isFinancial|default(false) %}
									{{ ((asset.currentRoe != 0 ? asset.currentRoe : asset.baselineRoe) * 100)|number_format(2) }}%
								{% else %}
									{{ ((asset.currentRoic != 0 ? asset.currentRoic : asset.baselineRoic) * 100)|number_format(2) }}%
								{% endif %}
							</dd>
						</div>
						<div class="py-3 flex justify-between items-center">
							<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Total Cash</span>
								{{ _self.tooltip('Corporate Treasury. The total cash and liquid reserves sitting on the balance sheet.') }}
							</dt>
							<dd class="text-sm font-semibold text-on-surface" id="stat-treasury">${{ asset.corporateTreasury|format_large }}</dd>
						</div>
						<div class="py-3 flex justify-between items-center">
							<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Book Value</span>
								{{ _self.tooltip('Total Equity. The absolute net value of the company if all debts were paid and assets liquidated.') }}
							</dt>
							<dd class="text-sm font-semibold text-on-surface" id="stat-equity">${{ asset.totalEquity|format_large }}</dd>
						</div>
						<div class="py-3 flex justify-between items-center">
							<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">D/E</span>
								{{ _self.tooltip('Debt-to-Equity Ratio. Measures financial leverage. A higher ratio indicates dangerous debt levels.') }}
							</dt>
							<dd class="text-sm font-semibold text-on-surface" id="stat-debt-ratio">{{ asset.debtToEquityRatio|number_format(2) }}x</dd>
						</div>
						{% if not isEtf and asset.creditRating is defined %}
							<div class="py-3 flex justify-between items-center">
								<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Credit Rating</span>
									{{ _self.tooltip('Discrete credit rating bracket (AAA through D) evaluated from Merton structural distance-to-default.') }}
								</dt>
								<dd class="text-sm font-semibold text-on-surface" id="stat-credit-rating">{{ asset.creditRating }}</dd>
							</div>
						{% endif %}
						<div class="py-3 flex justify-between items-center">
							<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Market Share</span>
								{{ _self.tooltip("The company's dominance of its sector, measured against the broader District GDP (Evaluates Equity for Banks).") }}
							</dt>
							<dd class="text-sm font-semibold text-on-surface" id="stat-market-share">{{ (marketShare * 100)|number_format(2) }}%</dd>
						</div>
						<div class="py-3 flex justify-between items-center">
							<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Jump Intensity</span>
								{{ _self.tooltip('The frequency of sudden, massive price shocks caused by corporate events or systemic panics.') }}
							</dt>
							<dd class="text-sm font-semibold text-on-surface">{{ asset.jumpIntensity }}</dd>
						</div>
					</dl>

					{% if isFinancial|default(false) %}
						{# DEDICATED ASSET BREAKDOWN VISUALIZATION FOR FINANCIAL INSTITUTIONS #}
						<div class="mt-6 p-4 bg-surface-container-highest rounded-xl border border-outline-variant/20 shadow-inner">
							<div class="flex flex-wrap justify-between items-center gap-2 mb-3">
								<div class="flex items-center gap-3">
									<h4 class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant flex items-center gap-1.5">
										<span class="material-symbols-outlined text-[14px]">account_balance</span>
										Asset & Balance Sheet Structure
									</h4>
									{% if businessModel|default('none') in ['commercial_bank', 'credit_services', 'shadow_bank'] %}
										<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-surface-container text-[10px] font-bold border border-outline-variant/10" title="Net Interest Spread between Blended Rate and Deposit APY/Cash Yield">
											<span class="text-on-surface-variant">Spread:</span>
											<span id="stat-bank-spread" class="font-mono text-primary">--%</span>
										</span>
									{% endif %}
								</div>
								<div class="flex items-center gap-3 text-[10px] font-bold text-on-surface-variant">
									<span>Total Assets: $<span id="stat-total-assets">{{ (asset.corporateTreasury + investedCapital)|format_large }}</span></span>
									{% set totalEquityVal = asset.totalEquity|default(1) %}
									{% set leverageMult = totalEquityVal > 0 ? ((asset.corporateTreasury + investedCapital) / totalEquityVal) : 1.0 %}
									<span class="pl-2 border-l border-outline-variant/30">Leverage: <span id="stat-leverage-mult" class="text-primary font-mono">{{ leverageMult|number_format(1) }}x</span></span>
								</div>
							</div>

							{% set totalAssets = asset.corporateTreasury + investedCapital %}
							{% set loanPct = totalAssets > 0 ? (investedCapital / totalAssets) * 100 : 0 %}
							{% set cashPct = totalAssets > 0 ? (asset.corporateTreasury / totalAssets) * 100 : 0 %}

                            {% set assetTypeLabel = 'Invested Capital' %}
                            {% set assetTypeTooltip = 'Capital deployed into earning operations and portfolio assets.' %}
                            {% set cashLabel = 'Treasury Reserves' %}
                            {% set cashTooltip = 'Liquid cash and reserve assets held on balance sheet.' %}

                            {% if businessModel|default('none') == 'commercial_bank' %}
                                {% set assetTypeLabel = 'Loan Book' %}
                                {% set assetTypeTooltip = 'The total value of active loans generating interest income.' %}
                                {% set cashLabel = 'Vault Cash' %}
                                {% set cashTooltip = 'Fractional reserve cash held at the Central Bank to safely cover customer deposit withdrawals.' %}
                            {% elseif businessModel|default('none') == 'insurance' %}
                                {% set assetTypeLabel = 'Investment Portfolio' %}
                                {% set assetTypeTooltip = 'The total value of premium float invested across markets to generate yield.' %}
                                {% set cashLabel = 'Claims Reserves' %}
                                {% set cashTooltip = 'Liquid cash reserves held to safely pay out policyholder claims.' %}
                            {% elseif businessModel|default('none') == 'credit_services' %}
                                {% set assetTypeLabel = 'Credit Receivables' %}
                                {% set assetTypeTooltip = 'The total value of revolving credit card balances generating interest income.' %}
                            {% elseif businessModel|default('none') == 'shadow_bank' %}
                                {% set assetTypeLabel = 'Wholesale & Mortgage Loans' %}
                                {% set assetTypeTooltip = 'High-yield non-bank lending and structured credit assets.' %}
                            {% elseif businessModel|default('none') == 'clearing_house' %}
                                {% set assetTypeLabel = 'Margin & Custody Assets' %}
                                {% set assetTypeTooltip = 'Initial margin deposits and collateral assets held from clearing members.' %}
                                {% set cashLabel = 'Guaranty Fund Cash' %}
                                {% set cashTooltip = 'Liquid reserves held to absorb counterparty default shocks.' %}
                            {% elseif businessModel|default('none') in ['brokerage', 'investment_bank'] %}
                                {% set assetTypeLabel = 'Trading & Capital Markets Assets' %}
                                {% set assetTypeTooltip = 'Capital deployed in securities, underwriting, and market making inventory.' %}
                            {% elseif businessModel|default('none') in ['asset_manager', 'private_equity', 'distressed_debt'] %}
                                {% set assetTypeLabel = 'Deployed Capital' %}
                                {% set assetTypeTooltip = 'Capital deployed into portfolio investments and fund operations.' %}
                            {% endif %}

							<div class="w-full h-2.5 flex rounded-full overflow-hidden mb-3 bg-surface-container-low border border-outline-variant/10">
								<div id="bar-loan-book" class="bg-primary transition-all duration-500" style="width: {{ loanPct }}%;" title="{{ assetTypeLabel }}: {{ loanPct|number_format(1) }}%"></div>
								<div id="bar-cash" class="bg-secondary transition-all duration-500" style="width: {{ cashPct }}%;" title="{{ cashLabel }}: {{ cashPct|number_format(1) }}%"></div>
							</div>

							<div class="flex justify-between items-start text-[10px] font-bold uppercase tracking-widest mt-2">
								<div class="text-primary group relative cursor-help">
									<span class="border-b border-dotted border-primary/50" id="label-loan-book">{{ assetTypeLabel }} ({{ loanPct|number_format(1) }}%)</span>
									<div class="text-sm font-bold text-on-surface mt-1">$<span id="stat-loan-book">{{ investedCapital|format_large }}</span>
									</div>
									{{ _self.tooltip(assetTypeTooltip, 'left', 'w-56') }}
								</div>
								<div class="text-secondary group relative cursor-help text-right">
									<span class="border-b border-dotted border-secondary/50" id="label-vault-cash">{{ cashLabel }} ({{ cashPct|number_format(1) }}%)</span>
									<div class="text-sm font-bold text-on-surface mt-1">$<span id="stat-vault-cash">{{ asset.corporateTreasury|format_large }}</span>
									</div>
									{{ _self.tooltip(cashTooltip, 'right', 'w-56') }}
								</div>
							</div>
						</div>
					{% endif %}
				</div>

				<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15">
					<div class="flex justify-between items-center mb-6">
						<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface flex items-center gap-2">
							<span class="material-symbols-outlined text-sm">query_stats</span>
							Analyst Consensus
						</h3>
						<span id="analyst-consensus-badge" class="hidden px-2 py-1 text-[10px] font-bold rounded-md uppercase tracking-widest"></span>
					</div>

					{# Add this new Blended Fair Value Box #}
					<div class="flex justify-between items-center pb-4 mb-4 border-b border-outline-variant/20 bg-surface-container-highest p-4 rounded-xl">
						<div>
							<p class="text-xs font-bold uppercase tracking-widest text-primary">Consensus Fair Value</p>
							<p class="text-[10px] text-on-surface-variant mt-1">Blended Target</p>
						</div>
						<div class="text-right">
							<p class="text-xl font-bold text-on-surface" id="target-consensus">--</p>
						</div>
					</div>

					<div class="space-y-4">

						<div class="space-y-4">
							<div class="flex justify-between items-center pb-4 border-b border-outline-variant/10">
								<div>
									<p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Growth Analyst</p>
									<p class="text-xs text-on-surface-variant mt-0.5">DCF & Earnings</p>
								</div>
								<div class="text-right">
									<p class="text-sm font-bold text-on-surface" id="target-growth">--</p>
								</div>
							</div>
							<div class="flex justify-between items-center pb-4 border-b border-outline-variant/10">
								<div>
									<p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Income Analyst</p>
									<p class="text-xs text-on-surface-variant mt-0.5">Dividend Yield</p>
								</div>
								<div class="text-right">
									<p class="text-sm font-bold text-on-surface" id="target-income">--</p>
								</div>
							</div>
							<div class="flex justify-between items-center">
								<div>
									<p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Value Analyst</p>
									<p class="text-xs text-on-surface-variant mt-0.5">Liquidation Floor</p>
								</div>
								<div class="text-right">
									<p class="text-sm font-bold text-on-surface" id="target-value">--</p>
								</div>
							</div>
						</div>
					</div>
				</div>

			{% else %}
				<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15">

					<div class="flex justify-between items-center mb-6 pb-4 border-b border-outline-variant/10">
						<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
							<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Index Composition</span>
							{{ _self.tooltip('The percentage weight of each company in the index, based on their live Market Capitalization.', 'left', 'w-64') }}
						</h3>

						<div class="flex items-center gap-2">
							<span class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">District Volatility (VIX):</span>
							<span id="district-vix" class="text-sm font-bold text-on-surface transition-colors">15.00%</span>
						</div>
					</div>

					{# DISTRICT MACROECONOMICS DASHBOARD #}
					<div class="bg-surface-container-lowest rounded-xl p-4 border border-outline-variant/10 mb-6">
						<h4 class="text-[10px] font-bold uppercase tracking-widest text-primary mb-4 flex items-center gap-2">
							<span class="material-symbols-outlined text-sm">monitoring</span>
							Real-Time Macroeconomics
						</h4>

						<div
							class="grid grid-cols-2 gap-4">
							{# INFLATION #}
							<div>
								<div class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Inflation</span>
									{{ _self.tooltip('The rate at which the general level of prices for goods and services is rising in the District.') }}
								</div>
								<p class="text-lg font-bold text-on-surface" id="macro-inflation">
									{{ (macro.inflation|default(0) * 100)|number_format(2) }}%
								</p>
							</div>

							{# OUTPUT GAP #}
							<div>
								<div class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Output Gap</span>
									{{ _self.tooltip('The difference between actual economic output and potential. Positive indicates an overheated boom.', 'right') }}
								</div>
								<p class="text-lg font-bold text-on-surface" id="macro-output-gap">
									{{ (macro.output_gap|default(0) * 100)|number_format(2) }}%
								</p>
							</div>

							{# POLICY RATE #}
							<div>
								<div class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Policy Rate</span>
									{{ _self.tooltip('The baseline interest rate set by central authorities, dictating borrowing costs for the entire District.') }}
								</div>
								<p class="text-lg font-bold text-on-surface" id="macro-policy-rate">
									{{ (macro.policy_rate|default(0) * 100)|number_format(2) }}%
								</p>
							</div>

							{# YIELD CURVE #}
							<div>
								<div class="text-[9px] font-bold uppercase tracking-widest text-on-surface-variant group relative cursor-help inline-flex items-center gap-1 focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">10-Yr Yield</span>
									{{ _self.tooltip("The interest rate on the District's 10-year bond. It serves as the benchmark for long-term corporate borrowing costs and heavily influences the broader business cycle.", 'right', 'w-64') }}
								</div>
								<p class="text-lg font-bold {% if macro.qe_active|default(false) %}text-secondary{% else %}text-on-surface{% endif %}" id="macro-yield">
									{{ (macro.yield_10y|default(0) * 100)|number_format(2) }}%
								</p>
							</div>
						</div>

						{# QUANTITATIVE EASING STATUS #}
						<div id="qe-status-container" class="mt-4 pt-3 border-t border-outline-variant/10 flex justify-between items-center transition-all duration-500 {% if not macro.qe_active|default(false) %}hidden{% endif %}">
							<span class="text-[10px] font-bold text-secondary uppercase tracking-widest group relative cursor-help inline-flex items-center gap-2 focus-visible:outline-none" tabindex="0">
								<span class="inline-flex w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
								<span class="border-b border-dotted border-secondary/70 pb-0.5">Quantitative Easing:</span>
								{{ _self.tooltip('The Central Bank is actively expanding its balance sheet to artificially suppress long-term yields and stimulate the economy.') }}
							</span>
							<span id="macro-qe-intensity" class="text-xs font-bold text-secondary">
								-{{ (macro.qe_intensity|default(0) * 100)|number_format(2) }}% Yield Suppression
							</span>
						</div>

						{# THE ECONOMIC STATUS BADGE #}
						<div class="mt-2 pt-2 border-t border-outline-variant/10 flex justify-between items-center">
							<span class="text-[10px] text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">District GDP:</span>
								{{ _self.tooltip('Gross Domestic Product. The total nominal value of all goods and services produced in the Aerie.') }}
							</span>
							<span id="macro-gdp" class="text-xs font-bold text-on-surface">
								${{ (50.00 * macro.nominal_gdp_index|default(1.0))|number_format(2) }}T
							</span>
						</div>

						<div class="mt-2 pt-2 flex justify-between items-center">
							<span class="text-[10px] text-on-surface-variant group relative cursor-help inline-block focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Current Cycle:</span>
								{{ _self.tooltip('The prevailing macroeconomic state of the District. Determines systemic trends and baseline inflation.') }}
							</span>
							<span id="market-economic-cycle" class="text-xs font-bold uppercase tracking-widest text-primary">
								{{ economic_cycle }}
							</span>
						</div>
					</div>

					<div class="relative h-72 w-full flex justify-center">
						<canvas id="etfPieChart"></canvas>
					</div>
				</div>
			{% endif %}

			<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15">
				<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface mb-6 flex items-center gap-2">
					<span class="material-symbols-outlined text-sm">feed</span>
					Live Events
				</h3>

				<p id="no-events-msg" class="text-xs text-on-surface-variant {{ events is not empty ? 'hidden' : '' }}">No recent news reported.</p>
				<ul id="events-list" role="list" class="divide-y divide-outline-variant/10">
					{% for event in events %}
						{% set isPositive = event.changePercent >= 0 %}
						<li class="py-3">
							<div class="flex items-start justify-between">
								<div class="flex items-start gap-3 flex-1 min-w-0">
									<div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 {{ isPositive ? 'bg-secondary/10 text-secondary' : 'bg-tertiary/10 text-tertiary' }}">
										<span class="material-symbols-outlined text-sm">{{ event.eventType == 'SHOCK' ? 'bolt' : 'campaign' }}</span>
									</div>
									<div class="flex-1 min-w-0">
										<p class="text-xs font-bold text-on-surface">{{ event.eventType }}</p>
										<p class="text-[11px] text-on-surface-variant mt-1 leading-relaxed whitespace-pre-line">
											{{ event.description }}
										</p>
									</div>
								</div>

								<div class="text-right flex-shrink-0 ml-2">
									<span class="inline-flex items-center rounded bg-transparent px-1 py-0.5 text-xs font-bold {{ isPositive ? 'text-secondary' : 'text-tertiary' }}">
										{{ isPositive ? '+' : '' }}{{ event.changePercent|number_format(2) }}%
									</span>
									<p class="text-[10px] text-on-surface-variant mt-1">
										{{ event.recordedAt|date('H:i') }}
									</p>
								</div>
							</div>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>

	</div>
</div>{% endblock %}{% block javascripts %}
<script>
	window.AERIE_DATA = {
ticker: "{{ asset.ticker }}",
isEtf: {{ isEtf ? 'true' : 'false' }},
isFinancial: {{ isFinancial|default(false) ? 'true' : 'false' }},
businessModel: "{{ businessModel|default('none') }}",
sharesOutstanding: {{ isEtf ? 0 : asset.sharesOutstanding }},
userQuantity: {{ userQuantity|default(0) }},
eps: {{ isEtf ? 0 : asset.earningsPerShare|default(0) }},
baselineVol: {{ isEtf ? 0.15 : asset.volatility }},
pieLabels: [{% if isEtf and allAssets is defined %}{% for a in allAssets %}"{{ a.ticker }}"{{ not loop.last ? ',' : '' }}{% endfor %}{% endif %}],
pieData: [{% if isEtf and allAssets is defined %}{% for a in allAssets %}{{ a.price * a.sharesOutstanding }}{{ not loop.last ? ',' : '' }}{% endfor %}{% endif %}],
sharesMap: {
{% if isEtf and allAssets is defined %}
{% for a in allAssets %}
"{{ a.ticker }}" : {{ a.sharesOutstanding }}
{{ not loop.last ? ',' : '' }}
{% endfor %}{% endif %}
},
ticksPerYear: {{ ticksPerYear }}
};
</script>

<script type="module">
	import 'pages/stock';
</script>

{% if not isEtf %}
<dialog id="sankeyModal" class="backdrop:bg-surface-container-lowest/80 backdrop:backdrop-blur-sm bg-surface-container shadow-2xl rounded-2xl border border-outline-variant/20 p-6 w-[90vw] max-w-5xl open:animate-in open:fade-in open:zoom-in-95">
    <div class="flex justify-between items-center mb-6">
        <h3 class="text-lg font-bold uppercase tracking-widest text-on-surface flex items-center gap-2">
			<span class="material-symbols-outlined text-primary text-xl">account_tree</span>
			{{ asset.name }} - Latest Earnings Flow
		</h3>
        <button onclick="document.getElementById('sankeyModal').close()" class="p-2 rounded-xl text-on-surface-variant hover:text-error hover:bg-error/10 transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
    <div id="sankeyContainer" data-controller="sankey" data-action="sankey:open@document->sankey#open" data-sankey-ticker-value="{{ asset.ticker }}" data-sankey-url-value="{{ path('api_earnings_flow') }}" class="w-full" style="height: 600px;"></div>
	<script>
		const modal = document.getElementById('sankeyModal');
		modal.addEventListener('click', (e) => {
			if (e.target === modal) modal.close();
		});
	</script>
</dialog>
{% endif %}
{% endblock %}
