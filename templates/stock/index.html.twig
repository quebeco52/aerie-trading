					</div>

					<div id="financialChartsGrid" class="space-y-10" data-chart-grid>
						<section class="space-y-4" data-chart-section aria-labelledby="financial-section-income">
							<h3 id="financial-section-income" class="text-base font-semibold text-on-surface">Income and cash flow</h3>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div class="chart-card md:col-span-2 bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-wide data-financial-category="income">
									<div class="flex items-start justify-between gap-4 mb-3">
										<div class="min-w-0">
											<h4 class="text-sm font-semibold text-on-surface">Revenue, net income and operating margin</h4>
