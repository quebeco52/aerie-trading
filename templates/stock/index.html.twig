							</div>
							<div class="flex justify-between items-center mt-2">
								<span class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Market Value</span>
								<span class="text-sm font-bold text-secondary" id="user-holding-value">${{ (userQuantity * asset.price)|number_format(2) }}</span>
							</div>
						</div>
					{% endif %}

					<form action="/trade/execute" method="POST" class="space-y-5 relative z-10">
						<input type="hidden" name="ticker" value="{{ asset.ticker }}">
						<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

						<div class="flex gap-2">
							<label class="flex-1 cursor-pointer">
								<input type="radio" name="orderType" value="MARKET" class="peer sr-only" checked onchange="document.getElementById('limitPriceContainer').style.display='none'">
								<div class="rounded-xl px-3 py-2 text-center text-[10px] font-bold uppercase tracking-widest text-on-surface-variant border border-outline-variant/30 peer-checked:bg-primary/10 peer-checked:text-primary peer-checked:border-primary/30 transition-all">Market</div>
							</label>
							<label class="flex-1 cursor-pointer">
								<input type="radio" name="orderType" value="LIMIT" class="peer sr-only" onchange="document.getElementById('limitPriceContainer').style.display='block'">
								<div class="rounded-xl px-3 py-2 text-center text-[10px] font-bold uppercase tracking-widest text-on-surface-variant border border-outline-variant/30 peer-checked:bg-primary/10 peer-checked:text-primary peer-checked:border-primary/30 transition-all">Limit</div>
							</label>
						</div>

						<div>
							<label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2">Quantity ({{ asset.ticker }})</label>
							<div class="relative">
								<input type="number" name="quantity" min="1" value="10" class="w-full bg-surface-container-highest border-none rounded-xl text-lg font-bold text-on-surface focus:ring-1 focus:ring-primary py-4 px-4 transition-all">
							</div>
						</div>

						<div id="limitPriceContainer" style="display:none">
							<label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-2">Limit Price ($)</label>
							<div class="relative">
								<input type="number" name="limitPrice" min="0.01" step="0.01" placeholder="{{ asset.price|number_format(2) }}" class="w-full bg-surface-container-highest border-none rounded-xl text-lg font-bold text-on-surface focus:ring-1 focus:ring-primary py-4 px-4 transition-all">
							</div>
						</div>

						<div class="grid grid-cols-2 gap-3 pt-2">
							<button type="submit" name="action" value="BUY" class="flex w-full justify-center rounded-xl bg-secondary px-3 py-3.5 text-sm font-bold text-[#002113] shadow-lg shadow-secondary/20 hover:brightness-110 active:scale-95 transition-all">
