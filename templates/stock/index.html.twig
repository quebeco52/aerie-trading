{% extends 'base.html.twig' %}

{# --- TOOLTIP MACRO --- #}
{% macro tooltip(text, position = 'left', width = 'w-48', vpos = 'top') %}
	{% set arrowPosition = position == 'right' ? 'right-4' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-4') %}
	{% set alignClass = position == 'right' ? 'right-0' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-0') %}
	{% set verticalClass = vpos == 'bottom' ? 'top-full mt-2.5' : 'bottom-full mb-2.5' %}
	{% set arrowVerticalClass = vpos == 'bottom' ? '-top-[5px] border-t border-l' : '-bottom-[5px] border-b border-r' %}

	<span role="tooltip" class="block pointer-events-none absolute {{ alignClass }} {{ verticalClass }} {{ width }} p-2.5 bg-[#0f172a] text-white text-[11px] leading-relaxed rounded-lg shadow-2xl opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 group-focus:opacity-100 group-focus:translate-y-0 transition-all duration-200 z-50 normal-case tracking-normal font-normal border border-slate-700">
		{{ text }}
		<span class="block absolute {{ arrowVerticalClass }} {{ arrowPosition }} w-2.5 h-2.5 bg-[#0f172a] border-slate-700 transform rotate-45"></span>
	</span>
{% endmacro %}

{% block title %}
	{{ asset.ticker }}
	Stock Price & Analysis |
	{{ asset.name }}
	- Aerie Exchange
{% endblock %}

{% block meta %}
	<meta name="description" content="View live stock prices, market cap, financial statements, and fundamental valuation metrics for {{ asset.name }} ({{ asset.ticker }}).">
	<meta property="og:title" content="{{ asset.ticker }} Stock Price & Financials | Aerie Exchange">
	<meta property="og:description" content="Live financial data and analytics for {{ asset.name }} ({{ isEtf ? 'Market Index' : asset.industry|default('General') }}).">
	<meta property="og:type" content="website">
{% endblock %}

{% block favicon %}
	<link rel="icon" href="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" type="image/svg+xml">
{% endblock %}

{% block body %}

	<div
		class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5">

		{# --- TOP ASSET HERO BANNER --- #}
		<div class="bg-surface-container-low rounded-lg p-5 lg:p-6 border border-outline-variant/25 relative z-20">
			<div
				class="flex flex-col md:flex-row md:justify-between md:items-center gap-6 relative z-10">
				{# Left: Identity & Sector #}
				<div class="flex items-center gap-4 sm:gap-5 min-w-0">
					<img class="w-16 h-16 sm:w-20 sm:h-20 rounded border border-outline-variant/20 bg-surface-container-lowest p-1 shrink-0 object-contain" src="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" onerror="this.onerror=null; this.src='{{ asset('icons/default.svg') }}';" alt="{{ asset.ticker }} icon">

					<div class="flex flex-col gap-1 min-w-0">
						<h1 class="text-xl sm:text-2xl md:text-3xl font-bold text-on-surface tracking-tight wrap-break-word leading-tight">{{ asset.name }}</h1>

						<div class="flex flex-wrap items-center gap-2 md:gap-3">
							<span class="text-sm font-bold text-primary font-mono tracking-wider">{{ asset.ticker }}</span>

							<span class="group relative cursor-help inline-flex items-center rounded bg-surface-container-highest px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-on-surface-variant focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">{{ isEtf ? 'Market Index' : asset.industry|default('General') }}</span>
								{% set bmMap = constant('App\\Data\\Sectors::BUSINESS_MODEL_DESCRIPTIONS') %}
								{% set bmDesc = isEtf ? 'An Exchange Traded Fund tracking a basket of underlying stocks, providing broad market exposure.' : (bmMap[businessModel|default('none')] ?? bmMap['none']) %}
								{{ _self.tooltip(bmDesc, 'left', 'w-72', 'bottom') }}
							</span>

							{% if not isEtf and asset.isBankrupt %}
								<span class="inline-flex items-center rounded bg-red-500/10 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-red-400 border border-red-500/20">
									BANKRUPT / DELISTED
								</span>
							{% endif %}
						</div>
					</div>
				</div>

				{# Right: Large Price & Status #}
				<div class="md:text-right shrink-0 flex flex-col md:items-end">
					<div class="flex items-center md:justify-end gap-2 mb-1">
						{% if not isEtf and asset.isBankrupt %}
							<span class="w-2 h-2 rounded-full bg-tertiary"></span>
							<span class="text-xs font-bold tracking-wider text-tertiary uppercase" id="live-indicator">BANKRUPT / DELISTED</span>
						{% else %}
							<span class="w-2 h-2 rounded-full bg-secondary"></span>
							<span class="text-xs font-bold tracking-wider text-secondary uppercase" id="live-indicator">Live Market</span>
						{% endif %}
					</div>
					<span class="block text-3xl sm:text-4xl md:text-5xl font-bold font-mono tabular-nums {{ not isEtf and asset.isBankrupt ? 'text-tertiary line-through' : 'text-on-surface' }} tracking-tight transition-colors duration-300" id="big-price">
						${{ (not isEtf and asset.isBankrupt ? 0.00 : asset.price)|number_format(2) }}
					</span>
				</div>
			</div>
		</div>

		{# --- TAB NAVIGATION BAR (ALL ENGLISH) --- #}
		<div class="space-y-5" data-controller="tabs" data-tabs-default-tab-value="overview">
			<div class="flex border-b border-outline-variant/20 overflow-x-auto gap-2 sm:gap-6 pb-px custom-scrollbar">
				<button class="stock-tab-btn pb-2.5 px-1 text-xs font-bold uppercase tracking-wider border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-primary border-primary cursor-pointer" data-tab="overview" data-tabs-target="tab" data-action="click->tabs#select">
					Overview
				</button>
				{% if isEtf %}
					<button class="stock-tab-btn pb-2.5 px-1 text-xs font-bold uppercase tracking-wider border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="macro" data-tabs-target="tab" data-action="click->tabs#select">
						Macro Trends & Indicators
					</button>
				{% else %}
					<button class="stock-tab-btn pb-2.5 px-1 text-xs font-bold uppercase tracking-wider border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="financials" data-tabs-target="tab" data-action="click->tabs#select">
						Financials & Fundamentals
					</button>
					<button class="stock-tab-btn pb-2.5 px-1 text-xs font-bold uppercase tracking-wider border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="sector" data-tabs-target="tab" data-action="click->tabs#select">
						Company & Sector
					</button>
				{% endif %}
				<button class="stock-tab-btn pb-2.5 px-1 text-xs font-bold uppercase tracking-wider border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="orders" data-tabs-target="tab" data-action="click->tabs#select">
					Orders & Trades
					{% if openOrders|length > 0 %}
						<span class="px-2 py-0.5 rounded-full text-[10px] bg-primary/20 text-primary font-mono font-bold">{{ openOrders|length }}</span>
					{% endif %}
				</button>
			</div>

			{# ========================================================================= #}
			{# TAB 1: OVERVIEW #}
			{# ========================================================================= #}
				<div id="stock-tab-content-overview" class="stock-tab-panel" data-tabs-target="panel" data-tab-panel="overview"> <div
					class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

					{# Left Column: Chart & About #}
					<div
						class="lg:col-span-8 space-y-6">
						{# Main Price Chart Card #}
						<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/25">
							<div class="flex overflow-x-auto gap-1 sm:gap-2 mb-4 bg-surface-container-lowest p-1 rounded border border-outline-variant/20 w-full md:w-max [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-3 py-1 text-xs font-bold rounded bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="1w">1W</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-3 py-1 text-xs font-bold rounded bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="1m">1M</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-3 py-1 text-xs font-bold rounded bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="6m">6M</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-3 py-1 text-xs font-bold rounded bg-primary text-[#001a42] transition-colors text-center" data-range="1y">1Y</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-3 py-1 text-xs font-bold rounded bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="3y">3Y</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-3 py-1 text-xs font-bold rounded bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="5y">5Y</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-3 py-1 text-xs font-bold rounded bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="10y">10Y</button>
								<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-3 py-1 text-xs font-bold rounded bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="max">MAX</button>
							</div>

							<div class="w-full h-75 md:h-112.5 relative rounded overflow-hidden">
								<div id="chart-spinner" class="hidden absolute inset-0 z-50 items-center justify-center bg-surface-container-low/80 transition-opacity duration-300">
									<svg class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
										<circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
										<path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
									</svg>
								</div>
								<div id="mainChartContainer" class="w-full h-full"></div>
							</div>
						</div>

						{# About Card #}
						<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/25">
							<h3 class="text-xs font-bold uppercase tracking-wider text-primary mb-3">
								About {{ asset.name }}
							</h3>
							<div class="text-xs font-serif text-on-surface-variant leading-relaxed tracking-wide">
								<p>{{ generalInfo|nl2br }}</p>
							</div>
						</div>

						{# Corporate News / Events Feed #}
						<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/25">
							<div class="flex items-center justify-between mb-4">
								<h3 class="text-xs font-bold uppercase tracking-wider text-on-surface">
									Recent Corporate Events & News
								</h3>
								{% if events|length > 0 %}
									<span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant border border-outline-variant/20">
										{{ events|length }}
										{{ events|length == 1 ? 'Event' : 'Events' }}
									</span>
								{% endif %}
							</div>
							<div class="space-y-3.5" id="events-feed">
								{% for rawEvent in events %}
									{% set event = present_event(rawEvent) %}
									<div
										class="p-4 rounded-xl bg-surface-container-lowest/80 border border-outline-variant/15 border-l-4 {{ event.borderClass }} hover:border-outline-variant/40 transition-all duration-200 space-y-2.5">

										{# Top Header Row: Icon + Badge + Headline / EPS + Surprise + EVA + Timestamp #}
										<div class="flex items-start justify-between gap-3">
											<div class="flex items-center flex-wrap gap-2 min-w-0">
												<div class="w-6 h-6 rounded-lg flex items-center justify-center shrink-0 {{ event.iconClass }}">
													<span class="material-symbols-outlined text-sm">{{ event.icon }}</span>
												</div>
												<span class="inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-bold font-mono uppercase tracking-wider border {{ event.badgeClass }}">
													{{ event.badge }}
												</span>
												{% if event.isEarnings and event.eps %}
													<span class="text-xs font-bold font-mono text-on-surface tracking-tight">
														EPS
														{{ event.eps }}
													</span>
												{% endif %}
												{% if event.isEarnings and event.surpriseType != 'met' and event.surpriseAmount %}
													<span class="text-[11px] font-bold font-mono {{ event.surpriseType == 'beat' ? 'text-secondary' : 'text-tertiary' }}">
														({{ event.surpriseText }})
													</span>
												{% elseif event.isEarnings and event.surpriseType == 'met' %}
													<span class="text-[11px] font-bold font-mono text-on-surface-variant/80">
														(In-Line)
													</span>
												{% endif %}
												{% if event.isEarnings and event.eva %}
													<span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-bold font-mono {{ event.evaPositive ? 'bg-secondary/10 text-secondary' : 'bg-tertiary/10 text-tertiary' }}">
														{{ event.eva }}
													</span>
												{% endif %}
											</div>

											<div class="text-right shrink-0 flex items-center gap-2">
												{% if event.changePercent is not null and event.changePercent != 0 %}
													<span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-mono font-bold {{ event.changePercent > 0 ? 'bg-secondary/10 text-secondary' : 'bg-tertiary/10 text-tertiary' }}">
														{{ event.changePercent > 0 ? '+' : '' }}{{ event.changePercent|number_format(2) }}%
													</span>
												{% endif %}
												<span class="text-[10px] text-on-surface-variant font-mono whitespace-nowrap">
													{{ event.recordedAt|date('Y-m-d H:i') }}
												</span>
											</div>
										</div>

										{# Body Description (For non-earnings or additional narrative) #}
										{% if not event.isEarnings and event.headline %}
											<p class="text-xs text-on-surface font-medium leading-relaxed pl-8">
												{{ event.headline }}
											</p>
										{% endif %}

										{# Corporate Action Sub-Pills (Dividends, Buybacks, Debt, Lore) #}
										{% if event.pills is defined and event.pills|length > 0 %}
											<div class="flex flex-wrap gap-2 pt-1 pl-8">
												{% for pill in event.pills %}
													<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-mono {{ pill.pillClass }}">
														<span class="material-symbols-outlined text-sm shrink-0">{{ pill.icon }}</span>
														<span class="leading-none">{{ pill.text }}</span>
													</div>
												{% endfor %}
											</div>
										{% endif %}
									</div>
								{% else %}
									<div id="no-events-msg" class="p-8 rounded-xl bg-surface-container-lowest/40 border border-outline-variant/10 text-center space-y-2">
										<span class="material-symbols-outlined text-3xl text-on-surface-variant/40">event_busy</span>
										<p class="text-xs text-on-surface-variant font-serif">No recent corporate events logged for this asset.</p>
									</div>
								{% endfor %}
							</div>
						</div>
					</div>

					{# Right Column: Trading Box, Position & Fundamentals #}
					<div
						class="lg:col-span-4 space-y-6">

						{# Trading Widget #}
						<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/25">
							<h3 class="text-xs font-bold uppercase tracking-wider text-on-surface mb-3">
								Trade {{ asset.ticker }}
							</h3>

							{% if not isEtf and asset.isBankrupt %}
								<div class="p-3 bg-red-950/20 border border-red-500/20 rounded space-y-1.5">
									<div class="flex items-center gap-2 text-red-400 font-bold text-xs uppercase tracking-wider">
										<span class="material-symbols-outlined text-base">block</span>
										Trading Halted
									</div>
									<p class="text-xs text-on-surface-variant leading-relaxed">
										This corporation is in bankruptcy liquidation. Trading is permanently halted.
									</p>
								</div>
							{% else %}
								{% if userQuantity > 0 %}
									<div class="mb-4 p-3 bg-surface-container-lowest/80 rounded border border-outline-variant/20 space-y-1.5">
										<div class="flex justify-between items-center text-xs">
											<span class="text-on-surface-variant uppercase tracking-wider text-xs font-bold">Your Position</span>
											<span class="font-bold text-on-surface font-mono tabular-nums">{{ userQuantity|number_format }} Shares</span>
										</div>
										<div class="flex justify-between items-center text-xs">
											<span class="text-on-surface-variant uppercase tracking-wider text-xs font-bold">Avg Cost Basis</span>
											<span class="font-mono tabular-nums text-on-surface-variant">${{ userAvgCost|number_format(2) }}</span>
										</div>
										<div class="flex justify-between items-center text-xs">
											<span class="text-on-surface-variant uppercase tracking-wider text-xs font-bold">Market Value</span>
											<span class="font-bold text-on-surface font-mono tabular-nums" id="user-holding-value">${{ (userQuantity * asset.price)|number_format(2) }}</span>
										</div>
										<div class="flex justify-between items-center text-xs pt-1.5 border-t border-outline-variant/15">
											<span class="text-on-surface-variant uppercase tracking-wider text-xs font-bold">Unrealized Return</span>
											<span class="font-mono tabular-nums font-bold {{ userUnrealizedPnL >= 0 ? 'text-secondary' : 'text-tertiary' }}">
												{{ userUnrealizedPnL >= 0 ? '+' : '' }}${{ userUnrealizedPnL|number_format(2) }}
												({{ userUnrealizedPnL >= 0 ? '+' : '' }}{{ userUnrealizedPnLPercent|number_format(2) }}%)
											</span>
										</div>
									</div>
								{% endif %}

								<form action="/trade/execute" method="POST" class="space-y-3">
									<input type="hidden" name="ticker" value="{{ asset.ticker }}">
									<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

									<div class="flex gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20">
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="action" value="BUY" class="peer sr-only" checked>
											<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-[#002111] transition-all">
												Buy
											</div>
										</label>
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="action" value="SELL" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-[#370001] transition-all">
												Sell
											</div>
										</label>
									</div>

									<div class="flex gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20">
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="orderType" value="MARKET" class="peer sr-only" checked onchange="toggleLimitPrice(false)">
											<div class="py-1 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-surface-container-high peer-checked:text-primary transition-all">
												Market
											</div>
										</label>
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="orderType" value="LIMIT" class="peer sr-only" onchange="toggleLimitPrice(true)">
											<div class="py-1 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-surface-container-high peer-checked:text-primary transition-all">
												Limit
											</div>
										</label>
									</div>

									<div id="limit-price-group" class="hidden space-y-1">
										<label for="limitPrice" class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Limit Price ($)</label>
										<input type="number" step="0.01" min="0.01" id="limitPrice" name="limitPrice" placeholder="{{ asset.price|number_format(2, '.', '') }}" class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none">
									</div>

									<div class="space-y-1">
										<label for="quantity" class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Quantity (Shares)</label>
										<input type="number" id="quantity" name="quantity" min="1" max="1000000" value="1" required class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none" oninput="updateEstimatedTotal()">
									</div>

									<div class="p-3 rounded bg-surface-container-lowest/80 border border-outline-variant/20 flex justify-between items-center text-xs">
										<span class="text-on-surface-variant uppercase tracking-wider font-bold">Estimated Cost</span>
										<span class="font-bold text-on-surface font-mono tabular-nums text-sm" id="estimated-total">${{ asset.price|number_format(2) }}</span>
									</div>

									<button type="submit" class="w-full py-2 px-4 rounded bg-primary text-[#001a42] font-bold text-xs uppercase tracking-wider hover:brightness-110 active:scale-98 transition-all cursor-pointer">
										Submit Order
									</button>
								</form>
							{% endif %}
						</div>

						{# Key Fundamentals Grid Card #}
						{% if not isEtf %}
							<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/25">
								<h3 class="text-xs font-bold uppercase tracking-wider text-on-surface mb-3">
									Key Statistics
								</h3>

								<dl class="divide-y divide-outline-variant/15 text-xs">
									<div class="py-2 flex justify-between items-center">
										<dt class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Market Cap</dt>
										<dd class="font-bold text-on-surface font-mono tabular-nums" id="stat-mkt-cap">${{ marketCap|format_large }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Shares Out</dt>
