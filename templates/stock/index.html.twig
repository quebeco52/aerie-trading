{% extends 'base.html.twig' %}

{# --- TOOLTIP MACRO --- #}
{% macro tooltip(text, position = 'left', width = 'w-48', vpos = 'top') %}
	{% set arrowPosition = position == 'right' ? 'right-4' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-4') %}
	{% set alignClass = position == 'right' ? 'right-0' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-0') %}
	{% set verticalClass = vpos == 'bottom' ? 'top-full mt-2.5' : 'bottom-full mb-2.5' %}
	{% set arrowVerticalClass = vpos == 'bottom' ? '-top-[5px] border-t border-l' : '-bottom-[5px] border-b border-r' %}

	<span role="tooltip" class="block pointer-events-none absolute {{ alignClass }} {{ verticalClass }} {{ width }} p-2.5 bg-[#0f172a] text-white text-[11px] leading-relaxed rounded-lg shadow-2xl opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 group-focus:opacity-100 group-focus:translate-y-0 transition-all duration-200 z-[100] normal-case tracking-normal font-normal border border-slate-700">
		{{ text }}
		<span class="block absolute {{ arrowVerticalClass }} {{ arrowPosition }} w-2.5 h-2.5 bg-[#0f172a] border-slate-700 transform rotate-45"></span>
	</span>
{% endmacro %}

{% block title %}
	{{ asset.ticker }} Stock Price & Analysis | {{ asset.name }} - Aerie Exchange
{% endblock %}

{% block meta %}
	<meta name="description" content="View live stock prices, market cap, and fundamental Clean Surplus accounting data for {{ asset.name }} ({{ asset.ticker }}).">
	<meta property="og:title" content="{{ asset.ticker }} Stock Price | Aerie Exchange">
	<meta property="og:description" content="Live financial data and economic simulation for {{ asset.name }} ({{ isEtf ? 'Market Index' : asset.industry|default('General') }}).">
	<meta property="og:type" content="website">
{% endblock %}

{% block favicon %}
	<link rel="icon" href="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" type="image/svg+xml">
{% endblock %}

{% block body %}

	<div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-4 lg:py-6 w-full space-y-6">

		{# --- TOP ASSET HERO BANNER --- #}
		<div class="bg-surface-container-low shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)] rounded-2xl p-6 lg:p-8 border border-outline-variant/15 relative overflow-hidden">
			<div class="absolute -right-20 -top-20 w-64 h-64 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

			<div class="flex flex-col md:flex-row md:justify-between md:items-start gap-6 relative z-10">
				{# Left: Identity & Sector #}
				<div class="flex items-center gap-4 min-w-0">
					<img class="w-14 h-14 md:w-16 md:h-16 rounded-full shadow-md shrink-0" src="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" onerror="this.onerror=null; this.src='{{ asset('icons/default.svg') }}';" alt="{{ asset.ticker }} icon">

					<div class="flex flex-col gap-1.5 min-w-0">
						<h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-on-surface tracking-tight break-words leading-tight">{{ asset.name }}</h1>

						<div class="flex flex-wrap items-center gap-2 md:gap-3">
							<span class="text-base font-bold text-primary font-mono tracking-wider">{{ asset.ticker }}</span>

							<span class="group relative cursor-help inline-flex items-center rounded-md bg-surface-container-highest px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant focus-visible:outline-none" tabindex="0">
								<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">{{ isEtf ? 'Market Index' : asset.industry|default('General') }}</span>
								{% set bmMap = constant('App\\Data\\Sectors::BUSINESS_MODEL_DESCRIPTIONS') %}
								{% set bmDesc = isEtf ? 'An Exchange Traded Fund tracking a basket of underlying stocks, providing broad market exposure.' : (bmMap[businessModel|default('none')] ?? bmMap['none']) %}
								{{ _self.tooltip(bmDesc, 'left', 'w-72 z-50', 'bottom') }}
							</span>

							{% if not isEtf and asset.isBankrupt %}
								<span class="inline-flex items-center rounded-md bg-red-500/10 px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-red-400 border border-red-500/20">
									BANKRUPT / DELISTED
								</span>
							{% endif %}
						</div>
					</div>
				</div>

				{# Right: Large Price & Status #}
				<div class="md:text-right shrink-0 flex flex-col md:items-end">
					<div class="flex items-center md:justify-end gap-2 mb-1">
						{% if not isEtf and asset.isBankrupt %}
							<span class="w-2 h-2 rounded-full bg-tertiary"></span>
							<span class="text-[10px] font-bold tracking-widest text-tertiary uppercase" id="live-indicator">BANKRUPT / DELISTED</span>
						{% else %}
							<span class="w-2 h-2 rounded-full bg-secondary animate-pulse shadow-[0_0_8px_rgba(78,222,163,0.6)]"></span>
							<span class="text-[10px] font-bold tracking-widest text-secondary uppercase" id="live-indicator">Live Market</span>
						{% endif %}
					</div>
					<span class="block text-4xl md:text-5xl font-bold font-mono {{ not isEtf and asset.isBankrupt ? 'text-tertiary line-through' : 'text-on-surface' }} tracking-tighter transition-colors duration-300" id="big-price">
						${{ (not isEtf and asset.isBankrupt ? 0.00 : asset.price)|number_format(2) }}
					</span>
				</div>
			</div>
		</div>

		{# --- TAB NAVIGATION BAR (ALL ENGLISH) --- #}
		<div class="flex border-b border-outline-variant/15 overflow-x-auto gap-2 sm:gap-6 pb-px custom-scrollbar">
			<button class="stock-tab-btn pb-3 px-1 text-sm font-bold border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-primary border-primary" data-tab="overview">
				<span class="material-symbols-outlined text-base">monitoring</span>
				Overview
			</button>
			{% if isEtf %}
				<button class="stock-tab-btn pb-3 px-1 text-sm font-bold border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent" data-tab="macro">
					<span class="material-symbols-outlined text-base">public</span>
					Macro Trends & Indicators
				</button>
			{% else %}
				<button class="stock-tab-btn pb-3 px-1 text-sm font-bold border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent" data-tab="financials">
					<span class="material-symbols-outlined text-base">analytics</span>
					Financials & Fundamentals
				</button>
				<button class="stock-tab-btn pb-3 px-1 text-sm font-bold border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent" data-tab="sector">
					<span class="material-symbols-outlined text-base">corporate_fare</span>
					Company & Sector
				</button>
			{% endif %}
			<button class="stock-tab-btn pb-3 px-1 text-sm font-bold border-b-2 transition-all flex items-center gap-2 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent" data-tab="orders">
				<span class="material-symbols-outlined text-base">swap_vert</span>
				Order Depth & Trades
				{% if openOrders|length > 0 %}
					<span class="px-2 py-0.5 rounded-full text-[10px] bg-primary/20 text-primary font-mono font-bold">{{ openOrders|length }}</span>
				{% endif %}
			</button>
		</div>

		{# ========================================================================= #}
		{# TAB 1: OVERVIEW #}
		{# ========================================================================= #}
		<div id="stock-tab-content-overview" class="stock-tab-panel">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
				
				{# Left Column: Chart & About #}
				<div class="lg:col-span-8 space-y-6">
					{# Main Price Chart Card #}
					<div class="bg-surface-container-low shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)] rounded-2xl p-6 lg:p-8 border border-outline-variant/15">
						<div class="flex overflow-x-auto gap-1 sm:gap-2 mb-4 bg-surface-container-lowest p-1 rounded-lg w-full md:w-max [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
							<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="1w">1W</button>
							<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="1m">1M</button>
							<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="6m">6M</button>
							<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-primary text-[#001a42] shadow-md shadow-primary/20 transition-colors text-center" data-range="1y">1Y</button>
							<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="3y">3Y</button>
							<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="5y">5Y</button>
							<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="10y">10Y</button>
							<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="max">MAX</button>
						</div>

						<div class="w-full h-[300px] md:h-[450px] relative rounded-xl overflow-hidden">
							<div id="chart-spinner" class="hidden absolute inset-0 z-50 flex items-center justify-center bg-surface-container-low/60 backdrop-blur-sm transition-opacity duration-300">
								<svg class="animate-spin h-12 w-12 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24">
									<circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
									<path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
								</svg>
							</div>
							<div id="mainChartContainer" class="w-full h-full"></div>
						</div>
					</div>

					{# About Card #}
					<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 lg:p-8 border border-outline-variant/15">
						<h3 class="text-xs font-bold uppercase tracking-widest text-primary mb-4 flex items-center gap-2">
							<span class="material-symbols-outlined text-base">info</span>
							About {{ asset.name }}
						</h3>
						<div class="text-sm font-serif text-on-surface-variant leading-relaxed tracking-wide">
							<p>{{ generalInfo|nl2br }}</p>
						</div>
					</div>

					{# Corporate News / Events Feed #}
					<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 lg:p-8 border border-outline-variant/15">
						<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface mb-4 flex items-center gap-2">
							<span class="material-symbols-outlined text-primary text-base">newspaper</span>
							Recent Company Events & News
						</h3>
						<div class="space-y-3" id="events-feed">
							{% for event in events %}
								<div class="p-3.5 rounded-xl bg-surface-container-lowest/60 border border-outline-variant/10 flex items-start gap-3">
									<span class="material-symbols-outlined text-base text-primary mt-0.5">campaign</span>
									<div class="flex-1 min-w-0">
										<div class="flex items-center justify-between gap-2">
											<span class="text-xs font-bold text-on-surface">{{ event.headline|default(event.description) }}</span>
											<span class="text-[10px] text-on-surface-variant font-mono whitespace-nowrap">{{ event.recordedAt|date('Y-m-d H:i') }}</span>
										</div>
										{% if event.description and event.headline is defined and event.headline != event.description %}
											<p class="text-xs text-on-surface-variant mt-1 leading-relaxed">{{ event.description }}</p>
										{% endif %}
									</div>
								</div>
							{% else %}
								<p class="text-xs text-on-surface-variant font-serif py-4 text-center">No recent corporate events logged.</p>
							{% endfor %}
						</div>
					</div>
				</div>

				{# Right Column: Trading Box, Position & Fundamentals #}
				<div class="lg:col-span-4 space-y-6">

					{# Trading Widget #}
					<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15 shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)]">
						<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface mb-4 flex items-center gap-2">
							<span class="material-symbols-outlined text-primary text-base">currency_exchange</span>
							Trade {{ asset.ticker }}
						</h3>

						{% if not isEtf and asset.isBankrupt %}
							<div class="p-4 bg-red-950/20 border border-red-500/20 rounded-xl space-y-2">
								<div class="flex items-center gap-2 text-red-400 font-bold text-xs uppercase tracking-wider">
									<span class="material-symbols-outlined text-base">block</span>
									Trading Halted
								</div>
								<p class="text-xs text-on-surface-variant leading-relaxed">
									This corporation is in bankruptcy liquidation. Trading is permanently halted.
								</p>
							</div>
						{% else %}
							{% if userQuantity > 0 %}
								<div class="mb-4 p-4 bg-surface-container-lowest/60 rounded-xl border border-outline-variant/10 space-y-2">
									<div class="flex justify-between items-center text-xs">
										<span class="text-on-surface-variant uppercase tracking-wider text-[10px] font-bold">Your Position</span>
										<span class="font-bold text-on-surface font-mono">{{ userQuantity|number_format }} Shares</span>
									</div>
									<div class="flex justify-between items-center text-xs">
										<span class="text-on-surface-variant uppercase tracking-wider text-[10px] font-bold">Avg Cost Basis</span>
										<span class="font-mono text-on-surface-variant">${{ userAvgCost|number_format(2) }}</span>
									</div>
									<div class="flex justify-between items-center text-xs">
										<span class="text-on-surface-variant uppercase tracking-wider text-[10px] font-bold">Market Value</span>
										<span class="font-bold text-on-surface font-mono" id="user-holding-value">${{ (userQuantity * asset.price)|number_format(2) }}</span>
									</div>
									<div class="flex justify-between items-center text-xs pt-1 border-t border-outline-variant/10">
										<span class="text-on-surface-variant uppercase tracking-wider text-[10px] font-bold">Unrealized Return</span>
										<span class="font-mono font-bold {{ userUnrealizedPnL >= 0 ? 'text-secondary' : 'text-tertiary' }}">
											{{ userUnrealizedPnL >= 0 ? '+' : '' }}${{ userUnrealizedPnL|number_format(2) }} ({{ userUnrealizedPnL >= 0 ? '+' : '' }}{{ userUnrealizedPnLPercent|number_format(2) }}%)
										</span>
									</div>
								</div>
							{% endif %}

							<form action="/trade/execute" method="POST" class="space-y-4">
								<input type="hidden" name="ticker" value="{{ asset.ticker }}">
								<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

								<div class="flex gap-2 bg-surface-container-lowest p-1 rounded-xl border border-outline-variant/15">
									<label class="flex-1 cursor-pointer">
										<input type="radio" name="orderType" value="MARKET" class="peer sr-only" checked onchange="document.getElementById('limitPriceContainer').style.display='none'">
										<div class="rounded-lg py-2 text-center text-xs font-bold uppercase tracking-widest text-on-surface-variant peer-checked:bg-primary peer-checked:text-[#001a42] transition-all">Market</div>
									</label>
									<label class="flex-1 cursor-pointer">
										<input type="radio" name="orderType" value="LIMIT" class="peer sr-only" onchange="document.getElementById('limitPriceContainer').style.display='block'">
										<div class="rounded-lg py-2 text-center text-xs font-bold uppercase tracking-widest text-on-surface-variant peer-checked:bg-primary peer-checked:text-[#001a42] transition-all">Limit</div>
									</label>
								</div>

								<div>
									<label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1.5">Quantity (Shares)</label>
									<input type="number" name="quantity" min="1" value="10" class="w-full bg-surface-container-highest border-none rounded-xl text-base font-bold text-on-surface font-mono focus:ring-1 focus:ring-primary py-3 px-4 transition-all">
								</div>

								<div id="limitPriceContainer" style="display:none">
									<label class="block text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1.5">Limit Price ($)</label>
									<input type="number" name="limitPrice" min="0.01" step="0.01" placeholder="{{ asset.price|number_format(2) }}" class="w-full bg-surface-container-highest border-none rounded-xl text-base font-bold text-on-surface font-mono focus:ring-1 focus:ring-primary py-3 px-4 transition-all">
								</div>

								<div class="grid grid-cols-2 gap-3 pt-1">
									<button type="submit" name="action" value="BUY" class="flex w-full justify-center rounded-xl bg-secondary px-3 py-3 text-sm font-bold text-[#002113] shadow-lg shadow-secondary/20 hover:brightness-110 active:scale-95 transition-all">
										BUY
									</button>
									<button type="submit" name="action" value="SELL" class="flex w-full justify-center rounded-xl bg-surface-container-high px-3 py-3 text-sm font-bold text-on-surface hover:bg-surface-bright active:scale-95 transition-all">
										SELL
									</button>
								</div>
							</form>
						{% endif %}
					</div>

					{# Key Fundamentals Grid Card #}
					{% if not isEtf %}
						<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15 shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)]">
							<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface mb-4 flex items-center gap-2">
								<span class="material-symbols-outlined text-primary text-base">query_stats</span>
								Key Statistics
							</h3>

							<dl class="divide-y divide-outline-variant/5 text-xs">
								<div class="py-2.5 flex justify-between items-center">
									<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Market Cap</dt>
									<dd class="font-bold text-on-surface font-mono" id="stat-mkt-cap">${{ marketCap|format_large }}</dd>
								</div>
								<div class="py-2.5 flex justify-between items-center">
									<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Shares Out</dt>
									<dd class="font-bold text-on-surface font-mono" id="stat-shares">{{ asset.sharesOutstanding|number_format }}</dd>
								</div>
								<div class="py-2.5 flex justify-between items-center">
									<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">P/E Ratio</dt>
									<dd class="font-bold text-on-surface font-mono" id="stat-pe">{{ peRatio ? peRatio|number_format(2) ~ 'x' : '-' }}</dd>
								</div>
								<div class="py-2.5 flex justify-between items-center">
									<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">EPS (TTM)</dt>
									<dd class="font-bold text-on-surface font-mono" id="stat-eps">${{ asset.earningsPerShare|number_format(2) }}</dd>
								</div>
								<div class="py-2.5 flex justify-between items-center">
									<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Beta</dt>
									<dd class="font-bold text-on-surface font-mono">{{ asset.beta|number_format(2) }}</dd>
								</div>
								<div class="py-2.5 flex justify-between items-center">
									<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">{{ isFinancial ? 'ROE' : 'ROIC' }}</dt>
									<dd class="font-bold text-on-surface font-mono" id="stat-roic">
										{% if isFinancial %}
											{{ ((asset.currentRoe != 0 ? asset.currentRoe : asset.baselineRoe) * 100)|number_format(2) }}%
										{% else %}
											{{ ((asset.currentRoic != 0 ? asset.currentRoic : asset.baselineRoic) * 100)|number_format(2) }}%
										{% endif %}
									</dd>
								</div>
								<div class="py-2.5 flex justify-between items-center">
									<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Book Value (Equity)</dt>
									<dd class="font-bold text-on-surface font-mono" id="stat-equity">${{ asset.totalEquity|format_large }}</dd>
								</div>
								<div class="py-2.5 flex justify-between items-center">
									<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Debt-to-Equity</dt>
									<dd class="font-bold text-on-surface font-mono" id="stat-debt-ratio">{{ asset.debtToEquityRatio|number_format(2) }}x</dd>
								</div>
								{% if asset.creditRating is defined %}
									<div class="py-2.5 flex justify-between items-center">
										<dt class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Credit Rating</dt>
										<dd class="font-bold text-primary font-mono" id="stat-credit-rating">{{ asset.creditRating }}</dd>
									</div>
								{% endif %}
							</dl>
						</div>
					{% endif %}

					{% if isEtf %}
						{# ETF Portfolio Allocation Card #}
						<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15 shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)]">
							<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface mb-4 flex items-center gap-2">
								<span class="material-symbols-outlined text-primary text-base">pie_chart</span>
								ETF Component Weightings
							</h3>

							<div class="h-64 relative w-full mb-4">
								<canvas id="etfPieChart"></canvas>
							</div>

							{% if components is defined and components|length > 0 %}
								<div class="space-y-2 mt-4 max-h-56 overflow-y-auto custom-scrollbar">
									{% for comp in components %}
										<div class="flex justify-between items-center text-xs p-2 rounded-lg bg-surface-container-lowest/60 border border-outline-variant/5">
