								<span class="text-on-surface-variant uppercase text-xs font-bold">Market Share</span>
								<p class="text-sm font-bold text-primary font-mono tabular-nums mt-1" id="stat-market-share">{{ (marketShare * 100)|number_format(2) }}%</p>
								<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">of addressable market{% if industry and industry.rosterShare is not null %} · {{ (industry.rosterShare * 100)|number_format(1) }}% of {{ industry.rosterSize }} modelled firms{% endif %}</p>
							</div>
						</div>
					</div>

					{# Management: the archetype running the firm's capital, and how long it has been in post.
					   Bertrand & Schoar (2003) manager fixed effects, surfaced because the market knows who is
					   in the chair. The dials themselves are deliberately not shown — the policy is meant to be
					   read off the payout, the capital budget and the deals. #}
					{% if management %}
						{% set convictionTone = {
							'nominal': 'border-outline-variant/40 text-on-surface-variant bg-surface-container-highest/60',
							'characteristic': 'border-primary/40 text-primary bg-primary/10',
							'pronounced': 'border-amber-500/40 text-amber-300 bg-amber-500/10'
						} %}
						<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all" id="management-card">
							<div class="flex items-start justify-between gap-4">
								<div>
									<h3 class="text-sm font-semibold text-primary">Capital Allocation</h3>
									<p class="text-xs text-on-surface-variant mt-1">Management carries a persistent policy bias (Bertrand &amp; Schoar 2003): two firms with the same fundamentals are run differently depending on who runs them. The board replaces a manager whose capital stops earning its cost, and the successor need not share the mandate.</p>
								</div>
								<span class="shrink-0 inline-flex items-center rounded border px-2 py-0.5 text-xs font-bold uppercase tracking-wide {{ convictionTone[management.conviction]|default(convictionTone['characteristic']) }}">{{ management.conviction }}</span>
							</div>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs mt-4">
								<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
									<span class="text-on-surface-variant uppercase text-xs font-bold">Style</span>
									<p class="text-sm font-bold text-on-surface mt-1">{{ management.label }}</p>
									<p class="text-3xs text-on-surface-variant/70 mt-1 leading-relaxed">Capital is {{ management.mandate }}.</p>
								</div>
								<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
									<span class="text-on-surface-variant uppercase text-xs font-bold">Tenure</span>
									<p class="text-sm font-bold text-primary font-mono tabular-nums mt-1">{{ management.tenureYears|number_format(1) }} yrs</p>
									<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">in post</p>
								</div>
							</div>
						</div>
					{% endif %}

					{# Industry Position: the industry ledger's roster and capacity balance, and the last report's price response #}
					{% if industry %}
						{% set balanceTone = {
							'overbuilt': 'border-error/40 text-error bg-error/10',
							'tight': 'border-tertiary/40 text-tertiary bg-tertiary/10',
							'balanced': 'border-primary/30 text-primary bg-primary/10',
							'unknown': 'border-outline-variant/30 text-on-surface-variant bg-surface-container-highest'
						} %}
						<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all" id="industry-position-card">
							<div class="flex items-start justify-between gap-3 mb-4">
								<div>
									<h3 class="text-sm font-semibold text-primary">Industry Position</h3>
									<p class="text-xs text-on-surface-variant mt-1">Plant built beyond trend, weighted by each firm's share of its market, sets the price every firm in the industry realizes (Cournot against a fringe supplying at trend); rivals' surprises take share from each other.</p>
								</div>
								{% if industry.pricesCapacity %}
									<span class="shrink-0 inline-flex items-center rounded border px-2 py-0.5 text-xs font-bold uppercase tracking-wide {{ balanceTone[industry.balance] }}">{{ industry.balance == 'unknown' ? 'No balance yet' : industry.balance }}</span>
								{% endif %}
							</div>

							{# Scale & saturation: the addressable share the physics is struck on, and the penalty it carries #}
							{% set sat = industry.saturation %}
							{% set saturated = industry.addressableShare > sat.threshold %}
							<div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs mb-3">
								<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
									<span class="text-on-surface-variant uppercase text-xs font-bold">Addressable Share</span>
									<p class="text-sm font-bold font-mono tabular-nums mt-1 {{ saturated ? 'text-error' : 'text-on-surface' }}">{{ (industry.addressableShare * 100)|number_format(2) }}%</p>
									<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">{{ saturated ? 'past' : 'under' }} the {{ (sat.threshold * 100)|number_format(0) }}% saturation line</p>
								</div>
								<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
									<span class="text-on-surface-variant uppercase text-xs font-bold">Scale Penalty</span>
									<p class="text-sm font-bold font-mono tabular-nums mt-1 {{ sat.penalty > 0.0005 ? 'text-error' : 'text-on-surface' }}">{{ sat.penalty > 0 ? '-' : '' }}{{ (sat.penalty * 100)|number_format(2) }} pts</p>
									<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">margin friction (Penrose) · {{ (sat.severity * 100)|number_format(0) }}% of return</p>
								</div>
								<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
									<span class="text-on-surface-variant uppercase text-xs font-bold">Marginal Return</span>
									<p class="text-sm font-bold font-mono tabular-nums mt-1 {{ sat.marginalReturn < sat.trueReturn - 0.0005 ? 'text-error' : 'text-on-surface' }}">{{ (sat.marginalReturn * 100)|number_format(2) }}%</p>
									<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">next dollar of capital · trailing {{ (sat.trueReturn * 100)|number_format(2) }}%</p>
								</div>
								<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
									<span class="text-on-surface-variant uppercase text-xs font-bold">Moat Factor</span>
									<p class="text-sm font-bold font-mono tabular-nums mt-1 text-on-surface">{{ sat.moatFactor|number_format(2) }}x</p>
									<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">{{ asset.systemicImportance }} · scales both penalties</p>
								</div>
							</div>

							{% if not industry.pricesCapacity %}
								<p class="text-xs text-on-surface-variant leading-relaxed">Not priced on capacity: {{ isFinancial ? 'a lender sells a yield on its book, not a unit of output, so there is no plant to overbuild.' : 'this industry\'s output is not substitutable enough for rivals\' plant to move its price.' }}</p>
							{% else %}
								<div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
									<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
										<span class="text-on-surface-variant uppercase text-xs font-bold">Capacity vs Demand</span>
										<p class="text-sm font-bold font-mono tabular-nums mt-1 {{ industry.balance == 'overbuilt' ? 'text-error' : (industry.balance == 'tight' ? 'text-tertiary' : 'text-on-surface') }}">{{ industry.capacityRatio is not null ? (industry.capacityRatio * 100)|number_format(1) ~ '%' : '-' }}</p>
										<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">{% if industry.installedCapacity is not null %}{{ industry.installedCapacity|format_large('$') }} plant · {{ industry.trendCapacity|format_large('$') }} at trend{% else %}anchored at first report{% endif %}</p>
									</div>
									<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
										<span class="text-on-surface-variant uppercase text-xs font-bold">Realized Price</span>
										{% if industry.priceLevel is not null %}
											{% set priceMove = (industry.priceLevel - 1) * 100 %}
											<p class="text-sm font-bold font-mono tabular-nums mt-1 {{ priceMove < -0.05 ? 'text-error' : (priceMove > 0.05 ? 'text-tertiary' : 'text-on-surface') }}">{{ priceMove >= 0 ? '+' : '' }}{{ priceMove|number_format(2) }}%</p>
										{% else %}
											<p class="text-sm font-bold font-mono tabular-nums mt-1 text-on-surface-variant">-</p>
										{% endif %}
										<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">vs balanced industry · last report</p>
									</div>
									<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
										<span class="text-on-surface-variant uppercase text-xs font-bold">Rival Share Drain</span>
										{% if industry.rivalShareDrain is not null %}
											{% set drain = industry.rivalShareDrain * 100 %}
											<p class="text-sm font-bold font-mono tabular-nums mt-1 {{ drain < -0.05 ? 'text-error' : (drain > 0.05 ? 'text-tertiary' : 'text-on-surface') }}">{{ drain >= 0 ? '+' : '' }}{{ drain|number_format(2) }}%</p>
										{% else %}
											<p class="text-sm font-bold font-mono tabular-nums mt-1 text-on-surface-variant">-</p>
										{% endif %}
										<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">of demand, from rivals' beats and misses</p>
									</div>
									<div class="p-4 rounded bg-surface-container-lowest/80 border border-outline-variant/15">
										<span class="text-on-surface-variant uppercase text-xs font-bold">Own-Price Volume</span>
										{% if industry.ownPriceVolumeShift is not null %}
											{% set shift = industry.ownPriceVolumeShift * 100 %}
											<p class="text-sm font-bold font-mono tabular-nums mt-1 {{ shift < -0.05 ? 'text-error' : (shift > 0.05 ? 'text-tertiary' : 'text-on-surface') }}">{{ shift >= 0 ? '+' : '' }}{{ shift|number_format(2) }}%</p>
										{% else %}
											<p class="text-sm font-bold font-mono tabular-nums mt-1 text-on-surface-variant">-</p>
										{% endif %}
										<p class="text-3xs uppercase tracking-wide text-on-surface-variant/60 mt-1">volume won or lost on its own real price change</p>
									</div>
								</div>
							{% endif %}

							{% if industry.rosterSize > 1 %}
								<div class="mt-4 pt-4 border-t border-outline-variant/15">
									<p class="text-2xs uppercase tracking-wide font-semibold text-on-surface-variant mb-2">Share of modelled industry sales</p>
									<ul class="space-y-1.5" aria-label="Industry revenue shares">
										{% for peerTicker, share in industry.peerShares|sort|reverse(true) %}
											{% set isSelf = peerTicker == asset.ticker %}
											<li class="flex items-center gap-3 text-xs">
												<span class="w-14 shrink-0 font-mono {{ isSelf ? 'text-primary font-bold' : 'text-on-surface-variant' }}">{% if isSelf %}{{ peerTicker }}{% else %}<a href="/stock/{{ peerTicker }}" class="hover:underline">{{ peerTicker }}</a>{% endif %}</span>
												<span class="flex-1 h-1.5 rounded-full bg-surface-container-highest overflow-hidden"><span class="block h-full rounded-full {{ isSelf ? 'bg-primary' : 'bg-outline-variant' }}" style="width: {{ (share * 100)|round(1) }}%"></span></span>
												<span class="w-14 shrink-0 text-right font-mono tabular-nums {{ isSelf ? 'text-primary font-bold' : 'text-on-surface-variant' }}">{{ (share * 100)|number_format(1) }}%</span>
											</li>
										{% endfor %}
									</ul>
								</div>
							{% elseif industry.tracked %}
								<p class="mt-4 pt-4 border-t border-outline-variant/15 text-xs text-on-surface-variant leading-relaxed">The only modelled firm in its industry: the rest of its addressable market is not simulated, so the roster share is not shown. The capacity balance above weighs its own build beyond trend by its addressable share; the rest of the industry is taken to supply at trend.</p>
							{% endif %}
						</div>
					{% endif %}

					{# Corporate Life-Cycle (Dickinson 2011) #}
					<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all" id="lifecycle-card">
						<div class="flex items-start justify-between gap-3 mb-4">
							<div>
								<h3 class="text-sm font-semibold text-primary">Corporate Life-Cycle</h3>
								<p class="text-xs text-on-surface-variant mt-1">Classified each quarter from the signs of operating, investing and financing cash flow (Dickinson 2011).</p>
							</div>
							{% if lifecycleStage is not null and not asset.isBankrupt %}
								<span class="shrink-0 inline-flex items-center rounded border px-2 py-0.5 text-xs font-bold uppercase tracking-wide {{ stageTone[lifecycleStage.value] }}">{{ lifecycleStage.label }}</span>
							{% endif %}
						</div>

						<ol class="grid grid-cols-5 gap-2" aria-label="Life-cycle stages">
							{% for stage in lifecycleStages %}
								{% set isCurrent = lifecycleStage is not null and not asset.isBankrupt and stage.value == lifecycleStage.value %}
								<li class="flex flex-col gap-2 min-w-0" {% if isCurrent %}aria-current="step"{% endif %}>
									<span class="h-1.5 rounded-full {{ isCurrent ? stageBar[stage.value] : 'bg-surface-container-highest' }}"></span>
									<span class="text-2xs uppercase tracking-wide font-semibold truncate {{ isCurrent ? 'text-on-surface' : 'text-on-surface-variant/60' }}">{{ stage.label }}</span>
									<span class="hidden sm:block text-2xs font-mono tabular-nums whitespace-nowrap {{ isCurrent ? 'text-on-surface-variant' : 'text-on-surface-variant/40' }}">{{ stage.cashFlowSignature }}</span>
								</li>
							{% endfor %}
						</ol>
						<p class="hidden sm:block mt-2 text-3xs uppercase tracking-wide text-on-surface-variant/50">Sign pattern: operating / investing / financing cash flow</p>

						<div class="mt-4 pt-4 border-t border-outline-variant/15 text-xs text-on-surface-variant leading-relaxed">
							{% if asset.isBankrupt %}
								Delisted. Life-cycle classification stopped with the last filed report.
							{% elseif lifecycleStage is null %}
								Not yet classified. The stage is assigned with the first quarterly report.
							{% else %}
								<span class="text-on-surface font-semibold">{{ lifecycleStage.label }}.</span> {{ lifecycleStage.description }}
								{% if not lifecycleStage.initiatesDistributions %}
									<span class="block mt-1">Dividends are withheld at this stage: every dollar is reinvested until operations turn cash positive.</span>
								{% elseif lifecycleStage.isShedding %}
									<span class="block mt-1">Management is under pressure to divest: shake-out and decline firms sell assets to fund operations.</span>
								{% endif %}
							{% endif %}
						</div>
					</div>
					{# Sector Peer Comparison Table #}
					<div class="bg-surface-container-low rounded-lg border border-outline-variant/15 overflow-hidden p-6 hover:border-outline-variant/30 transition-all">
						<h3 class="text-sm font-semibold text-on-surface mb-3">
							Sector Peer Comparison ({{ asset.sector }})
						</h3>

						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse min-w-162.5">
								<thead>
									<tr class="text-2xs text-on-surface-variant uppercase tracking-wide border-b border-outline-variant/15 font-semibold">
										<th class="py-2.5">Company</th>
										<th class="py-2.5 text-right">Price</th>
										<th class="py-2.5 text-right">Market Cap</th>
										<th class="py-2.5 text-right">P/E Ratio</th>
										<th class="py-2.5 text-right">ROIC / ROE</th>
										<th class="py-2.5 text-right">Ind. Share</th>
										<th class="py-2.5 text-right">Total Equity</th>
										<th class="py-2.5 text-right">Action</th>
									</tr>
								</thead>
								<tbody
									class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
									{# Current Stock Highlighted #}
									<tr class="bg-primary/5 font-bold">
										<td class="py-2.5 flex items-center gap-2">
											<span class="text-primary font-mono">{{ asset.ticker }}</span>
											<span class="text-on-surface text-xs">{{ asset.name }}</span>
											<span class="px-1.5 py-0.2 rounded text-4xs bg-primary/20 text-primary uppercase">Current</span>
										</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">${{ asset.price|number_format(2) }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ marketCap|format_large('$') }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peRatio ? peRatio|number_format(2) ~ 'x' : '-' }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ ((isFinancial ? (asset.currentRoe ?: asset.baselineRoe) : (asset.currentRoic ?: asset.baselineRoic)) * 100)|number_format(2) }}%</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ industry and industry.rosterShare is not null ? (industry.rosterShare * 100)|number_format(1) ~ '%' : '-' }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ asset.totalEquity|format_large('$') }}</td>
										<td class="py-2.5 text-right text-xs text-on-surface-variant">-</td>
									</tr>

									{# Peer Companies #}
									{% for peer in peers %}
										<tr class="relative hover:bg-surface-container-high/30 focus-within:bg-surface-container-high/30 transition-colors group">
											<th scope="row" class="py-2.5 flex items-center gap-2 text-left font-normal">
												<a href="/stock/{{ peer.ticker }}" class="font-mono text-primary font-bold group-hover:underline outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:underline-offset-4">{{ peer.ticker }}</a>
												<span class="text-on-surface-variant text-xs">{{ peer.name }}</span>
											</th>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">${{ peer.price|number_format(2) }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.marketCap|format_large('$') }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.peRatio ? peer.peRatio|number_format(2) ~ 'x' : '-' }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ (peer.roic * 100)|number_format(2) }}%</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ industry and industry.peerShares[peer.ticker] is defined ? (industry.peerShares[peer.ticker] * 100)|number_format(1) ~ '%' : '-' }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.totalEquity|format_large('$') }}</td>
											<td class="py-2.5 text-right">
												<a href="/stock/{{ peer.ticker }}" class="relative z-10 px-2 py-0.5 text-xs font-semibold text-primary bg-primary/10 rounded hover:bg-primary/20 transition-colors">
													View
												</a>
											</td>
										</tr>
									{% else %}
										<tr>
											<td colspan="8" class="py-4 text-center text-xs text-on-surface-variant">No peer companies found in this sector.</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>

				</div>
			{% endif %}


			{# ========================================================================= #}
			{# TAB: OPTIONS #}
			{# ========================================================================= #}
			{% if not isEtf %}
				<div id="stock-tab-content-options" class="stock-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="options" data-controller="option-ticket">

					{% include 'stock/_option_chain.html.twig' %}

					{# The ticket. One per page, loaded from whichever mark was clicked, so the contract
					   being traded is carried from the cell rather than re-derived from the form. #}
					{% if app.user and optionsListed %}
						<div data-option-ticket-target="modal"
							 data-action="click->option-ticket#backdropClick"
							 class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4">
							<div class="w-full max-w-sm bg-surface-container-low rounded-lg border border-outline-variant/30 shadow-2xl p-5 space-y-4">
								<div class="flex items-start justify-between gap-4">
									<div>
										<h3 class="text-xs uppercase tracking-wide font-semibold text-on-surface-variant">Option Order</h3>
										<p class="font-mono text-base font-bold text-on-surface" data-option-ticket-target="symbol"></p>
									</div>
									<button type="button" data-action="option-ticket#close" aria-label="Close order ticket"
											class="text-on-surface-variant hover:text-on-surface cursor-pointer text-lg leading-none">&times;</button>
								</div>

								<form action="/trade/execute" method="POST" class="space-y-3" data-action="submit->option-ticket#onSubmit">
									<input type="hidden" name="ticker" value="">
									<input type="hidden" name="orderType" value="MARKET">
									<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

									<div class="grid grid-cols-2 gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20"
										 data-option-ticket-target="actionGroup">
										<label class="cursor-pointer">
											<input type="radio" name="action" value="BUY" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">Buy</div>
										</label>
										<label class="cursor-pointer">
											<input type="radio" name="action" value="SELL" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">Sell</div>
										</label>
										<label class="cursor-pointer">
											<input type="radio" name="action" value="WRITE" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">Write</div>
										</label>
										<label class="cursor-pointer">
											<input type="radio" name="action" value="COVER" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">Cover</div>
										</label>
									</div>

									<p class="text-2xs text-on-surface-variant leading-relaxed" data-option-ticket-target="hint"></p>

									<div class="space-y-1">
										<label for="option-quantity" class="text-xs font-semibold text-on-surface-variant">Contracts</label>
										<input type="number" id="option-quantity" name="quantity" min="1" step="1" value="1" required
											   data-option-ticket-target="quantity"
											   data-action="input->option-ticket#render"
											   class="w-full px-3 py-2 rounded bg-surface-container-lowest border border-outline-variant/30 text-on-surface font-mono tabular-nums focus:border-primary focus:outline-none">
										<p class="text-3xs text-on-surface-variant/60">{{ optionMultiplier }} shares per contract.</p>
									</div>

									<div class="flex justify-between items-center text-xs pt-1 border-t border-outline-variant/15">
										<span class="text-on-surface-variant uppercase tracking-wide text-2xs font-semibold">Premium at mark</span>
										<span class="font-mono tabular-nums font-bold text-on-surface" data-option-ticket-target="estimate">—</span>
									</div>

									<button type="submit" data-option-ticket-target="submit"
											class="w-full py-2.5 rounded bg-primary text-on-primary text-sm font-bold uppercase tracking-wider hover:opacity-90 transition-opacity cursor-pointer">
										Send Order
									</button>

									<p class="text-3xs text-on-surface-variant/60 leading-relaxed">
										Filled at market against the live underlying. The premium above is struck at the mark and
										does not include the spread.
									</p>
								</form>
							</div>
						</div>
					{% endif %}
				</div>
			{% endif %}

			{# ========================================================================= #}
			{# TAB 4: ORDER DEPTH & TRADES #}
			{# ========================================================================= #}
				<div
				id="stock-tab-content-orders" class="stock-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="orders"> {# Open Limit Orders for this Ticker #}
				<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
					<div class="flex items-center justify-between mb-3">
						<h3 class="text-sm font-semibold text-on-surface">
							Your Active Orders for {{ asset.ticker }}
						</h3>
						<span class="text-xs font-mono text-on-surface-variant">{{ openOrders|length }} active</span>
					</div>

					{% if openOrders|length > 0 %}
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse min-w-125">
								<thead>
									<tr class="text-2xs text-on-surface-variant uppercase tracking-wide border-b border-outline-variant/15 font-semibold">
										<th class="py-2.5">Placed Date</th>
										<th class="py-2.5">Action</th>
										<th class="py-2.5 text-right">Shares</th>
										<th class="py-2.5 text-right">Limit Price</th>
										<th class="py-2.5 text-right">Total Est.</th>
										<th class="py-2.5 text-right">Cancel</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
									{% for order in openOrders %}
										<tr>
											<td class="py-2.5 text-xs text-on-surface-variant font-mono">{{ order.createdAt|date('Y-m-d H:i') }}</td>
											<td class="py-2.5 font-bold {{ order.action == 'BUY' ? 'text-secondary' : 'text-primary' }}">{{ order.action }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ order.quantity|number_format }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums font-bold text-on-surface">${{ order.limitPrice|number_format(2) }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">${{ (order.limitPrice * order.quantity)|number_format(2) }}</td>
											<td class="py-2.5 text-right">
												<form action="/trade/cancel/{{ order.id }}" method="POST" class="inline">
													<input type="hidden" name="_token" value="{{ csrf_token('cancel_trade_' ~ order.id) }}">
													<button type="submit" class="cursor-pointer px-2 py-0.5 text-xs font-bold text-tertiary bg-tertiary/10 hover:bg-tertiary/20 rounded border border-tertiary/20 transition-colors">
														Cancel
													</button>
												</form>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<p class="py-6 text-center text-xs text-on-surface-variant">No open limit orders for {{ asset.ticker }}.</p>
					{% endif %}
				</div>

				{# Your Past Trades on this Ticker #}
				<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/15 hover:border-outline-variant/30 transition-all">
					<h3 class="text-sm font-semibold text-on-surface mb-3">
						Your Execution History for {{ asset.ticker }}
					</h3>

					{% if userTrades|length > 0 %}
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse min-w-125">
								<thead>
									<tr class="text-3xs text-on-surface-variant uppercase tracking-widest border-b border-outline-variant/10">
										<th class="py-3 font-bold">Execution Date</th>
										<th class="py-3 font-bold">Action</th>
										<th class="py-3 font-bold text-right">Shares</th>
										<th class="py-3 font-bold text-right">Executed Price</th>
										<th class="py-3 font-bold text-right">Total</th>
										<th class="py-3 font-bold text-right">Status</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-outline-variant/5 text-sm">
									{% for trade in userTrades %}
										<tr>
											<td class="py-3 text-xs text-on-surface-variant">{{ (trade.filledAt ?? trade.createdAt)|date('Y-m-d H:i') }}</td>
											<td class="py-3 font-bold {{ trade.action == 'BUY' ? 'text-secondary' : 'text-primary' }}">{{ trade.action }}</td>
											<td class="py-3 text-right font-mono text-on-surface">{{ (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity)|number_format }}</td>
											<td class="py-3 text-right font-mono text-on-surface">${{ (trade.executionPrice ?? trade.limitPrice ?? 0.00)|number_format(2) }}</td>
											<td class="py-3 text-right font-mono font-bold text-on-surface">
												${{ ((trade.executionPrice ?? trade.limitPrice ?? 0.00) * (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity))|number_format(2) }}
											</td>
											<td class="py-3 text-right">
												<span class="px-2 py-0.5 text-3xs font-bold rounded {{ trade.status == 'FILLED' ? 'bg-secondary/10 text-secondary border border-secondary/20' : 'bg-surface-container text-on-surface-variant' }}">
													{{ trade.status }}
												</span>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<p class="py-6 text-center text-xs text-on-surface-variant font-serif">You have not executed any trades for
							{{ asset.ticker }}
							yet.</p>
					{% endif %}
				</div>

			</div>
		</div>

	</div>

	{# --- SANKEY MODAL (INCOME STATEMENT FLOW) --- #}
	<div id="sankey-modal" data-controller="sankey" data-sankey-ticker-value="{{ asset.ticker }}" data-sankey-url-value="/api/earnings-flow" data-action="click->sankey#backdropClick" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4">
		<div class="bg-surface-container-low border border-outline-variant/20 rounded-lg w-full max-w-5xl h-[85vh] flex flex-col overflow-hidden shadow-2xl">
			<div class="flex justify-between items-center p-6 border-b border-outline-variant/10">
				<div>
					<h3 class="text-lg font-bold text-on-surface flex items-center gap-2">
						<span class="material-symbols-outlined text-primary">account_tree</span>
						Earnings Flow (Sankey Diagram) -
						{{ asset.ticker }}
					</h3>
					<p class="text-xs text-on-surface-variant mt-0.5">Visualizing revenue streams through operational costs to net profit and capital allocation.</p>
				</div>
				<button type="button" data-action="click->sankey#close" onclick="document.dispatchEvent(new CustomEvent('sankey:close'))" class="text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer">
					<span class="material-symbols-outlined text-2xl">close</span>
				</button>
			</div>
			<div class="flex-1 p-6 relative">
				<div data-sankey-target="container" class="w-full h-full"></div>
			</div>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{# Price chart, fundamentals and macro panels, earnings flow Sankey. #}
	{% include 'partials/_chart_libraries.html.twig' with { lightweight: true, chartjs: true, echarts: true } %}

	{# Page data for assets/js/pages/stock.js. JSON rather than a JavaScript object literal:
	   in a literal, Twig's HTML escaper mangles apostrophes and a `</script>` in any value
	   closes the block early. #}
	<script type="application/json" id="aerie-data">
		{{ {
			ticker: asset.ticker,
			isEtf: isEtf,
			businessModel: businessModel|default('none'),
			isFinancial: isFinancial,
			sharesOutstanding: asset.sharesOutstanding|default(1),
			currentPrice: asset.price|default(0),
			userQuantity: userQuantity|default(0),
			eps: not isEtf and asset.earningsPerShare is defined ? asset.earningsPerShare|default(0) : 0,
			ticksPerYear: ticksPerYear|default(14400),
			pieLabels: pieLabels is defined and pieLabels ? pieLabels : [],
			pieData: pieData is defined and pieData ? pieData : [],
			sharesMap: sharesMap is defined and sharesMap ? sharesMap : {}
		}|json_encode|raw }}
	</script>

	<script type="module">
		import 'pages/stock';
	</script>
{% endblock %}
