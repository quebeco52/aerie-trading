{% extends 'base.html.twig' %}

{# --- TOOLTIP MACRO --- #}
{% macro tooltip(text, position = 'left', width = 'w-48', vpos = 'top') %}
	{% set arrowPosition = position == 'right' ? 'right-4' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-4') %}
	{% set alignClass = position == 'right' ? 'right-0' : (position == 'center' ? 'left-1/2 -translate-x-1/2' : 'left-0') %}
	{% set verticalClass = vpos == 'bottom' ? 'top-full mt-2.5' : 'bottom-full mb-2.5' %}
	{% set arrowVerticalClass = vpos == 'bottom' ? '-top-[5px] border-t border-l' : '-bottom-[5px] border-b border-r' %}

	<span role="tooltip" class="block pointer-events-none absolute {{ alignClass }} {{ verticalClass }} {{ width }} p-2.5 bg-[#0f172a] text-white text-[11px] leading-relaxed rounded-lg shadow-2xl opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 group-focus:opacity-100 group-focus:translate-y-0 transition-all duration-200 z-[100] normal-case tracking-normal font-normal border border-slate-700">
		{{ text }}
		<span class="block absolute {{ arrowVerticalClass }} {{ arrowPosition }} w-2.5 h-2.5 bg-[#0f172a] border-slate-700 transform rotate-45"></span>
	</span>
{% endmacro %}


{% block title %}
	{{ asset.ticker }}
	Stock Price & Analysis |
	{{ asset.name }}
	- Aerie Exchange
{% endblock %}

{% block meta %}
	<meta name="description" content="View live stock prices, market cap, and fundamental Clean Surplus accounting data for {{ asset.name }} ({{ asset.ticker }}). See the latest quarterly earnings reports and historical charts.">
	<meta property="og:title" content="{{ asset.ticker }} Stock Price | Aerie Exchange">
	<meta property="og:description" content="Live financial data and economic simulation for {{ asset.name }} ({{ isEtf ? 'Market Index' : asset.industry|default('General') }}).">
	<meta property="og:type" content="website">

	<script type="application/ld+json">
		{
				            "@context": "https://schema.org",
				            "@type": "{{ isEtf ? 'InvestmentFund' : 'Corporation' }}",
				            "name": "{{ asset.name }}",
				            "tickerSymbol": "{{ asset.ticker }}",
				            "description": "Live financial data and economic simulation for
		{{ asset.name }}.",
				            "url": "{{ app.request.uri }}"
		{% if isEtf and allAssets is defined %},
						                "hasPart": [
			{% for a in allAssets %}
				{
								                            "@type": "Corporation",
								                            "name": "{{ a.name }}",
								                            "tickerSymbol": "{{ a.ticker }}"
								                        }{{ not loop.last ? ',' : '' }}
			{% endfor %}
			]
		{% endif %}
		}
	</script>
{% endblock %}

{% block favicon %}
	<link rel="icon" href="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" type="image/svg+xml">
{% endblock %}

{% block body %}

	<div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-4 lg:py-8 w-full">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

			<div class="lg:col-span-8 space-y-6 lg:space-y-8">

				<div class="bg-surface-container-low shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)] rounded-2xl p-6 lg:p-8 border border-outline-variant/15">
					<div class="flex flex-col md:flex-row md:justify-between md:items-start gap-6 mb-8 w-full">
						{# Left Side - Identity #}
						<div class="flex items-center gap-4 min-w-0">
							<img class="w-14 h-14 md:w-16 md:h-16 rounded-full shadow-md shrink-0" src="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" onerror="this.onerror=null; this.src='{{ asset('icons/default.svg') }}';" alt="{{ asset.ticker }} icon">
							
							<div class="flex flex-col gap-1.5 min-w-0">
								<h1 class="text-3xl md:text-4xl font-bold text-on-surface tracking-tight break-words leading-tight">{{ asset.name }}</h1>
								
								<div class="flex flex-wrap items-center gap-2 md:gap-3">
									<p class="text-base font-bold text-on-surface-variant tracking-wide mr-1">{{ asset.ticker }}</p>
									
									<span class="group relative cursor-help inline-flex items-center rounded-md bg-surface-container-highest px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant focus-visible:outline-none" tabindex="0">
										<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">{{ isEtf ? 'Market Index' : asset.industry|default('General') }}</span>
										{% set bmMap = constant('App\\Data\\Sectors::BUSINESS_MODEL_DESCRIPTIONS') %}
										{% set bmDesc = isEtf ? 'An Exchange Traded Fund tracking a basket of underlying stocks, providing broad market exposure.' : (bmMap[businessModel|default('none')] ?? bmMap['none']) %}
										{{ _self.tooltip(bmDesc, 'left', 'w-72 z-50', 'bottom') }}
									</span>

									{% if not isEtf and asset.ceoArchetype is defined %}
										<span class="group relative cursor-help inline-flex items-center rounded-md bg-primary/10 px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-primary focus-visible:outline-none" tabindex="0">
											<span class="border-b border-dotted border-primary/70 pb-0.5">CEO: {{ asset.ceoArchetype|replace({'_': ' '})|title }}</span>
											{% set archetypeDescMap = constant('App\\Data\\CeoArchetypes::DESCRIPTIONS') %}
											{% set archetypeDesc = archetypeDescMap[asset.ceoArchetype] ?? 'The personality of the current CEO.' %}
											{{ _self.tooltip(archetypeDesc, 'left', 'w-64 z-50', 'bottom') }}
										</span>
									{% endif %}
								</div>
							</div>
						</div>

						{# Right Side - Price #}
						<div class="md:text-right shrink-0 flex flex-col md:items-end">
							<div class="flex items-center md:justify-end gap-2 mb-1">
								<span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
								<span class="text-[10px] font-bold tracking-widest text-secondary uppercase" id="live-indicator">Live Market</span>
							</div>
							<span class="block text-4xl md:text-5xl font-bold text-on-surface tracking-tighter transition-colors duration-300" id="big-price">
								${{ asset.price|number_format(2) }}
							</span>
						</div>
					</div>

					<div class="flex overflow-x-auto gap-1 sm:gap-2 mb-4 bg-surface-container-lowest p-1 rounded-lg w-full md:w-max [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="1w">1W</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="1m">1M</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="6m">6M</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-primary text-[#001a42] shadow-md shadow-primary/20 transition-colors text-center" data-range="1y">1Y</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="3y">3Y</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="5y">5Y</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="10y">10Y</button>
						<button class="range-btn flex-1 sm:flex-none shrink-0 px-1 sm:px-4 py-1.5 text-[10px] sm:text-xs font-bold rounded-md bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors text-center" data-range="max">MAX</button>
					</div>

					<div
						class="w-full h-[300px] md:h-[450px] relative rounded-xl overflow-hidden">

						{#SPINNER#}
						<div id="chart-spinner" class="hidden absolute inset-0 z-50 flex items-center justify-center bg-surface-container-low/60 backdrop-blur-sm transition-opacity duration-300">
							<svg class="animate-spin h-12 w-12 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24">
								<circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</div>

						<div id="mainChartContainer" class="w-full h-full"></div>
					</div>
				</div>

				<div class="bg-surface-container-low shadow-lg rounded-2xl p-6 lg:p-8 border border-outline-variant/15">
					<h3 class="text-sm font-bold uppercase tracking-widest text-primary mb-4">About
						{{ asset.name }}</h3>
					<div class="text-base font-serif text-on-surface-variant leading-relaxed tracking-wide">
						<p>{{ generalInfo|nl2br }}</p>
					</div>
				</div>

				{# --- FUNDAMENTALS DASHBOARD --- #}
				{% if not isEtf %}
					<div id="fundamentaldashboard" class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-surface-container-low/60 border border-outline-variant/20 rounded-2xl p-4 mb-4 gap-4">
						<div>
							<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface flex items-center gap-2">
								<span class="material-symbols-outlined text-primary text-base">analytics</span>
								Fundamental Financial Analytics
							</h3>
							<p class="text-[11px] text-on-surface-variant mt-0.5">Timeframe selection applies to all historical financial statement charts below.</p>
						</div>
						<div class="flex items-center gap-3 self-end sm:self-auto">
							<div class="flex space-x-2 bg-surface-container-lowest p-1.5 rounded-xl border border-outline-variant/15 shadow-inner">
								<button onclick="document.dispatchEvent(new CustomEvent('sankey:open'))" class="px-4 py-1.5 text-xs font-bold rounded-lg bg-surface-container text-primary border border-primary/20 hover:bg-primary/10 transition-all uppercase tracking-widest flex items-center gap-1">
									<span class="material-symbols-outlined text-[14px]">account_tree</span>
									Earnings Flow
								</button>
								<button onclick="updateCharts('12Q')" id="btn-global-12Q" class="px-4 py-1.5 text-xs font-bold rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-all uppercase tracking-widest">12Q</button>
								<button onclick="updateCharts('12Y')" id="btn-global-12Y" class="px-4 py-1.5 text-xs font-bold rounded-lg bg-primary text-[#001a42] shadow-lg shadow-primary/20 transition-all uppercase tracking-widest">12Y</button>
							</div>
						</div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-2">

						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Net Income Trend</span>
									{{ _self.tooltip('Tracks the total Revenue and Net Income generated each quarter.', 'left', 'w-64') }}
								</h3>
								<div class="flex items-center gap-3">
									<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
										<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
									</button>
								</div>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="netIncomeChart"></canvas>
							</div>
						</div>

						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Debt vs Equity</span>
									{{ _self.tooltip("Visualizes the company's capital structure. Total Equity (Book Value) compared against Total Debt.", 'right', 'w-64') }}
								</h3>
								<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
									<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
								</button>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="debtEquityChart"></canvas>
							</div>
						</div>

						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Credit Health & Maturity Wall</span>
									{{ _self.tooltip('Displays the Interest Coverage Ratio (ability to pay interest from operating profit) and the Blended Interest Rate on existing debt.', 'left', 'w-64') }}
								</h3>
								<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
									<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
								</button>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="creditHealthChart"></canvas>
							</div>
						</div>

						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Capital Efficiency</span>
									{% if isFinancial|default(false) %}
										{{ _self.tooltip('Shows Economic Value Added (EVA) and Return on Equity (ROE). Positive EVA means the company is creating true wealth above its capital costs.', 'right', 'w-64') }}
									{% else %}
										{{ _self.tooltip('Shows Economic Value Added (EVA) and Return on Invested Capital (ROIC). Positive EVA means the company is creating true wealth above its capital costs.', 'right', 'w-64') }}
									{% endif %}
								</h3>
								<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
									<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
								</button>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="capitalEfficiencyChart"></canvas>
							</div>
						</div>

						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Payout Allocation (LTM)</span>
									{{ _self.tooltip('Proportion of Trailing 12-Month net income distributed to shareholders as cash dividends vs retained earnings for business growth.', 'right', 'w-64') }}
								</h3>
								<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
									<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
								</button>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="payoutRatioChart"></canvas>
							</div>
						</div>

						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Revenue Streams</span>
									{{ _self.tooltip('Tracks the individual revenue sources making up the total revenue over time.', 'right', 'w-64') }}
								</h3>
								<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
									<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
								</button>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="revenueStreamsChart"></canvas>
							</div>
						</div>

						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Capital Return & Yield</span>
									{{ _self.tooltip('Tracks total dividends paid and stock buybacks over time (bars), overlaid with the trailing Dividend Yield percentage (orange line).', 'left', 'w-64') }}
								</h3>
								<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
									<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
								</button>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="capitalReturnChart"></canvas>
							</div>
						</div>
						{% if isFinancial|default(false) %}
							<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
								<div class="flex justify-between items-center mb-6">
									<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
										<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Regulatory Ratios</span>
										{{ _self.tooltip('Displays the Capital Ratio (Equity vs Total Assets) and Customer Deposit Ratio. Critical balance sheet health indicators for banks and financial institutions.', 'right', 'w-64') }}
									</h3>
									<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
										<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
									</button>
								</div>
								<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
									<canvas id="regulatoryRatiosChart"></canvas>
								</div>
							</div>
						{% endif %}

						{# --- NEW UNIVERSAL CHARTS --- #}
						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Valuation Multiples</span>
									{{ _self.tooltip('Displays historical Price-to-Earnings (P/E), Price-to-Book (P/B), and Price-to-Sales (P/S) multiples over time.', 'left', 'w-64') }}
								</h3>
								<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
									<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
								</button>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="valuationMultiplesChart"></canvas>
							</div>
						</div>

						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Per-Share Value & Dilution</span>
									{{ _self.tooltip('Tracks Earnings Per Share (EPS), Book Value Per Share (BVPS), and total Shares Outstanding (monitoring buyback retirement vs dilution).', 'right', 'w-64') }}
								</h3>
								<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
									<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
								</button>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="shareholderValueChart"></canvas>
							</div>
						</div>

						<div class="chart-card bg-surface-container-low shadow-lg rounded-2xl p-6 border border-outline-variant/15 transition-all duration-300">
							<div class="flex justify-between items-center mb-6">
								<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface group relative cursor-help focus-visible:outline-none" tabindex="0">
									<span class="border-b border-dotted border-on-surface-variant/70 pb-0.5">Free Cash Flow & Reinvestment</span>
									{{ _self.tooltip('Compares Free Cash Flow (FCF = Net Income - CapEx) against FCF Conversion Rate (%) and Net Retained Cash after shareholder distributions.', 'left', 'w-64') }}
								</h3>
								<button type="button" class="expand-chart-btn text-on-surface-variant hover:text-primary transition-colors focus:outline-none" title="Toggle Expand">
									<span class="material-symbols-outlined text-[18px] expand-icon">open_in_full</span>
								</button>
							</div>
							<div class="chart-canvas-container relative h-48 w-full transition-all duration-300">
								<canvas id="cashFlowSummaryChart"></canvas>
							</div>
						</div>

						{# --- SECTOR & BUSINESS MODEL TAILORED CHARTS --- #}
