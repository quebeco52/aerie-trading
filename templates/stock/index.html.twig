							<span class="text-on-surface-variant uppercase text-[10px] font-bold">Market Share</span>
							<p class="text-base font-bold text-primary font-mono mt-1">{{ (marketShare * 100)|number_format(2) }}%</p>
						</div>
					</div>
				</div>

				{# Sector Peer Comparison Table #}
				<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15 shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)]">
					<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface mb-4 flex items-center gap-2">
						<span class="material-symbols-outlined text-primary text-base">compare_arrows</span>
						Sector Peer Comparison ({{ asset.sector }})
					</h3>

					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse min-w-[650px]">
							<thead>
								<tr class="text-[10px] text-on-surface-variant uppercase tracking-widest border-b border-outline-variant/10">
									<th class="py-3 font-bold">Company</th>
									<th class="py-3 font-bold text-right">Price</th>
									<th class="py-3 font-bold text-right">Market Cap</th>
									<th class="py-3 font-bold text-right">P/E Ratio</th>
									<th class="py-3 font-bold text-right">ROIC / ROE</th>
									<th class="py-3 font-bold text-right">Total Equity</th>
									<th class="py-3 font-bold text-right">Action</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-outline-variant/5 text-sm">
								{# Current Stock Highlighted #}
								<tr class="bg-primary/5 font-bold">
									<td class="py-3 flex items-center gap-2">
										<span class="text-primary font-mono">{{ asset.ticker }}</span>
										<span class="text-on-surface text-xs">{{ asset.name }}</span>
										<span class="px-1.5 py-0.2 rounded text-[9px] bg-primary/20 text-primary uppercase">Current</span>
									</td>
									<td class="py-3 text-right font-mono text-on-surface">${{ asset.price|number_format(2) }}</td>
									<td class="py-3 text-right font-mono text-on-surface">${{ marketCap|format_large }}</td>
									<td class="py-3 text-right font-mono text-on-surface">{{ peRatio ? peRatio|number_format(2) ~ 'x' : '-' }}</td>
									<td class="py-3 text-right font-mono text-on-surface">{{ ((isFinancial ? (asset.currentRoe ?: asset.baselineRoe) : (asset.currentRoic ?: asset.baselineRoic)) * 100)|number_format(2) }}%</td>
									<td class="py-3 text-right font-mono text-on-surface">${{ asset.totalEquity|format_large }}</td>
									<td class="py-3 text-right text-xs text-on-surface-variant">-</td>
								</tr>

								{# Peer Companies #}
								{% for peer in peers %}
									<tr class="hover:bg-surface-container-high/40 transition-colors cursor-pointer group" onclick="window.location.href='/stock/{{ peer.ticker }}'">
										<td class="py-3 flex items-center gap-2">
											<span class="font-mono text-primary font-bold group-hover:underline">{{ peer.ticker }}</span>
											<span class="text-on-surface-variant text-xs">{{ peer.name }}</span>
										</td>
										<td class="py-3 text-right font-mono text-on-surface">${{ peer.price|number_format(2) }}</td>
										<td class="py-3 text-right font-mono text-on-surface">${{ peer.marketCap|format_large }}</td>
										<td class="py-3 text-right font-mono text-on-surface">{{ peer.peRatio ? peer.peRatio|number_format(2) ~ 'x' : '-' }}</td>
										<td class="py-3 text-right font-mono text-on-surface">{{ (peer.roic * 100)|number_format(2) }}%</td>
										<td class="py-3 text-right font-mono text-on-surface">${{ peer.totalEquity|format_large }}</td>
										<td class="py-3 text-right">
											<a href="/stock/{{ peer.ticker }}" class="px-2.5 py-1 text-xs font-bold text-primary bg-primary/10 rounded-lg hover:bg-primary/20 transition-colors">
												View
											</a>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="7" class="py-4 text-center text-xs text-on-surface-variant font-serif">No peer companies found in this sector.</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>

			</div>
		{% endif %}

		{# ========================================================================= #}
		{# TAB 4: ORDER DEPTH & TRADES #}
		{# ========================================================================= #}
		<div id="stock-tab-content-orders" class="stock-tab-panel hidden space-y-6">
			
			{# Open Limit Orders for this Ticker #}
			<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15 shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)]">
				<div class="flex items-center justify-between mb-4">
					<h3 class="text-xs font-bold uppercase tracking-widest text-on-surface flex items-center gap-2">
						<span class="material-symbols-outlined text-primary text-base">schedule</span>
						Your Active Orders for {{ asset.ticker }}
					</h3>
					<span class="text-xs font-mono text-on-surface-variant">{{ openOrders|length }} active</span>
				</div>

				{% if openOrders|length > 0 %}
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse min-w-[500px]">
							<thead>
								<tr class="text-[10px] text-on-surface-variant uppercase tracking-widest border-b border-outline-variant/10">
									<th class="py-3 font-bold">Placed Date</th>
									<th class="py-3 font-bold">Action</th>
									<th class="py-3 font-bold text-right">Shares</th>
									<th class="py-3 font-bold text-right">Limit Price</th>
									<th class="py-3 font-bold text-right">Total Est.</th>
									<th class="py-3 font-bold text-right">Cancel</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-outline-variant/5 text-sm">
								{% for order in openOrders %}
									<tr>
										<td class="py-3 text-xs text-on-surface-variant">{{ order.createdAt|date('Y-m-d H:i') }}</td>
										<td class="py-3 font-bold {{ order.action == 'BUY' ? 'text-secondary' : 'text-primary' }}">{{ order.action }}</td>
										<td class="py-3 text-right font-mono text-on-surface">{{ order.quantity|number_format }}</td>
										<td class="py-3 text-right font-mono font-bold text-on-surface">${{ order.limitPrice|number_format(2) }}</td>
										<td class="py-3 text-right font-mono text-on-surface-variant">${{ (order.limitPrice * order.quantity)|number_format(2) }}</td>
										<td class="py-3 text-right">
											<form action="/trade/cancel/{{ order.id }}" method="POST" class="inline">
												<input type="hidden" name="_token" value="{{ csrf_token('cancel_trade_' ~ order.id) }}">
												<button type="submit" class="px-2.5 py-1 text-xs font-bold text-tertiary bg-tertiary/10 hover:bg-tertiary/20 rounded-lg border border-tertiary/20 transition-colors">
													Cancel
												</button>
											</form>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% else %}
					<p class="py-6 text-center text-xs text-on-surface-variant font-serif">No open limit orders for {{ asset.ticker }}.</p>
				{% endif %}
			</div>

			{# Your Past Trades on this Ticker #}
			<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15 shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)]">
