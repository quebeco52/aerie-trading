								</div>

								<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-financial-category="income">
									<div class="flex items-start justify-between gap-4 mb-3">
										<div class="min-w-0">
											<h4 class="text-sm font-semibold text-on-surface">Revenue by segment</h4>
											<p class="text-xs text-on-surface-variant mt-0.5">How revenue splits across the company's business lines</p>
										</div>
										<div class="flex items-start gap-3 shrink-0">
											<div class="hidden sm:flex flex-col items-end text-right max-w-64">
												<span class="text-2xs text-on-surface-variant">Latest</span>
												<span class="text-xs font-mono font-bold text-on-surface tabular-nums" id="hud-revenueStreamsChart">-</span>
											</div>
											<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
												<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
											</button>
										</div>
									</div>
									<div class="chart-canvas-container h-80 md:h-85 w-full relative">
										<canvas id="revenueStreamsChart"></canvas>
									</div>
								</div>

								<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-financial-category="income">
									<div class="flex items-start justify-between gap-4 mb-3">
										<div class="min-w-0">
											<h4 class="text-sm font-semibold text-on-surface">Free cash flow</h4>
											<p class="text-xs text-on-surface-variant mt-0.5">Operating cash flow less capital spending, retained cash and cash conversion</p>
										</div>
										<div class="flex items-start gap-3 shrink-0">
											<div class="hidden sm:flex flex-col items-end text-right max-w-64">
												<span class="text-2xs text-on-surface-variant">Latest</span>
