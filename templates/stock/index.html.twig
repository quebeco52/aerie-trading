{% extends 'base.html.twig' %}

{% import 'partials/_ui.html.twig' as ui %}

{% block title %}
	{{ asset.ticker }}
	Stock Price & Analysis |
	{{ asset.name }}
	- Aerie Exchange
{% endblock %}

{% block meta %}
	<meta name="description" content="View live stock prices, market cap, financial statements, and fundamental valuation metrics for {{ asset.name }} ({{ asset.ticker }}).">
	<meta property="og:title" content="{{ asset.ticker }} Stock Price & Financials | Aerie Exchange">
	<meta property="og:description" content="Live financial data and analytics for {{ asset.name }} ({{ isEtf ? indexFacts.label : asset.industry|default('General') }}).">
	<meta property="og:type" content="website">
{% endblock %}

{% block favicon %}
	<link rel="icon" href="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" type="image/svg+xml">
{% endblock %}

{% block body %}
	{# Life-cycle stage tones: reused by the header badge and the Company card. #}
	{% set stageTone = {
		'introduction': 'bg-primary/10 text-primary border-primary/25',
		'growth': 'bg-secondary/10 text-secondary border-secondary/25',
		'mature': 'bg-surface-container-highest text-on-surface border-outline-variant/40',
		'shake_out': 'bg-tertiary/10 text-tertiary border-tertiary/25',
		'decline': 'bg-tertiary/20 text-tertiary border-tertiary/40',
	} %}
	{% set stageBar = {
		'introduction': 'bg-primary',
		'growth': 'bg-secondary',
		'mature': 'bg-on-surface',
		'shake_out': 'bg-tertiary/60',
		'decline': 'bg-tertiary',
	} %}

	<div
		class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5">

		<header class="flex flex-col md:flex-row md:justify-between md:items-end gap-6 pb-6 border-b border-outline-variant/15 relative z-20">
			<div class="flex items-center gap-4 min-w-0">
				<img class="w-12 h-12 sm:w-14 sm:h-14 rounded border border-outline-variant/20 bg-surface-container-lowest p-1.5 shrink-0 object-contain" src="{{ asset('icons/' ~ asset.ticker ~ '.svg') }}" onerror="this.onerror=null; this.src='{{ asset('icons/default.svg') }}';" alt="">

				<div class="min-w-0">
					<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight wrap-break-word leading-tight">{{ asset.name }}</h1>

					<div class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-sm text-on-surface-variant">
						<span class="font-mono font-semibold text-on-surface">{{ asset.ticker }}</span>
						{% if app.user %}
							<form action="{{ path('app_watchlist_toggle', { ticker: asset.ticker }) }}" method="POST" class="inline-flex">
								<input type="hidden" name="_token" value="{{ csrf_token('watchlist') }}">
								<button type="submit" aria-pressed="{{ isWatched ? 'true' : 'false' }}"
										class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-xs border transition-colors cursor-pointer {{ isWatched ? 'text-primary border-primary/40 bg-primary/10' : 'text-on-surface-variant border-outline-variant/30 hover:text-on-surface' }}">
									<span class="material-symbols-outlined text-sm leading-none {{ isWatched ? 'icon-filled' : '' }}" aria-hidden="true">star</span>
									{{ isWatched ? 'Watching' : 'Watch' }}
								</button>
							</form>
						{% endif %}
						<span class="text-on-surface-variant/40" aria-hidden="true">&middot;</span>
						<span class="group relative cursor-help focus-visible:outline-none" tabindex="0">
							<span class="term">{{ isEtf ? indexFacts.indexName : asset.industry|default('General') }}</span>
							{% set bmMap = constant('App\\Data\\Sectors::BUSINESS_MODEL_DESCRIPTIONS') %}
							{% set bmDesc = isEtf ? indexFacts.mandate : (bmMap[businessModel|default('none')] ?? bmMap['none']) %}
							{{ ui.tooltip(bmDesc, 'left', 'w-72', 'bottom') }}
						</span>

						{% if lifecycleStage is not null and not asset.isBankrupt %}
							<span class="group relative cursor-help inline-flex items-center rounded border px-1.5 py-0.5 text-xs font-medium {{ stageTone[lifecycleStage.value] }} focus-visible:outline-none" tabindex="0" id="lifecycle-badge">
								<span class="border-b border-dotted border-current/60">{{ lifecycleStage.label }}</span>
								{{ ui.tooltip('Life-cycle stage, read from the signs of operating, investing and financing cash flow in the last quarterly report. ' ~ lifecycleStage.description ~ ' Pattern: ' ~ lifecycleStage.cashFlowSignature ~ '.', 'left', 'w-80', 'bottom') }}
							</span>
						{% endif %}
						{% if corporateBonds|default([])|length > 0 %}
							<a href="#corporate-debt-section" class="inline-flex items-center gap-1 rounded bg-surface-container-high px-1.5 py-0.5 text-xs font-mono text-on-surface-variant hover:text-primary border border-outline-variant/30 transition-colors" title="{{ corporateBonds|length }} corporate debt issues listed on the exchange">
								<span class="material-symbols-outlined text-xs" aria-hidden="true">receipt_long</span>
								<span>{{ corporateBonds|length }} {{ corporateBonds|length == 1 ? 'bond' : 'bonds' }}</span>
							</a>
						{% endif %}
						{% if not isEtf and asset.isBankrupt %}
							<span class="inline-flex items-center rounded bg-tertiary/10 px-1.5 py-0.5 text-xs font-medium text-tertiary border border-tertiary/25">Bankrupt, delisted</span>
						{% endif %}
					</div>
				</div>
			</div>

			<div class="md:text-right shrink-0">
				<span class="block text-3xl sm:text-4xl font-semibold font-mono tabular-nums {{ not isEtf and asset.isBankrupt ? 'text-tertiary line-through' : 'text-on-surface' }} tracking-tight transition-colors duration-300" id="big-price">
					${{ (not isEtf and asset.isBankrupt ? 0.00 : asset.price)|number_format(2) }}
				</span>

				{# Trailing month, per the price buffer: the schema carries no session open or
				   previous close to compute a daily move from. Labelled accordingly. #}
				<p class="mt-1 text-sm font-mono tabular-nums" id="big-change-row">
					{% if changePercent is not null %}
						<span id="big-change" class="font-semibold {{ changePercent|signed_class }}">{{ changePercent|pct(2, true) }}</span>
					{% else %}
						<span id="big-change" class="font-semibold text-on-surface-faint">&mdash;</span>
					{% endif %}
					<span class="font-sans text-xs text-on-surface-variant">past month</span>
				</p>
			</div>
		</header>

		<div class="space-y-5" data-controller="tabs" data-tabs-default-tab-value="overview">
			<div class="flex border-b border-outline-variant/20 overflow-x-auto gap-5 sm:gap-7 pb-px custom-scrollbar" role="tablist">
				<button class="stock-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-primary border-primary cursor-pointer" data-tab="overview" data-tabs-target="tab" data-action="click->tabs#select">
					Overview
				</button>
				{% if isEtf %}
					<button class="stock-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="constituents" data-tabs-target="tab" data-action="click->tabs#select">
						Constituents
						<span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ indexFacts.memberCount }}</span>
					</button>
				{% else %}
					{% if anchorPortfolio %}
						<button class="stock-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="holdings" data-tabs-target="tab" data-action="click->tabs#select">
							Holdings
							<span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ anchorPortfolio.holdings|length }}</span>
						</button>
					{% endif %}
					<button class="stock-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="financials" data-tabs-target="tab" data-action="click->tabs#select">
						Financials
					</button>
					<button class="stock-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="sector" data-tabs-target="tab" data-action="click->tabs#select">
						Company
					</button>
					<button class="stock-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="options" data-tabs-target="tab" data-action="click->tabs#select">
						Options
						{% if optionsListed %}
							<span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ optionExpiries|length }}</span>
						{% endif %}
					</button>
				{% endif %}
				<button class="stock-tab-btn pb-2.5 text-sm font-medium border-b-2 transition-colors flex items-center gap-1.5 whitespace-nowrap text-on-surface-variant hover:text-on-surface border-transparent cursor-pointer" data-tab="orders" data-tabs-target="tab" data-action="click->tabs#select">
					Your orders
					{% if openOrders|length > 0 %}
						<span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ openOrders|length }}</span>
					{% endif %}
				</button>
			</div>

			{# Overview tab #}
				<div id="stock-tab-content-overview" class="stock-tab-panel" data-tabs-target="panel" data-tab-panel="overview"> <div
					class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">

					{# Left column: chart, about, news #}
					<div
						class="lg:col-span-8 space-y-6">
												<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
							<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
								<div class="flex overflow-x-auto gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5 w-full sm:w-auto [&::-webkit-scrollbar]:hidden" style="scrollbar-width: none;" role="group" aria-label="Chart range">
									<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="1w">1W</button>
									<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="1m">1M</button>
									<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="6m">6M</button>
									<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="true" data-range="1y">1Y</button>
									<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="3y">3Y</button>
									<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="5y">5Y</button>
									<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="10y">10Y</button>
									<button type="button" class="range-btn seg-btn flex-1 sm:flex-none" aria-pressed="false" data-range="max">Max</button>
								</div>

								{# Line or candles over the same bars. Candles only carry a real range on rows written
								   since bars existed; older rows render flat, which is what actually happened. #}
								{% if not isEtf %}
									<div class="inline-flex gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5" role="group" aria-label="Chart style">
										<button type="button" class="chart-style-btn seg-btn" aria-pressed="true" data-style="area">Line</button>
										<button type="button" class="chart-style-btn seg-btn" aria-pressed="false" data-style="candles">Candles</button>
									</div>
								{% endif %}
							</div>

							<div class="w-full h-75 md:h-112.5 relative rounded overflow-hidden">
								<div id="chart-spinner" class="hidden absolute inset-0 z-50 items-center justify-center bg-surface-container-low/80 transition-opacity duration-300">
									<svg class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
										<circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
										<path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
									</svg>
								</div>
								<div id="mainChartContainer" class="w-full h-full"></div>
							</div>
						</div>

												<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
							<h2 class="text-sm font-semibold text-on-surface mb-2">About {{ asset.name }}</h2>
							<div class="text-sm text-on-surface-variant leading-relaxed space-y-3">
								{% for paragraph in (generalInfo ?? '')|split("\n\n") %}
									<p>{{ paragraph }}</p>
								{% endfor %}
							</div>
						</div>

						{# Corporate news, one partials/_event_card.html.twig row per story. #}
						<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
							<h2 class="text-sm font-semibold text-on-surface mb-1">News and corporate events</h2>
							<div class="divide-y divide-outline-variant/10" id="events-feed">
								{% for rawEvent in events %}
									{% include 'partials/_event_card.html.twig' with { event: present_event(rawEvent) } only %}
								{% else %}
									<p id="no-events-msg" class="py-6 text-center text-sm text-on-surface-variant">No news for {{ asset.ticker }} yet.</p>
								{% endfor %}
							</div>
						</div>
					</div>

					{# Right column: trade ticket and statistics #}
					<div
						class="lg:col-span-4 space-y-6">

												<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
							<h3 class="text-sm font-semibold text-on-surface mb-3">
								Trade {{ asset.ticker }}
							</h3>

							{% if not isEtf and asset.isBankrupt %}
								<div class="p-3 bg-tertiary/10 border border-tertiary/25 rounded space-y-1.5">
									<p class="text-tertiary font-semibold text-sm">Trading halted</p>
									<p class="text-xs text-on-surface-variant leading-relaxed">
										This corporation is in bankruptcy liquidation. Trading is permanently halted.
									</p>
								</div>
							{% else %}
								{# Shown when the user holds shares OR has ever been paid by this ticker: dividend cash
								   received survives selling out of the position, so it stays visible afterwards. #}
								{% if userQuantity != 0 or userDividendIncome > 0 or userRealised|default(0) != 0 %}
									<div class="mb-4 p-3 bg-surface-container-lowest/80 rounded border border-outline-variant/20 space-y-1.5">
										{% if userQuantity != 0 %}
											<div class="flex justify-between items-center text-xs">
												<span class="text-on-surface-variant">Your position</span>
												<span class="flex items-center gap-2">
													{% if userQuantity < 0 %}<span class="badge badge-down">Short</span>{% endif %}
													<span class="font-bold text-on-surface font-mono tabular-nums">{{ userQuantity|abs|number_format }} shares</span>
												</span>
											</div>
											<div class="flex justify-between items-center text-xs">
												<span class="text-on-surface-variant">{{ userQuantity < 0 ? 'Avg sale price' : 'Avg cost basis' }}</span>
												<span class="font-mono tabular-nums text-on-surface-variant">{{ userAvgCost|money(2) }}</span>
											</div>
											<div class="flex justify-between items-center text-xs">
												<span class="text-on-surface-variant">{{ userQuantity < 0 ? 'Cost to cover' : 'Market value' }}</span>
												<span class="font-bold text-on-surface font-mono tabular-nums" id="user-holding-value">{{ (userQuantity|abs * asset.price)|money(2) }}</span>
											</div>
											<div class="flex justify-between items-center text-xs pt-1.5 border-t border-outline-variant/15">
												<span class="text-on-surface-variant">Unrealised return</span>
												<span class="font-mono tabular-nums font-bold {{ userUnrealizedPnL|signed_class }}">
													{{ userUnrealizedPnL|money(2, true) }}
													({{ (userUnrealizedPnLPercent / 100)|pct(2, true) }})
												</span>
											</div>
											{% if userBorrowAccrued|default(0) > 0 %}
												<div class="flex justify-between items-center text-xs">
													<span class="text-on-surface-variant">Borrow fees paid</span>
													<span class="font-mono tabular-nums text-tertiary">{{ (-userBorrowAccrued)|money(2) }}</span>
												</div>
											{% endif %}
										{% endif %}
										{% if userRealised|default(0) != 0 %}
											<div class="flex justify-between items-center text-xs {{ userQuantity != 0 ? 'pt-1.5 border-t border-outline-variant/15' : '' }}">
												<span class="text-on-surface-variant">Realised return</span>
												<span class="font-mono tabular-nums font-bold {{ userRealised|signed_class }}">{{ userRealised|money(2, true) }}</span>
											</div>
										{% endif %}
										{% if userDividendIncome > 0 %}
											<div class="flex justify-between items-center text-xs {{ userQuantity != 0 or userRealised|default(0) != 0 ? 'pt-1.5 border-t border-outline-variant/15' : '' }}">
												<span class="text-on-surface-variant">Dividends received</span>
												<span class="font-mono tabular-nums font-bold text-secondary">+{{ userDividendIncome|money(2) }}</span>
											</div>
										{% endif %}
									</div>
								{% endif %}

								<form action="/trade/execute" method="POST" class="space-y-3"
											  data-controller="trade-form"
											  data-trade-form-ticker-value="{{ asset.ticker }}"
											  data-trade-form-price-value="{{ asset.price }}"
											  data-trade-form-duty-rate-value="{{ isEtf ? 0 : macro.stampDutyRate }}"
											  data-action="submit->trade-form#onSubmit">
									<input type="hidden" name="ticker" value="{{ asset.ticker }}">
									<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

									<div class="flex gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20">
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="action" value="BUY" class="peer sr-only" checked>
											<div class="py-1.5 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">
												Buy
											</div>
										</label>
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="action" value="SELL" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">
												Sell
											</div>
										</label>
									</div>

									{# Borrowed sides, shown only on a margin account and only for equities. #}
									{% if not isEtf and app.user and app.user.marginEnabled %}
										<div class="flex gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20">
											<label class="flex-1 cursor-pointer">
												<input type="radio" name="action" value="SHORT" class="peer sr-only">
												<div class="py-1.5 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">
													Short
												</div>
											</label>
											<label class="flex-1 cursor-pointer">
												<input type="radio" name="action" value="COVER" class="peer sr-only">
												<div class="py-1.5 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">
													Cover
												</div>
											</label>
										</div>

										<div class="p-3 rounded bg-surface-container-lowest/80 border border-outline-variant/20 space-y-1.5 text-xs">
											<div class="flex justify-between items-center">
												<span class="text-on-surface-variant">Borrow fee</span>
												<span class="font-mono tabular-nums font-bold {{ borrowFee > borrowWarnings.expensiveFee ? 'text-warning' : 'text-on-surface' }}">{{ borrowFee|pct(2) }}/yr</span>
											</div>
											<div class="flex justify-between items-center">
												<span class="text-on-surface-variant">Available to borrow</span>
												<span class="font-mono tabular-nums font-bold text-on-surface">{{ availableToBorrow|format_large }}</span>
											</div>
											{% if shortUtilization >= borrowWarnings.scarceUtilization %}
												<p class="text-2xs text-warning leading-relaxed pt-1 border-t border-outline-variant/15">
													{{ shortUtilization|pct(0) }} of lendable stock is out on loan.
													{{ shortUtilization >= borrowWarnings.recallUtilization ? 'Lenders are recalling: open shorts can be bought in whether or not the account is in good standing.' : 'The borrow is getting expensive.' }}
												</p>
											{% endif %}
										</div>
									{% endif %}

									<div class="flex gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20">
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="orderType" value="MARKET" class="peer sr-only" checked data-action="change->trade-form#onOrderTypeChange">
											<div class="py-1 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-surface-container-high peer-checked:text-primary transition-all">
												Market
											</div>
										</label>
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="orderType" value="LIMIT" class="peer sr-only" data-action="change->trade-form#onOrderTypeChange">
											<div class="py-1 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-surface-container-high peer-checked:text-primary transition-all">
												Limit
											</div>
										</label>
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="orderType" value="STOP" class="peer sr-only" data-action="change->trade-form#onOrderTypeChange">
											<div class="py-1 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-surface-container-high peer-checked:text-primary transition-all">
												Stop
											</div>
										</label>
										<label class="flex-1 cursor-pointer">
											<input type="radio" name="orderType" value="STOP_LIMIT" class="peer sr-only" data-action="change->trade-form#onOrderTypeChange">
											<div class="py-1 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-surface-container-high peer-checked:text-primary transition-all">
												Stop limit
											</div>
										</label>
									</div>

									<div id="stop-price-group" class="hidden space-y-1" data-trade-form-target="stopGroup">
										<label for="stopPrice" class="text-xs font-medium text-on-surface-variant">Stop price</label>
										<input type="number" step="0.01" min="0.01" id="stopPrice" name="stopPrice" placeholder="{{ asset.price|number_format(2, '.', '') }}" class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none" data-trade-form-target="stopPrice" data-action="input->trade-form#render">
										<p class="text-3xs text-on-surface-faint leading-4">
											A sell stop sits below the market and fires when the price falls to it. A plain stop then takes whatever the book quotes, which on a fast tape can be well through the trigger.
										</p>
									</div>

									<div id="limit-price-group" class="hidden space-y-1" data-trade-form-target="limitGroup">
										<label for="limitPrice" class="text-xs font-medium text-on-surface-variant">Limit price</label>
										<input type="number" step="0.01" min="0.01" id="limitPrice" name="limitPrice" placeholder="{{ asset.price|number_format(2, '.', '') }}" class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none" data-trade-form-target="limitPrice" data-action="input->trade-form#render">
									</div>

									<div class="space-y-1">
										<label for="quantity" class="text-xs font-medium text-on-surface-variant">Quantity</label>
										<input type="number" id="quantity" name="quantity" min="1" max="1000000" value="1" required class="w-full bg-surface-container-lowest border border-outline-variant/25 rounded px-3 py-1.5 text-sm font-mono tabular-nums text-on-surface focus:ring-1 focus:ring-primary outline-none" data-trade-form-target="quantity" data-action="input->trade-form#render">
									</div>

									<div class="p-3 rounded bg-surface-container-lowest/80 border border-outline-variant/20 space-y-1.5 text-xs">
										<div class="flex justify-between items-center">
											<span class="text-on-surface-variant" data-trade-form-target="estimateLabel">Estimated cost</span>
											<span class="font-bold text-on-surface font-mono tabular-nums text-sm" id="estimated-total" data-trade-form-target="estimate" aria-live="polite">{{ asset.price|money(2) }}</span>
										</div>
										<div class="flex justify-between items-center text-on-surface-variant" data-trade-form-target="costsRow">
											<span>Spread and impact</span>
											<span class="font-mono tabular-nums" data-trade-form-target="costs">&mdash;</span>
										</div>
										<p class="hidden text-2xs text-on-surface-variant text-right" data-trade-form-target="costsNote"></p>
										{% if not isEtf %}
											{# Listed shares carry the District's stamp duty on both sides; funds are exempt. #}
											<div class="flex justify-between items-center text-on-surface-variant">
												<span>Stamp duty ({{ macro.stampDutyRate|pct(2) }}, to the Sovereign Reserve Fund)</span>
												<span class="font-mono tabular-nums" data-trade-form-target="duty">-</span>
											</div>
										{% endif %}
									</div>

									<button type="submit" data-trade-form-target="submit" class="w-full py-2 px-4 rounded bg-primary text-on-primary font-semibold text-sm hover:bg-primary-container transition-colors cursor-pointer">Place order</button>
								</form>
							{% endif %}
						</div>

						{% if app.user and not (not isEtf and asset.isBankrupt) %}
							{% include 'stock/_price_alerts.html.twig' with { ticker: asset.ticker, price: asset.price, alerts: priceAlerts } only %}
						{% endif %}

												{% if not isEtf %}
							<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
								<h3 class="text-sm font-semibold text-on-surface mb-3">
									Key statistics
								</h3>

								<dl class="divide-y divide-outline-variant/15 text-sm">
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Market cap</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-mkt-cap">{{ marketCap|format_large('$') }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Shares out</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-shares">{{ asset.sharesOutstanding|number_format }}</dd>
									</div>
									{% if strategicStake > 0 and not asset.bankrupt %}
										{# The District's own stake, off the float and outside the fund; its dividends are paid into the fund. #}
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">District strategic stake</span>
												{{ ui.tooltip('The District holds this stake itself, outside the Sovereign Reserve Fund. It is off the float and never traded, and its dividends are paid into the fund.', 'left', 'w-64') }}
											</dt>
											<dd class="font-medium font-mono tabular-nums"><a href="/reserve" class="text-on-surface hover:text-primary hover:underline">{{ strategicStake|pct(2) }} of shares</a></dd>
										</div>
									{% endif %}
									{% if macro.sovereignFundOwnershipShare > 0 and not asset.bankrupt %}
										{# The fund holds the same share of every name's float, so its stake here is that share of this float. #}
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Sovereign Reserve Fund</span>
												{{ ui.tooltip('The district\'s sovereign fund holds the same share of every listed company\'s float and trades only when its board weight, or its whole equity share, leaves its band around policy.', 'left', 'w-64') }}
											</dt>
											<dd class="font-medium font-mono tabular-nums"><a href="/reserve" class="text-on-surface hover:text-primary hover:underline">{{ (macro.sovereignFundOwnershipShare * asset.publicFloatPercentage * 100)|number_format(2) }}% of shares</a></dd>
										</div>
									{% endif %}
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">P/E ratio</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-pe">{{ peRatio ? peRatio|number_format(2) ~ 'x' : '-' }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">EPS (TTM)</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-eps">{{ asset.earningsPerShare|money(2) }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Dividend yield</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-div-yield">{{ dividendYield > 0 ? dividendYield|pct(2) : '-' }}</dd>
									</div>
									{% if netAssetValue %}
										{# A closed-end structure is quoted against its assets, never against its earnings. #}
										<div class="py-2 flex justify-between items-center">
											<dt class="text-on-surface-variant">NAV / share</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-nav">{{ netAssetValue.perShare|money(2) }}</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="text-on-surface-variant">{{ netAssetValue.premium < 0 ? 'Discount to NAV' : 'Premium to NAV' }}</dt>
											<dd class="font-medium font-mono tabular-nums {{ netAssetValue.premium|signed_class }}" id="stat-nav-premium">{{ netAssetValue.premium|pct(1) }}</dd>
										</div>
									{% endif %}
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Avg daily volume</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-adv">{{ advShares|format_large }}</dd>
									</div>
									{% if shortInterest|default(null) %}
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Short interest</span>
												{{ ui.tooltip('Shares sold short, as a share of the float, and the days of average volume it would take to buy them back.', 'left', 'w-64') }}
											</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums">
												{{ shortInterest.floatShare is null ? '—' : shortInterest.floatShare|pct(2) }}
												<span class="text-on-surface-variant font-normal text-2xs">{{ shortInterest.daysToCover is null ? '' : shortInterest.daysToCover|number_format(1) ~ ' days to cover' }}</span>
											</dd>
										</div>
									{% endif %}
									{% if nextReport|default(null) %}
										<div class="py-2 flex justify-between items-center">
											<dt class="text-on-surface-variant">Next results</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums">{{ nextReport.dateline }} <span class="text-on-surface-variant font-normal font-sans text-2xs">{{ nextReport.quarter }}</span></dd>
										</div>
									{% endif %}
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Bid-ask spread</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-spread">{{ (halfSpread * 20000)|number_format(1) }} bps</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Volatility</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-volatility">{{ ((asset.currentVolatility is not null ? asset.currentVolatility : asset.volatility) * 100)|number_format(2) }}%</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Beta</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">{{ asset.beta|number_format(2) }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">{{ isFinancial ? 'ROE' : 'ROIC' }}</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-roic">
											{% if isFinancial %}
												{{ ((asset.currentRoe != 0 ? asset.currentRoe : asset.baselineRoe) * 100)|number_format(2) }}%
											{% else %}
												{{ ((asset.currentRoic != 0 ? asset.currentRoic : asset.baselineRoic) * 100)|number_format(2) }}%
											{% endif %}
										</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Book value (equity)</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-equity">{{ asset.totalEquity|format_large('$') }}</dd>
									</div>
									{% if capital %}
										{# A firm the regulator governs is quoted on tangible book and judged on its capital ratio;
										   debt-to-equity with deposits in the numerator says nothing about a bank. #}
										{% set zoneLabel = {'Safe': 'well capitalized', 'Grey': 'grey zone', 'Distress': 'distressed'} %}
										{% set zoneTone = capital.zone == 'Safe' ? 'text-secondary' : (capital.zone == 'Grey' ? 'text-warning' : 'text-tertiary') %}
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Tangible book / share</span>
												{{ ui.tooltip('Book equity less goodwill, per share. The Financial Regulator deducts goodwill from capital, so this is the book a financial firm is valued and judged on.', 'left', 'w-72') }}
											</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-tbvps">{{ capital.tangibleBookPerShare|money(2) }}</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="text-on-surface-variant">Price / tangible book</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-ptbv" data-tbvps="{{ capital.tangibleBookPerShare }}">{{ capital.priceToTangibleBook is null ? '-' : capital.priceToTangibleBook|number_format(2) ~ 'x' }}</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Return on tangible equity</span>
												{{ ui.tooltip('Trailing twelve months of net income over tangible equity. It exceeds ROE by the goodwill the firm carries: the same earnings over the capital that actually backs them.', 'left', 'w-72') }}
											</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums">{{ capital.returnOnTangibleEquity is null ? '-' : capital.returnOnTangibleEquity|pct(2) }}</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Capital ratio</span>
												{{ ui.tooltip('Tangible equity over tangible assets, the ratio the regulator closes the firm on. Well capitalized above ' ~ capitalThresholds.warning|number_format(1) ~ '%, distressed below ' ~ capitalThresholds.distress|number_format(1) ~ '%, closed below ' ~ capitalThresholds.bankrupt|number_format(1) ~ '%.', 'left', 'w-72') }}
											</dt>
											<dd class="font-medium font-mono tabular-nums {{ zoneTone }}">{{ capital.ratio|pct(2) }} <span class="font-normal text-2xs">{{ zoneLabel[capital.zone] ?? capital.zone }}</span></dd>
										</div>
										{% if capital.cet1 is not null %}
											<div class="py-2 flex justify-between items-center">
												<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
													<span class="term">CET1 ratio</span>
													{{ ui.tooltip('Common equity tier 1 less goodwill, over risk-weighted assets (Basel III). Payouts are restricted when it runs below the regulatory buffer.', 'left', 'w-72') }}
												</dt>
												<dd class="font-medium text-on-surface font-mono tabular-nums">{{ capital.cet1|pct(2) }}</dd>
											</div>
										{% endif %}
										{% if capital.goodwillShare %}
											<div class="py-2 flex justify-between items-center">
												<dt class="text-on-surface-variant">Goodwill / book</dt>
												<dd class="font-medium text-on-surface font-mono tabular-nums">{{ capital.goodwillShare|pct(1) }}</dd>
											</div>
										{% endif %}
									{% else %}
										<div class="py-2 flex justify-between items-center">
											<dt class="text-on-surface-variant">Debt to equity</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-debt-ratio">{{ asset.debtToEquityRatio|number_format(2) }}x</dd>
										</div>
									{% endif %}
									{% if asset.creditRating is defined %}
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Credit rating</span>
												{{ ui.tooltip('The rating, and the spread the company\'s credit trades at today over the District\'s own bond curve. Its listed bonds are priced at this spread.', 'left', 'w-64') }}
											</dt>
											<dd class="font-medium font-mono"><span class="text-primary" id="stat-credit-rating">{{ asset.creditRating }}</span> <span class="text-on-surface-variant font-normal text-2xs tabular-nums" id="stat-credit-spread">+{{ (asset.dynamicCreditSpread * 10000)|number_format(0) }} bps</span></dd>
										</div>
									{% endif %}
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
											<span class="term">Accruals / assets</span>
											{{ ui.tooltip('Accruals ratio: (net income − free cash flow) / total assets, annualised. Cash-backed earnings sit near zero; a high positive reading means reported profit is running ahead of cash and tends to reverse.', 'left', 'w-72') }}
										</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums" id="stat-accruals">{{ asset.accrualsRatio is null ? '-' : ((asset.accrualsRatio > 0 ? '+' : '') ~ asset.accrualsRatio|pct(2)) }}</dd>
									</div>
								</dl>
							</div>
						{% endif %}

						{# Credit & Solvency: what would put an operating company into bankruptcy, as its lenders see it.
						   An operating firm files when it cannot pay, not when a score turns (FailureSweep). #}
						{% if creditHealth|default(null) %}
							{% set credit = creditHealth %}
							<div class="bg-surface-container-low rounded-lg p-6 border {{ credit.inDefault ? 'border-tertiary/40' : 'border-outline-variant/15 hover:border-outline-variant/30' }} transition-all" id="credit-health-card">
								<div class="flex items-center justify-between gap-3 mb-3">
									<h3 class="text-sm font-semibold text-on-surface">Credit and solvency</h3>
									{% if credit.inDefault %}
										<span class="badge badge-down">In default</span>
									{% elseif not credit.hasCovenantHeadroom %}
										<span class="badge badge-warn">Covenant breached</span>
									{% else %}
										<span class="inline-flex items-center rounded border px-1.5 py-0.5 text-2xs font-medium border-outline-variant/30 text-on-surface-variant">Current</span>
									{% endif %}
								</div>

								{% if credit.inDefault %}
									<p class="mb-3 p-3 rounded bg-tertiary/10 border border-tertiary/25 text-xs text-on-surface leading-relaxed">
										Missed a principal payment {{ credit.quartersInDefault }} {{ credit.quartersInDefault == 1 ? 'quarter' : 'quarters' }} running.
										{% if credit.cureDueNextReport %}
											The grace period has run: unless it funds the payment by the next report, its lenders accelerate and it files, under Chapter 11 if the business still covers its cash costs, otherwise Chapter 7.
										{% else %}
											It is inside the grace period and can still cure by funding the payment.
										{% endif %}
									</p>
								{% endif %}

								<dl class="divide-y divide-outline-variant/15 text-sm">
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
											<span class="term">Revolver drawn</span>
											{{ ui.tooltip('The committed credit line, and how much of it is drawn. The undrawn part is the cash the firm can reach in a bad quarter without going to the market.', 'left', 'w-72') }}
										</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">
											{% if credit.revolverUtilization is null %}
												-
											{% else %}
												{{ credit.revolverDrawn|format_large('$') }} <span class="text-on-surface-variant font-normal text-2xs">of {{ credit.revolverCommitment|format_large('$') }} ({{ credit.revolverUtilization|pct(0) }})</span>
											{% endif %}
										</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
											<span class="term">Net debt / EBITDA</span>
											{{ ui.tooltip('Funded net debt over trailing EBITDA, the leverage an incurrence covenant is tested on. Past the limit the firm may not take on new discretionary debt.', 'left', 'w-72') }}
										</dt>
										<dd class="font-medium font-mono tabular-nums {{ credit.hasCovenantHeadroom ? 'text-on-surface' : 'text-tertiary' }}">
											{{ credit.netDebtToEbitda|number_format(2) }}x{% if credit.covenantLimit is not null %} <span class="text-on-surface-variant font-normal text-2xs">limit {{ credit.covenantLimit|number_format(1) }}x</span>{% endif %}
										</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
											<span class="term">Interest coverage</span>
											{{ ui.tooltip('How many times operating income covers the interest bill. Below the sector minimum the firm pays down debt before it pays out.', 'left', 'w-72') }}
										</dt>
										<dd class="font-medium font-mono tabular-nums {{ credit.coverageState == 'adequate' ? 'text-on-surface' : 'text-tertiary' }}">
											{{ credit.interestCoverage|number_format(1) }}x{% if credit.coverageState != 'adequate' %} <span class="font-normal text-2xs">{{ credit.coverageState }}</span>{% endif %}
										</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
											<span class="term">Distance to default</span>
											{{ ui.tooltip('How many standard deviations of asset value stand between the firm and its debt over five years. The rating agency grades on it: below ' ~ constant('App\\Service\\Market\\CreditRatingAgency::THRESHOLD_BBB')|number_format(1) ~ ' is speculative grade.', 'left', 'w-72') }}
										</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">{{ credit.distanceToDefault|number_format(2) }}σ</dd>
									</div>
								</dl>
							</div>
						{% endif %}

						{# Corporate Debt Issues #}
						{% if corporateBonds|default([])|length > 0 %}
							<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/15 hover:border-outline-variant/30 transition-all" id="corporate-debt-section">
								<div class="flex items-center justify-between gap-3 mb-3">
									<div>
										<h2 class="text-sm font-semibold text-on-surface">Listed debt issues</h2>
										<p class="text-2xs text-on-surface-variant mt-0.5">Corporate bonds trading on the exchange</p>
									</div>
									<a href="/bonds" class="text-xs text-primary hover:underline flex items-center gap-0.5">
										<span>Bond ladder</span>
										<span class="material-symbols-outlined text-xs" aria-hidden="true">arrow_forward</span>
									</a>
								</div>
								<div class="divide-y divide-outline-variant/10">
									{% for bond in corporateBonds %}
										<a href="/bond/{{ bond.ticker }}" class="py-2.5 flex items-center justify-between group hover:bg-surface-bright/50 -mx-2 px-2 rounded transition-colors">
											<div class="min-w-0">
												<div class="flex items-center gap-2">
													<span class="font-mono font-semibold text-xs text-primary group-hover:underline">{{ bond.ticker }}</span>
													<span class="text-2xs text-on-surface-variant font-mono tabular-nums">{{ bond.couponRate|pct(3) }}</span>
												</div>
												<p class="text-3xs text-on-surface-variant mt-0.5 font-mono tabular-nums">Matures in {{ bond.yearsToMaturity|number_format(1) }}y &middot; {{ bond.modifiedDuration|number_format(2) }} duration</p>
											</div>
											<div class="text-right shrink-0">
												<p class="text-sm font-semibold font-mono tabular-nums text-on-surface">{{ bond.cleanPrice|money(2) }}</p>
												<p class="text-2xs text-on-surface-variant font-mono tabular-nums">YTM {{ bond.yieldToMaturity|pct(2) }}</p>
											</div>
										</a>
									{% endfor %}
								</div>
							</div>
						{% endif %}

						{# Wall Street Analyst Consensus & Price Targets Card #}
						{% if not isEtf and not asset.isBankrupt %}
							<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
								<div class="flex items-center justify-between gap-3 mb-3">
									<h2 class="text-sm font-semibold text-on-surface">Analyst targets</h2>

									{% set rating = analystTargets.rating|default('Neutral') %}
									{% set ratingBg = rating == 'Outperform' ? 'bg-secondary/10 border-secondary/20 text-secondary' : (rating == 'Underperform' ? 'bg-tertiary/10 border-tertiary/20 text-tertiary' : 'bg-surface-container-highest border-outline-variant/20 text-on-surface-variant') %}
									<span id="analyst-consensus-badge" class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium border {{ ratingBg }}">{{ rating }}</span>
								</div>

								<div class="pb-3 mb-1 border-b border-outline-variant/15">
									<p class="text-xs text-on-surface-variant">12-month consensus</p>
									{# A missing target prints the dash: falling back to the price or to zero would publish a call nobody made. #}
									{% set upside = analystTargets.upside_pct ?? null %}
									<p class="mt-0.5 flex items-baseline gap-3">
										<span class="text-2xl font-semibold font-mono tabular-nums tracking-tight text-on-surface" id="target-consensus">{{ (analystTargets.consensus ?? null)|money(2) }}</span>
										{% if upside is not null %}
											<span id="target-upside" class="text-sm font-mono tabular-nums {{ upside > 5 ? 'text-secondary' : (upside < -5 ? 'text-tertiary' : 'text-on-surface-variant') }}">{{ (upside / 100)|pct(1, true) }} to target</span>
										{% else %}
											<span id="target-upside" class="text-sm font-mono tabular-nums text-on-surface-faint">&mdash;</span>
										{% endif %}
									</p>
								</div>

								{# Three desks, each pricing the stock its own way. #}
								<dl class="divide-y divide-outline-variant/10 text-sm">
									<div class="py-2.5 flex items-start justify-between gap-3">
										<dt>
											<span class="text-on-surface">Growth desk</span>
											<span class="block text-xs text-on-surface-variant">Discounted cash flow on forward earnings</span>
										</dt>
										<dd class="font-mono tabular-nums text-on-surface" id="target-growth">{{ (analystTargets.growth_analyst ?? null)|money(2) }}</dd>
									</div>
									<div class="py-2.5 flex items-start justify-between gap-3">
										<dt>
											<span class="text-on-surface">Value desk</span>
											<span class="block text-xs text-on-surface-variant">Justified price to book: return over hurdle</span>
										</dt>
										<dd class="font-mono tabular-nums text-on-surface" id="target-value">{{ (analystTargets.value_analyst ?? null)|money(2) }}</dd>
									</div>
									<div class="py-2.5 flex items-start justify-between gap-3">
										<dt>
											<span class="text-on-surface">Income desk</span>
											<span class="block text-xs text-on-surface-variant">Dividend discount, with a cash-yield floor</span>
										</dt>
										<dd class="font-mono tabular-nums text-on-surface" id="target-income">{{ (analystTargets.income_analyst ?? null)|money(2) }}</dd>
									</div>
								</dl>
							</div>
						{% endif %}

						{% if isEtf %}
							{# Index Facts Card: what the level is struck on and when its membership is next reviewed. #}
							<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
								<h3 class="text-sm font-semibold text-on-surface mb-3">
									Index facts
								</h3>
								<dl class="divide-y divide-outline-variant/15 text-sm">
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Constituents</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">
											{{ indexFacts.memberCount }}{% if indexFacts.constituentCount is not null %} <span class="text-on-surface-variant font-normal text-2xs">of {{ indexFacts.constituentCount }} seats</span>{% else %} <span class="text-on-surface-variant font-normal text-2xs">whole board</span>{% endif %}
										</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
											<span class="term">Float-adjusted cap</span>
											{{ ui.tooltip('The part of each constituent that actually trades, summed. The level is struck on this, not on total market capitalisation: weighting on the whole would have the fund holding stock that is not for sale.', 'left', 'w-72') }}
										</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.totalFloatCap|format_large('$') }}</dd>
									</div>
									{% if macro.sovereignFundOwnershipShare > 0 %}
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Sovereign Reserve Fund</span>
												{{ ui.tooltip('The district\'s sovereign fund holds the same share of every constituent\'s float, and so of this float-adjusted cap. It buys after a fall and trims after a run only when its board weight, or its whole equity share, leaves its band.', 'left', 'w-72') }}
											</dt>
											<dd class="font-medium font-mono tabular-nums"><a href="/reserve" class="text-on-surface hover:text-primary hover:underline">{{ macro.sovereignFundOwnershipShare|pct(2) }} of float</a></dd>
										</div>
									{% endif %}
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
											<span class="term">Top {{ indexFacts.topN }} weight</span>
											{{ ui.tooltip('Share of the index carried by its largest constituents. The higher it runs, the more the level is a handful of names rather than the market.', 'left', 'w-64') }}
										</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.topWeight|number_format(1) }}%</dd>
									</div>
									{% if indexFacts.largest %}
										<div class="py-2 flex justify-between items-center">
											<dt class="text-on-surface-variant">Largest holding</dt>
											<dd class="font-medium font-mono tabular-nums"><a href="/stock/{{ indexFacts.largest.ticker }}" class="text-primary hover:underline">{{ indexFacts.largest.ticker }}</a> <span class="text-on-surface">{{ indexFacts.largest.weight|number_format(1) }}%</span></dd>
										</div>
									{% endif %}
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Next review</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">in {{ indexFacts.daysUntilReconstitution|round }} days</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Last review</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums text-right">
											{% if not indexFacts.hasRoster %}
												<span class="text-on-surface-variant font-normal">pending</span>
											{% elseif indexFacts.added|length == 0 and indexFacts.deleted|length == 0 %}
												<span class="text-on-surface-variant font-normal">no change</span>
											{% else %}
												{% if indexFacts.added|length > 0 %}<span class="text-secondary">+{{ indexFacts.added|length }}</span>{% endif %}
												{% if indexFacts.deleted|length > 0 %}<span class="text-tertiary">&minus;{{ indexFacts.deleted|length }}</span>{% endif %}
											{% endif %}
										</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Reviews per year</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.reconstitutionsPerYear }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
											<span class="term">Divisor</span>
											{{ ui.tooltip('Level = float-adjusted cap of the members / divisor. Restated at every review and every fund split so that a change of composition or of units never moves the level; only prices do.', 'left', 'w-72') }}
										</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.divisor is null ? '-' : indexFacts.divisor|format_large }}</dd>
									</div>
									<div class="py-2 flex justify-between items-center">
										<dt class="text-on-surface-variant">Passive money</dt>
										<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.carriesPassiveBook ? 'tracks this index' : 'benchmark only' }}</dd>
									</div>
									{% if indexFacts.navPremium is not null %}
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Premium to NAV</span>
												{{ ui.tooltip('What the fund trades at against what it owns. The two are set by different crowds and only agree because an authorized participant is paid to make them agree — and only to within what that trade costs. Past the band below, creating or redeeming shares turns a profit and somebody closes the gap.', 'left', 'w-72') }}
											</dt>
											<dd class="font-medium font-mono tabular-nums {{ indexFacts.navPremium >= 0 ? 'text-on-surface' : 'text-on-surface-variant' }}">
												{{ indexFacts.navPremium > 0 ? '+' : '' }}{{ indexFacts.navPremium|number_format(3) }}%
											</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Arbitrage band</span>
												{{ ui.tooltip('How far the fund may drift from its basket before the arbitrage pays. It is the round-trip cost of assembling the basket, read off the live book — so a fund whose constituents have become expensive to trade is allowed to drift further, which is why a credit fund and an equity fund behave differently in the same stressed week.', 'left', 'w-72') }}
											</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums">±{{ indexFacts.arbitrageBand|number_format(3) }}%</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="text-on-surface-variant">Shares in issue</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.sharesOutstanding|format_large('') }}</dd>
										</div>
									{% endif %}
									{% if indexFacts.expenseRatio is not null %}
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Expense ratio</span>
												{{ ui.tooltip('The annual fee, accrued continuously against net assets. It is met out of the dividend income the fund collects; anything income cannot cover is met by selling holdings, which is what makes the fund fall behind its index.', 'left', 'w-72') }}
											</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.expenseRatio|number_format(2) }}%</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Distribution yield</span>
												{{ ui.tooltip('Paid out over the trailing year, as a share of the current price. The index is a PRICE index and has no yield of its own; this is the dividend cash the fund collected from its constituents and passed on.', 'left', 'w-72') }}
											</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.distributionYield|number_format(2) }}%</dd>
										</div>
										<div class="py-2 flex justify-between items-center">
											<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
												<span class="term">Fees charged</span>
												{{ ui.tooltip('What the fee has come to since the fund opened, per share. It is taken out of the dividend income before that income is distributed, so it never appears as a fall in the price — the holder simply receives less every quarter.', 'left', 'w-72') }}
											</dt>
											<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.feesPaidPerShare|money(2) }}</dd>
										</div>
										{% if indexFacts.tradingCostsPerShare > 0.005 %}
											<div class="py-2 flex justify-between items-center">
												<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
													<span class="term">Trading costs</span>
													{{ ui.tooltip('The spread the fund has crossed rebalancing itself, per share. An index changes its weights by arithmetic; a fund has to trade to follow it. A fund weighted by size pays almost none of this, because its weights maintain themselves as prices move.', 'left', 'w-72') }}
												</dt>
												<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.tradingCostsPerShare|money(2) }}</dd>
											</div>
										{% endif %}
										{% if indexFacts.trackingDifference > 0.005 %}
											<div class="py-2 flex justify-between items-center">
												<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
													<span class="term">Tracking difference</span>
													{{ ui.tooltip('How far the basket has fallen behind the one index unit a share started with. It only ever grows: a fund never buys back what it sold to pay for itself, whether that was a fee income could not cover or the spread on a rebalance.', 'left', 'w-72') }}
												</dt>
												<dd class="font-medium text-on-surface font-mono tabular-nums">&minus;{{ indexFacts.trackingDifference|number_format(2) }}%</dd>
											</div>
										{% endif %}
										{% if indexFacts.accruedIncome > 0 %}
											<div class="py-2 flex justify-between items-center">
												<dt class="group relative cursor-help text-on-surface-variant" tabindex="0">
													<span class="term">Income accrued</span>
													{{ ui.tooltip('Dividend cash the fund has collected and not yet distributed, per share. It is already in the price and leaves it at the next distribution — the drop is the payment, not a loss.', 'left', 'w-72') }}
												</dt>
												<dd class="font-medium text-on-surface font-mono tabular-nums">{{ indexFacts.accruedIncome|money(2) }}</dd>
											</div>
										{% endif %}
									{% endif %}
								</dl>
							</div>

							{# Weightings Card #}
							<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
								<h3 class="text-sm font-semibold text-on-surface mb-3">
									Constituent weightings
								</h3>

								<div class="h-64 relative w-full mb-4">
									<canvas id="etfPieChart"></canvas>
								</div>

								{% if components is defined and components|length > 0 %}
									<div class="space-y-2 mt-4 max-h-56 overflow-y-auto custom-scrollbar">
										{% for comp in components %}
											<div class="flex justify-between items-center text-xs p-2 rounded-lg bg-surface-container-lowest/60 border border-outline-variant/5">
												<div class="flex items-center gap-2 min-w-0">
													<span class="text-3xs font-mono text-on-surface-faint w-5 text-right shrink-0">{{ comp.rank }}</span>
													<a href="/stock/{{ comp.ticker }}" class="font-bold text-primary hover:underline font-mono">{{ comp.ticker }}</a>
													<span class="text-on-surface-variant truncate max-w-30">{{ comp.name|default('') }}</span>
													{% if comp.isNew %}<span class="badge badge-up shrink-0">New</span>{% endif %}
												</div>
												<span class="font-bold text-on-surface font-mono tabular-nums" id="idx-weight-{{ comp.ticker }}">{{ comp.weight|default(0)|number_format(2) }}%</span>
											</div>
										{% endfor %}
									</div>
								{% endif %}
							</div>
						{% endif %}

					</div>
				</div>
			</div>

			{# Constituents tab (index funds only) #}
				{% if isEtf %}
					<div
					id="stock-tab-content-constituents" class="stock-tab-panel hidden space-y-6" data-tabs-target="panel" data-tab-panel="constituents">
					{# Header: what the index is for #}
					<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
						<div>
							<h2 class="text-lg font-semibold text-on-surface">{{ indexFacts.indexName }} constituents</h2>
							<p class="text-sm text-on-surface-variant mt-0.5">{{ asset.name }} tracks the {{ indexFacts.indexName }}, published by <a href="/stock/{{ indexFacts.indexProviderTicker }}" class="text-primary hover:underline">{{ indexFacts.indexProvider }}</a>.</p>
							<p class="text-sm text-on-surface-variant mt-1 max-w-3xl">{{ indexFacts.mandate }}</p>
						</div>
						<dl class="grid grid-cols-3 gap-x-8 shrink-0">
							<div>
								<dt class="text-xs text-on-surface-variant">Members</dt>
								<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5">{{ indexFacts.memberCount }}</dd>
							</div>
							<div>
								<dt class="text-xs text-on-surface-variant">Listed</dt>
								<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5">{{ indexFacts.listedCount }}</dd>
							</div>
							<div>
								<dt class="text-xs text-on-surface-variant">Next review</dt>
								<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5">{{ indexFacts.daysUntilReconstitution|round }}d</dd>
							</div>
						</dl>
					</div>

					<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
						{# Left: the full constituent table #}
						<div class="lg:col-span-8 space-y-6">
							<div class="bg-surface-container-low rounded-lg border border-outline-variant/15 overflow-hidden">
								<div class="px-5 py-4 border-b border-outline-variant/15 flex items-center justify-between">
									<div>
										<h3 class="text-sm font-semibold text-on-surface">Constituents</h3>
										<p class="text-xs text-on-surface-variant mt-0.5">Ranked on {{ indexFacts.rankingLabel|lower }} across {{ indexFacts.universe }}, weighted by {{ indexFacts.weightingLabel|lower }}. Weights repaint live and drift with prices between reviews.</p>
									</div>
								</div>
								<div class="overflow-x-auto">
									<table class="w-full text-left border-collapse">
										<thead>
											<tr class="table-head bg-surface-container-highest/20">
												<th scope="col" class="px-4 py-3 text-right w-12">#</th>
												<th scope="col" class="px-4 py-3">Company</th>
												<th scope="col" class="px-4 py-3 hidden md:table-cell">Sector</th>
												<th scope="col" class="px-4 py-3 text-right">Price</th>
												<th scope="col" class="px-4 py-3 text-right hidden sm:table-cell" title="Change over the trailing one-month buffered window">1M</th>
												<th scope="col" class="px-4 py-3 text-right hidden sm:table-cell">Float cap</th>
												<th scope="col" class="px-5 py-3 text-right w-40">Weight</th>
											</tr>
										</thead>
										<tbody class="divide-y divide-outline-variant/10 text-sm">
											{% for comp in components %}
												<tr id="idx-row-{{ comp.ticker }}" data-float-cap="{{ comp.adjustedCap }}" class="hover:bg-surface-container-high/30 transition-colors group relative">
													<td class="px-4 py-3 text-right font-mono text-xs text-on-surface-variant tabular-nums">{{ comp.rank }}</td>
													<th scope="row" class="px-4 py-3 text-left font-normal">
														<div class="flex items-center gap-2">
															<a href="/stock/{{ comp.ticker }}" class="font-bold text-on-surface text-sm group-hover:text-primary transition-colors outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:decoration-primary focus-visible:underline-offset-4">{{ comp.name }}</a>
															{% if comp.isNew %}<span class="badge badge-up relative z-10">New</span>{% endif %}
														</div>
														<div class="text-on-surface-variant text-xs font-mono mt-0.5">{{ comp.ticker }}</div>
													</th>
													<td class="px-4 py-3 hidden md:table-cell text-on-surface-variant text-xs">{{ comp.sector }}</td>
													<td class="px-4 py-3 text-right font-bold font-mono tabular-nums text-xs sm:text-sm text-on-surface" id="idx-price-{{ comp.ticker }}">{{ comp.price|money(2) }}</td>
													<td class="px-4 py-3 text-right font-semibold font-mono tabular-nums text-xs sm:text-sm hidden sm:table-cell {{ comp.changePercent|signed_class }}">
														{%- if comp.changePercent is null -%}&mdash;{%- else -%}{{ comp.changePercent|pct(2, true) }}{%- endif -%}
													</td>
													<td class="px-4 py-3 text-right font-mono tabular-nums text-xs sm:text-sm text-on-surface-variant hidden sm:table-cell">{{ comp.floatCap|format_large('$') }}</td>
													<td class="px-5 py-3 text-right">
														<div class="flex items-center justify-end gap-3">
															<div class="h-1.5 w-20 bg-surface-container-highest rounded overflow-hidden hidden sm:block" aria-hidden="true">
																<div id="idx-bar-{{ comp.ticker }}" class="h-1.5 bg-primary rounded" style="width: {{ comp.weight|number_format(2, '.', '') }}%"></div>
															</div>
															<div class="w-16 text-right">
												<span class="font-bold font-mono tabular-nums text-xs sm:text-sm text-on-surface block" id="idx-weight-{{ comp.ticker }}">{{ comp.weight|number_format(2) }}%</span>
												{# Where the review set it, shown only once the live weight has drifted off it. A capped name
												   above its cap is the commonest case and the one most likely to read as a broken cap: the
												   fund holds the shares it bought at the review and does not trade again until the next one. #}
												{% if comp.targetWeight is not null and (comp.weight - comp.targetWeight)|abs >= 0.05 %}
													<span class="group relative cursor-help text-4xs font-mono text-on-surface-faint block" tabindex="0">
														{{ comp.targetWeight|number_format(2) }}% set
														{{ ui.tooltip('The weight the last review set. Weights drift with prices between reviews because the fund holds a fixed number of shares &mdash; it does not trade again until the next review pulls it back to target.', 'left', 'w-64') }}
													</span>
												{% endif %}
											</div>
														</div>
													</td>
												</tr>
											{% else %}
												<tr>
													<td colspan="7" class="px-5 py-8 text-center text-xs text-on-surface-variant">The index committee has not held its first review yet.</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>
						</div>

						{# Right: sectors, the last review, the boundary, the method #}
						<div class="lg:col-span-4 space-y-6">
							{# Sector weights #}
							<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
								<h3 class="text-sm font-semibold text-on-surface mb-3">Sector weights</h3>
								<div class="space-y-2.5">
									{% for row in indexFacts.sectorWeights %}
										<div>
											<div class="flex justify-between items-center text-xs mb-1">
												<span class="text-on-surface-variant">{{ row.sector }} <span class="text-3xs font-mono text-on-surface-faint">({{ row.count }})</span></span>
												<span class="font-bold font-mono tabular-nums text-on-surface">{{ row.weight|number_format(1) }}%</span>
											</div>
											<div class="h-1.5 bg-surface-container-highest rounded overflow-hidden" aria-hidden="true">
												<div class="h-1.5 bg-primary/70 rounded" style="width: {{ row.weight|number_format(2, '.', '') }}%"></div>
											</div>
										</div>
									{% else %}
										<p class="text-xs text-on-surface-variant">No constituents.</p>
									{% endfor %}
								</div>
							</div>

							{# Last review #}
							<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
								<div class="flex items-center justify-between mb-3">
									<h3 class="text-sm font-semibold text-on-surface">Last review</h3>
									{% if indexFacts.daysSinceReconstitution is not null %}
										<span class="text-3xs font-mono text-on-surface-variant">{{ indexFacts.daysSinceReconstitution|round }} days ago</span>
									{% endif %}
								</div>
								{% if not indexFacts.hasRoster %}
									<p class="text-xs text-on-surface-variant">No review has been held yet.</p>
								{% elseif indexFacts.added|length == 0 and indexFacts.deleted|length == 0 %}
									<p class="text-xs text-on-surface-variant">The membership was confirmed unchanged.</p>
								{% else %}
									<div class="space-y-3 text-xs">
										{% if indexFacts.added|length > 0 %}
											<div>
												<div class="text-xs font-semibold text-secondary mb-1.5">Admitted</div>
												<div class="flex flex-wrap gap-1.5">
													{% for t in indexFacts.added %}<a href="/stock/{{ t }}" class="inline-flex items-center rounded bg-secondary/10 px-2 py-0.5 font-mono font-bold text-secondary border border-secondary/25 hover:bg-secondary/20">{{ t }}</a>{% endfor %}
												</div>
											</div>
										{% endif %}
										{% if indexFacts.deleted|length > 0 %}
											<div>
												<div class="text-xs font-semibold text-tertiary mb-1.5">Dropped</div>
												<div class="flex flex-wrap gap-1.5">
													{% for t in indexFacts.deleted %}<a href="/stock/{{ t }}" class="inline-flex items-center rounded bg-tertiary/10 px-2 py-0.5 font-mono font-bold text-tertiary border border-tertiary/25 hover:bg-tertiary/20">{{ t }}</a>{% endfor %}
												</div>
											</div>
										{% endif %}
									</div>
								{% endif %}
							</div>

							{# The boundary, for a selective index #}
							{% if indexFacts.isSelective %}
								<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
									<div class="flex items-center justify-between mb-1">
										<h3 class="text-sm font-semibold text-on-surface">The boundary</h3>
										{% if indexFacts.bands %}
											<span class="text-3xs font-mono text-on-surface-variant">bands #{{ indexFacts.bands.inner }} / #{{ indexFacts.bands.outer }}</span>
										{% endif %}
									</div>
									<p class="text-xs text-on-surface-variant leading-relaxed mb-4">
										A member keeps its seat until it ranks past #{{ indexFacts.bands ? indexFacts.bands.outer : '?' }}; an outsider is admitted once it ranks inside #{{ indexFacts.bands ? indexFacts.bands.inner : '?' }}, displacing the weakest member. Between the two nothing happens, which is what stops the boundary churning every quarter.
									</p>
									<div class="space-y-4 text-xs">
										<div>
											<div class="text-xs font-semibold text-tertiary mb-1.5">Exposed members</div>
											{% for row in indexFacts.atRisk %}
												<div class="flex justify-between items-center py-1.5 border-b border-outline-variant/10 last:border-0">
													<div class="flex items-center gap-2 min-w-0">
														<span class="font-mono text-on-surface-faint w-8 text-right shrink-0">#{{ row.rank }}</span>
														<a href="/stock/{{ row.ticker }}" class="font-bold font-mono text-primary hover:underline">{{ row.ticker }}</a>
														<span class="text-on-surface-variant truncate">{{ row.name }}</span>
													</div>
													{% if row.exits %}<span class="badge badge-down shrink-0">Drops next review</span>{% endif %}
												</div>
											{% else %}
												<p class="text-on-surface-variant">None. Every member ranks inside the inner band.</p>
											{% endfor %}
										</div>
										<div>
											<div class="text-xs font-semibold text-secondary mb-1.5">In contention</div>
											{% for row in indexFacts.contenders %}
												<div class="flex justify-between items-center py-1.5 border-b border-outline-variant/10 last:border-0">
													<div class="flex items-center gap-2 min-w-0">
														<span class="font-mono text-on-surface-faint w-8 text-right shrink-0">#{{ row.rank }}</span>
														<a href="/stock/{{ row.ticker }}" class="font-bold font-mono text-primary hover:underline">{{ row.ticker }}</a>
														<span class="text-on-surface-variant truncate">{{ row.name }}</span>
													</div>
													{% if row.qualifies %}<span class="badge badge-up shrink-0">Joins next review</span>{% endif %}
												</div>
											{% else %}
												<p class="text-on-surface-variant">None. No outsider ranks inside the outer band.</p>
											{% endfor %}
										</div>
									</div>
								</div>
							{% endif %}

							{# Method #}
							<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
								<h3 class="text-sm font-semibold text-on-surface mb-3">Methodology</h3>
								<dl class="space-y-3 text-xs">
									<div>
										<dt class="font-semibold text-on-surface">Index</dt>
										<dd class="text-on-surface-variant leading-relaxed">{{ asset.name }} is the fund; the {{ indexFacts.indexName }} is the index it tracks, published by <a href="/stock/{{ indexFacts.indexProviderTicker }}" class="text-primary hover:underline">{{ indexFacts.indexProvider }}</a>. They are separate things and the fund does not decide the index &mdash; it licenses it, out of the fee below.{% if indexFacts.providerIsConstituent %} The publisher is also the largest company in the index it publishes, which is a conflict the methodology discloses rather than resolves.{% endif %}</dd>
									</div>
									<div>
										<dt class="font-semibold text-on-surface">Universe</dt>
										<dd class="text-on-surface-variant leading-relaxed">{{ indexFacts.universe }}, ranked on: {{ indexFacts.rankingLabel|lower }}. Everything below applies to that universe and nothing outside it.{% if indexFacts.screensEarnings %} Admission additionally requires profitability &mdash; trailing twelve-month earnings and the most recent quarter both positive &mdash; and that test governs joining, never staying: a member that falls into losses keeps its seat until the bands take it.{% endif %}</dd>
									</div>
									<div>
										<dt class="font-semibold text-on-surface">Weighting</dt>
										<dd class="text-on-surface-variant leading-relaxed">{{ indexFacts.weightingLabel }}. {{ indexFacts.weightingDescription }}{% if indexFacts.isCapped %} Capped at each review at {{ indexFacts.maxConstituentWeight|number_format(1) }}% per constituent, with the excess redistributed across the rest &mdash; between reviews a constituent that outruns the index carries more than the cap, because the fund holds the shares it bought and does not trade until the next review{% if indexFacts.appliesConcentrationBudget %} &mdash; a sector this narrow cannot be sold as a diversified fund otherwise{% endif %}.{% endif %}</dd>
									</div>
									<div>
										<dt class="font-semibold text-on-surface">Level</dt>
										<dd class="text-on-surface-variant leading-relaxed">Members' float-adjusted cap, each carrying the weight factor fixed at the last review, divided by a divisor. The divisor is restated at every review and every fund split, so composition and re-weighting never move the level; only prices do. Between reviews the weights drift with prices, as a real fund's holdings do. A fresh market opens at {{ constant('App\\Service\\Math\\FinancialConstants::INDEX_BASE_LEVEL')|number_format(0) }}.</dd>
									</div>
									<div>
										<dt class="font-semibold text-on-surface">Review</dt>
										<dd class="text-on-surface-variant leading-relaxed">{{ indexFacts.reconstitutionsPerYear }} times a year. {% if indexFacts.isSelective %}Membership is banded: a &plusmn;{{ (constant('App\\Service\\Math\\FinancialConstants::INDEX_MEMBERSHIP_BUFFER') * 100)|number_format(0) }}% buffer around the cut, so a marginal overtake buys nothing and a clear one gets in.{% else %}Every name in the universe is a member; the review only removes what has been delisted or has left it.{% endif %} A bankrupt shell leaves at the first review after it dies.</dd>
									</div>
									{% if indexFacts.expenseRatio is not null %}
										<div>
											<dt class="font-semibold text-on-surface">Fees and income</dt>
											<dd class="text-on-surface-variant leading-relaxed">The fund holds the basket, so it receives the dividends its constituents pay and passes them on {{ constant('App\\Service\\Math\\FinancialConstants::FUND_DISTRIBUTIONS_PER_YEAR') }} times a year; the level above is a price index and shows none of that. Its {{ indexFacts.expenseRatio|number_format(2) }}% fee is charged against net assets and met out of that income first, so a distribution is net of what the fund costs to run. Only where income falls short does the fund sell holdings, which is why its price can track the index exactly while its holders are still paying for it: the cost is the {{ indexFacts.feesPaidPerShare|money(2) }} a share that never reached a distribution.{% if indexFacts.tradingCostsPerShare > 0.005 %} The fee is not the only cost. This index restrikes its weights at every review, and the fund has to trade to follow it: {{ indexFacts.tradingCostsPerShare|money(2) }} a share has gone in spread doing so, out of the basket rather than out of income, because a spread is paid inside the trade.{% endif %}</dd>
										</div>
									{% endif %}
									<div>
										<dt class="font-semibold text-on-surface">Passive flow</dt>
										<dd class="text-on-surface-variant leading-relaxed">{% if indexFacts.carriesPassiveBook %}{{ indexFacts.passiveShare|number_format(0) }}% of the market's indexed money tracks this index. Index funds hold each name in proportion to how much indexed money points at it across every published index, so an admitted name is bought and a dropped name is sold by the same flow that trades everything else.{% else %}No passive book tracks this index; it is a benchmark, read against the headline index.{% endif %}</dd>
									</div>
								</dl>
							</div>
						</div>
					</div>
				</div>
			{% endif %}

			{# Financials tab #}
				{% if not isEtf %}
				{% if anchorPortfolio %}
					<div id="stock-tab-content-holdings" class="stock-tab-panel hidden space-y-6" data-tabs-target="panel" data-tab-panel="holdings">
					{# Look-through holdings: for a sphere the portfolio IS the company, so these are its fundamentals. #}
					<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden p-5">
						<div class="flex items-baseline justify-between mb-3 gap-4 flex-wrap">
							<h3 class="text-sm font-semibold text-on-surface">Anchor holdings</h3>
							<p class="text-xs text-on-surface-variant">
								{{ anchorPortfolio.totalValue|format_large('$') }}
								<span class="text-on-surface-faint">&middot; {{ anchorPortfolio.shareOfNav|pct(1) }} of net asset value</span>
							</p>
						</div>

						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse min-w-162.5">
								<thead>
									<tr class="table-head">
										<th class="py-2.5">Holding</th>
										<th class="py-2.5 text-right">Owned</th>
										<th class="py-2.5 text-right">Price</th>
										<th class="py-2.5 text-right">Change</th>
										<th class="py-2.5 text-right">Stake value</th>
										<th class="py-2.5 text-right">% of portfolio</th>
										<th class="py-2.5 text-right">% of NAV</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
									{% for holding in anchorPortfolio.holdings %}
										<tr class="{{ holding.isBankrupt ? 'opacity-50' : '' }}">
										<td class="py-2.5">
											<a href="/stock/{{ holding.ticker }}" class="font-bold text-on-surface hover:text-primary transition-colors">{{ holding.ticker }}</a>
											<span class="block text-2xs text-on-surface-variant">{{ holding.industry ?? holding.name }}</span>
										</td>
										<td class="py-2.5 text-right">
											<span class="font-mono tabular-nums text-on-surface">{{ holding.ownership|pct(0) }}</span>
											<span class="block text-2xs text-on-surface-variant">{{ holding.tier }}</span>
										</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ holding.price|money(2) }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums {{ holding.changePercent|signed_class }}">
											{%- if holding.changePercent is null -%}&mdash;{%- else -%}{{ holding.changePercent|pct(2, true) }}{%- endif -%}
										</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ holding.value|format_large('$') }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ holding.shareOfPortfolio|pct(1) }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ holding.shareOfNav|pct(1) }}</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>

						<p class="mt-3 text-2xs text-on-surface-faint">
							Stakes are valued at the holdings' live prices. Shares held by an anchor do not trade, so they are outside each holding's free float.
						</p>
					</div>
					</div>
				{% endif %}

					<div
					id="stock-tab-content-financials" class="stock-tab-panel hidden space-y-6" data-tabs-target="panel" data-tab-panel="financials">
					{# Whether any of the business-model charts in the Industry section below applies to this company. #}
					{% set has_industry_charts = isFinancial|default(false) or isInsurer|default(false) or kpiSeries|default([])|length > 0 or businessModel|default('none') in [
						'commercial_bank', 'credit_services', 'shadow_bank', 'reit',
						'tech', 'semiconductor', 'biotech', 'defense_contractor',
						'mining', 'oil_gas_producer', 'refining', 'shipping'
					] %}
					<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
						<div>
							<h2 class="text-lg font-semibold text-on-surface">Financial statements</h2>
							<p class="text-sm text-on-surface-variant mt-0.5">Reported results, balance sheet, cash flow and valuation.</p>
						</div>
						<div class="flex items-center gap-3">
							<button type="button" onclick="document.dispatchEvent(new CustomEvent('sankey:open'))" class="px-3 py-1.5 text-xs font-medium rounded border border-outline-variant/30 text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer">Earnings flow</button>
							<div class="inline-flex gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5" role="group" aria-label="Reporting period">
								<button type="button" data-financial-timeframe="12Q" id="btn-global-12Q" class="seg-btn" aria-pressed="false">Quarterly</button>
								<button type="button" data-financial-timeframe="12Y" id="btn-global-12Y" class="seg-btn" aria-pressed="true">Annual</button>
							</div>
						</div>
					</div>

					{# Summary strip: the numbers an analyst reads first off the last report (FinancialSummaryBuilder). #}
					{% if financialSummary|default([])|length > 0 %}
						<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] gap-3" id="financial-summary">
							{% for tile in financialSummary %}
								{% set v = tile.value %}
								{% set shown = {
									'percent': v|pct(2),
									'signed_percent': v|pct(2, true),
									'multiple': v|number_format(2) ~ 'x',
									'quarters': v|number_format(1) ~ ' qtrs',
									'years': v|number_format(1) ~ ' yrs',
									'index': v|number_format(3),
									'signed_index': (v > 0 ? '+' : '') ~ v|number_format(3)
								}[tile.format] ?? v|number_format(2) %}
