{% extends 'base.html.twig' %}

{% import 'partials/_ui.html.twig' as ui %}

{% block page_title %}{{ asset.ticker }} stock price & analysis | {{ asset.name }}{% endblock %}

{% block description %}View live stock prices, market cap, financial statements, and fundamental valuation metrics for {{ asset.name }} ({{ asset.ticker }}).{% endblock %}
{% block og_description %}Live financial data and analytics for {{ asset.name }} ({{ isEtf ? indexFacts.label : asset.industry|default('General') }}).{% endblock %}

{% block favicon %}
	<link rel="icon" href="{{ logo_url(asset.ticker) }}" type="image/svg+xml">
{% endblock %}

{% block body %}
	{# The earnings-flow and business-map modals' controllers sit over the whole page, so the buttons that open them are
	   actions in their scope (assets/controllers/sankey_controller.js, business_map_controller.js). #}
	<div data-controller="sankey{{ businessMap ? ' business-map' }}" data-sankey-ticker-value="{{ asset.ticker }}" data-sankey-url-value="/api/earnings-flow"{% if businessMap %} data-business-map-edges-value="{{ businessMap.edges|json_encode }}"{% endif %}>
	<div
		class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5">

		<header class="flex flex-col md:flex-row md:justify-between md:items-end gap-6 pb-6 border-b border-outline-variant/15 relative z-20">
			<div class="flex items-center gap-4 min-w-0">
				{% include 'partials/_logo.html.twig' with { ticker: asset.ticker, class: 'w-12 h-12 sm:w-14 sm:h-14 p-1.5 object-contain' } only %}

				<div class="min-w-0">
					<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight wrap-break-word leading-tight">{{ asset.name }}</h1>

					<div class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-sm text-on-surface-variant">
						<span class="font-mono font-semibold text-on-surface">{{ asset.ticker }}</span>
						{% if app.user %}
							<form action="{{ path('app_watchlist_toggle', { ticker: asset.ticker }) }}" method="POST" class="inline-flex">
								<input type="hidden" name="_token" value="{{ csrf_token('watchlist') }}">
								<button type="submit" aria-pressed="{{ isWatched ? 'true' : 'false' }}"
										class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-xs border transition-colors cursor-pointer {{ isWatched ? 'text-primary border-primary/40 bg-primary/10' : 'text-on-surface-variant border-outline-variant/30 hover:text-on-surface' }}">
									<span class="material-symbols-outlined text-sm leading-none {{ isWatched ? 'icon-filled' : '' }}" aria-hidden="true">star</span>
									{{ isWatched ? 'Watching' : 'Watch' }}
								</button>
							</form>
						{% endif %}
						<span class="text-on-surface-variant/40" aria-hidden="true">&middot;</span>
						{{ ui.term(isEtf ? indexFacts.indexName : asset.industry|default('General'), industryDescription, {tag: 'span', class: '', vpos: 'bottom'}) }}

						{% if lifecycleStage is not null and not asset.isBankrupt %}
							{% set stageTip = ui_id('tip') %}
							<span class="group relative cursor-help badge badge-{{ lifecycleStage.tone }}" tabindex="0" id="lifecycle-badge" aria-describedby="{{ stageTip }}">
								<span class="border-b border-dotted border-current/60">{{ lifecycleStage.label }}</span>
								{{ ui.tooltip('Life-cycle stage, read from the signs of operating, investing and financing cash flow in the last quarterly report. ' ~ lifecycleStage.description ~ ' Pattern: ' ~ lifecycleStage.cashFlowSignature ~ '.', 'left', 'w-80', 'bottom', stageTip) }}
							</span>
						{% endif %}
						{% if corporateBonds|length > 0 %}
							<a href="#corporate-debt-section" class="inline-flex items-center gap-1 rounded bg-surface-container-high px-1.5 py-0.5 text-xs font-mono text-on-surface-variant hover:text-primary border border-outline-variant/30 transition-colors" title="{{ corporateBonds|length }} corporate debt issues listed on the exchange">
								<span class="material-symbols-outlined text-xs" aria-hidden="true">receipt_long</span>
								<span>{{ corporateBonds|length }} {{ corporateBonds|length == 1 ? 'bond' : 'bonds' }}</span>
							</a>
						{% endif %}
						{% if not isEtf and asset.isBankrupt %}
							<span class="badge badge-down">Bankrupt, delisted</span>
						{% endif %}
					</div>
				</div>
			</div>

			<div class="md:text-right shrink-0">
				<span class="block text-3xl sm:text-4xl font-semibold font-mono tabular-nums {{ not isEtf and asset.isBankrupt ? 'text-tertiary line-through' : 'text-on-surface' }} tracking-tight transition-colors duration-300" id="big-price">
					{{ (not isEtf and asset.isBankrupt ? 0.0 : asset.price)|money(2) }}
				</span>

				{# Trailing month, per the price buffer: the schema carries no session open or
				   previous close to compute a daily move from. Labelled accordingly. #}
				<p class="mt-1 text-sm font-mono tabular-nums" id="big-change-row">
					<span id="big-change" class="font-semibold {{ changePercent|signed_class }}">{{ changePercent|pct(2, true) }}</span>
					<span class="font-sans text-xs text-on-surface-variant">past month</span>
				</p>
			</div>
		</header>

		<div class="space-y-5" data-controller="tabs" data-tabs-default-tab-value="overview">
			<div class="flex border-b border-outline-variant/20 overflow-x-auto gap-5 sm:gap-7 pb-px custom-scrollbar" role="tablist">
				<button class="tab-btn" aria-selected="true" data-tab="overview" data-tabs-target="tab" data-action="click->tabs#select">
					Overview
				</button>
				{% if isEtf %}
					<button class="tab-btn" data-tab="constituents" data-tabs-target="tab" data-action="click->tabs#select">
						Constituents
						<span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ indexFacts.memberCount }}</span>
					</button>
				{% else %}
					{% if anchorPortfolio %}
						<button class="tab-btn" data-tab="holdings" data-tabs-target="tab" data-action="click->tabs#select">
							Holdings
							<span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ anchorPortfolio.holdings|length }}</span>
						</button>
					{% endif %}
					<button class="tab-btn" data-tab="financials" data-tabs-target="tab" data-action="click->tabs#select">
						Financials
					</button>
					<button class="tab-btn" data-tab="sector" data-tabs-target="tab" data-action="click->tabs#select">
						Company
					</button>
					<button class="tab-btn" data-tab="options" data-tabs-target="tab" data-action="click->tabs#select">
						Options
						{% if optionsListed %}
							<span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ optionExpiries|length }}</span>
						{% endif %}
					</button>
				{% endif %}
				<button class="tab-btn" data-tab="orders" data-tabs-target="tab" data-action="click->tabs#select">
					Your orders
					{% if openOrders|length > 0 %}
						<span class="text-xs font-normal text-on-surface-variant tabular-nums">{{ openOrders|length }}</span>
					{% endif %}
				</button>
			</div>

			{# Overview tab #}
				{% include 'stock/_tab_overview.html.twig' %}

			{# Constituents tab (index funds only) #}
				{% if isEtf %}
					{% include 'stock/_tab_constituents.html.twig' %}
			{% endif %}

			{# Financials tab #}
				{% if not isEtf %}
				{% if anchorPortfolio %}
					{% include 'stock/_tab_holdings.html.twig' %}
				{% endif %}

					{% include 'stock/_tab_financials.html.twig' %}
			{% endif %}

			{# Company tab #}
				{% if not isEtf %}
					{% include 'stock/_tab_company.html.twig' %}
			{% endif %}


			{# Options tab #}
			{% if not isEtf %}
				{% include 'stock/_tab_options.html.twig' %}
			{% endif %}

			{# Your orders tab #}
				{% include 'stock/_tab_orders.html.twig' %}
		</div>

	</div>

	{% if businessMap %}
		{% include 'stock/_business_map.html.twig' with { map: businessMap, name: asset.name } only %}
	{% endif %}

	{# Earnings-flow modal. #}
	<div id="sankey-modal" data-sankey-target="modal" data-action="click->sankey#backdropClick" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4">
		<div class="bg-surface-container-low border border-outline-variant/20 rounded-lg w-full max-w-5xl h-[85vh] flex flex-col overflow-hidden shadow-2xl">
			<div class="flex justify-between items-center p-6 border-b border-outline-variant/10">
				<div>
					<h2 class="text-lg font-semibold text-on-surface">{{ asset.ticker }} earnings flow</h2>
					<p class="text-sm text-on-surface-variant mt-0.5">Revenue by segment, through operating costs, to net income and what it is spent on.</p>
				</div>
				<button type="button" data-action="sankey#close" class="text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer" aria-label="Close">
					<span class="material-symbols-outlined text-2xl" aria-hidden="true">close</span>
				</button>
			</div>
			<div class="flex-1 p-6 relative">
				<div data-sankey-target="container" class="w-full h-full"></div>
			</div>
			{# Keep in step with ROLE_COLORS in assets/controllers/sankey_controller.js. #}
			<ul class="flex flex-wrap gap-x-5 gap-y-1.5 px-6 pb-5 text-xs text-on-surface-variant" aria-label="Colour key">
				{% for role in [
					{ label: 'Revenue and funding', swatch: 'bg-series-blue' },
					{ label: 'Profit and cash kept', swatch: 'bg-secondary' },
					{ label: 'Costs', swatch: 'bg-tertiary' },
					{ label: 'Non-cash charges', swatch: 'bg-on-surface-variant' },
					{ label: 'Paid to shareholders', swatch: 'bg-series-violet' }
				] %}
					<li class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm {{ role.swatch }}" aria-hidden="true"></span>{{ role.label }}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{# Price chart, fundamentals and macro panels, earnings flow Sankey. #}
	{% include 'partials/_chart_libraries.html.twig' with { lightweight: true, chartjs: true, echarts: true } %}

	{# Page data for assets/js/pages/stock.js. JSON rather than a JavaScript object literal:
	   in a literal, Twig's HTML escaper mangles apostrophes and a `</script>` in any value
	   closes the block early. #}
	<script type="application/json" id="aerie-data">
		{{ {
			ticker: asset.ticker,
			isEtf: isEtf,
			businessModel: businessModel,
			isFinancial: isFinancial,
			isInsurer: isInsurer,
			industryCharts: industryCharts,
			sharesOutstanding: asset.sharesOutstanding|default(1),
			currentPrice: asset.price|default(0),
			userQuantity: userQuantity,
			eps: isEtf ? 0 : asset.earningsPerShare,
			ticksPerYear: ticksPerYear,
			pieLabels: pieLabels,
			pieData: pieData,
			sharesMap: sharesMap ?: {},
			capitalThresholds: capitalThresholds,
			kpiSeries: kpiSeries ?: {}
		}|json_encode|raw }}
	</script>

	<script type="module">
		import 'pages/stock';
	</script>
{% endblock %}
