				{# Sector Profile & Business Model Details #}
				<div class="bg-surface-container-low rounded-2xl p-6 border border-outline-variant/15 shadow-[0_30px_60px_-5px_rgba(6,14,32,0.4)]">
					<h3 class="text-xs font-bold uppercase tracking-widest text-primary mb-3 flex items-center gap-2">
						<span class="material-symbols-outlined text-base">domain</span>
						Sector Mechanics & Industry Profile
					</h3>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs mt-4">
						<div class="p-4 rounded-xl bg-surface-container-lowest/60 border border-outline-variant/10">
							<span class="text-on-surface-variant uppercase text-[10px] font-bold">Sector</span>
							<p class="text-base font-bold text-on-surface mt-1">{{ asset.sector }}</p>
						</div>
						<div class="p-4 rounded-xl bg-surface-container-lowest/60 border border-outline-variant/10">
							<span class="text-on-surface-variant uppercase text-[10px] font-bold">Industry</span>
							<p class="text-base font-bold text-on-surface mt-1">{{ asset.industry|default('General') }}</p>
