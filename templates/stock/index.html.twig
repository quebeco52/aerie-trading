											</div>
											<div class="chart-canvas-container h-80 md:h-85 w-full relative">
												<canvas id="reitCoverageChart"></canvas>
											</div>
										</div>
									{% endif %}

									{# Tech / Semi / Biotech / Defense: R&D & Reinvestment Intensity #}
									{% if businessModel|default('none') in ['tech', 'semiconductor', 'biotech', 'defense_contractor'] %}
										<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-financial-category="sector">
											<div class="flex items-start justify-between gap-4 mb-3">
												<div class="min-w-0">
													<h4 class="text-sm font-semibold text-on-surface">Reinvestment</h4>
													<p class="text-xs text-on-surface-variant mt-0.5">Capital spending as a share of revenue, against operating margin and ROIC</p>
												</div>
												<div class="flex items-start gap-3 shrink-0">
													<div class="hidden sm:flex flex-col items-end text-right max-w-64">
														<span class="text-2xs text-on-surface-variant">Latest</span>
														<span class="text-xs font-mono font-bold text-on-surface tabular-nums" id="hud-reinvestmentIntensityChart">-</span>
													</div>
													<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
														<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
													</button>
												</div>
											</div>
											<div class="chart-canvas-container h-80 md:h-85 w-full relative">
												<canvas id="reinvestmentIntensityChart"></canvas>
											</div>
										</div>
									{% endif %}

									{# Commodities / Shipping: Cyclical Dynamics & Deleveraging #}
									{% if businessModel|default('none') in ['mining', 'oil_gas_producer', 'refining', 'shipping'] %}
										<div class="chart-card bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-financial-category="sector">
											<div class="flex items-start justify-between gap-4 mb-3">
												<div class="min-w-0">
													<h4 class="text-sm font-semibold text-on-surface">Cyclical margins and liquidity</h4>
													<p class="text-xs text-on-surface-variant mt-0.5">Operating margin swings against debt service and cash reserves</p>
												</div>
												<div class="flex items-start gap-3 shrink-0">
													<div class="hidden sm:flex flex-col items-end text-right max-w-64">
														<span class="text-2xs text-on-surface-variant">Latest</span>
														<span class="text-xs font-mono font-bold text-on-surface tabular-nums" id="hud-cyclicalDynamicsChart">-</span>
													</div>
													<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
														<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
													</button>
												</div>
											</div>
											<div class="chart-canvas-container h-80 md:h-85 w-full relative">
												<canvas id="cyclicalDynamicsChart"></canvas>
											</div>
										</div>
									{% endif %}
								</div>
							</section>
						{% endif %}

						<p class="hidden py-12 text-center text-sm text-on-surface-variant" data-chart-empty>No charts match the filter.</p>
					</div>
				</div>
			{% endif %}

			{# Company tab #}
				{% if not isEtf %}
					<div
					id="stock-tab-content-sector" class="stock-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="sector"> {# Sector Profile & Business Model Details #}
					<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
						<h3 class="text-sm font-semibold text-on-surface mb-3">Sector and industry</h3>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs mt-3">
							<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
								<span class="text-xs text-on-surface-variant">Sector</span>
								<p class="text-base font-semibold text-on-surface mt-1">{{ asset.sector }}</p>
							</div>
							<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
								<span class="text-xs text-on-surface-variant">Industry</span>
								<p class="text-base font-semibold text-on-surface mt-1">{{ asset.industry|default('General') }}</p>
							</div>
							<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
								<span class="text-xs text-on-surface-variant">Market share</span>
								<p class="text-base font-semibold text-on-surface font-mono tabular-nums mt-1" id="stat-market-share">{{ marketShare|pct(2) }}</p>
								<p class="text-2xs text-on-surface-faint mt-1">of its addressable market{% if industry and industry.rosterShare is not null %} · {{ industry.rosterShare|pct(1) }} of sales among {{ industry.rosterSize }} listed peers{% endif %}</p>
							</div>
						</div>
					</div>

					{# A drug company's late-stage pipeline, patent expiry ladder and cash runway as the last report left them (BiotechPipelineBuilder). #}
					{% if pipeline|default(null) %}
						<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" id="pipeline-card">
							<h3 class="text-sm font-semibold text-on-surface">Pipeline and patents</h3>
							<p class="text-xs text-on-surface-variant mt-1">Late-stage trials decide what the company sells next, and patent expiries decide when what it sells now goes generic. As of the last quarterly report.</p>
							<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 text-xs mt-4">
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="group relative cursor-help focus-visible:outline-none" tabindex="0">
										<span class="term text-xs text-on-surface-variant">Late-stage programmes</span>
										{{ ui.tooltip('Programmes in their final trials before approval, counted by value, so a smaller one counts as part of a programme. Each reads out when its trial ends; an approval joins the marketed book and a failure is gone until research replaces it.', 'left', 'w-72', 'bottom') }}
									</span>
									<p class="text-base font-semibold text-on-surface font-mono tabular-nums mt-1">{{ pipeline.lateStageAssets|number_format(1) }}</p>
									<p class="text-2xs text-on-surface-faint mt-1">about <span class="font-mono tabular-nums">{{ pipeline.readoutsPerYear|number_format(1) }}</span> pivotal readouts a year</p>
								</div>
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="text-xs text-on-surface-variant">Sales under patent</span>
									<p class="text-base font-semibold text-on-surface font-mono tabular-nums mt-1">{{ pipeline.protectedShare|pct(1) }}</p>
									<p class="text-2xs text-on-surface-faint mt-1">of marketed sales</p>
								</div>
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="text-xs text-on-surface-variant">Marketed book</span>
									<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ pipeline.franchiseChange|signed_class }}">{{ pipeline.franchiseChange|pct(1, true) }}</p>
									<p class="text-2xs text-on-surface-faint mt-1">since listing</p>
								</div>
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="group relative cursor-help focus-visible:outline-none" tabindex="0">
										<span class="term text-xs text-on-surface-variant">Research spending</span>
										{{ ui.tooltip('Research spending against the level that refills the late-stage pipeline as fast as trials read out. Below 1.0× the pipeline thins and fewer launches replace the patents that expire.', 'left', 'w-72', 'bottom') }}
									</span>
									<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ pipeline.rndReplacement < 1.0 ? 'text-warning' : 'text-on-surface' }}">{{ pipeline.rndReplacement|number_format(2) }}×</p>
									<p class="text-2xs text-on-surface-faint mt-1">of replacement</p>
								</div>
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="group relative cursor-help focus-visible:outline-none" tabindex="0">
										<span class="term text-xs text-on-surface-variant">Cash runway</span>
										{{ ui.tooltip('How long cash on hand lasts at the last quarter\'s free cash outflow. Research is the company\'s capital spending, so it counts against the cash.', 'right', 'w-64', 'bottom') }}
									</span>
									{% if pipeline.runway is null %}
										<p class="text-base font-semibold text-on-surface-faint mt-1">—</p>
										<p class="text-2xs text-on-surface-faint mt-1">no cash flow reported yet</p>
									{% elseif pipeline.runway.years is null %}
										<p class="text-base font-semibold text-on-surface mt-1">Cash generative</p>
										<p class="text-2xs text-on-surface-faint mt-1">last quarter</p>
									{% else %}
										<p class="text-base font-semibold font-mono tabular-nums mt-1 text-on-surface">{{ pipeline.runway.years|number_format(1) }} yrs</p>
										<p class="text-2xs text-on-surface-faint mt-1">at <span class="font-mono tabular-nums">{{ pipeline.runway.quarterlyBurn|format_large('$') }}</span> a quarter</p>
									{% endif %}
								</div>
							</div>
							<div class="overflow-x-auto mt-5">
								<table class="w-full text-left border-collapse">
									<thead>
										<tr class="table-head">
											<th class="py-2">Exclusivity left</th>
											<th class="py-2 text-right">Share of marketed sales</th>
											<th class="py-2 text-right">Medicines</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-outline-variant/10 text-xs">
										{% for rung in pipeline.ladder %}
											<tr>
												<td class="py-2 text-on-surface">{{ rung.label }}</td>
												<td class="py-2 text-right font-mono tabular-nums text-on-surface">{{ rung.share|pct(1) }}</td>
												<td class="py-2 text-right font-mono tabular-nums {{ rung.count is null ? 'text-on-surface-faint' : 'text-on-surface' }}">{{ rung.count ?? '—' }}</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
							{% if pipeline.ramping > 0 %}
								<p class="text-2xs text-on-surface-variant mt-3"><span class="font-mono tabular-nums">{{ pipeline.ramping }}</span> {{ pipeline.ramping == 1 ? 'medicine is' : 'medicines are' }} still building toward peak sales.</p>
							{% endif %}
						</div>
					{% endif %}

					{# Management: the archetype running the firm's capital, and how long it has been in post.
					   Bertrand & Schoar (2003) manager fixed effects, surfaced because the market knows who is
					   in the chair. The dials themselves are deliberately not shown — the policy is meant to be
					   read off the payout, the capital budget and the deals. #}
					{% if management %}
						{% set convictionTone = {
							'nominal': 'border-outline-variant/40 text-on-surface-variant bg-surface-container-highest/60',
							'characteristic': 'border-primary/40 text-primary bg-primary/10',
							'pronounced': 'border-tertiary/40 text-tertiary bg-tertiary/10'
						} %}
						<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" id="management-card">
							<div class="flex items-start justify-between gap-4">
								<div>
									<h3 class="text-sm font-semibold text-on-surface">Management</h3>
									<p class="text-xs text-on-surface-variant mt-1">Two companies with the same numbers can be run very differently depending on who runs them. The board replaces a manager whose capital stops earning its cost, and the successor need not share the approach.</p>
								</div>
								<span class="shrink-0 inline-flex items-center rounded border px-2 py-0.5 text-xs font-medium {{ convictionTone[management.conviction]|default(convictionTone['characteristic']) }}">{{ management.conviction|capitalize }}</span>
							</div>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs mt-4">
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="text-xs text-on-surface-variant">Style</span>
									<p class="text-base font-semibold text-on-surface mt-1">{{ management.label }}</p>
									<p class="text-3xs text-on-surface-faint mt-1 leading-relaxed">Capital is {{ management.mandate }}.</p>
								</div>
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="text-xs text-on-surface-variant">Tenure</span>
									<p class="text-base font-semibold text-on-surface font-mono tabular-nums mt-1">{{ management.tenureYears|number_format(1) }} yrs</p>
									<p class="text-2xs text-on-surface-faint mt-1">in post</p>
								</div>
							</div>
						</div>
					{% endif %}

					{# Industry Position: the industry ledger's roster and capacity balance, and the last report's price response #}
					{% if industry %}
						{# Both ends of the balance are a caution, so both read amber; red stays the colour of a fall. #}
						{% set balanceTone = {
							'overbuilt': 'border-warning/40 text-warning bg-warning/10',
							'tight': 'border-warning/40 text-warning bg-warning/10',
							'balanced': 'border-primary/30 text-primary bg-primary/10',
							'unknown': 'border-outline-variant/30 text-on-surface-variant bg-surface-container-highest'
						} %}
						<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" id="industry-position-card">
							<div class="flex items-start justify-between gap-3 mb-4">
								<div>
									<h3 class="text-sm font-semibold text-on-surface">Industry position</h3>
									<p class="text-xs text-on-surface-variant mt-1">Capacity built ahead of demand across the industry sets the price every producer realises, and when one company beats or misses, its rivals lose or gain share.</p>
								</div>
								{% if industry.pricesCapacity %}
									<span class="shrink-0 inline-flex items-center rounded border px-2 py-0.5 text-xs font-medium {{ balanceTone[industry.balance] }}">{{ industry.balance == 'unknown' ? 'No reading yet' : industry.balance|capitalize }}</span>
								{% endif %}
							</div>

							{# Scale & saturation: the addressable share the physics is struck on, and the penalty it carries #}
							{% set sat = industry.saturation %}
							{% set saturated = industry.addressableShare > sat.threshold %}
							<div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs mb-3">
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="text-xs text-on-surface-variant">Addressable share</span>
									<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ saturated ? 'text-warning' : 'text-on-surface' }}">{{ industry.addressableShare|pct(2) }}</p>
									<p class="text-2xs text-on-surface-faint mt-1">{{ saturated ? 'past' : 'under' }} the {{ sat.threshold|pct(0) }} saturation line</p>
								</div>
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="text-xs text-on-surface-variant">Drag from size</span>
									<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ sat.penalty > 0.0005 ? 'text-warning' : 'text-on-surface' }}">{{ sat.penalty > 0 ? '-' : '' }}{{ (sat.penalty * 100)|number_format(2) }} pts</p>
									<p class="text-2xs text-on-surface-faint mt-1">margin lost to the friction of size · {{ sat.severity|pct(0) }} of return</p>
								</div>
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="text-xs text-on-surface-variant">Marginal return</span>
									<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ sat.marginalReturn < sat.trueReturn - 0.0005 ? 'text-warning' : 'text-on-surface' }}">{{ sat.marginalReturn|pct(2) }}</p>
									<p class="text-2xs text-on-surface-faint mt-1">next dollar of capital · trailing {{ sat.trueReturn|pct(2) }}</p>
								</div>
								<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
									<span class="text-xs text-on-surface-variant">Moat</span>
									<p class="text-base font-semibold font-mono tabular-nums mt-1 text-on-surface">{{ sat.moatFactor|number_format(2) }}x</p>
									<p class="text-2xs text-on-surface-faint mt-1">{{ asset.systemicImportance }} · offsets the drag from size</p>
								</div>
							</div>

							{% if not industry.pricesCapacity %}
								<p class="text-xs text-on-surface-variant leading-relaxed">Not priced on capacity: {{ isFinancial ? 'a lender sells a yield on its book, not a unit of output, so there is no plant to overbuild.' : 'this industry\'s output is not substitutable enough for rivals\' plant to move its price.' }}</p>
							{% else %}
								<div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
									<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
										<span class="text-xs text-on-surface-variant">Capacity against demand</span>
										<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ industry.balance in ['overbuilt', 'tight'] ? 'text-warning' : 'text-on-surface' }}">{{ industry.capacityRatio is not null ? industry.capacityRatio|pct(1) : '-' }}</p>
										<p class="text-2xs text-on-surface-faint mt-1">{% if industry.installedCapacity is not null %}{{ industry.installedCapacity|format_large('$') }} plant · {{ industry.trendCapacity|format_large('$') }} at trend{% else %}anchored at first report{% endif %}</p>
									</div>
									<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
										<span class="text-xs text-on-surface-variant">Realised price</span>
										{% if industry.priceLevel is not null %}
											{% set priceMove = (industry.priceLevel - 1) * 100 %}
											<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ priceMove|abs > 0.05 ? 'text-warning' : 'text-on-surface' }}">{{ priceMove > 0 ? '+' : '' }}{{ priceMove|number_format(2) }}%</p>
										{% else %}
											<p class="text-base font-semibold font-mono tabular-nums mt-1 text-on-surface-variant">-</p>
										{% endif %}
										<p class="text-2xs text-on-surface-faint mt-1">against a balanced industry, last report</p>
									</div>
									<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
										<span class="text-xs text-on-surface-variant">Share moved by rivals</span>
										{% if industry.rivalShareDrain is not null %}
											{% set drain = industry.rivalShareDrain * 100 %}
											<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ drain|abs > 0.05 ? 'text-warning' : 'text-on-surface' }}">{{ drain > 0 ? '+' : '' }}{{ drain|number_format(2) }}%</p>
										{% else %}
											<p class="text-base font-semibold font-mono tabular-nums mt-1 text-on-surface-variant">-</p>
										{% endif %}
										<p class="text-2xs text-on-surface-faint mt-1">of demand, from rivals' beats and misses</p>
									</div>
									<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
										<span class="text-xs text-on-surface-variant">Volume from own pricing</span>
										{% if industry.ownPriceVolumeShift is not null %}
											{% set shift = industry.ownPriceVolumeShift * 100 %}
											<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ shift|abs > 0.05 ? 'text-warning' : 'text-on-surface' }}">{{ shift > 0 ? '+' : '' }}{{ shift|number_format(2) }}%</p>
										{% else %}
											<p class="text-base font-semibold font-mono tabular-nums mt-1 text-on-surface-variant">-</p>
										{% endif %}
										<p class="text-2xs text-on-surface-faint mt-1">volume won or lost on its own real price change</p>
									</div>
								</div>
							{% endif %}

							{% if industry.rosterSize > 1 %}
								<div class="mt-4 pt-4 border-t border-outline-variant/15">
									<p class="text-xs font-semibold text-on-surface-variant mb-2">Share of industry sales among listed peers</p>
									<ul class="space-y-1.5" aria-label="Industry revenue shares">
										{% for peerTicker, share in industry.peerShares|sort|reverse(true) %}
											{% set isSelf = peerTicker == asset.ticker %}
											<li class="flex items-center gap-3 text-xs">
												<span class="w-14 shrink-0 font-mono {{ isSelf ? 'text-primary font-bold' : 'text-on-surface-variant' }}">{% if isSelf %}{{ peerTicker }}{% else %}<a href="/stock/{{ peerTicker }}" class="hover:underline">{{ peerTicker }}</a>{% endif %}</span>
												<span class="flex-1 h-1.5 rounded-full bg-surface-container-highest overflow-hidden"><span class="block h-full rounded-full {{ isSelf ? 'bg-primary' : 'bg-outline-variant' }}" style="width: {{ (share * 100)|round(1) }}%"></span></span>
												<span class="w-14 shrink-0 text-right font-mono tabular-nums {{ isSelf ? 'text-primary font-bold' : 'text-on-surface-variant' }}">{{ share|pct(1) }}</span>
											</li>
										{% endfor %}
									</ul>
								</div>
							{% elseif industry.tracked %}
								<p class="mt-4 pt-4 border-t border-outline-variant/15 text-xs text-on-surface-variant leading-relaxed">The only listed company in its industry, so no peer share is shown. The capacity figures above take the unlisted rest of the industry as supplying at trend.</p>
							{% endif %}

							{# Merger review: the same ledger reading the M&A engine sizes this firm's deals on. #}
							{% set review = industry.mergerReview|default(null) %}
							{% if review %}
								<div class="mt-4 pt-4 border-t border-outline-variant/15" id="merger-review">
									<div class="flex items-start justify-between gap-3 mb-3">
										<div>
											<p class="text-xs font-semibold text-on-surface-variant">Merger review</p>
											<p class="text-xs text-on-surface-variant mt-1 leading-relaxed">Under the merger guidelines, a deal is presumed to lessen competition when it raises the HHI by more than 100 points and leaves the market above 1,800, or creates a company with more than 30% of it. Targets come from the unlisted fringe.</p>
										</div>
										<span class="inline-flex shrink-0 items-center rounded border px-2 py-0.5 text-xs font-medium {{ review.highlyConcentrated ? 'border-tertiary/40 text-tertiary bg-tertiary/10' : 'border-outline-variant/30 text-on-surface-variant' }}">{{ review.highlyConcentrated ? 'Highly concentrated' : 'Below 1,800' }}</span>
									</div>
									<div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
										<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
											<span class="text-xs text-on-surface-variant">HHI</span>
											<p class="text-base font-semibold font-mono tabular-nums mt-1 text-on-surface">{{ (review.herfindahl * 10000)|number_format(0) }}</p>
											<p class="text-2xs text-on-surface-faint mt-1">sum of listed peers' squared market shares</p>
										</div>
										<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
											<span class="text-xs text-on-surface-variant">Own share</span>
											<p class="text-base font-semibold font-mono tabular-nums mt-1 text-on-surface">{{ review.acquirerShare|pct(1) }}</p>
											<p class="text-2xs text-on-surface-faint mt-1">trend share of its market</p>
										</div>
										<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
											<span class="text-xs text-on-surface-variant">Fringe</span>
											<p class="text-base font-semibold font-mono tabular-nums mt-1 text-on-surface">{{ review.fringeShare|pct(1) }}</p>
											<p class="text-2xs text-on-surface-faint mt-1">unlisted competitors, available to buy</p>
										</div>
										<div class="p-3.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15">
											<span class="text-xs text-on-surface-variant">Largest deal</span>
											<p class="text-base font-semibold font-mono tabular-nums mt-1 {{ review.clearedShare < 0.005 ? 'text-tertiary' : 'text-on-surface' }}">{{ review.clearedShare|pct(1) }}</p>
											<p class="text-2xs text-on-surface-faint mt-1">of the market · {{ review.reviewBinds ? 'capped by review' : 'capped by the fringe' }}</p>
										</div>
									</div>
								</div>
							{% endif %}
						</div>
					{% endif %}

					{# Corporate Life-Cycle (Dickinson 2011) #}
					<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20" id="lifecycle-card">
						<div class="flex items-start justify-between gap-3 mb-4">
							<div>
								<h3 class="text-sm font-semibold text-on-surface">Life-cycle stage</h3>
								<p class="text-xs text-on-surface-variant mt-1">Classified each quarter from the signs of operating, investing and financing cash flow.</p>
							</div>
							{% if lifecycleStage is not null and not asset.isBankrupt %}
								<span class="shrink-0 inline-flex items-center rounded border px-2 py-0.5 text-xs font-medium {{ stageTone[lifecycleStage.value] }}">{{ lifecycleStage.label }}</span>
							{% endif %}
						</div>

						<ol class="grid grid-cols-5 gap-2" aria-label="Life-cycle stages">
							{% for stage in lifecycleStages %}
								{% set isCurrent = lifecycleStage is not null and not asset.isBankrupt and stage.value == lifecycleStage.value %}
								<li class="flex flex-col gap-2 min-w-0" {% if isCurrent %}aria-current="step"{% endif %}>
									<span class="h-1.5 rounded-full {{ isCurrent ? stageBar[stage.value] : 'bg-surface-container-highest' }}"></span>
									<span class="text-xs font-medium truncate {{ isCurrent ? 'text-on-surface' : 'text-on-surface-faint' }}">{{ stage.label }}</span>
									<span class="hidden sm:block text-2xs font-mono tabular-nums whitespace-nowrap {{ isCurrent ? 'text-on-surface-variant' : 'text-on-surface-faint' }}">{{ stage.cashFlowSignature }}</span>
								</li>
							{% endfor %}
						</ol>
						<p class="hidden sm:block mt-2 text-2xs text-on-surface-faint">Sign of operating / investing / financing cash flow</p>

						<div class="mt-4 pt-4 border-t border-outline-variant/15 text-xs text-on-surface-variant leading-relaxed">
							{% if asset.isBankrupt %}
								Delisted. Life-cycle classification stopped with the last filed report.
							{% elseif lifecycleStage is null %}
								Not yet classified. The stage is assigned with the first quarterly report.
							{% else %}
								<span class="text-on-surface font-semibold">{{ lifecycleStage.label }}.</span> {{ lifecycleStage.description }}
								{% if not lifecycleStage.initiatesDistributions %}
									<span class="block mt-1">Dividends are withheld at this stage: every dollar is reinvested until operations turn cash positive.</span>
								{% elseif lifecycleStage.isShedding %}
									<span class="block mt-1">Management is under pressure to divest: shake-out and decline firms sell assets to fund operations.</span>
								{% endif %}
							{% endif %}
						</div>
					</div>
					{# Sector Peer Comparison Table #}
					<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden p-5">
						<h3 class="text-sm font-semibold text-on-surface mb-3">Peers in {{ asset.sector }}</h3>

						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse min-w-162.5">
								<thead>
									<tr class="table-head">
										<th class="py-2.5">Company</th>
										<th class="py-2.5 text-right">Price</th>
										<th class="py-2.5 text-right">Market cap</th>
										<th class="py-2.5 text-right">P/E ratio</th>
										<th class="py-2.5 text-right">ROIC / ROE</th>
										<th class="py-2.5 text-right">Ind. share</th>
										<th class="py-2.5 text-right">Total equity</th>
										<th class="py-2.5 text-right">Action</th>
									</tr>
								</thead>
								<tbody
									class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
									{# Current Stock Highlighted #}
									<tr class="bg-primary/5 font-bold">
										<td class="py-2.5 flex items-center gap-2">
											<span class="text-primary font-mono">{{ asset.ticker }}</span>
											<span class="text-on-surface text-xs">{{ asset.name }}</span>
											<span class="badge badge-accent">Current</span>
										</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ asset.price|money(2) }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ marketCap|format_large('$') }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peRatio ? peRatio|number_format(2) ~ 'x' : '-' }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ ((isFinancial ? (asset.currentRoe ?: asset.baselineRoe) : (asset.currentRoic ?: asset.baselineRoic)) * 100)|number_format(2) }}%</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ industry and industry.rosterShare is not null ? industry.rosterShare|pct(1) : '-' }}</td>
										<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ asset.totalEquity|format_large('$') }}</td>
										<td class="py-2.5 text-right text-xs text-on-surface-variant">-</td>
									</tr>

									{# Peer Companies #}
									{% for peer in peers %}
										{# One divider where the direct competitors end and the rest of the sector begins. #}
										{% if not peer.sameIndustry and (loop.first or peers[loop.index0 - 1].sameIndustry) %}
											<tr>
												<td colspan="8" class="pt-3 pb-1 text-xs font-semibold text-on-surface-faint">Elsewhere in {{ asset.sector }}</td>
											</tr>
										{% endif %}
										<tr class="relative hover:bg-surface-container-high/30 focus-within:bg-surface-container-high/30 transition-colors group">
											<th scope="row" class="py-2.5 flex items-center gap-2 text-left font-normal">
												<a href="/stock/{{ peer.ticker }}" class="font-mono text-primary font-bold group-hover:underline outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:underline-offset-4">{{ peer.ticker }}</a>
												<span class="text-on-surface-variant text-xs">{{ peer.name }}</span>
											</th>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.price|money(2) }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.marketCap|format_large('$') }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.peRatio ? peer.peRatio|number_format(2) ~ 'x' : '-' }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.roic|pct(2) }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ industry and industry.peerShares[peer.ticker] is defined ? (industry.peerShares[peer.ticker] * 100)|number_format(1) ~ '%' : '-' }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.totalEquity|format_large('$') }}</td>
											<td class="py-2.5 text-right">
												<a href="/stock/{{ peer.ticker }}" class="relative z-10 px-2 py-0.5 text-xs font-semibold text-primary bg-primary/10 rounded hover:bg-primary/20 transition-colors">
													View
												</a>
											</td>
										</tr>
									{% else %}
										<tr>
											<td colspan="8" class="py-4 text-center text-xs text-on-surface-variant">No peer companies found in this sector.</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>

				</div>
			{% endif %}


			{# Options tab #}
			{% if not isEtf %}
				<div id="stock-tab-content-options" class="stock-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="options" data-controller="option-ticket">

					{% include 'stock/_option_chain.html.twig' %}

					{# The ticket. One per page, loaded from whichever mark was clicked, so the contract
					   being traded is carried from the cell rather than re-derived from the form. #}
					{% if app.user and optionsListed %}
						<div data-option-ticket-target="modal"
							 data-action="click->option-ticket#backdropClick"
							 class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4">
							<div class="w-full max-w-sm bg-surface-container-low rounded-lg border border-outline-variant/30 shadow-2xl p-5 space-y-4">
								<div class="flex items-start justify-between gap-4">
									<div>
										<h3 class="text-xs font-semibold text-on-surface-variant">Option order</h3>
										<p class="font-mono text-base font-bold text-on-surface" data-option-ticket-target="symbol"></p>
									</div>
									<button type="button" data-action="option-ticket#close" aria-label="Close order ticket"
											class="text-on-surface-variant hover:text-on-surface cursor-pointer text-lg leading-none">&times;</button>
								</div>

								<form action="/trade/execute" method="POST" class="space-y-3" data-action="submit->option-ticket#onSubmit">
									<input type="hidden" name="ticker" value="">
									<input type="hidden" name="orderType" value="MARKET">
									<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

									<div class="grid grid-cols-2 gap-2 bg-surface-container-lowest p-1 rounded border border-outline-variant/20"
										 data-option-ticket-target="actionGroup">
										<label class="cursor-pointer">
											<input type="radio" name="action" value="BUY" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">Buy</div>
										</label>
										<label class="cursor-pointer">
											<input type="radio" name="action" value="SELL" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">Sell</div>
										</label>
										<label class="cursor-pointer">
											<input type="radio" name="action" value="WRITE" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">Write</div>
										</label>
										<label class="cursor-pointer">
											<input type="radio" name="action" value="COVER" class="peer sr-only">
											<div class="py-1.5 text-center text-xs font-semibold rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">Cover</div>
										</label>
									</div>

									<p class="text-2xs text-on-surface-variant leading-relaxed" data-option-ticket-target="hint"></p>

									<div class="space-y-1">
										<label for="option-quantity" class="text-xs font-semibold text-on-surface-variant">Contracts</label>
										<input type="number" id="option-quantity" name="quantity" min="1" step="1" value="1" required
											   data-option-ticket-target="quantity"
											   data-action="input->option-ticket#render"
											   class="w-full px-3 py-2 rounded bg-surface-container-lowest border border-outline-variant/30 text-on-surface font-mono tabular-nums focus:border-primary focus:outline-none">
										<p class="text-3xs text-on-surface-faint">{{ optionMultiplier }} shares per contract.</p>
									</div>

									<div class="flex justify-between items-center text-xs pt-1 border-t border-outline-variant/15">
										<span class="text-on-surface-variant">Premium at mark</span>
										<span class="font-mono tabular-nums font-bold text-on-surface" data-option-ticket-target="estimate">—</span>
									</div>

									<button type="submit" data-option-ticket-target="submit"
											class="w-full py-2 rounded bg-primary text-on-primary text-sm font-semibold hover:bg-primary-container transition-colors cursor-pointer">
										Send order
									</button>

									<p class="text-3xs text-on-surface-faint leading-relaxed">
										Filled at market against the live underlying. The premium above is struck at the mark and
										does not include the spread.
									</p>
								</form>
							</div>
						</div>
					{% endif %}
				</div>
			{% endif %}

			{# Your orders tab #}
				<div
				id="stock-tab-content-orders" class="stock-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="orders"> {# Open Limit Orders for this Ticker #}
				<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
					<div class="flex items-center justify-between mb-3">
						<h3 class="text-sm font-semibold text-on-surface">
							Your active orders for {{ asset.ticker }}
						</h3>
						<span class="text-xs font-mono text-on-surface-variant">{{ openOrders|length }} active</span>
					</div>

					{% if openOrders|length > 0 %}
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse min-w-125">
								<thead>
									<tr class="table-head">
										<th class="py-2.5">Placed date</th>
										<th class="py-2.5">Action</th>
										<th class="py-2.5 text-right">Shares</th>
										<th class="py-2.5 text-right">Limit price</th>
										<th class="py-2.5 text-right">Total Est.</th>
										<th class="py-2.5 text-right">Cancel</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
									{% for order in openOrders %}
										<tr>
											<td class="py-2.5 text-xs text-on-surface-variant font-mono">{{ order.createdAt|date('Y-m-d H:i') }}</td>
											<td class="py-2.5 font-bold {{ order.action in ['BUY', 'COVER'] ? 'text-secondary' : 'text-tertiary' }}">
												{{ order.action|lower|capitalize }}
												{% if order.stop %}<span class="ml-1 text-2xs font-normal text-on-surface-variant">{{ order.orderType == 'STOP_LIMIT' ? 'Stop limit' : 'Stop' }}</span>{% endif %}
											</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ order.quantity|number_format }}</td>
											{# A stop has no limit until it fires; what it rests on is its trigger. #}
											{% set restingPrice = order.stop ? order.stopPrice : order.limitPrice %}
											<td class="py-2.5 text-right font-mono tabular-nums font-bold text-on-surface">{{ restingPrice|money(2) }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ (restingPrice is null ? null : restingPrice * order.quantity)|money(2) }}</td>
											<td class="py-2.5 text-right">
												<form action="/trade/cancel/{{ order.id }}" method="POST" class="inline">
													<input type="hidden" name="_token" value="{{ csrf_token('cancel_trade_' ~ order.id) }}">
													<button type="submit" class="cursor-pointer px-2 py-0.5 text-xs font-bold text-tertiary bg-tertiary/10 hover:bg-tertiary/20 rounded border border-tertiary/20 transition-colors">
														Cancel
													</button>
												</form>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<p class="py-6 text-center text-xs text-on-surface-variant">No resting orders for {{ asset.ticker }}.</p>
					{% endif %}
				</div>

				{# Your Past Trades on this Ticker #}
				<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
					<h3 class="text-sm font-semibold text-on-surface mb-3">
						Your execution history for {{ asset.ticker }}
					</h3>

					{% if userTrades|length > 0 %}
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse min-w-125">
								<thead>
									<tr class="table-head">
										<th class="py-3 font-bold">Execution date</th>
										<th class="py-3 font-bold">Action</th>
										<th class="py-3 font-bold text-right">Shares</th>
										<th class="py-3 font-bold text-right">Executed price</th>
										<th class="py-3 font-bold text-right">Total</th>
										<th class="py-3 font-bold text-right">Trading costs</th>
										<th class="py-3 font-bold text-right">Status</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-outline-variant/5 text-sm">
									{% for trade in userTrades %}
										<tr>
											<td class="py-3 text-xs text-on-surface-variant">{{ (trade.filledAt ?? trade.createdAt)|date('Y-m-d H:i') }}</td>
											<td class="py-3 font-bold {{ trade.action in ['BUY', 'COVER'] ? 'text-secondary' : 'text-tertiary' }}">{{ trade.action|lower|capitalize }}</td>
											<td class="py-3 text-right font-mono text-on-surface">{{ (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity)|number_format }}</td>
											{% set tradePrice = trade.executionPrice ?? trade.limitPrice %}
											<td class="py-3 text-right font-mono text-on-surface">{{ tradePrice|money(2) }}</td>
											<td class="py-3 text-right font-mono font-bold text-on-surface">
												{{ (tradePrice is null ? null : tradePrice * (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity))|money(2) }}
											</td>
											<td class="py-3 text-right font-mono tabular-nums text-xs">{% include 'partials/_trade_costs.html.twig' with { trade: trade } only %}</td>
											<td class="py-3 text-right">
												<span class="badge {{ trade.status == 'FILLED' ? 'badge-up' : 'badge-neutral' }}">
													{{ trade.status|replace({'_': ' '})|lower|capitalize }}
												</span>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<p class="py-6 text-center text-xs text-on-surface-variant">You have not executed any trades for
							{{ asset.ticker }}
							yet.</p>
					{% endif %}
				</div>

			</div>
		</div>

	</div>

	{# Earnings-flow modal (assets/controllers/sankey_controller.js). #}
	<div id="sankey-modal" data-controller="sankey" data-sankey-ticker-value="{{ asset.ticker }}" data-sankey-url-value="/api/earnings-flow" data-action="click->sankey#backdropClick" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4">
		<div class="bg-surface-container-low border border-outline-variant/20 rounded-lg w-full max-w-5xl h-[85vh] flex flex-col overflow-hidden shadow-2xl">
			<div class="flex justify-between items-center p-6 border-b border-outline-variant/10">
				<div>
					<h2 class="text-lg font-semibold text-on-surface">{{ asset.ticker }} earnings flow</h2>
					<p class="text-sm text-on-surface-variant mt-0.5">Revenue by segment, through operating costs, to net income and what it is spent on.</p>
				</div>
				<button type="button" data-action="click->sankey#close" onclick="document.dispatchEvent(new CustomEvent('sankey:close'))" class="text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer" aria-label="Close">
					<span class="material-symbols-outlined text-2xl" aria-hidden="true">close</span>
				</button>
			</div>
			<div class="flex-1 p-6 relative">
				<div data-sankey-target="container" class="w-full h-full"></div>
			</div>
			{# Keep in step with ROLE_COLORS in assets/controllers/sankey_controller.js. #}
			<ul class="flex flex-wrap gap-x-5 gap-y-1.5 px-6 pb-5 text-xs text-on-surface-variant" aria-label="Colour key">
				{% for role in [
					{ label: 'Revenue and funding', swatch: 'bg-series-blue' },
					{ label: 'Profit and cash kept', swatch: 'bg-secondary' },
					{ label: 'Costs', swatch: 'bg-tertiary' },
					{ label: 'Non-cash charges', swatch: 'bg-on-surface-variant' },
					{ label: 'Paid to shareholders', swatch: 'bg-series-violet' }
				] %}
					<li class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm {{ role.swatch }}" aria-hidden="true"></span>{{ role.label }}</li>
				{% endfor %}
			</ul>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{# Price chart, fundamentals and macro panels, earnings flow Sankey. #}
	{% include 'partials/_chart_libraries.html.twig' with { lightweight: true, chartjs: true, echarts: true } %}

	{# Page data for assets/js/pages/stock.js. JSON rather than a JavaScript object literal:
	   in a literal, Twig's HTML escaper mangles apostrophes and a `</script>` in any value
	   closes the block early. #}
	<script type="application/json" id="aerie-data">
		{{ {
			ticker: asset.ticker,
			isEtf: isEtf,
			businessModel: businessModel|default('none'),
			isFinancial: isFinancial,
			isInsurer: isInsurer|default(false),
			sharesOutstanding: asset.sharesOutstanding|default(1),
			currentPrice: asset.price|default(0),
			userQuantity: userQuantity|default(0),
			eps: not isEtf and asset.earningsPerShare is defined ? asset.earningsPerShare|default(0) : 0,
			ticksPerYear: ticksPerYear|default(14400),
			pieLabels: pieLabels is defined and pieLabels ? pieLabels : [],
			pieData: pieData is defined and pieData ? pieData : [],
			sharesMap: sharesMap is defined and sharesMap ? sharesMap : {},
			capitalThresholds: capitalThresholds|default(null),
			kpiSeries: kpiSeries|default([]) ?: {}
		}|json_encode|raw }}
	</script>

	<script type="module">
		import 'pages/stock';
	</script>
{% endblock %}
