											</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">${{ peer.price|number_format(2) }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">${{ peer.marketCap|format_large }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ peer.peRatio ? peer.peRatio|number_format(2) ~ 'x' : '-' }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ (peer.roic * 100)|number_format(2) }}%</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">${{ peer.totalEquity|format_large }}</td>
											<td class="py-2.5 text-right">
												<a href="/stock/{{ peer.ticker }}" class="px-2 py-0.5 text-xs font-bold text-primary bg-primary/10 rounded hover:bg-primary/20 transition-colors uppercase tracking-wider">
													View
												</a>
											</td>
										</tr>
									{% else %}
										<tr>
											<td colspan="7" class="py-4 text-center text-xs text-on-surface-variant">No peer companies found in this sector.</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>

				</div>
			{% endif %}

			{# ========================================================================= #}
			{# TAB 4: ORDER DEPTH & TRADES #}
			{# ========================================================================= #}
				<div
				id="stock-tab-content-orders" class="stock-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="orders"> {# Open Limit Orders for this Ticker #}
				<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/25">
					<div class="flex items-center justify-between mb-3">
						<h3 class="text-xs font-bold uppercase tracking-wider text-on-surface">
							Your Active Orders for {{ asset.ticker }}
						</h3>
						<span class="text-xs font-mono text-on-surface-variant">{{ openOrders|length }} active</span>
					</div>

					{% if openOrders|length > 0 %}
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse min-w-125">
								<thead>
									<tr class="text-xs text-on-surface-variant uppercase tracking-wider border-b border-outline-variant/15 font-bold">
										<th class="py-2.5">Placed Date</th>
										<th class="py-2.5">Action</th>
										<th class="py-2.5 text-right">Shares</th>
										<th class="py-2.5 text-right">Limit Price</th>
										<th class="py-2.5 text-right">Total Est.</th>
										<th class="py-2.5 text-right">Cancel</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
									{% for order in openOrders %}
										<tr>
											<td class="py-2.5 text-xs text-on-surface-variant font-mono">{{ order.createdAt|date('Y-m-d H:i') }}</td>
											<td class="py-2.5 font-bold {{ order.action == 'BUY' ? 'text-secondary' : 'text-primary' }}">{{ order.action }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ order.quantity|number_format }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums font-bold text-on-surface">${{ order.limitPrice|number_format(2) }}</td>
											<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">${{ (order.limitPrice * order.quantity)|number_format(2) }}</td>
											<td class="py-2.5 text-right">
												<form action="/trade/cancel/{{ order.id }}" method="POST" class="inline">
													<input type="hidden" name="_token" value="{{ csrf_token('cancel_trade_' ~ order.id) }}">
													<button type="submit" class="px-2 py-0.5 text-xs font-bold text-tertiary bg-tertiary/10 hover:bg-tertiary/20 rounded border border-tertiary/20 transition-colors">
														Cancel
													</button>
												</form>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<p class="py-6 text-center text-xs text-on-surface-variant">No open limit orders for {{ asset.ticker }}.</p>
					{% endif %}
				</div>

				{# Your Past Trades on this Ticker #}
				<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/25">
					<h3 class="text-xs font-bold uppercase tracking-wider text-on-surface mb-3">
						Your Execution History for {{ asset.ticker }}
					</h3>

					{% if userTrades|length > 0 %}
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse min-w-125">
								<thead>
									<tr class="text-[10px] text-on-surface-variant uppercase tracking-widest border-b border-outline-variant/10">
										<th class="py-3 font-bold">Execution Date</th>
										<th class="py-3 font-bold">Action</th>
										<th class="py-3 font-bold text-right">Shares</th>
										<th class="py-3 font-bold text-right">Executed Price</th>
										<th class="py-3 font-bold text-right">Total</th>
										<th class="py-3 font-bold text-right">Status</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-outline-variant/5 text-sm">
									{% for trade in userTrades %}
										<tr>
											<td class="py-3 text-xs text-on-surface-variant">{{ (trade.filledAt ?? trade.createdAt)|date('Y-m-d H:i') }}</td>
											<td class="py-3 font-bold {{ trade.action == 'BUY' ? 'text-secondary' : 'text-primary' }}">{{ trade.action }}</td>
											<td class="py-3 text-right font-mono text-on-surface">{{ (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity)|number_format }}</td>
											<td class="py-3 text-right font-mono text-on-surface">${{ (trade.executionPrice ?? trade.limitPrice ?? 0.00)|number_format(2) }}</td>
											<td class="py-3 text-right font-mono font-bold text-on-surface">
												${{ ((trade.executionPrice ?? trade.limitPrice ?? 0.00) * (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity))|number_format(2) }}
											</td>
											<td class="py-3 text-right">
												<span class="px-2 py-0.5 text-[10px] font-bold rounded {{ trade.status == 'FILLED' ? 'bg-secondary/10 text-secondary border border-secondary/20' : 'bg-surface-container text-on-surface-variant' }}">
													{{ trade.status }}
												</span>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% else %}
						<p class="py-6 text-center text-xs text-on-surface-variant font-serif">You have not executed any trades for
							{{ asset.ticker }}
							yet.</p>
					{% endif %}
				</div>

			</div>
		</div>

	</div>

	{# --- SANKEY MODAL (INCOME STATEMENT FLOW) --- #}
	<div id="sankey-modal" data-controller="sankey" data-sankey-ticker-value="{{ asset.ticker }}" data-sankey-url-value="/api/earnings-flow" data-action="click->sankey#backdropClick" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4">
		<div class="bg-surface-container-low border border-outline-variant/20 rounded-2xl w-full max-w-5xl h-[85vh] flex flex-col overflow-hidden shadow-2xl">
			<div class="flex justify-between items-center p-6 border-b border-outline-variant/10">
				<div>
					<h3 class="text-lg font-bold text-on-surface flex items-center gap-2">
						<span class="material-symbols-outlined text-primary">account_tree</span>
						Earnings Flow (Sankey Diagram) -
						{{ asset.ticker }}
					</h3>
					<p class="text-xs text-on-surface-variant mt-0.5">Visualizing revenue streams through operational costs to net profit and capital allocation.</p>
				</div>
				<button type="button" data-action="click->sankey#close" onclick="document.dispatchEvent(new CustomEvent('sankey:close'))" class="text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer">
					<span class="material-symbols-outlined text-2xl">close</span>
				</button>
			</div>
			<div class="flex-1 p-6 relative">
				<div data-sankey-target="container" class="w-full h-full"></div>
			</div>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}

	<script>
		window.AERIE_DATA = {
ticker: "{{ asset.ticker }}",
isEtf: {{ isEtf ? 'true' : 'false' }},
businessModel: "{{ businessModel|default('none') }}",
isFinancial: {{ isFinancial ? 'true' : 'false' }},
sharesOutstanding: {{ asset.sharesOutstanding|default(1) }},
currentPrice: {{ asset.price|default(0) }},
userQuantity: {{ userQuantity|default(0) }},
eps: {{ not isEtf and asset.earningsPerShare is defined ? asset.earningsPerShare|default(0) : 0 }},
ticksPerYear: {{ ticksPerYear|default(14400) }},
pieLabels: {{ pieLabels is defined and pieLabels ? pieLabels|json_encode|raw : '[]' }},
pieData: {{ pieData is defined and pieData ? pieData|json_encode|raw : '[]' }},
sharesMap: {{ sharesMap is defined and sharesMap ? sharesMap|json_encode|raw : '{}' }}
};
	</script>

	<script type="module">
		import 'pages/stock';
	</script>
{% endblock %}
