									<span class="block mt-0.5 text-base font-semibold font-mono tabular-nums {{ tile.format starts with 'signed' ? v|signed_class : 'text-on-surface' }}">{{ shown }}</span>
								</div>
							{% endfor %}
						</div>
					{% endif %}

					<div class="flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-3">
