							</button>
							<button type="submit" name="action" value="SELL" class="flex w-full justify-center rounded-xl bg-surface-container-high px-3 py-3.5 text-sm font-bold text-on-surface hover:bg-surface-bright active:scale-95 transition-all">
								SELL
							</button>
						</div>
					</form>
				</div>

				{% if openOrders|length > 0 %}
