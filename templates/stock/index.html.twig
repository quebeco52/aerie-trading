							<div class="flex items-center justify-between p-3 rounded-lg bg-surface-container-lowest border border-outline-variant/10">
								<div>
									<div class="flex items-center gap-2">
										<span class="text-xs font-bold {{ order.action == 'BUY' ? 'text-secondary' : 'text-primary' }}">{{ order.action }}</span>
										<span class="text-xs font-bold text-on-surface">{{ order.quantity|number_format }} shares</span>
									</div>
									<div class="text-[10px] text-on-surface-variant mt-1">@ ${{ order.limitPrice|number_format(2) }}</div>
								</div>
								<form action="/trade/cancel/{{ order.id }}" method="POST">
									<input type="hidden" name="_token" value="{{ csrf_token('cancel_trade_' ~ order.id) }}">
									<button type="submit" class="p-1.5 rounded-md text-on-surface-variant hover:text-error hover:bg-error/10 transition-colors" title="Cancel Order">
										<span class="material-symbols-outlined text-sm">close</span>
									</button>
								</form>
							</div>
						{% endfor %}
					</div>
				</div>
