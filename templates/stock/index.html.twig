											<div class="hidden sm:flex flex-col items-end text-right max-w-64">
												<span class="text-2xs text-on-surface-variant">Latest</span>
												<span class="text-xs font-mono font-bold text-on-surface tabular-nums" id="hud-netIncomeChart">-</span>
											</div>
											<button type="button" class="expand-chart-btn p-1 -m-1 rounded text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors cursor-pointer" title="Expand chart" aria-label="Expand chart">
												<span class="material-symbols-outlined text-base leading-none expand-icon" aria-hidden="true">open_in_full</span>
											</button>
										</div>
									</div>
									<div class="chart-canvas-container h-80 md:h-85 w-full relative">
										<canvas id="netIncomeChart"></canvas>
									</div>
								</div>

								{# The last four quarters as filed and their trailing-year sum (assets/js/stock/income-statement.js). #}
								<div id="income-statement-panel" data-unavailable class="chart-card hidden md:col-span-2 bg-surface-container-low border border-outline-variant/20 rounded-lg p-5 flex flex-col" data-wide data-financial-category="income">
									<div class="min-w-0 mb-3">
										<h4 class="text-sm font-semibold text-on-surface">Income statement</h4>
										<p class="text-xs text-on-surface-variant mt-0.5">The last four quarterly reports, from revenue down to what was left for shareholders</p>
									</div>
