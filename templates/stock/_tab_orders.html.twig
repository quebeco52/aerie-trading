{# The orders tab of the stock page (stock/index.html.twig). #}

<div id="stock-tab-content-orders" class="stock-tab-panel hidden space-y-5" data-tabs-target="panel" data-tab-panel="orders"> {# Open Limit Orders for this Ticker #}
<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
	<div class="flex items-center justify-between mb-3">
		<h3 class="text-sm font-semibold text-on-surface">
			Your active orders for {{ asset.ticker }}
		</h3>
		<span class="text-xs font-mono text-on-surface-variant">{{ openOrders|length }} active</span>
	</div>

	{% if openOrders|length > 0 %}
		<div class="overflow-x-auto">
			<table class="w-full text-left border-collapse min-w-125">
				<thead>
					<tr class="table-head">
						<th class="py-2.5">Placed date</th>
						<th class="py-2.5">Action</th>
						<th class="py-2.5 text-right">Shares</th>
						<th class="py-2.5 text-right">Limit price</th>
						<th class="py-2.5 text-right">Total Est.</th>
						<th class="py-2.5 text-right">Cancel</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
					{% for order in openOrders %}
						<tr>
							<td class="py-2.5 text-xs text-on-surface-variant font-mono">{{ order.createdAt|date('Y-m-d H:i') }}</td>
							<td class="py-2.5 font-bold {{ order.action in ['BUY', 'COVER'] ? 'text-secondary' : 'text-tertiary' }}">
								{{ order.action|lower|capitalize }}
								{% if order.stop %}<span class="ml-1 text-2xs font-normal text-on-surface-variant">{{ order.orderType == 'STOP_LIMIT' ? 'Stop limit' : 'Stop' }}</span>{% endif %}
							</td>
							<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ order.quantity|number_format }}</td>
							{# A stop has no limit until it fires; what it rests on is its trigger. #}
							{% set restingPrice = order.stop ? order.stopPrice : order.limitPrice %}
							<td class="py-2.5 text-right font-mono tabular-nums font-bold text-on-surface">{{ restingPrice|money(2) }}</td>
							<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ (restingPrice is null ? null : restingPrice * order.quantity)|money(2) }}</td>
							<td class="py-2.5 text-right">
								<form action="/trade/cancel/{{ order.id }}" method="POST" class="inline">
									<input type="hidden" name="_token" value="{{ csrf_token('cancel_trade_' ~ order.id) }}">
									<button type="submit" class="cursor-pointer px-2 py-0.5 text-xs font-bold text-tertiary bg-tertiary/10 hover:bg-tertiary/20 rounded border border-tertiary/20 transition-colors">
										Cancel
									</button>
								</form>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	{% else %}
		<p class="py-6 text-center text-xs text-on-surface-variant">No resting orders for {{ asset.ticker }}.</p>
	{% endif %}
</div>

{# Your Past Trades on this Ticker #}
<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
	<h3 class="text-sm font-semibold text-on-surface mb-3">
		Your execution history for {{ asset.ticker }}
	</h3>

	{% if userTrades|length > 0 %}
		<div class="overflow-x-auto">
			<table class="w-full text-left border-collapse min-w-125">
				<thead>
					<tr class="table-head">
						<th class="py-3 font-bold">Execution date</th>
						<th class="py-3 font-bold">Action</th>
						<th class="py-3 font-bold text-right">Shares</th>
						<th class="py-3 font-bold text-right">Executed price</th>
						<th class="py-3 font-bold text-right">Total</th>
						<th class="py-3 font-bold text-right">Trading costs</th>
						<th class="py-3 font-bold text-right">Status</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-outline-variant/5 text-sm">
					{% for trade in userTrades %}
						<tr>
							<td class="py-3 text-xs text-on-surface-variant">{{ (trade.filledAt ?? trade.createdAt)|date('Y-m-d H:i') }}</td>
							<td class="py-3 font-bold {{ trade.action in ['BUY', 'COVER'] ? 'text-secondary' : 'text-tertiary' }}">{{ trade.action|lower|capitalize }}</td>
							<td class="py-3 text-right font-mono text-on-surface">{{ (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity)|number_format }}</td>
							{% set tradePrice = trade.executionPrice ?? trade.limitPrice %}
							<td class="py-3 text-right font-mono text-on-surface">{{ tradePrice|money(2) }}</td>
							<td class="py-3 text-right font-mono font-bold text-on-surface">
								{{ (tradePrice is null ? null : tradePrice * (trade.filledQuantity > 0 ? trade.filledQuantity : trade.quantity))|money(2) }}
							</td>
							<td class="py-3 text-right font-mono tabular-nums text-xs">{% include 'partials/_trade_costs.html.twig' with { trade: trade } only %}</td>
							<td class="py-3 text-right">
								<span class="badge {{ trade.status == 'FILLED' ? 'badge-up' : 'badge-neutral' }}">
									{{ trade.status|replace({'_': ' '})|lower|capitalize }}
								</span>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	{% else %}
		<p class="py-6 text-center text-xs text-on-surface-variant">You have not executed any trades for
			{{ asset.ticker }}
			yet.</p>
	{% endif %}
</div>

			</div>
