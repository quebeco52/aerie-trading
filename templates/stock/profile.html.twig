{% extends 'base.html.twig' %}

{# The long-form company profile: App\Data\Company\CompanyResearch's article beside live facts from
   App\Service\View\CompanyProfilePageBuilder. Tickbird Research writes for terminal subscribers. #}

{% block title %}{{ article.headline }} | {{ publisher }}{% endblock %}

{% block meta %}
	<meta name="description" content="{{ article.standfirst }}">
{% endblock %}

{% block body %}
<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full">
	<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_20rem] gap-8 lg:gap-12">

		<article class="min-w-0 max-w-3xl">
			<header class="pb-6 border-b border-outline-variant/15">
				<a href="/stock/{{ asset.ticker }}" class="text-sm text-on-surface-variant hover:text-primary transition-colors"><span class="font-mono font-semibold text-on-surface">{{ asset.ticker }}</span> {{ asset.name }}</a>
				<h1 class="mt-3 text-2xl md:text-3xl font-semibold text-on-surface tracking-tight leading-tight">{{ article.headline }}</h1>
				<p class="mt-3 text-base md:text-lg text-on-surface-variant leading-relaxed">{{ article.standfirst }}</p>
				<p class="mt-4 text-sm text-on-surface-variant">{{ publisher }}, company profile</p>
			</header>

			<div class="pt-6 space-y-8">
				{% for section in article.sections %}
					<section>
						<h2 class="text-lg font-semibold text-on-surface">{{ section.heading }}</h2>
						<div class="mt-3 space-y-4 text-base text-on-surface-variant leading-relaxed">
							{% for paragraph in section.body|split("\n\n") %}
								<p>{{ paragraph }}</p>
							{% endfor %}
						</div>
					</section>
				{% endfor %}
			</div>

			<p class="mt-10 pt-4 border-t border-outline-variant/15 text-xs text-on-surface-variant">Profiles are written for terminal subscribers and are not investment advice. Figures in the margin are live; the text is reviewed periodically.</p>
		</article>

		<aside class="space-y-4" aria-label="Company facts">
			<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
				<h2 class="text-sm font-semibold text-on-surface mb-3">Key facts</h2>
				<dl class="space-y-2 text-sm">
					<div class="flex justify-between gap-3">
						<dt class="text-on-surface-variant">Price</dt>
						<dd class="font-mono tabular-nums text-on-surface">
							{% if asset.isBankrupt %}<span class="text-on-surface-faint">Delisted</span>{% else %}{{ asset.price|money(2) }}{% endif %}
						</dd>
					</div>
					<div class="flex justify-between gap-3">
						<dt class="text-on-surface-variant">Change</dt>
						<dd class="font-mono tabular-nums {{ changePercent is null ? 'text-on-surface-faint' : changePercent|signed_class }}">{{ changePercent is null ? '—' : changePercent|pct(2, true) }}</dd>
					</div>
					<div class="flex justify-between gap-3">
						<dt class="text-on-surface-variant">Market value</dt>
						<dd class="font-mono tabular-nums {{ marketCap is null ? 'text-on-surface-faint' : 'text-on-surface' }}">{{ marketCap is null ? '—' : marketCap|format_large('$') }}</dd>
					</div>
					<div class="flex justify-between gap-3">
						<dt class="text-on-surface-variant">Sector</dt>
						<dd class="text-on-surface text-right">{{ asset.sector }}</dd>
					</div>
					<div class="flex justify-between gap-3">
						<dt class="text-on-surface-variant">Industry</dt>
						<dd class="text-on-surface text-right">{{ asset.industry }}</dd>
					</div>
				</dl>
				<a href="/stock/{{ asset.ticker }}" class="inline-block mt-4 text-sm text-primary hover:underline">Quote, financials and trading</a>
			</div>

			{% if management %}
				<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
					<h2 class="text-sm font-semibold text-on-surface mb-3">Management</h2>
					<p class="text-sm text-on-surface">{{ management.label }}</p>
					<p class="mt-1 text-xs text-on-surface-variant leading-relaxed">Capital is {{ management.mandate }}.</p>
					<p class="mt-3 text-xs text-on-surface-variant">Chief executive in post <span class="font-mono tabular-nums text-on-surface">{{ management.tenureYears|number_format(1) }}</span> years</p>
				</div>
			{% endif %}

			<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
				<h2 class="text-sm font-semibold text-on-surface mb-3">Ownership</h2>
				<dl class="space-y-2 text-sm">
					<div class="flex justify-between gap-3">
						<dt class="text-on-surface-variant">Free float</dt>
						<dd class="font-mono tabular-nums text-on-surface">{{ freeFloat|pct(0) }}</dd>
					</div>
					{% for holder in holders %}
						<div class="flex justify-between gap-3">
							<dt class="text-on-surface-variant">
								{% if holder.ticker %}<a href="/stock/{{ holder.ticker }}" class="hover:text-primary">{{ holder.name }}</a>{% else %}{{ holder.name }}{% endif %}
							</dt>
							<dd class="font-mono tabular-nums text-on-surface">{{ holder.share|pct(0) }}</dd>
						</div>
					{% endfor %}
				</dl>
				{% if holdings is not empty %}
					<h3 class="mt-4 mb-2 text-xs font-semibold text-on-surface">Stakes it holds</h3>
					<dl class="space-y-2 text-sm">
						{% for holding in holdings %}
							<div class="flex justify-between gap-3">
								<dt class="text-on-surface-variant"><a href="/stock/{{ holding.ticker }}" class="hover:text-primary">{{ holding.name }}</a></dt>
								<dd class="font-mono tabular-nums text-on-surface">{{ holding.share|pct(0) }}</dd>
							</div>
						{% endfor %}
					</dl>
				{% endif %}
			</div>

			{% if related is not empty %}
				<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
					<h2 class="text-sm font-semibold text-on-surface mb-3">Named in this profile</h2>
					<ul class="space-y-2 text-sm">
						{% for company in related %}
							<li class="flex justify-between gap-3">
								<a href="/stock/{{ company.ticker }}{{ company.hasProfile ? '/profile' : '' }}" class="text-on-surface-variant hover:text-primary"><span class="font-mono font-semibold text-on-surface">{{ company.ticker }}</span> {{ company.name }}</a>
								{% if company.isDelisted %}<span class="text-xs text-on-surface-faint">Delisted</span>{% elseif company.hasProfile %}<span class="text-xs text-on-surface-variant">Profile</span>{% endif %}
							</li>
						{% endfor %}
					</ul>
				</div>
			{% endif %}

			{% if peers is not empty %}
				<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
					<h2 class="text-sm font-semibold text-on-surface mb-3">Peers</h2>
					<ul class="space-y-2 text-sm">
						{% for peer in peers %}
							<li class="flex justify-between gap-3">
								<a href="/stock/{{ peer.ticker }}" class="min-w-0 truncate text-on-surface-variant hover:text-primary"><span class="font-mono font-semibold text-on-surface">{{ peer.ticker }}</span> {{ peer.name }}</a>
								<span class="shrink-0 font-mono tabular-nums {{ peer.isBankrupt ? 'text-on-surface-faint' : 'text-on-surface' }}">{{ peer.isBankrupt ? '—' : peer.marketCap|format_large('$') }}</span>
							</li>
						{% endfor %}
					</ul>
				</div>
			{% endif %}

			<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
				<h2 class="text-sm font-semibold text-on-surface mb-3">Headlines</h2>
				{% for rawEvent in headlines %}
					{% set story = present_event(rawEvent) %}
					<div class="py-2 first:pt-0 border-t first:border-t-0 border-outline-variant/10">
						<time class="block text-xs text-on-surface-variant">{{ story.dateline|default(story.recordedAt|date('Y-m-d')) }}</time>
						<p class="mt-0.5 text-sm text-on-surface leading-snug">{{ story.headline|default(story.badge|lower|capitalize) }}</p>
					</div>
				{% else %}
					<p class="text-sm text-on-surface-variant">No headlines yet.</p>
				{% endfor %}
			</div>
		</aside>
	</div>
</div>
{% endblock %}
