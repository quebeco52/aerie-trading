{# The holdings tab of the stock page (stock/index.html.twig). #}

<div id="stock-tab-content-holdings" class="stock-tab-panel hidden space-y-6" data-tabs-target="panel" data-tab-panel="holdings">
{# Look-through holdings: for a sphere the portfolio IS the company, so these are its fundamentals. #}
<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden p-5">
	<div class="flex items-baseline justify-between mb-3 gap-4 flex-wrap">
		<h3 class="text-sm font-semibold text-on-surface">Anchor holdings</h3>
		<p class="text-xs text-on-surface-variant">
			{{ anchorPortfolio.totalValue|format_large('$') }}
			<span class="text-on-surface-faint">&middot; {{ anchorPortfolio.shareOfNav|pct(1) }} of net asset value</span>
		</p>
	</div>

	<div class="overflow-x-auto">
		<table class="w-full text-left border-collapse min-w-162.5">
			<thead>
				<tr class="table-head">
					<th class="py-2.5">Holding</th>
					<th class="py-2.5 text-right">Owned</th>
					<th class="py-2.5 text-right">Price</th>
					<th class="py-2.5 text-right">Change</th>
					<th class="py-2.5 text-right">Stake value</th>
					<th class="py-2.5 text-right">% of portfolio</th>
					<th class="py-2.5 text-right">% of NAV</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
				{% for holding in anchorPortfolio.holdings %}
					<tr class="{{ holding.isBankrupt ? 'opacity-50' : '' }}">
					<td class="py-2.5">
						<a href="/stock/{{ holding.ticker }}" class="font-bold text-on-surface hover:text-primary transition-colors">{{ holding.ticker }}</a>
						<span class="block text-2xs text-on-surface-variant">{{ holding.industry ?? holding.name }}</span>
					</td>
					<td class="py-2.5 text-right">
						<span class="font-mono tabular-nums text-on-surface">{{ holding.ownership|pct(0) }}</span>
						<span class="block text-2xs text-on-surface-variant">{{ holding.tier }}</span>
					</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ holding.price|money(2) }}</td>
					<td class="py-2.5 text-right font-mono tabular-nums {{ holding.changePercent|signed_class }}">
						{%- if holding.changePercent is null -%}&mdash;{%- else -%}{{ holding.changePercent|pct(2, true) }}{%- endif -%}
					</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface">{{ holding.value|format_large('$') }}</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ holding.shareOfPortfolio|pct(1) }}</td>
					<td class="py-2.5 text-right font-mono tabular-nums text-on-surface-variant">{{ holding.shareOfNav|pct(1) }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	<p class="mt-3 text-2xs text-on-surface-faint">
		Stakes are valued at the holdings' live prices. Shares held by an anchor do not trade, so they are outside each holding's free float.
	</p>
</div>
</div>
