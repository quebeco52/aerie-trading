{% extends 'base.html.twig' %}

{% block page_title %}Industries{% endblock %}

{% block description %}Every industry with a company listed on the Aerie Exchange: its price against a balanced market, idle plant and demand outlook.{% endblock %}

{# A column heading the table sorts by, on a click or on Enter; tip, when given, explains it on hover and focus. #}
{% macro sortable(label, tip, align) %}
	{% import 'partials/_ui.html.twig' as ui %}
	<th scope="col" class="{{ align }} font-semibold px-4 py-3 cursor-pointer select-none hover:text-primary transition-colors" tabindex="0" data-screener-target="header" data-action="click->screener#sort keydown.enter->screener#sort">{% if tip %}{{ ui.term(label, tip, {tag: 'span', class: '', position: 'right', vpos: 'bottom', width: 'w-64'}) }}{% else %}{{ label }}{% endif %}</th>
{% endmacro %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5">

		{% embed 'partials/_page_header.html.twig' with {title: 'Industries'} %}
			{% block lead %}
				Every industry with a listed company, from the companies' last full quarter of reports. An industry short of plant sells above a balanced price until new plant opens; an overbuilt one sells below it.
			{% endblock %}
		{% endembed %}

		{# Sorts as the screener does (screener_controller.js): a heading's click or Enter orders the rows by each cell's
		   data-value, a missing figure last. #}
		<div class="bg-surface-container-low border border-outline-variant/20 rounded-lg overflow-hidden" data-controller="screener">
			<div class="overflow-x-auto">
				<table class="w-full text-sm min-w-180">
					<thead>
						<tr class="table-head">
							{{ _self.sortable('Industry', null, 'text-left') }}
							{{ _self.sortable('Sector', null, 'text-left') }}
							{{ _self.sortable('Companies', null, 'text-right') }}
							{{ _self.sortable('Price against balance', 'What the industry\'s output sold for against what it would fetch with just enough plant for demand. Above means too little plant; below, too much.', 'text-right') }}
							{{ _self.sortable('Idle plant', 'Plant switched off because its output would not cover its running cost.', 'text-right') }}
							{{ _self.sortable('Demand outlook', 'Expected long-run demand for the whole industry, 1.00 when trading opened.', 'text-right') }}
							{{ _self.sortable('Last revision', 'The outlook\'s last revision.', 'text-right') }}
						</tr>
					</thead>
					<tbody class="divide-y divide-outline-variant/10" data-screener-target="tbody">
						{% for row in industries %}
							<tr class="screener-row hover:bg-surface-container/40">
								<th scope="row" class="px-4 py-2 text-left font-normal" data-value="{{ row.name }}"><a href="{{ path('app_industry', {slug: row.slug}) }}" class="text-primary hover:underline">{{ row.name }}</a></th>
								<td class="px-4 py-2 text-on-surface-variant" data-value="{{ row.sector }}">{{ row.sector }}</td>
								<td class="px-4 py-2 text-right font-mono tabular-nums text-on-surface" data-value="{{ row.companies }}">{{ row.companies }}</td>
								<td class="px-4 py-2 text-right font-mono tabular-nums {{ row.priceGap is null ? 'text-on-surface-faint' : (row.priceGap|abs >= constant('App\\Service\\View\\IndustryPageBuilder::PRICE_GAP_NOTED') ? 'text-warning' : 'text-on-surface') }}" data-value="{{ row.priceGap }}">{{ row.priceGap|pct(1, true) }}</td>
								<td class="px-4 py-2 text-right font-mono tabular-nums {{ row.idle is null ? 'text-on-surface-faint' : 'text-on-surface' }}" data-value="{{ row.idle }}">{{ row.idle|pct(1) }}</td>
								<td class="px-4 py-2 text-right font-mono tabular-nums {{ row.outlook is null ? 'text-on-surface-faint' : (row.outlook.level - 1)|round(2)|signed_class }}" data-value="{{ row.outlook.level ?? '' }}">{{ row.outlook is null ? '—' : row.outlook.level|figure('index', 2) }}</td>
								<td class="px-4 py-2 text-right font-mono tabular-nums {{ row.outlook is null or row.outlook.revision is null ? 'text-on-surface-faint' : row.outlook.revision|round(3)|signed_class }}" data-value="{{ row.outlook.revision ?? '' }}">{{ (row.outlook.revision ?? null)|pct(1, true) }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>
{% endblock %}
