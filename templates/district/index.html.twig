							<path d="M 15 2 C 15 2, 3 17, 3 24 A 12 12 0 0 0 27 24 C 27 17, 15 2, 15 2 Z" fill="currentColor"/>
						</symbol>
						<symbol id="roof-crane" viewBox="0 0 30 36">
							<line x1="7" y1="36" x2="7" y2="5" stroke="currentColor" stroke-width="4"/>
