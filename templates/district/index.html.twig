							<path d="M 5 16 H 25 L 22 36 H 8 Z" fill="currentColor"/>
						</symbol>
						<symbol id="roof-shield" viewBox="0 0 30 36">
							<path d="M 15 1 L 28 7 V 18 C 28 27, 22 33, 15 36 C 8 33, 2 27, 2 18 V 7 Z" fill="currentColor"/>
						</symbol>
						<symbol id="roof-lock" viewBox="0 0 30 36">
							<path d="M 7 17 V 11 A 8 8 0 0 1 23 11 V 17" fill="none" stroke="currentColor" stroke-width="4"/>
							<rect x="2" y="17" width="26" height="19" rx="3" fill="currentColor"/>
						</symbol>
						<symbol id="roof-cart" viewBox="0 0 30 36">
							<path d="M 1 6 H 7 L 11 24 H 26 L 29 11 H 9" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>
							<circle cx="13" cy="32" r="3.5" fill="currentColor"/>
							<circle cx="24" cy="32" r="3.5" fill="currentColor"/>
						</symbol>
						<symbol id="roof-bottle" viewBox="0 0 30 36">
							<rect x="11" y="1" width="8" height="9" fill="currentColor"/>
							<path d="M 11 10 H 19 L 24 17 V 33 A 3 3 0 0 1 21 36 H 9 A 3 3 0 0 1 6 33 V 17 Z" fill="currentColor"/>
						</symbol>
						<symbol id="roof-fork" viewBox="0 0 30 36">
							<path d="M 4 1 V 11 A 5 5 0 0 0 14 11 V 1 M 9 14 V 36" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
							<path d="M 25 1 C 18 8, 18 16, 25 20 V 36" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
						</symbol>
						<symbol id="roof-shirt" viewBox="0 0 30 36">
							<path d="M 1 10 L 10 3 C 12 8, 18 8, 20 3 L 29 10 L 25 17 L 23 15 V 36 H 7 V 15 L 5 17 Z" fill="currentColor"/>
						</symbol>
						<symbol id="roof-car" viewBox="0 0 30 36">
							<path d="M 1 30 V 20 L 7 11 H 23 L 29 20 V 30 Z" fill="currentColor"/>
							<circle cx="8" cy="31" r="4.5" fill="currentColor"/>
							<circle cx="22" cy="31" r="4.5" fill="currentColor"/>
						</symbol>
						<symbol id="roof-bag" viewBox="0 0 30 36">
							<path d="M 4 12 H 26 L 29 36 H 1 Z" fill="currentColor"/>
							<path d="M 10 12 V 8 A 5 5 0 0 1 20 8 V 12" fill="none" stroke="currentColor" stroke-width="3.5"/>
						</symbol>
						<symbol id="roof-gem" viewBox="0 0 30 36">
							<polygon points="15,36 1,15 7,5 23,5 29,15" fill="currentColor"/>
						</symbol>
						<symbol id="roof-dice" viewBox="0 0 30 36">
							<rect x="2" y="6" width="26" height="26" rx="5" fill="currentColor"/>
							<circle cx="9" cy="13" r="3" fill="#0b1120"/>
							<circle cx="15" cy="19" r="3" fill="#0b1120"/>
							<circle cx="21" cy="25" r="3" fill="#0b1120"/>
						</symbol>
						<symbol id="roof-megaphone" viewBox="0 0 30 36">
							<path d="M 1 14 H 9 L 27 3 V 31 L 9 20 H 1 Z" fill="currentColor"/>
							<rect x="8" y="21" width="6" height="12" fill="currentColor"/>
						</symbol>
						<symbol id="roof-cap" viewBox="0 0 30 36">
							<polygon points="15,4 29,12 15,20 1,12" fill="currentColor"/>
							<path d="M 7 16 V 25 C 7 30, 23 30, 23 25 V 16" fill="none" stroke="currentColor" stroke-width="4"/>
							<line x1="29" y1="12" x2="29" y2="24" stroke="currentColor" stroke-width="2.5"/>
						</symbol>
						<symbol id="roof-scales" viewBox="0 0 30 36">
							<line x1="15" y1="3" x2="15" y2="32" stroke="currentColor" stroke-width="3.5"/>
							<rect x="6" y="32" width="18" height="4" fill="currentColor"/>
							<line x1="2" y1="9" x2="28" y2="9" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
							<path d="M 1 21 A 6 5 0 0 0 13 21 Z" fill="currentColor"/>
							<path d="M 17 21 A 6 5 0 0 0 29 21 Z" fill="currentColor"/>
							<path d="M 7 9 L 1 21 M 7 9 L 13 21 M 23 9 L 17 21 M 23 9 L 29 21" fill="none" stroke="currentColor" stroke-width="1.5"/>
						</symbol>
						<symbol id="roof-chip" viewBox="0 0 30 36">
							<rect x="7" y="10" width="16" height="16" fill="currentColor"/>
							<path d="M 10 4 V 10 M 15 4 V 10 M 20 4 V 10 M 10 26 V 32 M 15 26 V 32 M 20 26 V 32 M 1 13 H 7 M 1 18 H 7 M 1 23 H 7 M 23 13 H 29 M 23 18 H 29 M 23 23 H 29" fill="none" stroke="currentColor" stroke-width="2.5"/>
						</symbol>
						<symbol id="roof-cloud" viewBox="0 0 30 36">
							<path d="M 8 32 A 7 7 0 0 1 8 18 A 9 9 0 0 1 24 15 A 7 7 0 0 1 24 32 Z" fill="currentColor"/>
						</symbol>
						<symbol id="roof-signal" viewBox="0 0 30 36">
							<line x1="15" y1="36" x2="15" y2="17" stroke="currentColor" stroke-width="4"/>
							<circle cx="15" cy="17" r="3.5" fill="currentColor"/>
							<path d="M 7 15 A 10 10 0 0 1 23 15" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
							<path d="M 1 9 A 17 17 0 0 1 29 9" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
						</symbol>
						<symbol id="roof-cross" viewBox="0 0 30 36">
							<rect x="10" y="2" width="10" height="32" fill="currentColor"/>
							<rect x="1" y="13" width="28" height="10" fill="currentColor"/>
						</symbol>
						<symbol id="roof-pill" viewBox="0 0 30 36">
							<rect x="1" y="11" width="28" height="14" rx="7" fill="none" stroke="currentColor" stroke-width="3.5"/>
							<path d="M 8 11 A 7 7 0 0 0 8 25 H 15 V 11 Z" fill="currentColor"/>
						</symbol>
						<symbol id="roof-house" viewBox="0 0 30 36">
							<polygon points="15,3 29,17 24,17 24,36 6,36 6,17 1,17" fill="currentColor"/>
							<rect x="12" y="25" width="6" height="11" fill="#0b1120"/>
						</symbol>
						<symbol id="roof-blocks" viewBox="0 0 30 36">
							<rect x="2" y="22" width="12" height="12" fill="currentColor"/>
							<rect x="16" y="22" width="12" height="12" fill="currentColor"/>
							<rect x="9" y="8" width="12" height="12" fill="currentColor"/>
						</symbol>
						</defs>

					<rect x="0" y="0" width="{{ viewboxWidth }}" height="{{ viewboxHeight }}" fill="url(#sky)"/>

					{# Market-cap reference gridlines, behind everything. A cap maps to a facade height,
					   so the same reference sits at a different y on each row — hence one set per row. #}
					<g id="gutter" aria-hidden="true">
						{% for line in gridlines %}
							<line class="gridline" x1="{{ gutterWidth - 8 }}" y1="{{ line.y }}"
								x2="{{ viewboxWidth - frontageMargin }}" y2="{{ line.y }}"/>
							<text class="gridline-label" x="{{ gutterWidth - 16 }}" y="{{ line.y + 11 }}"
								text-anchor="end">{{ line.label }}</text>
						{% endfor %}
					</g>

					{# The far bank: abstract institutions publishing the macro state every tenant reads.
					   Only institutions at least one tenant draws a conduit from render here — see
					   App\Service\District\DistrictMapBuilder::buildInstitutions(). #}
					<g id="institutions">
						{% for institution in institutions %}
							<g class="institution"
								data-district-target="institution"
								data-institution="{{ institution.id }}"
								data-stressed="{{ institutionStress[institution.id] ? 'true' : 'false' }}"
								data-action="click->district#selectInstitution keydown.enter->district#selectInstitution mouseenter->district#hoverInstitution mouseleave->district#unhoverInstitution focus->district#hoverInstitution blur->district#unhoverInstitution"
								tabindex="0"
								role="button"
								aria-label="{{ institution.label }}">

								{% set top = institutionBand.top %}
								<polygon class="pediment" points="
									{{ institution.x }},{{ top + 26 }}
									{{ institution.x + institution.width / 2 }},{{ top }}
									{{ institution.x + institution.width }},{{ top + 26 }}
								"/>
								<rect class="body"
									x="{{ institution.x }}" y="{{ top + 26 }}"
									width="{{ institution.width }}" height="{{ institutionBand.height - 26 }}"/>
								{% for c in 0..5 %}
									<line class="column"
										x1="{{ institution.x + 16 + c * ((institution.width - 32) / 5) }}" y1="{{ top + 34 }}"
										x2="{{ institution.x + 16 + c * ((institution.width - 32) / 5) }}" y2="{{ top + institutionBand.height - 8 }}"/>
								{% endfor %}
								<circle class="institution-beacon" cx="{{ institution.x + institution.width / 2 }}" cy="{{ top }}" r="8"/>

								{% set centreX = institution.x + institution.width / 2 %}
								{% set structureBottom = top + institutionBand.height %}
								<text class="institution-label" x="{{ centreX }}" y="{{ structureBottom + institutionBand.labelOffset }}"
									text-anchor="middle">{{ institution.shortLabel|upper }}</text>

								{# Live readout: the actual macro numbers behind the stress pulse, not just
								   the pulse itself. One line per reading so the larger legible font size
								   never overruns a narrower institution's width. #}
								<text class="institution-readout" data-district-target="institutionReadout" data-institution-readout-for="{{ institution.id }}"
									text-anchor="middle">{%- for readout in institution.readouts -%}
										{%- set raw = macroSnapshot[readout.field] ?? 0 -%}
										<tspan x="{{ centreX }}" y="{{ structureBottom + institutionBand.readoutTopOffset + loop.index0 * institutionBand.readoutPitch }}"
											><tspan class="readout-label">{{ readout.label }}</tspan> <tspan class="readout-value" data-readout-field="{{ readout.field }}">{% if readout.unit == 'pct' %}{{ (raw * 100)|number_format(2) }}%{% else %}{{ raw|number_format(1) }}{% endif %}</tspan></tspan>
									{%- endfor -%}</text>

								{# One sparkline strip under each readout — the reading's recent path, drawn by
								   district_controller.js from the ticks this page has seen. #}
								{% for readout in institution.readouts %}
									{% set sparkTop = structureBottom + institutionBand.readoutTopOffset + loop.index0 * institutionBand.readoutPitch + institutionBand.sparklineGap %}
									{% set sparkLeft = centreX - institutionBand.sparklineWidth / 2 %}
									<line class="readout-spark-base"
										x1="{{ sparkLeft }}" y1="{{ sparkTop + institutionBand.sparklineHeight }}"
										x2="{{ sparkLeft + institutionBand.sparklineWidth }}" y2="{{ sparkTop + institutionBand.sparklineHeight }}"/>
									<polyline class="readout-spark" data-district-target="readoutSpark"
										data-spark-field="{{ readout.field }}"
										data-spark-left="{{ sparkLeft }}" data-spark-top="{{ sparkTop }}"
										data-spark-width="{{ institutionBand.sparklineWidth }}" data-spark-height="{{ institutionBand.sparklineHeight }}"
										points=""/>
								{% endfor %}
							</g>
						{% endfor %}
					</g>

					{# Conduits: institution outlet down to its lane, along the lane, and down onto the
					   tenant's roofline — see App\Data\DistrictMap::CONDUIT_LANE_PITCH. Drawn behind the
					   skyline, so a lower-row drop passes through the upper row's gaps and behind its
					   kerb, which is the one depth cue the elevation allows itself. #}
					<g id="conduits">
						{% set institutionsById = {} %}
						{% for institution in institutions %}
							{% set institutionsById = institutionsById|merge({(institution.id): institution}) %}
						{% endfor %}
						{% for plot in plots %}
							{% for institutionId in plot.conduits %}
								{% set institution = institutionsById[institutionId] %}
								{% set sx = institution.x + institution.width / 2 %}
								{% set sy = institutionBand.outletY %}
								{% set tx = plot.conduitDropX[institutionId] %}
								{% set ty = plot.y - 7 %}
								<path class="conduit"
									data-district-target="conduit"
									data-conduit-institution="{{ institutionId }}"
									data-conduit-building="{{ plot.ticker }}"
									data-stressed="{{ institutionStress[institutionId] ? 'true' : 'false' }}"
									data-sx="{{ sx }}" data-sy="{{ sy }}" data-tx="{{ tx }}" data-lane-y="{{ institution.laneY }}"
									d="M {{ sx }} {{ sy }} V {{ institution.laneY }} H {{ tx }} V {{ ty }}"/>
							{% endfor %}
						{% endfor %}
					</g>

					<g id="skyline">
						{% for rowIndex, rowGroundLine in rowGroundLines %}
							<g id="skyline-row-{{ rowIndex }}">
								{% for plot in plots|filter(p => p.row == rowIndex) %}
									{% set palette = sectorPalette[plot.sector] ?? {'facade': '#1b2439', 'stroke': '#424754', 'window': '#adc6ff'} %}
									{% set cols = plot.windowColumns %}
									{% set isOwned = userHoldings[plot.ticker] is defined %}
									{% set holding = userHoldings[plot.ticker] ?? null %}
									<g class="plot"
										data-district-target="plot"
										data-plot="{{ plot.plotId }}"
										data-row="{{ plot.row }}"
										data-ground-line="{{ plot.groundLine }}"
										data-condition="{{ plot.condition }}"
										data-ticker="{{ plot.ticker }}"
										data-name="{{ plot.name }}"
										data-rank="{{ plot.rank }}"
										data-sector="{{ plot.sector }}"
										data-industry="{{ plot.industry }}"
										data-importance="{{ plot.systemicImportance }}"
										data-rating="{{ plot.creditRating }}"
										data-price="{{ plot.price }}"
										data-mcap="{{ plot.marketCap }}"
										data-roc="{{ plot.returnOnCapital }}"
										data-baseline-roc="{{ plot.baselineReturnOnCapital }}"
										data-return-field="{{ plot.returnField }}"
										data-lit-share="{{ plot.litShare }}"
										data-change="{{ plot.changePercent is null ? '' : plot.changePercent }}"
										data-blurb="{{ plot.blurb|e('html_attr') }}"
										data-owned="{{ isOwned ? 'true' : 'false' }}"
										data-position-qty="{{ isOwned ? holding.quantity : '0' }}"
										data-position-short="{{ isOwned and holding.isShort ? 'true' : 'false' }}"
										data-action="click->district#select keydown.enter->district#select mouseenter->district#showTooltip mouseleave->district#hideTooltip"
										tabindex="0"
										role="button"
										aria-label="{{ plot.name }} ({{ plot.ticker }}), rank {{ plot.rank }}{{ isOwned ? ', you hold ' ~ holding.quantity ~ (holding.isShort ? ' shares short' : ' shares') : '' }}">

										<rect class="facade"
											x="{{ plot.x }}" y="{{ plot.y }}"
											width="{{ plot.width }}" height="{{ plot.height }}"
											fill="{{ palette.facade }}" stroke="{{ palette.stroke }}"/>

										<rect class="roofline"
											x="{{ plot.x - 5 }}" y="{{ plot.y - 7 }}"
											width="{{ plot.width + 10 }}" height="7"/>

										{% if cols > 0 %}
											<g clip-path="url(#above-ground-{{ rowIndex }})">
											<g class="plot-windows" transform="translate({{ plot.x }} {{ plot.y }})">
												{% for row in 0..(plot.floors - 1) %}
													{% for col in 0..(cols - 1) %}
														{% set phase = plot.twinklePhases[row][col] %}
														<rect class="window" fill="{{ palette.window }}"
															data-lit="{{ plot.litWindows[row][col] ? 'true' : 'false' }}"
															data-key="{{ plot.windowKeys[row][col] }}"
															{%- if phase is not null %} data-twinkle="true" style="animation-duration:{{ window.twinklePeriod }}s;animation-delay:-{{ (phase * window.twinklePeriod)|number_format(2, '.', '') }}s"{% endif %}
															x="{{ plot.windowInset + col * window.pitch }}" y="{{ firstFloorInset + row * floorHeight }}"
															width="{{ window.width }}" height="{{ window.height }}"/>
													{% endfor %}
												{% endfor %}
											</g>
											</g>

											{# Roof furniture by business model, right-anchored clear of the badge —
											   see App\Data\DistrictMap::ROOF_FURNITURE_EAST_MARGIN. #}
											{% set furnitureX = plot.x + plot.width - roofFurniture.eastMargin - roofFurniture.width %}
											<use class="roof-furniture" href="#roof-{{ plot.roofFurniture }}"
												x="{{ furnitureX }}" y="{{ plot.y - 7 - roofFurniture.height }}"
												width="{{ roofFurniture.width }}" height="{{ roofFurniture.height }}"
												style="color: {{ palette.window }}"/>

											{% if plot.systemicImportance == 'titan' and plot.condition != 'ruin' %}
												<circle class="beacon" cx="{{ plot.x + plot.width / 2 }}" cy="{{ plot.y - 20 }}" r="9"/>
											{% endif %}

											{# One reusable burst per building, fired and coloured by district_controller.js
											   when a live event lands on this ticker. #}
											<circle class="event-flare" data-district-target="flare" data-flare-for="{{ plot.ticker }}"
												cx="{{ plot.x + plot.width / 2 }}" cy="{{ plot.y - 34 }}" r="6"/>

											{# Rank rides the roofline's west end, the event badge its east end — the
											   kerb below has no width to spare for either alongside the ticker. #}
											<text class="plot-rank" data-district-target="rank" data-rank-for="{{ plot.ticker }}"
												x="{{ plot.x + 4 }}" y="{{ plot.y - 14 }}">#{{ plot.rank }}</text>

											{# Position pennant on the roof of a building the player holds. Geometry is
											   App\Data\DistrictMap::POSITION_PENNANT_*; movePennant() in district_controller.js
											   redraws it from the same figures when the facade resizes. #}
											{% if isOwned %}
												{% set poleX = plot.x + positionPennant.inset %}
												{% set poleTop = plot.y - 14 - positionPennant.height - 6 %}
												{% set pennantColour = holding.isShort ? '#ffd9a0' : '#4edea3' %}
												<g class="plot-pennant" data-district-target="pennant" data-pennant-for="{{ plot.ticker }}">
													<line x1="{{ poleX }}" y1="{{ plot.y - 14 }}" x2="{{ poleX }}" y2="{{ poleTop }}"
														stroke="{{ pennantColour }}" stroke-width="2"/>
													<polygon points="{{ poleX }},{{ poleTop }} {{ poleX + positionPennant.width }},{{ poleTop + positionPennant.height / 2 }} {{ poleX }},{{ poleTop + positionPennant.height }}"
														fill="{{ pennantColour }}" opacity="0.95"/>
													<circle cx="{{ poleX }}" cy="{{ poleTop }}" r="2" fill="#dae2fd"/>
												</g>
											{% endif %}

											{# On the roofline, not the kerb: a narrow plot has no room beside
											   the ticker plate. Counts only the events inside the badge window
											   (DistrictEventFeed marks them `recent`), not the whole backfill —
											   the client re-counts on a timer so the badge ages out. #}
											{% set recentCount = events[plot.ticker]|default([])|filter(e => e.recent)|length %}
											<g class="event-badge" data-district-target="badge" data-badge-for="{{ plot.ticker }}"
												data-count="{{ recentCount }}">
												<circle cx="{{ plot.x + plot.width - 6 }}" cy="{{ plot.y - 18 }}" r="15"/>
												<text data-district-target="badgeCount"
													x="{{ plot.x + plot.width - 6 }}" y="{{ plot.y - 18 }}"
													text-anchor="middle" dominant-baseline="central">{{ recentCount }}</text>
											</g>
										{% endif %}
									</g>
								{% endfor %}
							</g>
						{% endfor %}
					</g>

					{# Every row's kerb. Opaque, so a lower-row conduit drop passes behind the upper
					   kerb rather than showing through the pavement. #}
					{% for rowGroundLine in rowGroundLines %}
						<rect x="0" y="{{ rowGroundLine }}" width="{{ viewboxWidth }}" height="{{ kerbDepth }}" fill="#0b1120"/>
						<line x1="0" y1="{{ rowGroundLine }}" x2="{{ viewboxWidth }}" y2="{{ rowGroundLine }}" stroke="#424754" stroke-width="3"/>
						<line x1="0" y1="{{ rowGroundLine + kerbDepth }}" x2="{{ viewboxWidth }}" y2="{{ rowGroundLine + kerbDepth }}"
							stroke="#424754" stroke-width="1.5" opacity="0.35"/>
					{% endfor %}

					{# Terrace embankment retaining wall beneath the upper row's kerb #}
					{% if rowGroundLines|length > 1 %}
						{% set upperKerbBottom = rowGroundLines[0] + kerbDepth %}
						<g id="terrace-embankment" aria-hidden="true">
							<rect x="0" y="{{ upperKerbBottom }}" width="{{ viewboxWidth }}" height="{{ terraceWallHeight }}" fill="url(#terrace-wall-grad)"/>
							<line x1="0" y1="{{ upperKerbBottom + terraceWallHeight / 2 }}" x2="{{ viewboxWidth }}" y2="{{ upperKerbBottom + terraceWallHeight / 2 }}"
								stroke="#28344e" stroke-width="1" stroke-dasharray="60 30 90 40" opacity="0.6"/>
							<line x1="0" y1="{{ upperKerbBottom + terraceWallHeight }}" x2="{{ viewboxWidth }}" y2="{{ upperKerbBottom + terraceWallHeight }}"
								stroke="#364566" stroke-width="1.5" opacity="0.8"/>
						</g>
					{% endif %}

					{# Kerb lights: a pool in the sector colour on the pavement under each plate,
					   clipped to the kerb band — see App\Data\DistrictMap::KERB_LIGHT_DEPTH. #}
					<g id="kerb-lights" aria-hidden="true">
						{% for plot in plots %}
							<ellipse class="kerb-light" data-district-target="kerbLight" data-light-for="{{ plot.ticker }}"
								clip-path="url(#kerb-band-{{ plot.row }})"
								cx="{{ plot.x + plot.width / 2 }}" cy="{{ plot.groundLine }}"
								rx="{{ plot.width / 2 + 10 }}" ry="{{ kerbLight.depth }}"
								fill="url(#kerb-glow-{{ kerbGlowIds[plot.sector] ?? 0 }})"/>
						{% endfor %}
					</g>

					{# Frontage plates sit on each row's kerb.
					   Three stacked, centred lines rather than two left/right pairs: the narrowest
					   plot is 100 units, and a price and a change set side by side run to ~218,
					   so the pairs collided on every base-tier plot. #}
					<g id="plot-labels">
						{% for plot in plots %}
							{% set centre = plot.x + plot.width / 2 %}
							<text class="plot-label" data-district-target="label" data-label-for="{{ plot.ticker }}"
								x="{{ centre }}" y="{{ plot.groundLine + 30 }}"
								text-anchor="middle">{{ plot.ticker }}</text>

							<text class="plot-price" data-district-target="kerbPrice" data-price-for="{{ plot.ticker }}"
								x="{{ centre }}" y="{{ plot.groundLine + 60 }}"
								text-anchor="middle">${{ plot.price|number_format(2) }}</text>

							<text class="plot-change" data-district-target="kerbChange" data-change-for="{{ plot.ticker }}"
								x="{{ centre }}" y="{{ plot.groundLine + 88 }}"
								text-anchor="middle"
								data-direction="{{ plot.changePercent is null ? 'flat' : (plot.changePercent > 0 ? 'up' : (plot.changePercent < 0 ? 'down' : 'flat')) }}"
								>{% if plot.changePercent is null %}&mdash;{% else %}{{ plot.changePercent > 0 ? '+' : '' }}{{ (plot.changePercent * 100)|number_format(1) }}%{% endif %}</text>
						{% endfor %}
					</g>

					{# Sector brackets: a rule in the sector's colour under each run of adjacent
					   same-sector plots, named where the run is wide enough to carry it — see
					   App\Service\District\DistrictMapBuilder::buildSectorRuns(). #}
					<g id="sector-runs" aria-hidden="true">
						{% for run in sectorRuns %}
							{% set palette = sectorPalette[run.sector] ?? {'facade': '#1b2439', 'stroke': '#424754', 'window': '#adc6ff'} %}
							{% set groundLine = rowGroundLines[run.row] %}
							<g class="sector-run" data-district-target="sectorRun" data-sector="{{ run.sector }}">
								<line class="sector-rule" stroke="{{ palette.window }}"
									x1="{{ run.x }}" y1="{{ groundLine + sectorBracket.ruleOffset }}"
									x2="{{ run.x + run.width }}" y2="{{ groundLine + sectorBracket.ruleOffset }}"/>
								{% if run.label %}
									<text class="sector-label" fill="{{ palette.window }}"
										x="{{ run.x + run.width / 2 }}" y="{{ groundLine + sectorBracket.labelOffset }}"
										text-anchor="middle">{{ run.label|upper }}</text>
								{% endif %}
							</g>
						{% endfor %}
					</g>

					{# Tooltip last, so it paints above every other layer. #}
					<g id="plot-tooltip" data-district-target="tooltip" data-visible="false">
						<rect class="tooltip-bg" x="0" y="0" width="520" height="210"/>
						<text class="tt-ticker" data-district-target="tooltipTicker" x="20" y="46"></text>
						<text class="tt-rank" data-district-target="tooltipRank" x="500" y="46" text-anchor="end"></text>
						<text class="tt-name" data-district-target="tooltipName" x="20" y="84"></text>
						<text class="tt-meta" data-district-target="tooltipMeta" x="20" y="118"></text>
						<text class="tt-value" data-district-target="tooltipPrice" x="20" y="158"></text>
						<text class="tt-value tt-change" data-district-target="tooltipChange" x="500" y="158" text-anchor="end"></text>
						<text class="tt-meta" data-district-target="tooltipCap" x="20" y="192"></text>
						<text class="tt-meta tt-position" data-district-target="tooltipPosition" x="500" y="192" text-anchor="end" fill="#4edea3"></text>
					</g>
				</svg>
			</div>
		</div>

		{# Info Panel #}
		<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-5 xl:sticky xl:top-20">
			<div data-district-target="empty">
				<h2 class="text-sm font-semibold text-on-surface mb-2">Select a building or institution</h2>
				<p class="text-xs text-on-surface-variant leading-relaxed">
					{{ plots|length }} listed houses hold frontage on {{ wardName }}, ranked by market
					capitalisation and reshuffled as it moves. Facade height tracks that capitalisation;
					the windows carry the sector's colour, and how many are lit tracks the return on capital
					against the house's own baseline; masonry condition tracks credit standing. The
					structures along the top are the institutions publishing the macro conditions this
					street trades on &mdash; hover one to see everyone it feeds, hover a building to see
					what it draws, and a conduit reddens on its own once the variable it carries turns
					adverse. Click a sector in the legend to pick that sector out of the street.
				</p>
			</div>

			<div data-district-target="detail" class="hidden">
				<div class="flex items-baseline justify-between gap-2 mb-1">
					<span class="text-xl font-bold text-primary font-mono" data-district-target="detailTicker"></span>
					<span class="text-xs font-mono text-on-surface-variant/60" data-district-target="detailPlot"></span>
				</div>
				<h2 class="text-sm font-bold text-on-surface leading-tight" data-district-target="detailName"></h2>
				<p class="text-xs text-on-surface-variant/70 mb-4" data-district-target="detailIndustry"></p>

				<dl class="grid grid-cols-2 gap-x-3 gap-y-2.5 text-xs font-mono mb-4">
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-3xs">Price</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailPrice"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-3xs">Change (1M)</dt>
						<dd class="tabular-nums" data-district-target="detailChange"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-3xs">Market Cap</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailMcap"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-3xs">Credit</dt>
						<dd class="text-on-surface" data-district-target="detailRating"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-3xs">Return <span class="normal-case tracking-normal">vs baseline</span></dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailRoc"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-3xs">Street Rank</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailRank"></dd></div>
					<div class="col-span-2"><dt class="text-on-surface-variant/60 uppercase tracking-wider text-3xs">Standing</dt>
						<dd class="text-on-surface" data-district-target="detailImportance"></dd></div>
					<div class="col-span-2 border-t border-outline-variant/15 pt-2" data-district-target="detailPositionWrap">
						<dt class="text-on-surface-variant/60 uppercase tracking-wider text-3xs">Your Position</dt>
						<dd class="text-on-surface tabular-nums font-bold" data-district-target="detailPosition">None</dd></div>
				</dl>

				{# Segment revenue — laid out as a filing's segment note: period header, headline with
				   sequential and year-on-year moves, a 100% mix bar, then one row per stream. #}
				<div class="mb-4 border-t border-outline-variant/25 pt-3">
					<div class="flex items-center justify-between mb-1.5">
						<h3 class="text-2xs font-semibold uppercase tracking-wide text-on-surface-variant/70">Segment Revenue</h3>
						<span class="text-3xs font-mono uppercase tracking-wider text-on-surface-variant/50"
							data-district-target="detailRevenuePeriod"></span>
					</div>

					<div data-district-target="detailRevenueHeadline" class="mb-2 hidden">
						<div class="flex items-baseline gap-2 flex-wrap">
							<span class="text-lg font-mono font-bold text-on-surface tabular-nums"
								data-district-target="detailRevenueTotal"></span>
							<span class="text-2xs font-mono tabular-nums" data-district-target="detailRevenueQoq"></span>
							<span class="text-2xs font-mono tabular-nums" data-district-target="detailRevenueYoy"></span>
						</div>
						<p class="text-3xs font-mono text-on-surface-variant/50 mt-0.5"
							data-district-target="detailRevenueMeta"></p>
					</div>

					<div class="flex h-2 rounded-sm overflow-hidden bg-surface-container-high mb-3"
						data-district-target="detailRevenueMixBar"></div>

					<div class="space-y-3" data-district-target="detailRevenueMix">
						<p class="text-xs text-on-surface-variant/50 italic" data-district-target="noRevenueMix">No quarterly report filed yet.</p>
					</div>

					<p class="text-4xs text-on-surface-variant/40 mt-2.5 leading-relaxed"
						data-district-target="detailRevenueFootnote" hidden>
						Unaudited. Figures in USD as reported for the period shown. Growth quoted against the
						prior quarter and the year-ago quarter; &ldquo;n/m&rdquo; where no comparison period is on
						file. Contribution is the segment&rsquo;s share of the firm&rsquo;s sequential growth.
					</p>
				</div>

				<p class="text-xs text-on-surface-variant leading-relaxed max-h-48 overflow-y-auto custom-scrollbar pr-2 mb-4"
					data-district-target="detailBlurb"></p>

				<div class="mb-4">
					<h3 class="text-2xs font-semibold uppercase tracking-wide text-on-surface-variant/70 mb-2">Recent Events</h3>
					<div class="space-y-2 max-h-56 overflow-y-auto custom-scrollbar pr-1" data-district-target="detailEvents">
						<p class="text-xs text-on-surface-variant/50 italic" data-district-target="noEvents">No recent events logged.</p>
					</div>
				</div>

				{# Quick Trade Ticket #}
				<div class="mb-4 border-t border-outline-variant/25 pt-3">
					<div class="flex items-center justify-between mb-2">
						<h3 class="text-2xs font-semibold uppercase tracking-wide text-on-surface-variant/70">Quick Trade</h3>
						<span class="text-3xs font-mono font-semibold" data-district-target="quickTradeHolding"></span>
					</div>

					{% if app.user %}
						<form action="/trade/execute" method="POST" class="space-y-2.5"
							data-district-target="quickTradeForm"
							data-action="submit->district#onQuickTradeSubmit">
							<input type="hidden" name="ticker" data-district-target="quickTradeTickerInput" value="">
							<input type="hidden" name="_token" value="{{ csrf_token('execute_trade') }}">

							<div class="flex gap-1.5 bg-surface-container-lowest p-1 rounded border border-outline-variant/20">
								<label class="flex-1 cursor-pointer">
									<input type="radio" name="action" value="BUY" class="peer sr-only" checked
										data-action="change->district#onTradeActionChange">
									<div class="py-1 text-center text-3xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">
										Buy
									</div>
								</label>
								<label class="flex-1 cursor-pointer">
									<input type="radio" name="action" value="SELL" class="peer sr-only"
										data-action="change->district#onTradeActionChange">
									<div class="py-1 text-center text-3xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">
										Sell
									</div>
								</label>
								{% if marginEnabled %}
									<label class="flex-1 cursor-pointer">
										<input type="radio" name="action" value="SHORT" class="peer sr-only"
											data-action="change->district#onTradeActionChange">
										<div class="py-1 text-center text-3xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-tertiary peer-checked:text-on-tertiary transition-all">
											Short
										</div>
									</label>
									<label class="flex-1 cursor-pointer">
										<input type="radio" name="action" value="COVER" class="peer sr-only"
											data-action="change->district#onTradeActionChange">
										<div class="py-1 text-center text-3xs font-bold uppercase tracking-wider rounded text-on-surface-variant peer-checked:bg-secondary peer-checked:text-on-secondary transition-all">
											Cover
										</div>
									</label>
								{% endif %}
							</div>

							<div class="space-y-1">
								<div class="flex items-center justify-between text-3xs text-on-surface-variant/70 font-mono">
									<span>Quantity</span>
									<span data-district-target="quickTradeEstimate" class="text-on-surface font-bold tabular-nums">Est: $0.00</span>
								</div>
								<div class="flex items-center gap-1.5">
									<input type="number" name="quantity" min="1" max="1000000000" value="10"
										class="w-full bg-surface-container-lowest border border-outline-variant/30 rounded px-2.5 py-1 text-xs font-mono text-on-surface focus:outline-none focus:border-primary"
										data-district-target="quickTradeQuantity"
										data-action="input->district#onQuantityInput">
									<div class="flex items-center gap-1 shrink-0 font-mono text-3xs">
										<button type="button" class="px-1.5 py-1 bg-surface-container-high/70 hover:bg-surface-container-high rounded text-on-surface-variant hover:text-on-surface cursor-pointer"
											data-action="click->district#setQuickQuantity" data-quantity="10">10</button>
										<button type="button" class="px-1.5 py-1 bg-surface-container-high/70 hover:bg-surface-container-high rounded text-on-surface-variant hover:text-on-surface cursor-pointer"
											data-action="click->district#setQuickQuantity" data-quantity="50">50</button>
										<button type="button" class="px-1.5 py-1 bg-surface-container-high/70 hover:bg-surface-container-high rounded text-on-surface-variant hover:text-on-surface cursor-pointer"
											data-action="click->district#setQuickQuantity" data-quantity="100">100</button>
										<button type="button" class="px-1.5 py-1 bg-surface-container-high/70 hover:bg-surface-container-high rounded text-on-surface-variant hover:text-on-surface cursor-pointer"
											data-action="click->district#setQuickQuantityMax">Max</button>
									</div>
								</div>
							</div>

							<button type="submit"
								class="w-full py-1.5 rounded bg-primary text-on-primary text-xs font-bold uppercase tracking-wider hover:opacity-90 transition-opacity cursor-pointer flex items-center justify-center gap-1.5"
								data-district-target="quickTradeSubmit">
								<span class="material-symbols-outlined text-sm">shopping_cart</span>
								<span>Execute Order</span>
							</button>
						</form>
					{% else %}
						<div class="p-2.5 rounded bg-surface-container-lowest/60 border border-outline-variant/15 text-center">
							<p class="text-xs text-on-surface-variant/70 mb-2">Sign in to trade directly from Glasswater Row</p>
							<a href="/login" class="inline-block px-3 py-1 bg-primary text-on-primary rounded text-xs font-bold uppercase tracking-wider hover:opacity-90">Log In</a>
						</div>
					{% endif %}
				</div>

				<a href="#" data-district-target="detailLink"
					class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary hover:underline">
					<span class="material-symbols-outlined text-sm">open_in_new</span>
					Open trading file
				</a>
			</div>

			{# Institution detail, shown when a publisher is selected. #}
			<div data-district-target="institutionDetail" class="hidden">
				<div class="flex items-baseline justify-between gap-2 mb-1">
					<span class="text-sm font-bold text-primary font-mono uppercase tracking-wider" data-district-target="institutionName"></span>
					<span class="text-3xs font-mono uppercase tracking-wider px-1.5 py-0.5 rounded border"
						data-district-target="institutionStatus"></span>
				</div>
				<p class="text-xs text-on-surface-variant/70 mb-4">Macro publisher</p>

				<h3 class="text-2xs font-semibold uppercase tracking-wide text-on-surface-variant/70 mb-2">Published Readings</h3>
				<dl class="grid grid-cols-2 gap-x-3 gap-y-2.5 text-xs font-mono mb-4" data-district-target="institutionReadings"></dl>

				<h3 class="text-2xs font-semibold uppercase tracking-wide text-on-surface-variant/70 mb-2">
					Feeds <span class="text-on-surface-variant/40" data-district-target="institutionFeedCount"></span>
				</h3>
				<div class="flex flex-wrap gap-1.5" data-district-target="institutionFeeds"></div>
			</div>
		</div>
	</div>
</div>
</turbo-frame>
{% endblock %}
