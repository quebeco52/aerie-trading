{% extends 'base.html.twig' %}

{% block title %}{{ wardName }} | Aerie District{% endblock %}

{% block stylesheets %}
<style>
	/* Stroke widths throughout are sized for the street's rendered scale (~0.45px per user unit):
	   anything under ~2.5 units lands below one device pixel and stops reading as a line. */
	.plot { cursor: pointer; }
	.facade {
		stroke-width: 2.5;
		transition: y 600ms ease-out, height 600ms ease-out, fill 300ms ease-out;
	}
	.plot-windows { transition: transform 600ms ease-out; }
	/* Lit share tracks return on capital against baseline — see DistrictMap::WINDOW_LIT_SHARE_AT_BASELINE.
	   Dark windows stay faintly visible so the facade keeps its texture. */
	.window { opacity: 0.08; }
	.window[data-lit="true"] { opacity: 0.5; }
	/* A few lit windows drift slowly — see DistrictMap::WINDOW_TWINKLE_SHARE. Animated on
	   fill-opacity, not opacity, so the hover and condition rules still apply on top. */
	.window[data-lit="true"][data-twinkle="true"] { animation: window-twinkle ease-in-out infinite; }
	@keyframes window-twinkle { 0%, 100% { fill-opacity: 1; } 50% { fill-opacity: 0.35; } }
	.roofline { transition: y 600ms ease-out, fill 300ms ease-out; fill: #4a5266; }

	/* Condition outranks the sector hue — solvency is the more urgent fact. */
	/* Condition recolours the windows but leaves the lit pattern alone — a distressed tenant
	   that still earns its baseline keeps its lights on, in the condition's hue. */
	.plot[data-condition="distressed"] .facade { fill: #37291d !important; stroke: #a37b3d !important; }
	.plot[data-condition="distressed"] .window { fill: #ffd9a0 !important; }
	.plot[data-condition="distressed"] .window[data-lit="true"] { opacity: 0.30; }
	.plot[data-condition="distressed"] .roofline { fill: #6b5a3d; }

	.plot[data-condition="ruin"] .facade { fill: #241a24 !important; stroke: #8c4b4b !important; stroke-dasharray: 10 7; }
	.plot[data-condition="ruin"] .window { fill: #ffb3ad !important; opacity: 0.04; }
	.plot[data-condition="ruin"] .window[data-lit="true"] { opacity: 0.10; }
	.plot[data-condition="ruin"] .roofline { fill: #5c3030; }

	.plot:hover .facade { fill: #2c3854 !important; }
	.plot:hover .window[data-lit="true"] { opacity: 0.85; }
	.plot:hover .window:not([data-lit="true"]) { opacity: 0.18; }
	.plot[data-selected="true"] .facade { stroke: #adc6ff !important; stroke-width: 5; }
	.plot[data-selected="true"] .window[data-lit="true"] { opacity: 0.95; }

	/* Sector filter: a legend chip dims every tenant outside its sector, plates and brackets included. */
	.plot[data-dimmed="true"], .plot-label[data-dimmed="true"], .plot-rank[data-dimmed="true"],
	.plot-price[data-dimmed="true"], .plot-change[data-dimmed="true"], .sector-run[data-dimmed="true"] {
		opacity: 0.18;
		transition: opacity 200ms;
	}

	.plot[data-tick="up"] .roofline { fill: #4edea3; }
	.plot[data-tick="down"] .roofline { fill: #ffb3ad; }

	/* Sized against the narrowest plot (100 units): a 5-character ticker at 30 is 90 units, a
	   price at 22 is 92, a change at 22 is 79. Each fits alone on a centred line; no two fit
	   side by side, so they are never paired. */
	.plot-rank { fill: #7a8398; font-size: 24px; letter-spacing: 0.5px; transition: fill 300ms; }
	/* Street rank is re-ranked from live caps; a plate that just moved shows its direction for a moment. */
	.plot-rank[data-rank-move="up"] { fill: #4edea3; }
	.plot-rank[data-rank-move="down"] { fill: #ffb3ad; }
	.plot-label { fill: #dae2fd; font-size: 30px; letter-spacing: 1px; transition: fill 200ms; }
	.plot-price { fill: #9aa3b8; font-size: 22px; letter-spacing: 0.5px; }
	.plot-change { font-size: 22px; font-weight: bold; letter-spacing: 0.5px; }
	.plot-change[data-direction="up"] { fill: #4edea3; }
	.plot-change[data-direction="down"] { fill: #ffb3ad; }
	.plot-change[data-direction="flat"] { fill: #838da3; }
	.plot-label[data-selected="true"], .plot-rank[data-selected="true"] { fill: #adc6ff; }

	/* Sector brackets along the kerb — one rule per run of adjacent same-sector plots. */
	.sector-run .sector-rule { stroke-width: 3; opacity: 0.7; }
	.sector-run .sector-label { font-size: 20px; letter-spacing: 1.5px; opacity: 0.75; }

	.gridline { stroke: #2b3550; stroke-width: 2; stroke-dasharray: 4 12; opacity: 0.55; }
	.gridline-label { fill: #6b7690; font-size: 32px; letter-spacing: 0.5px; opacity: 0.75; }

	/* Roof furniture: one pictogram per trade (DistrictMap::ROOF_FURNITURE_BY_INDUSTRY), in the
	   sector's window colour so it is legible at the street's scale; condition recolours it the
	   way it recolours the windows. */
	.roof-furniture { transition: y 600ms ease-out, color 300ms; opacity: 0.85; }
	.plot[data-condition="distressed"] .roof-furniture { color: #ffd9a0 !important; }
	.plot[data-condition="ruin"] .roof-furniture { color: #ffb3ad !important; opacity: 0.3; }

	/* Titan marker. Scoped to .plot so it cannot leak onto the institution beacons — an earlier
	   version shared one .beacon rule, and a running animation outranks a plain opacity:0, so
	   every institution pulsed an alarm-coloured dot permanently whether stressed or not. */
	.plot .beacon { fill: #ffd9a0; animation: beacon-pulse 2.4s ease-in-out infinite; }
	@keyframes beacon-pulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

	/* Kerb lights: a pool in the sector colour under each plate — see DistrictMap::KERB_LIGHT_DEPTH. */
	.kerb-light { pointer-events: none; }
	.kerb-light[data-dimmed="true"] { opacity: 0.18; transition: opacity 200ms; }


	/* --- Institutions --- */
	.institution { cursor: pointer; }
	.institution .pediment, .institution .body {
		fill: #232c42;
		stroke: #4a5568;
		stroke-width: 2.5;
		transition: fill 300ms, stroke 300ms;
	}
	.institution .column { stroke: #56617a; stroke-width: 3; opacity: 0.5; }
	.institution-beacon { fill: #ffb3ad; opacity: 0; transition: opacity 300ms; }
	.institution-label {
		fill: #8891a8;
		font-size: 30px;
		letter-spacing: 1px;
		opacity: 0.7;
		transition: opacity 200ms, fill 200ms;
	}
	.institution-readout { font-size: 26px; }
	.readout-label { fill: #838da3; letter-spacing: 0.5px; }
	.readout-value { fill: #adc6ff; font-weight: bold; }
	/* Recent readings under each value, drawn client-side from the ticks seen — see
	   DistrictMap::INSTITUTION_SPARKLINE_WIDTH. Empty until a second sample lands. */
	.readout-spark { fill: none; stroke: #56617a; stroke-width: 2; stroke-linejoin: round; opacity: 0.8; }
	.readout-spark-base { stroke: #2b3550; stroke-width: 1.5; opacity: 0.6; }
	.institution[data-stressed="true"] .readout-spark { stroke: #ffb3ad; }

	.institution:hover .pediment, .institution:hover .body { fill: #2c3854; }
	.institution[data-selected="true"] .pediment, .institution[data-selected="true"] .body {
		stroke: #adc6ff;
		stroke-width: 5;
	}
	.institution[data-selected="true"] .institution-label { opacity: 1; fill: #adc6ff; }

	.institution[data-stressed="true"] .pediment, .institution[data-stressed="true"] .body {
		fill: #3a2a2e;
		stroke: #a35c5c;
	}
	.institution[data-stressed="true"] .institution-beacon { opacity: 1; animation: beacon-pulse 2.4s ease-in-out infinite; }
	.institution[data-stressed="true"] .institution-label { opacity: 1; fill: #ffb3ad; }
	.institution[data-stressed="true"] .readout-value { fill: #ffb3ad; }

	/* --- Conduits --- */
	/* Routed orthogonally along one lane per institution (see DistrictMap::CONDUIT_LANE_PITCH).
	   Barely there at rest — the lane structure shows, the wiring does not — and revealed by
	   hovering either end: an institution lights everything it feeds, a building everything it
	   draws. A stressed institution's lines stay lit on their own. The two institutions with no
	   stress rules are reachable through hover, which is why the resting state need not be. */
	.conduit {
		fill: none;
		stroke: #3a4260;
		stroke-width: 3;
		stroke-linejoin: round;
		stroke-dasharray: 10 9;
		opacity: 0.12;
		transition: opacity 300ms, stroke 300ms;
	}
	.conduit[data-hover="true"] {
		opacity: 0.85;
		stroke: #8fa5d6;
	}
	.conduit[data-stressed="true"] {
		opacity: 0.75;
		stroke: #ffb3ad;
		animation: conduit-flow 1.4s linear infinite;
	}
	.conduit[data-highlighted="true"] {
		opacity: 0.95;
		stroke: #adc6ff;
		stroke-width: 4;
	}
	@keyframes conduit-flow { to { stroke-dashoffset: -38; } }

	/* --- Event Flares & Badges --- */
	.event-flare { opacity: 0; pointer-events: none; fill: #adc6ff; }
	.event-flare[data-flash="true"] { animation: flare-burst 900ms ease-out; }
	@keyframes flare-burst {
		0%   { opacity: 0.95; r: 6; }
		55%  { opacity: 0.45; r: 30; }
		100% { opacity: 0; r: 40; }
	}

	.event-badge { opacity: 0; transition: opacity 200ms; pointer-events: none; }
	.event-badge:not([data-count="0"]) { opacity: 1; }
	.event-badge circle { fill: #171f33; stroke: #56617a; stroke-width: 2.5; }
	.event-badge text { fill: #c2c6d6; font-size: 26px; font-weight: bold; }
	.event-badge[data-flash="true"] circle { animation: badge-pop 500ms ease-out; }
	@keyframes badge-pop {
		0%   { stroke: #ffb3ad; }
		100% { stroke: #56617a; }
	}

	/* Labels drawn inside the map. CSS beats an SVG presentation attribute, so this is the
	   single place the street's type is set — it tracks --font-mono in assets/styles/app.css. */
	.district-map text { font-family: var(--font-mono); }

	/* --- Hover tooltip --- */
	/* Drawn in SVG rather than as an HTML bubble: the map card clips on overflow, which would
	   cut an absolutely-positioned tooltip off at the card edge. */
	#plot-tooltip { pointer-events: none; opacity: 0; transition: opacity 140ms; }
	#plot-tooltip[data-visible="true"] { opacity: 1; }
	#plot-tooltip .tooltip-bg { fill: #0f172a; stroke: #56617a; stroke-width: 2.5; rx: 10; }
	#plot-tooltip text { font-family: var(--font-mono); }
	#plot-tooltip .tt-ticker { fill: #adc6ff; font-size: 34px; font-weight: bold; }
	#plot-tooltip .tt-rank { fill: #6b7690; font-size: 26px; }
	#plot-tooltip .tt-name { fill: #dae2fd; font-size: 26px; }
	#plot-tooltip .tt-meta { fill: #838da3; font-size: 24px; }
	#plot-tooltip .tt-value { fill: #dae2fd; font-size: 28px; font-weight: bold; }
	#plot-tooltip .tt-change[data-direction="up"] { fill: #4edea3; }
	#plot-tooltip .tt-change[data-direction="down"] { fill: #ffb3ad; }
	#plot-tooltip .tt-change[data-direction="flat"] { fill: #838da3; }

	/* Position pennant & owned building styling */
	.plot[data-owned="true"] .facade { stroke: #4edea3 !important; stroke-width: 3.5; }
	.plot[data-owned="true"][data-position-short="true"] .facade { stroke: #ffd9a0 !important; }
	.plot[data-owned="true"] .plot-rank { fill: #4edea3; font-weight: bold; }
	.plot-pennant { pointer-events: none; }

	/* Conduit mode display */
	.district-map[data-conduit-mode="muted"] .conduit { display: none !important; }
	.district-map[data-conduit-mode="stressed"] .conduit:not([data-stressed="true"]) { opacity: 0.02 !important; }
	.district-map[data-conduit-mode="focused"] .conduit:not([data-highlighted="true"]):not([data-hover="true"]) { opacity: 0.02 !important; }

	@media (prefers-reduced-motion: reduce) {
		.plot .beacon { animation: none; opacity: 0.75; }
		.window[data-lit="true"][data-twinkle="true"] { animation: none; }
		.roof-furniture { transition: none; }
		.institution[data-stressed="true"] .institution-beacon { animation: none; opacity: 1; }
		.facade, .plot-windows, .roofline, .institution .pediment, .institution .body, .conduit,
		#plot-tooltip { transition: none; animation: none; }
		.event-flare[data-flash="true"] { animation: none; opacity: 0.6; }
		.event-badge[data-flash="true"] circle { animation: none; }
	}
</style>
{% endblock %}

{% block body %}
{# The frame is what a reconstitution reloads: the district controller points it at this page's
   URL when the live feed announces a new roster, and Stimulus reconnects against the freshly
   rendered street. Selection and plot positions ride across in sessionStorage — see
   reconstitute() and settleReconstitution() in district_controller.js. target="_top" so the
   stock-page link and the quick-trade form inside it still drive the whole page, not the frame. #}
<turbo-frame id="district-ward" target="_top">
<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5"
	data-controller="district"
	data-district-shares-value="{{ shares|json_encode|e('html_attr') }}"
	data-district-envelope-value="{{ envelope|json_encode|e('html_attr') }}"
	data-district-lighting-value="{{ lighting|json_encode|e('html_attr') }}"
	data-district-condition-value="{{ condition|json_encode|e('html_attr') }}"
	data-district-events-value="{{ events|json_encode|e('html_attr') }}"
	data-district-event-badge-window-seconds-value="{{ eventBadgeWindowSeconds }}"
	data-district-revenue-mix-value="{{ revenueMix|json_encode|e('html_attr') }}"
	data-district-institutions-value="{{ institutions|map(i => {id: i.id, label: i.label, readouts: i.readouts, stressRules: i.stressRules, fields: i.fields})|json_encode|e('html_attr') }}"
	data-district-user-holdings-value="{{ userHoldings|json_encode(constant('JSON_FORCE_OBJECT'))|e('html_attr') }}"
	data-district-user-cash-value="{{ userCash }}"
	data-district-margin-enabled-value="{{ marginEnabled ? 'true' : 'false' }}"
	data-district-position-pennant-value="{{ positionPennant|json_encode|e('html_attr') }}"
	data-district-reconstitution-value="{{ reconstitution|json_encode|e('html_attr') }}">

	{# Hero #}
	<div class="bg-surface-container-low rounded-lg p-5 md:p-6 border border-outline-variant/25">
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
			<div>
				<div class="flex items-center gap-2 mb-2">
					<span class="text-2xs font-semibold tracking-wide text-primary uppercase">Aerie Autonomous District</span>
					<span class="text-xs text-on-surface-variant/60 font-mono">/ Top {{ rosterSize }} by market cap</span>
				</div>
				<h1 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight">{{ wardName }}</h1>
				<p class="text-xs text-on-surface-variant mt-1 max-w-2xl">{{ wardTagline }}</p>
				{# Shown for a while after a live reconstitution reloads the street. #}
				<p class="text-xs font-mono mt-2 px-2 py-1 rounded bg-primary/10 text-primary border border-primary/25 inline-block"
					data-district-target="reconstitutionNotice" hidden></p>
			</div>
			<div class="flex flex-col gap-2 text-xs font-mono text-on-surface-variant shrink-0">
				<div class="flex items-center gap-4 flex-wrap">
					<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:#4edea3;border:1px solid #14532d"></span>Position held</span>
					<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:#37291d;border:1px solid #a37b3d"></span>Distressed</span>
					<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:#241a24;border:1px dashed #8c4b4b"></span>Defunct</span>
					<span class="flex items-center gap-1.5"><span class="w-3 h-0.5" style="background:#ffb3ad"></span>Conduit stressed</span>
				</div>
			</div>
		</div>

		{# Street summary — every figure read off plots already built, no extra query #}
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mt-5">
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between">
				<span class="text-2xs font-semibold text-on-surface-variant uppercase tracking-wide">Street Cap</span>
				<span class="text-sm font-bold text-on-surface font-mono tabular-nums mt-1">${{ summary.totalMarketCap|format_large }}</span>
			</div>
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between">
				<span class="text-2xs font-semibold text-on-surface-variant uppercase tracking-wide">Street 1M</span>
				{% if summary.changePercent is not null %}
					<span class="text-sm font-bold font-mono tabular-nums mt-1 {{ summary.changePercent >= 0 ? 'text-secondary' : 'text-tertiary' }}">
						{{ summary.changePercent >= 0 ? '+' : '' }}{{ (summary.changePercent * 100)|number_format(2) }}%
					</span>
				{% else %}
					<span class="text-sm font-bold text-on-surface-variant/50 font-mono mt-1">&mdash;</span>
				{% endif %}
			</div>
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between">
				<span class="text-2xs font-semibold text-on-surface-variant uppercase tracking-wide">Biggest Mover</span>
				{% if summary.biggestMover %}
					<span class="text-sm font-bold font-mono tabular-nums mt-1 {{ summary.biggestMover.changePercent >= 0 ? 'text-secondary' : 'text-tertiary' }}">
						{{ summary.biggestMover.ticker }}
						{{ summary.biggestMover.changePercent >= 0 ? '+' : '' }}{{ (summary.biggestMover.changePercent * 100)|number_format(1) }}%
					</span>
				{% else %}
					<span class="text-sm font-bold text-on-surface-variant/50 font-mono mt-1">&mdash;</span>
				{% endif %}
			</div>
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between">
				<span class="text-2xs font-semibold text-on-surface-variant uppercase tracking-wide">Institutions</span>
				<span class="text-sm font-bold font-mono tabular-nums mt-1 {{ summary.stressedInstitutions > 0 ? 'text-tertiary' : 'text-on-surface' }}"
					data-district-target="summaryStress">
					{{ summary.stressedInstitutions }}/{{ summary.totalInstitutions }} stressed
				</span>
			</div>
			{# The roster is frozen between reconstitutions (DistrictRoster); this counts down to the
			   next one in simulated days, kept live from the tick count on the feed. #}
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between"
				title="The street's roster is re-ranked once a simulated quarter. Until then a bankrupt tenant keeps its plot and a riser waits below the cut.">
				<span class="text-2xs font-semibold text-on-surface-variant uppercase tracking-wide">Reconstitution</span>
				<span class="text-sm font-bold text-on-surface font-mono tabular-nums mt-1"
					data-district-target="summaryReconstitution">in {{ reconstitution.simDaysUntilNext|round(0, 'ceil') }}d</span>
			</div>
		</div>

		{# Sector legend — the street's primary colour signal. Each chip is a filter: click to dim
		   every other sector, click again (or press Escape) to clear. #}
		<div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-4 pt-4 border-t border-outline-variant/15">
			{% for sector, colours in sectorPalette %}
				<button type="button"
					class="cursor-pointer flex items-center gap-1.5 text-xs font-mono text-on-surface-variant/80 rounded px-1 -mx-1 hover:text-on-surface data-[active=true]:text-on-surface data-[active=true]:bg-surface-container-high data-[muted=true]:opacity-40"
					data-district-target="sectorChip"
					data-sector="{{ sector }}"
					data-action="click->district#toggleSector"
					aria-pressed="false"
					title="Show only {{ sector }}">
					<span class="w-2.5 h-2.5 rounded-full" style="background:{{ colours.window }}"></span>{{ sector }}
				</button>
			{% endfor %}
		</div>
	</div>

	<div class="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-5 items-start">

		{# The Elevation #}
		<div class="bg-surface-container-lowest border border-outline-variant/25 rounded-lg overflow-hidden">
			<div class="flex items-center justify-between px-4 py-2 border-b border-outline-variant/15 bg-surface-container-high/20">
				<span class="text-sm font-semibold text-on-surface-variant">Street Elevation &mdash; facing north</span>
				<div class="flex items-center gap-3">
					<span class="text-xs font-mono text-on-surface-variant/60 hidden sm:block">Height &prop; log market capitalisation, scaled to this street</span>
					<div class="flex items-center gap-1">
						<div class="flex items-center gap-0.5 text-3xs font-mono border-r border-outline-variant/20 pr-2 mr-1">
							<span class="text-on-surface-variant/50 uppercase tracking-wider mr-1 hidden md:inline">Conduits:</span>
							<button type="button" class="px-1.5 py-0.5 rounded text-on-surface-variant data-[active=true]:bg-primary/20 data-[active=true]:text-primary data-[active=true]:font-bold cursor-pointer"
								data-district-target="conduitModeBtn"
								data-mode="all"
								data-action="click->district#setConduitMode"
								data-active="true"
								title="Show all conduits">All</button>
							<button type="button" class="px-1.5 py-0.5 rounded text-on-surface-variant hover:bg-surface-container-high data-[active=true]:bg-tertiary/20 data-[active=true]:text-tertiary data-[active=true]:font-bold cursor-pointer"
								data-district-target="conduitModeBtn"
								data-mode="stressed"
								data-action="click->district#setConduitMode"
								data-active="false"
								title="Show stressed conduits only">Stressed</button>
							<button type="button" class="px-1.5 py-0.5 rounded text-on-surface-variant hover:bg-surface-container-high data-[active=true]:bg-secondary/20 data-[active=true]:text-secondary data-[active=true]:font-bold cursor-pointer"
								data-district-target="conduitModeBtn"
								data-mode="focused"
								data-action="click->district#setConduitMode"
								data-active="false"
								title="Show conduits only for selected/hovered tenant">Focused</button>
							<button type="button" class="px-1.5 py-0.5 rounded text-on-surface-variant hover:bg-surface-container-high data-[active=true]:bg-surface-container-highest data-[active=true]:font-bold cursor-pointer"
								data-district-target="conduitModeBtn"
								data-mode="muted"
								data-action="click->district#setConduitMode"
								data-active="false"
								title="Hide conduits">Off</button>
						</div>
						<button type="button" data-action="click->district#zoomOut" title="Zoom out"
							class="cursor-pointer w-6 h-6 flex items-center justify-center rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface">
							<span class="material-symbols-outlined text-base">zoom_out</span>
						</button>
						<button type="button" data-action="click->district#fitToWidth" title="Fit whole street"
							class="cursor-pointer w-6 h-6 flex items-center justify-center rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface">
							<span class="material-symbols-outlined text-base">fit_screen</span>
						</button>
						<button type="button" data-action="click->district#zoomIn" title="Zoom in"
							class="cursor-pointer w-6 h-6 flex items-center justify-center rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface">
							<span class="material-symbols-outlined text-base">zoom_in</span>
						</button>
					</div>
				</div>
			</div>

			<div class="overflow-x-auto custom-scrollbar">
				<svg viewBox="0 0 {{ viewboxWidth }} {{ viewboxHeight }}"
					data-district-target="svg"
					data-action="click->district#deselect keydown.esc->district#deselect"
					class="district-map block min-w-250 w-full h-auto"
					role="img"
					aria-label="Illustrated street elevation of {{ wardName }}">

					<defs>
						{# One clip per row: a single one at the upper ground line would clip the lower row's windows away entirely. #}
						{% for rowIndex, rowGroundLine in rowGroundLines %}
							<clipPath id="above-ground-{{ rowIndex }}">
								<rect x="0" y="0" width="{{ viewboxWidth }}" height="{{ rowGroundLine }}"/>
							</clipPath>
						{% endfor %}
						<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#050b1a"/>
							<stop offset="55%" stop-color="#0d1526"/>
							<stop offset="100%" stop-color="#161f36"/>
						</linearGradient>

						{# One kerb clip per row: a light pool is a full ellipse centred on the ground
						   line, and only its lower half belongs on the pavement. #}
						{% for rowIndex, rowGroundLine in rowGroundLines %}
							<clipPath id="kerb-band-{{ rowIndex }}">
								<rect x="0" y="{{ rowGroundLine }}" width="{{ viewboxWidth }}" height="{{ kerbDepth }}"/>
							</clipPath>
						{% endfor %}

						{# One kerb-light gradient per sector colour, plus the fallback. #}
						{% set kerbGlowIds = {} %}
						{% for sector, colours in sectorPalette %}
							{% set kerbGlowIds = kerbGlowIds|merge({(sector): loop.index}) %}
							<radialGradient id="kerb-glow-{{ loop.index }}">
								<stop offset="0%" stop-color="{{ colours.window }}" stop-opacity="{{ kerbLight.opacity }}"/>
								<stop offset="100%" stop-color="{{ colours.window }}" stop-opacity="0"/>
							</radialGradient>
						{% endfor %}
						<radialGradient id="kerb-glow-0">
							<stop offset="0%" stop-color="#adc6ff" stop-opacity="{{ kerbLight.opacity }}"/>
							<stop offset="100%" stop-color="#adc6ff" stop-opacity="0"/>
						</radialGradient>
						<linearGradient id="terrace-wall-grad" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#1c253b"/>
							<stop offset="40%" stop-color="#131b2c"/>
							<stop offset="100%" stop-color="#0b1120"/>
						</linearGradient>

						{# Roof furniture, one symbol per DistrictMap::ROOF_FURNITURE_SYMBOLS, each drawn in a
						   30×36 box with its base on the bottom edge (DistrictMapTest pins the set). Bold, filled
						   pictograms: the street renders at ~0.45px per unit, so a box is ~14px wide on screen and
						   anything finer than a 3-unit stroke vanishes. #}
						<symbol id="roof-coin" viewBox="0 0 30 36">
							<circle cx="15" cy="20" r="14" fill="currentColor"/>
							<text x="15" y="28" text-anchor="middle" font-size="22" font-weight="bold" fill="#0b1120">$</text>
						</symbol>
						<symbol id="roof-umbrella" viewBox="0 0 30 36">
							<path d="M 1 19 A 14 14 0 0 1 29 19 Z" fill="currentColor"/>
							<path d="M 15 19 V 30 A 4 4 0 0 1 7 30" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
						</symbol>
						<symbol id="roof-chart" viewBox="0 0 30 36">
							<rect x="2" y="22" width="7" height="14" fill="currentColor"/>
							<rect x="11.5" y="13" width="7" height="23" fill="currentColor"/>
							<rect x="21" y="3" width="7" height="33" fill="currentColor"/>
						</symbol>
						<symbol id="roof-derrick" viewBox="0 0 30 36">
							<path d="M 6 36 L 14 12 L 22 36" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round"/>
							<line x1="2" y1="18" x2="28" y2="9" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
							<rect x="24" y="8" width="6" height="9" fill="currentColor"/>
							<circle cx="4" cy="19" r="3.5" fill="currentColor"/>
							<rect x="2" y="32" width="26" height="4" fill="currentColor"/>
						</symbol>
						<symbol id="roof-flare_stack" viewBox="0 0 30 36">
							<rect x="10" y="15" width="10" height="21" fill="currentColor"/>
							<path d="M 15 1 C 8 8, 7 12, 15 15 C 23 12, 22 8, 15 1 Z" fill="currentColor"/>
							<rect x="7" y="33" width="16" height="3" fill="currentColor"/>
						</symbol>
						<symbol id="roof-ingot" viewBox="0 0 30 36">
							<path d="M 1 36 L 5 27 H 14 L 17 36 Z" fill="currentColor"/>
							<path d="M 13 36 L 16 27 H 25 L 29 36 Z" fill="currentColor"/>
							<path d="M 7 26 L 11 17 H 20 L 23 26 Z" fill="currentColor"/>
						</symbol>
						<symbol id="roof-factory" viewBox="0 0 30 36">
							<path d="M 1 36 V 19 L 10 13 V 19 L 19 13 V 19 L 28 13 V 36 Z" fill="currentColor"/>
							<rect x="22" y="3" width="6" height="12" fill="currentColor"/>
						</symbol>
						<symbol id="roof-flask" viewBox="0 0 30 36">
