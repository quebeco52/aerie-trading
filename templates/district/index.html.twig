{% extends 'base.html.twig' %}

{% block title %}{{ wardName }} | Aerie District{% endblock %}

{% block stylesheets %}
<style>
	/* Stroke widths throughout are sized for the street's rendered scale (~0.45px per user unit):
	   anything under ~2.5 units lands below one device pixel and stops reading as a line. */
	.plot { cursor: pointer; }
	.facade {
		stroke-width: 2.5;
		transition: y 600ms ease-out, height 600ms ease-out, fill 300ms ease-out;
	}
	.plot-windows { transition: transform 600ms ease-out; }
	.window { opacity: 0.42; }
	.roofline { transition: y 600ms ease-out, fill 300ms ease-out; fill: #4a5266; }

	/* Condition outranks the sector hue — solvency is the more urgent fact. */
	.plot[data-condition="distressed"] .facade { fill: #37291d !important; stroke: #a37b3d !important; }
	.plot[data-condition="distressed"] .window { fill: #ffd9a0 !important; opacity: 0.30; }
	.plot[data-condition="distressed"] .roofline { fill: #6b5a3d; }

	.plot[data-condition="ruin"] .facade { fill: #241a24 !important; stroke: #8c4b4b !important; stroke-dasharray: 10 7; }
	.plot[data-condition="ruin"] .window { fill: #ffb3ad !important; opacity: 0.10; }
	.plot[data-condition="ruin"] .roofline { fill: #5c3030; }

	.plot:hover .facade { fill: #2c3854 !important; }
	.plot:hover .window { opacity: 0.85; }
	.plot[data-selected="true"] .facade { stroke: #adc6ff !important; stroke-width: 5; }
	.plot[data-selected="true"] .window { opacity: 0.95; }

	.plot[data-tick="up"] .roofline { fill: #4edea3; }
	.plot[data-tick="down"] .roofline { fill: #ffb3ad; }

	/* Kerb text is sized against the narrowest plot (100 units): a 5-character ticker at 30 is
	   90 units, a price at 22 is 92, a change at 22 is 79 — each fits alone on its own centred
	   line, and none of them fit paired left-and-right, which is what used to collide. */
	.plot-rank { fill: #7a8398; font-size: 24px; letter-spacing: 0.5px; }
	.plot-label { fill: #dae2fd; font-size: 30px; letter-spacing: 1px; transition: fill 200ms; }
	.plot-price { fill: #9aa3b8; font-size: 22px; letter-spacing: 0.5px; }
	.plot-change { font-size: 22px; font-weight: bold; letter-spacing: 0.5px; }
	.plot-change[data-direction="up"] { fill: #4edea3; }
	.plot-change[data-direction="down"] { fill: #ffb3ad; }
	.plot-change[data-direction="flat"] { fill: #838da3; }
	.plot-label[data-selected="true"], .plot-rank[data-selected="true"] { fill: #adc6ff; }

	.gridline { stroke: #2b3550; stroke-width: 2; stroke-dasharray: 4 12; opacity: 0.55; }
	.gridline-label { fill: #6b7690; font-size: 32px; letter-spacing: 0.5px; opacity: 0.75; }

	/* Titan marker. Scoped to .plot so it cannot leak onto the institution beacons — an earlier
	   version shared one .beacon rule, and a running animation outranks a plain opacity:0, so
	   every institution pulsed an alarm-coloured dot permanently whether stressed or not. */
	.plot .beacon { fill: #ffd9a0; animation: beacon-pulse 2.4s ease-in-out infinite; }
	@keyframes beacon-pulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

	/* --- Institutions --- */
	.institution { cursor: pointer; }
	.institution .pediment, .institution .body {
		fill: #232c42;
		stroke: #4a5568;
		stroke-width: 2.5;
		transition: fill 300ms, stroke 300ms;
	}
	.institution .column { stroke: #56617a; stroke-width: 3; opacity: 0.5; }
	.institution-beacon { fill: #ffb3ad; opacity: 0; transition: opacity 300ms; }
	.institution-label {
		fill: #8891a8;
		font-size: 30px;
		letter-spacing: 1px;
		opacity: 0.7;
		transition: opacity 200ms, fill 200ms;
	}
	.institution-readout { font-size: 26px; }
	.readout-label { fill: #838da3; letter-spacing: 0.5px; }
	.readout-value { fill: #adc6ff; font-weight: bold; }

	.institution:hover .pediment, .institution:hover .body { fill: #2c3854; }
	.institution[data-selected="true"] .pediment, .institution[data-selected="true"] .body {
		stroke: #adc6ff;
		stroke-width: 5;
	}
	.institution[data-selected="true"] .institution-label { opacity: 1; fill: #adc6ff; }

	.institution[data-stressed="true"] .pediment, .institution[data-stressed="true"] .body {
		fill: #3a2a2e;
		stroke: #a35c5c;
	}
	.institution[data-stressed="true"] .institution-beacon { opacity: 1; animation: beacon-pulse 2.4s ease-in-out infinite; }
	.institution[data-stressed="true"] .institution-label { opacity: 1; fill: #ffb3ad; }
	.institution[data-stressed="true"] .readout-value { fill: #ffb3ad; }

	/* --- Conduits --- */
	/* Faintly visible at rest: two institutions carry no stress rules at all, so an opacity-0
	   resting state made their conduits permanently unreachable on a calm market. */
	.conduit {
		fill: none;
		stroke: #3a4260;
		stroke-width: 3;
		stroke-dasharray: 10 9;
		opacity: 0.30;
		transition: opacity 300ms, stroke 300ms;
	}
	.conduit[data-stressed="true"] {
		opacity: 0.75;
		stroke: #ffb3ad;
		animation: conduit-flow 1.4s linear infinite;
	}
	.conduit[data-highlighted="true"] {
		opacity: 0.95;
		stroke: #adc6ff;
		stroke-width: 4;
	}
	@keyframes conduit-flow { to { stroke-dashoffset: -38; } }

	/* --- Event Flares & Badges --- */
	.event-flare { opacity: 0; pointer-events: none; fill: #adc6ff; }
	.event-flare[data-flash="true"] { animation: flare-burst 900ms ease-out; }
	@keyframes flare-burst {
		0%   { opacity: 0.95; r: 6; }
		55%  { opacity: 0.45; r: 30; }
		100% { opacity: 0; r: 40; }
	}

	.event-badge { opacity: 0; transition: opacity 200ms; pointer-events: none; }
	.event-badge:not([data-count="0"]) { opacity: 1; }
	.event-badge circle { fill: #171f33; stroke: #56617a; stroke-width: 2.5; }
	.event-badge text { fill: #c2c6d6; font-size: 26px; font-weight: bold; }
	.event-badge[data-flash="true"] circle { animation: badge-pop 500ms ease-out; }
	@keyframes badge-pop {
		0%   { stroke: #ffb3ad; }
		100% { stroke: #56617a; }
	}

	/* --- Hover tooltip --- */
	/* Drawn in SVG rather than as an HTML bubble: the map card clips on overflow, which would
	   cut an absolutely-positioned tooltip off at the card edge. */
	#plot-tooltip { pointer-events: none; opacity: 0; transition: opacity 140ms; }
	#plot-tooltip[data-visible="true"] { opacity: 1; }
	#plot-tooltip .tooltip-bg { fill: #0f172a; stroke: #56617a; stroke-width: 2.5; rx: 10; }
	#plot-tooltip text { font-family: "Courier Prime", monospace; }
	#plot-tooltip .tt-ticker { fill: #adc6ff; font-size: 34px; font-weight: bold; }
	#plot-tooltip .tt-rank { fill: #6b7690; font-size: 26px; }
	#plot-tooltip .tt-name { fill: #dae2fd; font-size: 26px; }
	#plot-tooltip .tt-meta { fill: #838da3; font-size: 24px; }
	#plot-tooltip .tt-value { fill: #dae2fd; font-size: 28px; font-weight: bold; }
	#plot-tooltip .tt-change[data-direction="up"] { fill: #4edea3; }
	#plot-tooltip .tt-change[data-direction="down"] { fill: #ffb3ad; }
	#plot-tooltip .tt-change[data-direction="flat"] { fill: #838da3; }

	@media (prefers-reduced-motion: reduce) {
		.plot .beacon { animation: none; opacity: 0.75; }
		.institution[data-stressed="true"] .institution-beacon { animation: none; opacity: 1; }
		.facade, .plot-windows, .roofline, .institution .pediment, .institution .body, .conduit,
		#plot-tooltip { transition: none; animation: none; }
		.event-flare[data-flash="true"] { animation: none; opacity: 0.6; }
		.event-badge[data-flash="true"] circle { animation: none; }
	}
</style>
{% endblock %}

{% block body %}
<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5"
	data-controller="district"
	data-district-shares-value="{{ shares|json_encode|e('html_attr') }}"
	data-district-envelope-value="{{ envelope|json_encode|e('html_attr') }}"
	data-district-events-value="{{ events|json_encode|e('html_attr') }}"
	data-district-revenue-mix-value="{{ revenueMix|json_encode|e('html_attr') }}"
	data-district-institutions-value="{{ institutions|map(i => {id: i.id, label: i.label, readouts: i.readouts, stressRules: i.stressRules, fields: i.fields})|json_encode|e('html_attr') }}">

	{# Hero #}
	<div class="bg-surface-container-low rounded-lg p-5 md:p-6 border border-outline-variant/25">
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
			<div>
				<div class="flex items-center gap-2 mb-2">
					<span class="text-xs font-bold tracking-wider text-primary uppercase">Aerie Autonomous District</span>
					<span class="text-xs text-on-surface-variant/60 font-mono">/ Top {{ rosterSize }} by market cap</span>
				</div>
				<h1 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight">{{ wardName }}</h1>
				<p class="text-xs text-on-surface-variant mt-1 max-w-2xl">{{ wardTagline }}</p>
			</div>
			<div class="flex flex-col gap-2 text-xs font-mono text-on-surface-variant shrink-0">
				<div class="flex items-center gap-4">
					<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:#37291d;border:1px solid #a37b3d"></span>Distressed</span>
					<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:#241a24;border:1px dashed #8c4b4b"></span>Defunct</span>
					<span class="flex items-center gap-1.5"><span class="w-3 h-0.5" style="background:#ffb3ad"></span>Conduit stressed</span>
				</div>
			</div>
		</div>

		{# Street summary — every figure read off plots already built, no extra query #}
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mt-5">
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between">
				<span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Street Cap</span>
				<span class="text-sm font-bold text-on-surface font-mono tabular-nums mt-1">${{ summary.totalMarketCap|format_large }}</span>
			</div>
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between">
				<span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Street 1M</span>
				{% if summary.changePercent is not null %}
					<span class="text-sm font-bold font-mono tabular-nums mt-1 {{ summary.changePercent >= 0 ? 'text-secondary' : 'text-tertiary' }}">
						{{ summary.changePercent >= 0 ? '+' : '' }}{{ (summary.changePercent * 100)|number_format(2) }}%
					</span>
				{% else %}
					<span class="text-sm font-bold text-on-surface-variant/50 font-mono mt-1">&mdash;</span>
				{% endif %}
			</div>
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between">
				<span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Biggest Mover</span>
				{% if summary.biggestMover %}
					<span class="text-sm font-bold font-mono tabular-nums mt-1 {{ summary.biggestMover.changePercent >= 0 ? 'text-secondary' : 'text-tertiary' }}">
						{{ summary.biggestMover.ticker }}
						{{ summary.biggestMover.changePercent >= 0 ? '+' : '' }}{{ (summary.biggestMover.changePercent * 100)|number_format(1) }}%
					</span>
				{% else %}
					<span class="text-sm font-bold text-on-surface-variant/50 font-mono mt-1">&mdash;</span>
				{% endif %}
			</div>
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between">
				<span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Institutions</span>
				<span class="text-sm font-bold font-mono tabular-nums mt-1 {{ summary.stressedInstitutions > 0 ? 'text-tertiary' : 'text-on-surface' }}"
					data-district-target="summaryStress">
					{{ summary.stressedInstitutions }}/{{ summary.totalInstitutions }} stressed
				</span>
			</div>
			<div class="bg-surface-container-lowest/80 border border-outline-variant/20 rounded p-3 flex flex-col justify-between">
				<span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Next In Line</span>
				{% if summary.nextInLine %}
					<span class="text-sm font-bold text-on-surface font-mono tabular-nums mt-1"
						title="{{ summary.nextInLine.name }} — first company below the cut">
						{{ summary.nextInLine.ticker }}
						<span class="text-on-surface-variant/60">${{ summary.nextInLine.marketCap|format_large }}</span>
					</span>
				{% else %}
					<span class="text-sm font-bold text-on-surface-variant/50 font-mono mt-1">&mdash;</span>
				{% endif %}
			</div>
		</div>

		{# Sector legend — the street's primary colour signal #}
		<div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-4 pt-4 border-t border-outline-variant/15">
			{% for sector, colours in sectorPalette %}
				<span class="flex items-center gap-1.5 text-xs font-mono text-on-surface-variant/80">
					<span class="w-2.5 h-2.5 rounded-full" style="background:{{ colours.window }}"></span>{{ sector }}
				</span>
			{% endfor %}
		</div>
	</div>

	<div class="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-5 items-start">

		{# The Elevation #}
		<div class="bg-surface-container-lowest border border-outline-variant/25 rounded-lg overflow-hidden">
			<div class="flex items-center justify-between px-4 py-2 border-b border-outline-variant/15 bg-surface-container-high/20">
				<span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Street Elevation &mdash; facing north</span>
				<div class="flex items-center gap-3">
					<span class="text-xs font-mono text-on-surface-variant/60 hidden sm:block">Height &prop; market capitalisation (log scale)</span>
					<div class="flex items-center gap-1">
						<button type="button" data-action="click->district#zoomOut" title="Zoom out"
							class="w-6 h-6 flex items-center justify-center rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface">
							<span class="material-symbols-outlined text-base">zoom_out</span>
						</button>
						<button type="button" data-action="click->district#fitToWidth" title="Fit whole street"
							class="w-6 h-6 flex items-center justify-center rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface">
							<span class="material-symbols-outlined text-base">fit_screen</span>
						</button>
						<button type="button" data-action="click->district#zoomIn" title="Zoom in"
							class="w-6 h-6 flex items-center justify-center rounded text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface">
							<span class="material-symbols-outlined text-base">zoom_in</span>
						</button>
					</div>
				</div>
			</div>

			<div class="overflow-x-auto custom-scrollbar">
				<svg viewBox="0 0 {{ viewboxWidth }} {{ viewboxHeight }}"
					data-district-target="svg"
					data-action="click->district#deselect keydown.esc->district#deselect"
					class="block min-w-250 w-full h-auto"
					role="img"
					aria-label="Illustrated street elevation of {{ wardName }}">

					<defs>
						{# One clip per row: a single one at the upper ground line would clip the lower row's windows away entirely. #}
						{% for rowIndex, rowGroundLine in rowGroundLines %}
							<clipPath id="above-ground-{{ rowIndex }}">
								<rect x="0" y="0" width="{{ viewboxWidth }}" height="{{ rowGroundLine }}"/>
							</clipPath>
						{% endfor %}
						<linearGradient id="water-fade" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#ffffff" stop-opacity="0.42"/>
							<stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
						</linearGradient>
						<mask id="water-mask">
							<rect x="0" y="{{ waterLine }}" width="{{ viewboxWidth }}" height="{{ viewboxHeight - waterLine }}" fill="url(#water-fade)"/>
						</mask>
						<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#050b1a"/>
							<stop offset="55%" stop-color="#0d1526"/>
							<stop offset="100%" stop-color="#161f36"/>
						</linearGradient>
					</defs>

					<rect x="0" y="0" width="{{ viewboxWidth }}" height="{{ viewboxHeight }}" fill="url(#sky)"/>

					{# Market-cap reference gridlines, behind everything. A cap maps to a facade height,
					   so the same reference sits at a different y on each row — hence one set per row. #}
					<g id="gutter" aria-hidden="true">
						{% for line in gridlines %}
							<line class="gridline" x1="{{ gutterWidth - 8 }}" y1="{{ line.y }}"
								x2="{{ viewboxWidth - frontageMargin }}" y2="{{ line.y }}"/>
							<text class="gridline-label" x="{{ gutterWidth - 16 }}" y="{{ line.y + 11 }}"
								text-anchor="end" font-family="Courier Prime, monospace">{{ line.label }}</text>
						{% endfor %}
					</g>

					{# The far bank: abstract institutions publishing the macro state every tenant reads.
					   Only institutions at least one tenant draws a conduit from render here — see
					   App\Service\District\DistrictMapBuilder::buildInstitutions(). #}
					<g id="institutions">
						{% for institution in institutions %}
							<g class="institution"
								data-district-target="institution"
								data-institution="{{ institution.id }}"
								data-stressed="{{ institutionStress[institution.id] ? 'true' : 'false' }}"
								data-action="click->district#selectInstitution keydown.enter->district#selectInstitution"
								tabindex="0"
								role="button"
								aria-label="{{ institution.label }}">

								<polygon class="pediment" points="
									{{ institution.x }},{{ institutionBand.top + 26 }}
									{{ institution.x + institution.width / 2 }},{{ institutionBand.top }}
									{{ institution.x + institution.width }},{{ institutionBand.top + 26 }}
								"/>
								<rect class="body"
									x="{{ institution.x }}" y="{{ institutionBand.top + 26 }}"
									width="{{ institution.width }}" height="{{ institutionBand.height - 26 }}"/>
								{% for c in 0..5 %}
									<line class="column"
										x1="{{ institution.x + 16 + c * ((institution.width - 32) / 5) }}" y1="{{ institutionBand.top + 34 }}"
										x2="{{ institution.x + 16 + c * ((institution.width - 32) / 5) }}" y2="{{ institutionBand.top + institutionBand.height - 8 }}"/>
								{% endfor %}
								<circle class="institution-beacon" cx="{{ institution.x + institution.width / 2 }}" cy="{{ institutionBand.top }}" r="8"/>

								<text class="institution-label" x="{{ institution.x + institution.width / 2 }}" y="{{ institutionBand.top + institutionBand.height + 28 }}"
									text-anchor="middle" font-family="Courier Prime, monospace">{{ institution.shortLabel|upper }}</text>

								{# Live readout: the actual macro numbers behind the stress pulse, not just
								   the pulse itself. One line per reading so the larger legible font size
								   never overruns a narrower institution's width. #}
								<text class="institution-readout" data-district-target="institutionReadout" data-institution-readout-for="{{ institution.id }}"
									text-anchor="middle" font-family="Courier Prime, monospace">{%- for readout in institution.readouts -%}
										{%- set raw = macroSnapshot[readout.field] ?? 0 -%}
										<tspan x="{{ institution.x + institution.width / 2 }}"
											{%- if loop.first %} y="{{ institutionBand.top + institutionBand.height + 58 }}"{% else %} dy="30"{% endif %}
											><tspan class="readout-label">{{ readout.label }}</tspan> <tspan class="readout-value" data-readout-field="{{ readout.field }}">{% if readout.unit == 'pct' %}{{ (raw * 100)|number_format(2) }}%{% else %}{{ raw|number_format(1) }}{% endif %}</tspan></tspan>
									{%- endfor -%}</text>
							</g>
						{% endfor %}
					</g>

					{# Conduits: institution outlet to a wired tenant's roofline, drawn behind the skyline.
					   The upper row takes a symmetric S; the lower row traverses the corridor band above
					   every possible upper-row roofline first, then drops — see
					   App\Data\DistrictMap::CONDUIT_CORRIDOR_Y for why the S cannot be used there. #}
					<g id="conduits">
						{% set institutionsById = {} %}
						{% for institution in institutions %}
							{% set institutionsById = institutionsById|merge({(institution.id): institution}) %}
						{% endfor %}
						{% for plot in plots %}
							{% for institutionId in plot.conduits %}
								{% set institution = institutionsById[institutionId] %}
								{% set sx = institution.x + institution.width / 2 %}
								{% set sy = institutionBand.outletY %}
								{% set tx = plot.x + plot.width / 2 %}
								{% set ty = plot.y - 7 %}
								<path class="conduit"
									data-district-target="conduit"
									data-conduit-institution="{{ institutionId }}"
									data-conduit-building="{{ plot.ticker }}"
									data-conduit-row="{{ plot.row }}"
									data-stressed="{{ institutionStress[institutionId] ? 'true' : 'false' }}"
									data-sx="{{ sx }}" data-sy="{{ sy }}" data-tx="{{ tx }}"
									d="{% if plot.row == 0 %}M {{ sx }} {{ sy }} C {{ sx }} {{ sy + (ty - sy) / 2 }}, {{ tx }} {{ ty - (ty - sy) / 2 }}, {{ tx }} {{ ty }}{% else %}M {{ sx }} {{ sy }} C {{ sx }} {{ sy + 20 }}, {{ tx }} {{ institutionBand.corridorY - 20 }}, {{ tx }} {{ institutionBand.corridorY }} L {{ tx }} {{ ty }}{% endif %}"/>
							{% endfor %}
						{% endfor %}
					</g>

					<g id="skyline">
						{% for rowIndex, rowGroundLine in rowGroundLines %}
							<g id="skyline-row-{{ rowIndex }}">
								{% for plot in plots|filter(p => p.row == rowIndex) %}
									{% set palette = sectorPalette[plot.sector] ?? {'facade': '#1b2439', 'stroke': '#424754', 'window': '#adc6ff'} %}
									{% set cols = ((plot.width - 20) // 34) %}
									{% set band = cols * 34 - 14 %}
									{% set inset = (plot.width - band) / 2 %}
									<g class="plot"
										data-district-target="plot"
										data-plot="{{ plot.plotId }}"
										data-row="{{ plot.row }}"
										data-ground-line="{{ plot.groundLine }}"
										data-condition="{{ plot.condition }}"
										data-ticker="{{ plot.ticker }}"
										data-name="{{ plot.name }}"
										data-rank="{{ plot.rank }}"
										data-sector="{{ plot.sector }}"
										data-industry="{{ plot.industry }}"
										data-importance="{{ plot.systemicImportance }}"
										data-rating="{{ plot.creditRating }}"
										data-price="{{ plot.price }}"
										data-mcap="{{ plot.marketCap }}"
										data-roc="{{ plot.returnOnCapital }}"
										data-change="{{ plot.changePercent is null ? '' : plot.changePercent }}"
										data-blurb="{{ plot.blurb|e('html_attr') }}"
										data-action="click->district#select keydown.enter->district#select mouseenter->district#showTooltip mouseleave->district#hideTooltip"
										tabindex="0"
										role="button"
										aria-label="{{ plot.name }} ({{ plot.ticker }}), rank {{ plot.rank }}">

										<rect class="facade"
											x="{{ plot.x }}" y="{{ plot.y }}"
											width="{{ plot.width }}" height="{{ plot.height }}"
											fill="{{ palette.facade }}" stroke="{{ palette.stroke }}"/>

										<rect class="roofline"
											x="{{ plot.x - 5 }}" y="{{ plot.y - 7 }}"
											width="{{ plot.width + 10 }}" height="7"/>

										{% if cols > 0 %}
											<g clip-path="url(#above-ground-{{ rowIndex }})">
											<g class="plot-windows" transform="translate({{ plot.x }} {{ plot.y }})">
												{% for row in 0..(plot.floors - 1) %}
													{% for col in 0..(cols - 1) %}
														<rect class="window" fill="{{ palette.window }}"
															x="{{ inset + col * 34 }}" y="{{ firstFloorInset + row * floorHeight }}"
															width="20" height="22"/>
													{% endfor %}
												{% endfor %}
											</g>
											</g>

											{% if plot.systemicImportance == 'titan' and plot.condition != 'ruin' %}
												<circle class="beacon" cx="{{ plot.x + plot.width / 2 }}" cy="{{ plot.y - 20 }}" r="9"/>
											{% endif %}

											{# One reusable burst per building, fired and coloured by district_controller.js
											   when a live event lands on this ticker. #}
											<circle class="event-flare" data-district-target="flare" data-flare-for="{{ plot.ticker }}"
												cx="{{ plot.x + plot.width / 2 }}" cy="{{ plot.y - 34 }}" r="6"/>

											{# Rank rides the roofline's west end, the event badge its east end — the
											   kerb below has no width to spare for either alongside the ticker. #}
											<text class="plot-rank" data-district-target="rank" data-rank-for="{{ plot.ticker }}"
												x="{{ plot.x + 4 }}" y="{{ plot.y - 14 }}"
												font-family="Courier Prime, monospace">#{{ plot.rank }}</text>

											{# Recent-events badge, on the roofline rather than the kerb — on a narrow
											   plot it used to sit on top of the ticker plate. #}
											<g class="event-badge" data-district-target="badge" data-badge-for="{{ plot.ticker }}"
												data-count="{{ events[plot.ticker]|default([])|length }}">
												<circle cx="{{ plot.x + plot.width - 6 }}" cy="{{ plot.y - 18 }}" r="15"/>
												<text data-district-target="badgeCount"
													x="{{ plot.x + plot.width - 6 }}" y="{{ plot.y - 18 }}"
													text-anchor="middle" dominant-baseline="central"
													font-family="Courier Prime, monospace">{{ events[plot.ticker]|default([])|length }}</text>
											</g>
										{% endif %}
									</g>
								{% endfor %}
							</g>
						{% endfor %}
					</g>

					{# Upper row's kerb: dry stone, no water beneath it. #}
					{% if rowGroundLines|length > 1 %}
						<rect x="0" y="{{ rowGroundLines[0] }}" width="{{ viewboxWidth }}" height="{{ kerbDepth }}" fill="#0b1120" opacity="0.94"/>
						<line x1="0" y1="{{ rowGroundLines[0] }}" x2="{{ viewboxWidth }}" y2="{{ rowGroundLines[0] }}" stroke="#424754" stroke-width="3"/>
						<line x1="0" y1="{{ rowGroundLines[0] + kerbDepth }}" x2="{{ viewboxWidth }}" y2="{{ rowGroundLines[0] + kerbDepth }}"
							stroke="#424754" stroke-width="1.5" opacity="0.35"/>
					{% endif %}

					{# Glasswater itself: only the lowest row stands on the water, so only it reflects. #}
					<rect x="0" y="{{ waterLine }}" width="{{ viewboxWidth }}" height="{{ viewboxHeight - waterLine }}" fill="#070d1c"/>

					<g mask="url(#water-mask)">
						<use href="#skyline-row-{{ rowGroundLines|length - 1 }}" transform="translate(0 {{ waterLine * 2 }}) scale(1 -1)"/>
					</g>

					<rect x="0" y="{{ waterLine }}" width="{{ viewboxWidth }}" height="{{ kerbDepth }}" fill="#0b1120" opacity="0.94"/>
					<line x1="0" y1="{{ waterLine }}" x2="{{ viewboxWidth }}" y2="{{ waterLine }}" stroke="#424754" stroke-width="3"/>
					<line x1="0" y1="{{ waterLine + kerbDepth }}" x2="{{ viewboxWidth }}" y2="{{ waterLine + kerbDepth }}"
						stroke="#424754" stroke-width="1.5" opacity="0.35"/>

					{# Frontage plates sit on each row's kerb so they are never mirrored.
					   Three stacked, centred lines rather than two left/right pairs: the narrowest
					   plot is 100 units, and a price and a change set side by side run to ~218,
					   so the pairs collided on every base-tier plot. #}
					<g id="plot-labels">
						{% for plot in plots %}
							{% set centre = plot.x + plot.width / 2 %}
							<text class="plot-label" data-district-target="label" data-label-for="{{ plot.ticker }}"
								x="{{ centre }}" y="{{ plot.groundLine + 30 }}"
								text-anchor="middle" font-family="Courier Prime, monospace">{{ plot.ticker }}</text>

							<text class="plot-price" data-district-target="kerbPrice" data-price-for="{{ plot.ticker }}"
								x="{{ centre }}" y="{{ plot.groundLine + 60 }}"
								text-anchor="middle" font-family="Courier Prime, monospace">${{ plot.price|number_format(2) }}</text>

							<text class="plot-change" data-district-target="kerbChange" data-change-for="{{ plot.ticker }}"
								x="{{ centre }}" y="{{ plot.groundLine + 88 }}"
								text-anchor="middle" font-family="Courier Prime, monospace"
								data-direction="{{ plot.changePercent is null ? 'flat' : (plot.changePercent > 0 ? 'up' : (plot.changePercent < 0 ? 'down' : 'flat')) }}"
								>{% if plot.changePercent is null %}&mdash;{% else %}{{ plot.changePercent > 0 ? '+' : '' }}{{ (plot.changePercent * 100)|number_format(1) }}%{% endif %}</text>
						{% endfor %}
					</g>

					{# Tooltip last, so it paints above every other layer. #}
					<g id="plot-tooltip" data-district-target="tooltip" data-visible="false">
						<rect class="tooltip-bg" x="0" y="0" width="520" height="210"/>
						<text class="tt-ticker" data-district-target="tooltipTicker" x="20" y="46" font-family="Courier Prime, monospace"></text>
						<text class="tt-rank" data-district-target="tooltipRank" x="500" y="46" text-anchor="end" font-family="Courier Prime, monospace"></text>
						<text class="tt-name" data-district-target="tooltipName" x="20" y="84" font-family="Courier Prime, monospace"></text>
						<text class="tt-meta" data-district-target="tooltipMeta" x="20" y="118" font-family="Courier Prime, monospace"></text>
						<text class="tt-value" data-district-target="tooltipPrice" x="20" y="158" font-family="Courier Prime, monospace"></text>
						<text class="tt-value tt-change" data-district-target="tooltipChange" x="500" y="158" text-anchor="end" font-family="Courier Prime, monospace"></text>
						<text class="tt-meta" data-district-target="tooltipCap" x="20" y="192" font-family="Courier Prime, monospace"></text>
					</g>
				</svg>
			</div>
		</div>

		{# Info Panel #}
		<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-5 xl:sticky xl:top-20">
			<div data-district-target="empty">
				<h2 class="text-sm font-bold uppercase tracking-wider text-on-surface mb-2">Select a building or institution</h2>
				<p class="text-xs text-on-surface-variant leading-relaxed">
					{{ plots|length }} listed houses hold frontage on {{ wardName }}, ranked by market
					capitalisation and reshuffled as it moves. Facade height tracks that capitalisation;
					lit windows carry the sector; masonry condition tracks credit standing. The structures
					along the top are the institutions publishing the macro conditions this street trades
					on &mdash; a conduit reddens on its own once the variable it carries turns adverse.
					Hover any building for its file, or click an institution to see everyone it feeds.
				</p>
			</div>

			<div data-district-target="detail" class="hidden">
				<div class="flex items-baseline justify-between gap-2 mb-1">
					<span class="text-xl font-bold text-primary font-mono" data-district-target="detailTicker"></span>
					<span class="text-xs font-mono text-on-surface-variant/60" data-district-target="detailPlot"></span>
				</div>
				<h2 class="text-sm font-bold text-on-surface leading-tight" data-district-target="detailName"></h2>
				<p class="text-xs text-on-surface-variant/70 mb-4" data-district-target="detailIndustry"></p>

				<dl class="grid grid-cols-2 gap-x-3 gap-y-2.5 text-xs font-mono mb-4">
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Price</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailPrice"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Change (1M)</dt>
						<dd class="tabular-nums" data-district-target="detailChange"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Market Cap</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailMcap"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Credit</dt>
						<dd class="text-on-surface" data-district-target="detailRating"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Return</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailRoc"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Street Rank</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailRank"></dd></div>
					<div class="col-span-2"><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Standing</dt>
						<dd class="text-on-surface" data-district-target="detailImportance"></dd></div>
				</dl>

				<div class="mb-4">
					<div class="flex items-center justify-between mb-2">
						<h3 class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant/60">Revenue Mix</h3>
						<span class="text-[10px] font-mono text-on-surface-variant/50" data-district-target="detailRevenueTotal"></span>
					</div>
					<div class="space-y-2.5" data-district-target="detailRevenueMix">
						<p class="text-xs text-on-surface-variant/50 italic" data-district-target="noRevenueMix">No quarterly report filed yet.</p>
					</div>
				</div>

				<p class="text-xs text-on-surface-variant leading-relaxed max-h-48 overflow-y-auto custom-scrollbar pr-2 mb-4"
					data-district-target="detailBlurb"></p>

				<div class="mb-4">
					<h3 class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant/60 mb-2">Recent Events</h3>
					<div class="space-y-2 max-h-56 overflow-y-auto custom-scrollbar pr-1" data-district-target="detailEvents">
						<p class="text-xs text-on-surface-variant/50 italic" data-district-target="noEvents">No recent events logged.</p>
					</div>
				</div>

				<a href="#" data-district-target="detailLink"
					class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary hover:underline">
					<span class="material-symbols-outlined text-sm">open_in_new</span>
					Open trading file
				</a>
			</div>

			{# Institution detail — clicking a publisher used to fall back to the generic intro copy. #}
			<div data-district-target="institutionDetail" class="hidden">
				<div class="flex items-baseline justify-between gap-2 mb-1">
					<span class="text-sm font-bold text-primary font-mono uppercase tracking-wider" data-district-target="institutionName"></span>
					<span class="text-[10px] font-mono uppercase tracking-wider px-1.5 py-0.5 rounded border"
						data-district-target="institutionStatus"></span>
				</div>
				<p class="text-xs text-on-surface-variant/70 mb-4">Macro publisher</p>

				<h3 class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant/60 mb-2">Published Readings</h3>
				<dl class="grid grid-cols-2 gap-x-3 gap-y-2.5 text-xs font-mono mb-4" data-district-target="institutionReadings"></dl>

				<h3 class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant/60 mb-2">
					Feeds <span class="text-on-surface-variant/40" data-district-target="institutionFeedCount"></span>
				</h3>
				<div class="flex flex-wrap gap-1.5" data-district-target="institutionFeeds"></div>
			</div>
		</div>
	</div>
</div>
{% endblock %}
