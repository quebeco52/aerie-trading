{% extends 'base.html.twig' %}

{% block title %}{{ ward.name }} | Aerie District{% endblock %}

{% block stylesheets %}
<style>
	.plot { cursor: pointer; }
	.facade {
		fill: #1b2439;
		stroke: #424754;
		stroke-width: 1.5;
		transition: y 600ms ease-out, height 600ms ease-out, fill 300ms ease-out;
	}
	.plot-windows { transition: transform 600ms ease-out; }
	.window { fill: #adc6ff; opacity: 0.30; }
	.roofline { transition: y 600ms ease-out, fill 300ms ease-out; fill: #424754; }

	.plot[data-condition="distressed"] .facade { fill: #2b2334; stroke: #6b5a3d; }
	.plot[data-condition="distressed"] .window { fill: #ffd9a0; opacity: 0.16; }

	.plot[data-condition="ruin"] .facade { fill: #0c1120; stroke: #4a2b2b; stroke-dasharray: 6 5; }
	.plot[data-condition="ruin"] .window { fill: #ffb3ad; opacity: 0.05; }
	.plot[data-condition="ruin"] .roofline { fill: #3a2020; }

	.plot[data-vacant="true"] .facade { fill: #0a1020; stroke: #2b303c; stroke-dasharray: 4 6; }
	.plot[data-vacant="true"] { cursor: default; }

	.plot:hover .facade { fill: #2c3854; }
	.plot:hover .window { opacity: 0.70; }
	.plot[data-selected="true"] .facade { stroke: #adc6ff; stroke-width: 3; }
	.plot[data-selected="true"] .window { opacity: 0.85; }

	.plot[data-tick="up"] .roofline { fill: #4edea3; }
	.plot[data-tick="down"] .roofline { fill: #ffb3ad; }

	.plot-label { fill: #c2c6d6; font-size: 26px; letter-spacing: 1px; opacity: 0.55; transition: opacity 200ms, fill 200ms; }
	.plot-label[data-selected="true"] { opacity: 1; fill: #adc6ff; }

	.beacon { fill: #ffb3ad; animation: beacon-pulse 2.4s ease-in-out infinite; }
	@keyframes beacon-pulse { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }

	/* --- Institutions --- */
	.institution { cursor: pointer; }
	.institution .pediment, .institution .body {
		fill: #232c42;
		stroke: #4a5568;
		stroke-width: 1.5;
		transition: fill 300ms, stroke 300ms;
	}
	.institution .column { stroke: #56617a; stroke-width: 2; opacity: 0.45; }
	.institution-beacon { opacity: 0; transition: opacity 300ms; }
	.institution-label {
		fill: #8891a8;
		font-size: 24px;
		letter-spacing: 1.5px;
		opacity: 0.65;
		transition: opacity 200ms, fill 200ms;
	}
	.institution-readout {
		font-size: 20px;
		transition: opacity 200ms;
	}
	.readout-label { fill: #838da3; letter-spacing: 0.5px; }
	.readout-value { fill: #adc6ff; font-weight: bold; }

	.institution:hover .pediment, .institution:hover .body { fill: #2c3854; }
	.institution[data-selected="true"] .pediment, .institution[data-selected="true"] .body {
		stroke: #adc6ff;
		stroke-width: 3;
	}
	.institution[data-selected="true"] .institution-label { opacity: 1; fill: #adc6ff; }

	.institution[data-stressed="true"] .pediment, .institution[data-stressed="true"] .body {
		fill: #3a2a2e;
		stroke: #a35c5c;
	}
	.institution[data-stressed="true"] .institution-beacon { opacity: 1; }
	.institution[data-stressed="true"] .institution-label { opacity: 1; fill: #ffb3ad; }
	.institution[data-stressed="true"] .readout-value { fill: #ffb3ad; }

	/* --- Conduits --- */
	.conduit {
		fill: none;
		stroke: #56617a;
		stroke-width: 2;
		stroke-dasharray: 7 6;
		opacity: 0;
		transition: opacity 300ms, stroke 300ms;
	}
	.conduit[data-stressed="true"] {
		opacity: 0.55;
		stroke: #ffb3ad;
		animation: conduit-flow 1.4s linear infinite;
	}
	.conduit[data-highlighted="true"] {
		opacity: 0.85;
		stroke: #adc6ff;
		stroke-width: 2.5;
	}
	@keyframes conduit-flow { to { stroke-dashoffset: -26; } }

	/* --- Event Flares & Badges --- */
	.event-flare {
		opacity: 0;
		pointer-events: none;
		fill: #adc6ff;
	}
	.event-flare[data-flash="true"] { animation: flare-burst 900ms ease-out; }
	@keyframes flare-burst {
		0%   { opacity: 0.95; r: 4; }
		55%  { opacity: 0.45; r: 24; }
		100% { opacity: 0; r: 32; }
	}

	.event-badge {
		opacity: 0;
		transition: opacity 200ms;
		pointer-events: none;
	}
	.event-badge:not([data-count="0"]) { opacity: 1; }
	.event-badge circle { fill: #171f33; stroke: #56617a; stroke-width: 1.5; }
	.event-badge text { fill: #c2c6d6; font-size: 15px; font-weight: bold; }
	.event-badge[data-flash="true"] circle { animation: badge-pop 500ms ease-out; }
	@keyframes badge-pop {
		0%   { stroke: #ffb3ad; }
		100% { stroke: #56617a; }
	}

	@media (prefers-reduced-motion: reduce) {
		.beacon, .institution-beacon { animation: none; }
		.beacon { opacity: 0.7; }
		.institution[data-stressed="true"] .institution-beacon { opacity: 0.7; }
		.facade, .plot-windows, .roofline, .institution .pediment, .institution .body, .conduit { transition: none; animation: none; }
		.event-flare[data-flash="true"] { animation: none; opacity: 0.6; }
		.event-badge[data-flash="true"] circle { animation: none; }
	}
</style>
{% endblock %}

{% block body %}
<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 py-5 w-full space-y-5"
	data-controller="district"
	data-district-shares-value="{{ shares|json_encode|e('html_attr') }}"
	data-district-envelope-value="{{ envelope|json_encode|e('html_attr') }}"
	data-district-events-value="{{ events|json_encode|e('html_attr') }}"
	data-district-revenue-mix-value="{{ revenueMix|json_encode|e('html_attr') }}">

	{# Hero #}
	<div class="bg-surface-container-low rounded-lg p-5 md:p-6 border border-outline-variant/25">
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
			<div>
				<div class="flex items-center gap-2 mb-2">
					<span class="text-xs font-bold tracking-wider text-primary uppercase">Aerie Autonomous District</span>
					<span class="text-xs text-on-surface-variant/60 font-mono">/ {{ ward.sector }}</span>
				</div>
				<h1 class="text-2xl md:text-3xl font-bold text-on-surface tracking-tight">{{ ward.name }}</h1>
				<p class="text-xs text-on-surface-variant mt-1 max-w-2xl">{{ ward.tagline }}</p>
			</div>
			<div class="flex items-center gap-4 text-xs font-mono text-on-surface-variant">
				<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:#1b2439;border:1px solid #424754"></span>Sound</span>
				<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:#2b2334;border:1px solid #6b5a3d"></span>Distressed</span>
				<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm" style="background:#0c1120;border:1px dashed #4a2b2b"></span>Defunct</span>
				<span class="flex items-center gap-1.5"><span class="w-3 h-0.5" style="background:#ffb3ad"></span>Macro conduit stressed</span>
			</div>
		</div>
	</div>

	<div class="grid grid-cols-1 xl:grid-cols-[1fr_360px] gap-5 items-start">

		{# The Elevation #}
		<div class="bg-surface-container-lowest border border-outline-variant/25 rounded-lg overflow-hidden">
			<div class="flex items-center justify-between px-4 py-2 border-b border-outline-variant/15 bg-surface-container-highest/20">
				<span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Street Elevation &mdash; facing north</span>
				<span class="text-xs font-mono text-on-surface-variant/60 hidden sm:block">Height &prop; market capitalisation (log scale)</span>
			</div>

			<div class="overflow-x-auto custom-scrollbar">
				<svg viewBox="0 0 {{ ward.viewbox_width }} {{ ward.viewbox_height }}"
					class="block min-w-250 w-full h-auto"
					role="img"
					aria-label="Illustrated street elevation of {{ ward.name }}">

					<defs>
						<clipPath id="above-ground">
							<rect x="0" y="0" width="{{ ward.viewbox_width }}" height="{{ ward.ground_line }}"/>
						</clipPath>
						<linearGradient id="water-fade" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#ffffff" stop-opacity="0.42"/>
							<stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
						</linearGradient>
						<mask id="water-mask">
							<rect x="0" y="{{ ward.ground_line }}" width="{{ ward.viewbox_width }}" height="{{ ward.viewbox_height - ward.ground_line }}" fill="url(#water-fade)"/>
						</mask>
						<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#060e20"/>
							<stop offset="100%" stop-color="#131b2e"/>
						</linearGradient>
					</defs>

					<rect x="0" y="0" width="{{ ward.viewbox_width }}" height="{{ ward.viewbox_height }}" fill="url(#sky)"/>

					{# The far bank: abstract institutions publishing the macro state every tenant reads #}
					<g id="institutions">
						{% for institutionId, institution in institutions %}
							<g class="institution"
								data-district-target="institution"
								data-institution="{{ institutionId }}"
								data-stressed="{{ institutionStress[institutionId] ? 'true' : 'false' }}"
								data-action="click->district#selectInstitution"
								tabindex="0"
								role="button"
								aria-label="{{ institution.label }}">

								<polygon class="pediment" points="
									{{ institution.x }},{{ institutionBand.top + 26 }}
									{{ institution.x + institution.width / 2 }},{{ institutionBand.top }}
									{{ institution.x + institution.width }},{{ institutionBand.top + 26 }}
								"/>
								<rect class="body"
									x="{{ institution.x }}" y="{{ institutionBand.top + 26 }}"
									width="{{ institution.width }}" height="{{ institutionBand.height - 26 }}"/>
								{% for c in 0..5 %}
									<line class="column"
										x1="{{ institution.x + 16 + c * ((institution.width - 32) / 5) }}" y1="{{ institutionBand.top + 34 }}"
										x2="{{ institution.x + 16 + c * ((institution.width - 32) / 5) }}" y2="{{ institutionBand.top + institutionBand.height - 8 }}"/>
								{% endfor %}
								<circle class="beacon institution-beacon" cx="{{ institution.x + institution.width / 2 }}" cy="{{ institutionBand.top }}" r="6"/>

								<text class="institution-label" x="{{ institution.x + institution.width / 2 }}" y="{{ institutionBand.top + institutionBand.height + 22 }}"
									text-anchor="middle" font-family="Courier Prime, monospace">{{ institution.label|upper }}</text>

								{# Live readout: the actual macro numbers behind the stress pulse, not just
								   the pulse itself. One line per reading — not joined on one line with a
								   separator — so the larger legible font size never overruns a narrower
								   institution's width. Field values come straight off MacroStateDTO; see
								   DistrictMap::INSTITUTIONS[*]['readouts'] for the curated field/unit picks. #}
								<text class="institution-readout" data-district-target="institutionReadout" data-institution-readout-for="{{ institutionId }}"
									text-anchor="middle" font-family="Courier Prime, monospace">{%- for readout in institution.readouts -%}
										{%- set raw = macroSnapshot[readout.field] ?? 0 -%}
										<tspan x="{{ institution.x + institution.width / 2 }}"
											{%- if loop.first %} y="{{ institutionBand.top + institutionBand.height + 50 }}"{% else %} dy="24"{% endif %}
											><tspan class="readout-label">{{ readout.label }}</tspan> <tspan class="readout-value">{% if readout.unit == 'pct' %}{{ (raw * 100)|number_format(2) }}%{% else %}{{ raw|number_format(1) }}{% endif %}</tspan></tspan>
									{%- endfor -%}</text>
							</g>
						{% endfor %}
					</g>

					{# Conduits: institution outlet to a wired tenant's roofline. Drawn only where a
					   building's own business model genuinely reads that institution's fields — see
					   App\Data\DistrictMap::CONDUITS. Visible at rest only while stressed; selecting
					   a building or institution reveals the rest. #}
					<g id="conduits">
						{% for plot in plots|filter(p => p.isOccupied) %}
							{% for institutionId in plot.conduits %}
								{% set institution = institutions[institutionId] %}
								{% set sx = institution.x + institution.width / 2 %}
								{% set sy = institutionBand.outletY %}
								{% set tx = plot.x + plot.width / 2 %}
								{% set ty = plot.y - 7 %}
								<path class="conduit"
									data-district-target="conduit"
									data-conduit-institution="{{ institutionId }}"
									data-conduit-building="{{ plot.ticker }}"
									data-stressed="{{ institutionStress[institutionId] ? 'true' : 'false' }}"
									data-sx="{{ sx }}" data-sy="{{ sy }}" data-tx="{{ tx }}"
									d="M {{ sx }} {{ sy }} C {{ sx }} {{ sy + (ty - sy) / 2 }}, {{ tx }} {{ ty - (ty - sy) / 2 }}, {{ tx }} {{ ty }}"/>
							{% endfor %}
						{% endfor %}
					</g>

					<g id="skyline">
						{% for plot in plots %}
							{% set cols = ((plot.width - 20) // 34) %}
							{% set band = cols * 34 - 14 %}
							{% set inset = (plot.width - band) / 2 %}
							<g class="plot"
								data-district-target="plot"
								data-plot="{{ plot.plotId }}"
								data-vacant="{{ plot.isOccupied ? 'false' : 'true' }}"
								data-condition="{{ plot.condition }}"
								{% if plot.isOccupied %}
									data-ticker="{{ plot.ticker }}"
									data-name="{{ plot.name }}"
									data-industry="{{ plot.industry }}"
									data-importance="{{ plot.systemicImportance }}"
									data-rating="{{ plot.creditRating }}"
									data-price="{{ plot.price }}"
									data-mcap="{{ plot.marketCap }}"
									data-roc="{{ plot.returnOnCapital }}"
									data-blurb="{{ plot.blurb|e('html_attr') }}"
									data-action="click->district#select keydown.enter->district#select"
									tabindex="0"
									role="button"
									aria-label="{{ plot.name }} ({{ plot.ticker }})"
								{% endif %}>

								<rect class="facade"
									data-district-target="facade"
									x="{{ plot.x }}" y="{{ plot.y }}"
									width="{{ plot.width }}" height="{{ plot.height }}"/>

								<rect class="roofline"
									data-district-target="roofline"
									x="{{ plot.x - 5 }}" y="{{ plot.y - 7 }}"
									width="{{ plot.width + 10 }}" height="7"/>

								{% if plot.isOccupied and cols > 0 %}
									<g clip-path="url(#above-ground)">
									<g class="plot-windows" data-district-target="windows"
										transform="translate({{ plot.x }} {{ plot.y }})">
										{% for row in 0..(plot.floors - 1) %}
											{% for col in 0..(cols - 1) %}
												<rect class="window"
													x="{{ inset + col * 34 }}" y="{{ 22 + row * 46 }}"
													width="20" height="20"/>
											{% endfor %}
										{% endfor %}
									</g>
									</g>

									{% if plot.systemicImportance == 'titan' and plot.condition != 'ruin' %}
										<circle class="beacon" cx="{{ plot.x + plot.width / 2 }}" cy="{{ plot.y - 18 }}" r="7"/>
									{% endif %}

									{# One reusable burst per building, fired and coloured by district_controller.js
									   when a live event lands on this ticker — see EVENT_CATEGORY_STYLES. #}
									<circle class="event-flare" data-district-target="flare" data-flare-for="{{ plot.ticker }}"
										cx="{{ plot.x + plot.width / 2 }}" cy="{{ plot.y - 30 }}" r="4"/>
								{% endif %}
							</g>
						{% endfor %}
					</g>

					{# Glasswater itself: the street reflects the row #}
					<rect x="0" y="{{ ward.ground_line }}" width="{{ ward.viewbox_width }}" height="{{ ward.viewbox_height - ward.ground_line }}" fill="#070d1c"/>

					<g mask="url(#water-mask)">
						<use href="#skyline" transform="translate(0 {{ ward.ground_line * 2 }}) scale(1 -1)"/>
					</g>
					{# The embankment: an opaque kerb carrying the frontage plates over the water #}
					<rect x="0" y="{{ ward.ground_line }}" width="{{ ward.viewbox_width }}" height="{{ ward.quay_depth }}" fill="#0b1120" opacity="0.94"/>
					<line x1="0" y1="{{ ward.ground_line }}" x2="{{ ward.viewbox_width }}" y2="{{ ward.ground_line }}"
						stroke="#424754" stroke-width="2"/>
					<line x1="0" y1="{{ ward.ground_line + ward.quay_depth }}" x2="{{ ward.viewbox_width }}" y2="{{ ward.ground_line + ward.quay_depth }}"
						stroke="#424754" stroke-width="1" opacity="0.35"/>

					{# Frontage plates sit on the kerb so they are never mirrored #}
					<g id="plot-labels">
						{% for plot in plots|filter(p => p.isOccupied) %}
							<text class="plot-label" data-district-target="label" data-label-for="{{ plot.ticker }}"
								x="{{ plot.x + plot.width / 2 }}" y="{{ ward.ground_line + 31 }}"
								text-anchor="middle" font-family="Courier Prime, monospace">{{ plot.ticker }}</text>

							{# Recent-events badge: server-rendered count on first paint, incremented live
							   as new events arrive — see district_controller.js#applyEvent(). #}
							<g class="event-badge" data-district-target="badge" data-badge-for="{{ plot.ticker }}"
								data-count="{{ events[plot.ticker]|default([])|length }}">
								<circle cx="{{ plot.x + plot.width - 12 }}" cy="{{ ward.ground_line + 11 }}" r="10"/>
								<text data-district-target="badgeCount"
									x="{{ plot.x + plot.width - 12 }}" y="{{ ward.ground_line + 11 }}"
									text-anchor="middle" dominant-baseline="central"
									font-family="Courier Prime, monospace">{{ events[plot.ticker]|default([])|length }}</text>
							</g>
						{% endfor %}
					</g>
				</svg>
			</div>
		</div>

		{# Info Panel #}
		<div class="bg-surface-container-low border border-outline-variant/25 rounded-lg p-5 xl:sticky xl:top-20">
			<div data-district-target="empty">
				<h2 class="text-sm font-bold uppercase tracking-wider text-on-surface mb-2">Select a building or institution</h2>
				<p class="text-xs text-on-surface-variant leading-relaxed">
					{{ plots|filter(p => p.isOccupied)|length }} listed houses hold frontage on {{ ward.name }}.
					Facade height tracks market capitalisation; masonry condition tracks credit standing.
					The structures on the far bank are the institutions that publish the macro
					conditions this row trades on &mdash; a conduit lights up on its own once the
					variable it carries turns adverse. Click any building to read its file, or an
					institution to see everyone it feeds.
				</p>
			</div>

			<div data-district-target="detail" class="hidden">
				<div class="flex items-baseline justify-between gap-2 mb-1">
					<span class="text-xl font-bold text-primary font-mono" data-district-target="detailTicker"></span>
					<span class="text-xs font-mono text-on-surface-variant/60" data-district-target="detailPlot"></span>
				</div>
				<h2 class="text-sm font-bold text-on-surface leading-tight" data-district-target="detailName"></h2>
				<p class="text-xs text-on-surface-variant/70 mb-4" data-district-target="detailIndustry"></p>

				<dl class="grid grid-cols-2 gap-x-3 gap-y-2.5 text-xs font-mono mb-4">
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Price</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailPrice"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Market Cap</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailMcap"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Credit</dt>
						<dd class="text-on-surface" data-district-target="detailRating"></dd></div>
					<div><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Return</dt>
						<dd class="text-on-surface tabular-nums" data-district-target="detailRoc"></dd></div>
					<div class="col-span-2"><dt class="text-on-surface-variant/60 uppercase tracking-wider text-[10px]">Standing</dt>
						<dd class="text-on-surface" data-district-target="detailImportance"></dd></div>
				</dl>

				<div class="mb-4">
					<div class="flex items-center justify-between mb-2">
						<h3 class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant/60">Revenue Mix</h3>
						<span class="text-[10px] font-mono text-on-surface-variant/50" data-district-target="detailRevenueTotal"></span>
					</div>
					<div class="space-y-2.5" data-district-target="detailRevenueMix">
						<p class="text-xs text-on-surface-variant/50 italic" data-district-target="noRevenueMix">No quarterly report filed yet.</p>
					</div>
				</div>

				<p class="text-xs text-on-surface-variant leading-relaxed max-h-48 overflow-y-auto custom-scrollbar pr-2 mb-4"
					data-district-target="detailBlurb"></p>

				<div class="mb-4">
					<h3 class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant/60 mb-2">Recent Events</h3>
					<div class="space-y-2 max-h-56 overflow-y-auto custom-scrollbar pr-1" data-district-target="detailEvents">
						<p class="text-xs text-on-surface-variant/50 italic" data-district-target="noEvents">No recent events logged.</p>
					</div>
				</div>

				<a href="#" data-district-target="detailLink"
					class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary hover:underline">
					<span class="material-symbols-outlined text-sm">open_in_new</span>
					Open trading file
				</a>
			</div>
		</div>
	</div>
</div>
{% endblock %}
