{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% set issuer = bond.issuer %}

{% block page_title %}{{ bond.ticker }} bond price & yield | {{ bond.name }}{% endblock %}

{% block description %}Live clean price, yield to maturity, duration and cash flow schedule for {{ bond.ticker }} ({{ bond.name }}).{% endblock %}
{% block og_description %}{{ issuer ? issuer.name ~ ' corporate' : 'Sovereign' }} bond {{ bond.ticker }}, {{ bond.couponRate|pct(3) }} coupon, {{ yearsToMaturity|number_format(2) }} years to maturity.{% endblock %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-6">

		<header class="pb-6 border-b border-outline-variant/15">
			<div class="flex flex-col md:flex-row md:justify-between md:items-end gap-6">
				<div class="min-w-0">
					<nav class="flex items-center gap-1.5 mb-2 text-xs" aria-label="Breadcrumb">
						<a href="{{ path('app_bond_ladder') }}" class="text-primary hover:underline underline-offset-2">Bonds</a>
						<span class="text-on-surface-variant/50" aria-hidden="true">/</span>
						<span class="text-on-surface-variant">{{ bond.tenorYears|number_format(0) }}-year {{ issuer ? 'corporate' : 'sovereign' }}</span>
					</nav>

					<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight leading-tight wrap-break-word">{{ bond.name }}</h1>

					<div class="flex flex-wrap items-center gap-2 md:gap-3 mt-1.5">
						<span class="text-sm font-semibold text-on-surface font-mono">{{ bond.ticker }}</span>
						{% if bond.isOnTheRun %}
							<span class="badge badge-accent">On the run</span>
						{% endif %}
						{% if retired %}
							<span class="badge badge-{{ retired.tone }}">{{ retired.badge }}</span>
						{% endif %}
					</div>

					{% if issuer %}
						<p class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-on-surface-variant">
							<span>Issued by <a href="/stock/{{ issuer.ticker }}" class="text-primary hover:underline underline-offset-2">{{ issuer.name }}</a></span>
							{% if bond.seniority %}<span>{{ bond.seniority|replace({'_': ' '})|lower|capitalize }}</span>{% endif %}
							<span>Rated <span class="font-mono font-medium text-on-surface">{{ issuer.creditRating }}</span></span>
							<span>Issuer spread <span class="font-mono tabular-nums font-medium text-on-surface">{{ issuer.dynamicCreditSpread|bps }}</span></span>
						</p>
					{% endif %}
				</div>

				<div class="md:text-right shrink-0 flex flex-col md:items-end">

					{# The clean price is the quote. The dirty price sits beneath it, because that is what
					   an order actually costs: a buyer pays the holder for the accrued coupon. #}
					<span class="block text-3xl sm:text-4xl font-semibold font-mono tabular-nums text-on-surface tracking-tight transition-colors duration-300" id="big-price">
						{{ bond.cleanPrice|number_format(2) }}
					</span>

					<div class="flex items-center md:justify-end gap-2 mt-1.5">
						<span id="big-change" class="text-sm font-semibold font-mono tabular-nums {{ changePercent|signed_class }}">{{ changePercent|pct(2, true) }}</span>
						<span class="text-xs text-on-surface-variant">past month, clean</span>
					</div>

					<div class="text-2xs text-on-surface-variant mt-1 font-mono tabular-nums">
						Dirty <span id="stat-dirty">{{ bond.price|number_format(2) }}</span>
						· accrued <span id="stat-accrued">{{ bond.accruedInterest|number_format(2) }}</span>
					</div>
				</div>
			</div>
		</header>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

			<div class="lg:col-span-2 space-y-5">

				<div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
					<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
						<div class="flex items-center gap-3">
							<h2 id="chart-title" class="text-sm font-semibold text-on-surface">Clean price</h2>
							<div class="inline-flex gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5" role="group" aria-label="Chart series">
								<button type="button" data-field="price" class="field-btn seg-btn" aria-pressed="true">Price</button>
								<button type="button" data-field="yield" class="field-btn seg-btn" aria-pressed="false">Yield</button>
							</div>
						</div>
						{# A bond's bar has no intraday range recorded, so the candle view is not offered here. #}
						<div class="inline-flex flex-wrap gap-0.5 rounded-md border border-outline-variant/25 bg-surface-container-lowest p-0.5" role="group" aria-label="Chart range">
							{% for range in ['1w', '1m', '3m', '6m', '1y', '3y', 'max'] %}
								<button type="button" data-range="{{ range }}" class="range-btn seg-btn" aria-pressed="{{ range == '1y' ? 'true' : 'false' }}">{{ range == 'max' ? 'Max' : range|upper }}</button>
							{% endfor %}
						</div>
					</div>

					<div class="relative h-80 w-full">
						<div id="mainChartContainer" class="absolute inset-0"></div>
						<div id="chart-spinner" class="absolute inset-0 hidden items-center justify-center bg-surface-container-low/60">
							<span class="text-xs text-on-surface-variant">Loading…</span>
						</div>
					</div>

					<p class="text-2xs text-on-surface-variant mt-3 leading-relaxed">
						Clean, so the coupon accrual sawtooth is not drawn as price movement. An issue trading above
						par carries a coupon above the market yield; it converges to par regardless as it ages.
					</p>
				</div>

				<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden">
					<div class="px-5 py-3 border-b border-outline-variant/15">
						<h2 class="text-sm font-bold text-on-surface">Remaining cash flows</h2>
						<p class="text-2xs text-on-surface-variant mt-0.5">Per bond of {{ bond.faceValue|money(0) }} face. Contractual, not forecast.</p>
					</div>

					{% if cashFlows is empty %}
						<div class="px-5 py-8 text-center text-sm text-on-surface-variant">No cash flows remain.</div>
					{% else %}
						<div class="overflow-x-auto max-h-96 overflow-y-auto">
							<table class="w-full text-left">
								<thead class="table-head bg-surface-container-lowest/60 sticky top-0">
									<tr>
										<th scope="col" class="px-5 py-2 font-bold">Due in</th>
										<th scope="col" class="px-4 py-2 font-bold">Type</th>
										<th scope="col" class="px-5 py-2 font-bold text-right">Amount</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
									{% for flow in cashFlows %}
										<tr class="hover:bg-surface-container-high/30 transition-colors">
											<td class="px-5 py-2.5 font-mono tabular-nums text-on-surface-variant">{{ flow.yearsAway|number_format(2) }}y</td>
											<td class="px-4 py-2.5">
												{% if flow.isRedemption %}
													<span class="badge badge-accent">Final coupon + face</span>
												{% else %}
													<span class="text-on-surface-variant">Coupon</span>
												{% endif %}
											</td>
											<td class="px-5 py-2.5 font-mono tabular-nums text-right font-bold text-on-surface">{{ flow.amount|money(2) }}</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>
			</div>

			<div class="space-y-5">

				<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/20">
					<h2 class="text-sm font-semibold text-on-surface mb-3">Order ticket</h2>

					{% if not app.user %}
						<p class="text-xs text-on-surface-variant">
							<a href="{{ path('app_login') }}" class="text-primary font-semibold hover:underline underline-offset-4">Sign in</a>
							to trade this issue.
						</p>
					{% elseif retired %}
						<p class="text-xs text-on-surface-variant">{{ retired.note }}</p>
					{% else %}
						{% if userQuantity > 0 or userCouponIncome > 0 %}
							<div class="mb-4 p-3 rounded bg-surface-container-lowest/80 border border-outline-variant/20 space-y-1.5">
								{% if userQuantity > 0 %}
									<div class="flex justify-between items-center text-xs">
										<span class="text-on-surface-variant">Position</span>
										<span class="font-mono tabular-nums font-medium text-on-surface">{{ userQuantity|number_format }} bonds</span>
									</div>
									<div class="flex justify-between items-center text-xs">
										<span class="text-on-surface-variant">Market value</span>
										<span class="font-mono tabular-nums font-medium text-on-surface" id="user-holding-value">{{ (bond.price * userQuantity)|money(2) }}</span>
									</div>
									{% if userAvgCost > 0 %}
										<div class="flex justify-between items-center text-xs">
											<span class="text-on-surface-variant">Avg cost</span>
											<span class="font-mono tabular-nums font-medium text-on-surface">{{ userAvgCost|money(2) }}</span>
										</div>
									{% endif %}
								{% endif %}
								{% if userCouponIncome > 0 %}
									<div class="flex justify-between items-center text-xs {{ userQuantity > 0 ? 'pt-1.5 border-t border-outline-variant/15' : '' }}">
										<span class="text-on-surface-variant">Coupons received</span>
										<span class="font-mono tabular-nums font-medium text-secondary">{{ userCouponIncome|money(2, true) }}</span>
									</div>
								{% endif %}
							</div>
						{% endif %}

						{% embed 'partials/_trade_ticket.html.twig' with {ticker: bond.ticker, price: dealingPrice, estimate: bond.price, limitLabel: 'Limit price ($, dirty)', quantityLabel: 'Quantity (bonds)'} %}
							{% block choices %}
								{% import 'partials/_ui.html.twig' as ui %}
								{{ ui.choices('action', [{value: 'BUY', label: 'Buy', tone: 'up', checked: true}, {value: 'SELL', label: 'Sell', tone: 'down'}], {label: 'Side'}) }}
								{{ ui.choices('orderType', [{value: 'MARKET', label: 'Market', checked: true}, {value: 'LIMIT', label: 'Limit'}], {label: 'Order type', pad: 'py-1', action: 'change->trade-form#onOrderTypeChange'}) }}
							{% endblock %}
							{% block notes %}
								<p class="text-2xs text-on-surface-variant leading-relaxed">
									Settled at the dirty price: the buyer reimburses the seller for the
									{{ bond.accruedInterest|money(2) }} of coupon accrued since the last payment.
								</p>
							{% endblock %}
						{% endembed %}

						{% if openOrders is not empty %}
							<div class="mt-4 pt-4 border-t border-outline-variant/15 space-y-2">
								<h3 class="text-xs font-semibold text-on-surface-variant">Open orders</h3>
								{% for order in openOrders %}
									<div class="flex items-center justify-between gap-2 text-xs">
										<span class="font-mono tabular-nums text-on-surface">
											<span class="{{ ui.side(order.action) }} font-bold">{{ order.action|lower|capitalize }}</span>
											{{ order.quantity|number_format }} @ {{ order.limitPrice|money(2) }}
										</span>
										{{ ui.cancel_order(order) }}
									</div>
								{% endfor %}
							</div>
						{% endif %}
					{% endif %}
				</div>

				<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/20">
					<h2 class="text-sm font-semibold text-on-surface mb-3">Key statistics</h2>

					<dl class="divide-y divide-outline-variant/15 text-sm">
						{{ ui.stat('Yield to maturity', bond.yieldToMaturity|pct(2), {id: 'stat-ytm'}) }}
						{{ ui.stat('Coupon', bond.couponRate|pct(3)) }}
						{{ ui.stat('Annual income', annualCouponIncome|money(2)) }}
						{{ ui.stat('Time to maturity', yearsToMaturity|number_format(2) ~ 'y', {id: 'stat-ttm'}) }}
						{{ ui.stat('Modified duration', bond.modifiedDuration|number_format(2), {id: 'stat-duration'}) }}
						{{ ui.stat('Convexity', bond.convexity|number_format(1), {id: 'stat-convexity'}) }}
						{{ ui.stat('Face value', bond.faceValue|money(0)) }}
						{{ ui.stat('Amount outstanding', bond.outstandingFace|format_large('$')) }}
					</dl>
				</div>

				<div class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/20">
					<h2 class="text-sm font-semibold text-on-surface mb-1">Rate sensitivity</h2>
					<p class="text-2xs text-on-surface-variant mb-3 leading-relaxed">
						Estimated price move per parallel shift in yields, from this issue's own duration and
						convexity: &minus;D&times;&Delta;y + &frac12;&times;C&times;&Delta;y&sup2;.
					</p>

					<dl class="divide-y divide-outline-variant/15 text-sm">
						{% for shock in rateShocks %}
							{{ ui.stat(shock.shift|bps(0, true), shock.move|pct(2, true), {tone: shock.move|signed_class}) }}
						{% endfor %}
					</dl>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{% include 'partials/_chart_libraries.html.twig' with { lightweight: true } %}

	<script type="application/json" id="aerie-data">
		{{ {
			ticker: bond.ticker,
			ticksPerYear: ticksPerYear,
			userQuantity: userQuantity,
			faceValue: bond.faceValue
		}|json_encode|raw }}
	</script>

	<script type="module">
		import 'pages/bond';
	</script>
{% endblock %}
