{% extends 'base.html.twig' %}
{% import 'partials/_ui.html.twig' as ui %}

{% block page_title %}Bonds{% endblock %}

{% block description %}The outstanding sovereign bond ladder: benchmark yields, coupons, duration and every issue currently trading on the Aerie Exchange.{% endblock %}
{% block og_description %}Live sovereign yield curve and the full outstanding bond ladder.{% endblock %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-6">

		<header class="pb-6 border-b border-outline-variant/15">
			<div class="flex flex-col lg:flex-row lg:justify-between lg:items-end gap-6">
				<div class="min-w-0">
					<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight leading-tight">Bonds</h1>
					<p class="text-sm text-on-surface-variant mt-2 max-w-2xl leading-relaxed">
						District government and corporate bonds. Fixed coupons and fixed redemption dates. An issue ages toward its maturity, so its duration
						falls and its price pulls to par whatever the curve does in the meantime.
					</p>
				</div>

				{# Benchmark readout: the four points the macro engine publishes. #}
				<dl class="grid grid-cols-4 gap-x-8 shrink-0">
					{% for point in benchmarks %}
						{{ ui.figure(point.label, point.yield|pct(2)) }}
					{% endfor %}
				</dl>
			</div>
		</header>

		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<div class="lg:col-span-2">
					<h2 class="text-sm font-semibold text-on-surface mb-2">Zero-coupon yield curve</h2>
					<div class="relative h-64 w-full">
						<canvas id="curveChart" aria-label="Sovereign zero-coupon yield curve by maturity" role="img"></canvas>
					</div>
				</div>

				<div class="space-y-3">
					<h2 class="text-sm font-semibold text-on-surface">Curve shape</h2>
					<dl class="divide-y divide-outline-variant/15 text-sm">
						{# An inverted curve is a caution, not a loss: amber, as the warning under it. #}
						{% set slope2s10s = macro.yield10y - macro.yield2y %}
						{{ ui.stat('2s10s spread', slope2s10s|bps(0, true), {tone: slope2s10s < 0 ? 'text-warning' : slope2s10s|signed_class}) }}
						{{ ui.stat('Policy rate', macro.policyRate|pct(2)) }}
						{{ ui.stat('10Y term premium', macro.termPremium10y|bps) }}
						{{ ui.stat('Inflation', macro.inflation|pct(2)) }}
					</dl>

					{% if slope2s10s < 0 %}
						<div class="rounded border border-warning/30 bg-warning/10 px-3 py-2 text-xs text-warning leading-relaxed">
							<span class="font-semibold">Inverted.</span>
							The front end out-yields the long end, which historically leads a downturn rather than
							following one.
						</div>
					{% endif %}
				</div>
			</div>
		</section>

		{% for tenor, rows in rowsByTenor %}
			<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden">
				<div class="px-5 py-3 border-b border-outline-variant/15 flex items-center justify-between">
					<h2 class="text-base font-semibold text-on-surface">{{ tenor|number_format(0) }}-year issues</h2>
					<span class="text-xs text-on-surface-variant">{{ rows|length }} outstanding</span>
				</div>

				{% include 'bond/_issue_table.html.twig' with {rows: rows, holdings: holdings} only %}
			</div>
		{% else %}
			<div class="bg-surface-container-low rounded-lg p-10 border border-outline-variant/20 text-center">
				<p class="text-sm text-on-surface-variant">No issues are outstanding. The desk opens at the first auction.</p>
			</div>
		{% endfor %}

		{% if corporateByIssuer is not empty %}
			<div class="pt-2">
				<h2 class="text-base font-semibold text-on-surface mb-1">Corporate issues</h2>
				<p class="text-xs text-on-surface-variant leading-relaxed max-w-3xl">
					Company debt, read one borrower at a time. A corporate bond is discounted at the sovereign
					curve <em>plus</em> what that company's credit costs, so two issues of the same maturity
					differ by exactly the market's opinion of who is paying. The claim stands ahead of the
					equity: if the issuer fails, the shares go to zero and the bond settles at its recovery.
				</p>
			</div>

			{% for ticker, group in corporateByIssuer %}
				<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden">
					<div class="px-5 py-3 border-b border-outline-variant/15 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
						<h3 class="text-sm font-semibold text-on-surface flex items-center gap-2">
							<a href="/stock/{{ ticker }}" class="text-primary hover:underline font-mono">{{ ticker }}</a>
							<span class="font-normal text-on-surface-variant">{{ group.issuer.name }}</span>
						</h3>
						<div class="flex items-center gap-4 text-2xs">
							<span class="badge badge-neutral" title="Credit rating, from the issuer's distance to default and its balance sheet">{{ group.rating }}</span>
							<span class="text-on-surface-variant">
								Spread
								<span class="ml-1 font-mono tabular-nums font-medium text-on-surface" title="What this company's credit costs over the sovereign curve">{{ group.spread|bps }}</span>
							</span>
						</div>
					</div>

					{% include 'bond/_issue_table.html.twig' with {rows: group.issues, holdings: holdings} only %}
				</div>
			{% endfor %}
		{% endif %}
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{% include 'partials/_chart_libraries.html.twig' with { chartjs: true } %}

	{# Page data for assets/js/pages/bond-ladder.js. JSON rather than a JavaScript object literal,
	   for the same reason the stock page uses one: Twig's HTML escaper mangles a literal. #}
	<script type="application/json" id="aerie-data">
		{{ { curve: curve }|json_encode|raw }}
	</script>

	<script type="module">
		import 'pages/bond-ladder';
	</script>
{% endblock %}
