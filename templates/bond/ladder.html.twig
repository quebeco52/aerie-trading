{% extends 'base.html.twig' %}

{% block title %}Bonds | Aerie Exchange{% endblock %}

{% block meta %}
	<meta name="description" content="The outstanding sovereign bond ladder: benchmark yields, coupons, duration and every issue currently trading on the Aerie Exchange.">
	<meta property="og:title" content="Sovereign Bond Desk | Aerie Exchange">
	<meta property="og:description" content="Live sovereign yield curve and the full outstanding bond ladder.">
	<meta property="og:type" content="website">
{% endblock %}

{% block body %}
	<div class="max-w-400 mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12 w-full space-y-6">

		<header class="pb-6 border-b border-outline-variant/15">
			<div class="flex flex-col lg:flex-row lg:justify-between lg:items-end gap-6">
				<div class="min-w-0">
					<h1 class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight leading-tight">Bonds</h1>
					<p class="text-sm text-on-surface-variant mt-2 max-w-2xl leading-relaxed">
						District government and corporate bonds. Fixed coupons and fixed redemption dates. An issue ages toward its maturity, so its duration
						falls and its price pulls to par whatever the curve does in the meantime.
					</p>
				</div>

				{# Benchmark readout: the four points the macro engine publishes. #}
				<dl class="grid grid-cols-4 gap-x-8 shrink-0">
					{% for point in benchmarks %}
						<div>
							<dt class="text-xs text-on-surface-variant">{{ point.label }}</dt>
							<dd class="text-lg font-semibold font-mono tabular-nums text-on-surface mt-0.5">{{ (point.yield * 100)|number_format(2) }}%</dd>
						</div>
					{% endfor %}
				</dl>
			</div>

			</div>
		</header>

		<section class="bg-surface-container-low rounded-lg p-5 border border-outline-variant/20">
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<div class="lg:col-span-2">
					<h2 class="text-sm font-semibold text-on-surface mb-2">Zero-coupon yield curve</h2>
					<div class="relative h-64 w-full">
						<canvas id="curveChart" aria-label="Sovereign zero-coupon yield curve by maturity" role="img"></canvas>
					</div>
				</div>

				<div class="space-y-3">
					<h2 class="text-sm font-semibold text-on-surface">Curve shape</h2>
					<dl class="divide-y divide-outline-variant/15 text-sm">
						{% set slope2s10s = macro.yield10y - macro.yield2y %}
						<div class="py-2 flex justify-between items-center">
							<dt class="text-on-surface-variant">2s10s spread</dt>
							<dd class="font-medium font-mono tabular-nums {{ slope2s10s >= 0 ? 'text-secondary' : 'text-tertiary' }}">
								{{ slope2s10s >= 0 ? '+' : '' }}{{ (slope2s10s * 10000)|number_format(0) }} bps
							</dd>
						</div>
						<div class="py-2 flex justify-between items-center">
							<dt class="text-on-surface-variant">Policy rate</dt>
							<dd class="font-medium font-mono tabular-nums text-on-surface">{{ (macro.policyRate * 100)|number_format(2) }}%</dd>
						</div>
						<div class="py-2 flex justify-between items-center">
							<dt class="text-on-surface-variant">10Y term premium</dt>
							<dd class="font-medium font-mono tabular-nums text-on-surface">{{ (macro.termPremium10y * 10000)|number_format(0) }} bps</dd>
						</div>
						<div class="py-2 flex justify-between items-center">
							<dt class="text-on-surface-variant">Inflation</dt>
							<dd class="font-medium font-mono tabular-nums text-on-surface">{{ (macro.inflation * 100)|number_format(2) }}%</dd>
						</div>
					</dl>

					{% if slope2s10s < 0 %}
						<div class="rounded border border-tertiary/25 bg-tertiary/10 px-3 py-2 text-xs text-tertiary leading-relaxed">
							<span class="font-semibold">Inverted.</span>
							The front end out-yields the long end, which historically leads a downturn rather than
							following one.
						</div>
					{% endif %}
				</div>
			</div>
		</section>

		{% for tenor, rows in rowsByTenor %}
			<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden">
				<div class="px-5 py-3 border-b border-outline-variant/15 flex items-center justify-between">
					<h2 class="text-base font-semibold text-on-surface">{{ tenor|number_format(0) }}-year issues</h2>
					<span class="text-xs text-on-surface-variant">{{ rows|length }} outstanding</span>
				</div>

				<div class="overflow-x-auto">
					<table class="w-full text-left">
						<thead class="text-2xs uppercase tracking-wide text-on-surface-variant bg-surface-container-lowest/60">
							<tr>
								<th scope="col" class="px-5 py-2 font-semibold">Issue</th>
								<th scope="col" class="px-4 py-2 font-semibold text-right">Coupon</th>
								<th scope="col" class="px-4 py-2 font-semibold text-right">Maturity</th>
								<th scope="col" class="px-4 py-2 font-semibold text-right">Price</th>
								<th scope="col" class="px-4 py-2 font-semibold text-right">1M</th>
								<th scope="col" class="px-4 py-2 font-semibold text-right">Yield</th>
								<th scope="col" class="px-4 py-2 font-semibold text-right">Duration</th>
								<th scope="col" class="px-5 py-2 font-semibold text-right">Held</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
							{% for row in rows %}
								{% set bond = row.bond %}
								<tr class="relative hover:bg-surface-container-high/30 focus-within:bg-surface-container-high/30 transition-colors group">
									<td class="px-5 py-3">
										<div class="flex items-center gap-2">
											<a href="{{ path('app_bond_view', { ticker: bond.ticker }) }}" class="font-semibold text-primary font-mono outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:underline-offset-4">{{ bond.ticker }}</a>
											{% if bond.isOnTheRun %}
												<span class="relative z-10 px-1.5 py-0.5 rounded bg-primary/10 text-primary text-2xs font-medium border border-primary/25" title="The newest issue at this tenor, and the one the benchmark yield is quoted from">On the run</span>
											{% endif %}
										</div>
									</td>
									<td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant">{{ (bond.couponRate * 100)|number_format(3) }}%</td>
									<td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant" title="Matures {{ bond.maturesAtTime|sim_date }}">
										{{ row.yearsToMaturity|number_format(2) }}y
									</td>
									<td class="px-4 py-3 font-mono tabular-nums text-right font-medium text-on-surface" id="clean-{{ bond.ticker }}" title="Clean price, per {{ bond.faceValue|number_format(0) }} of face">
										{{ bond.cleanPrice|number_format(2) }}
									</td>
									<td class="px-4 py-3 font-mono tabular-nums text-right font-semibold {{ row.change is null ? 'text-on-surface-faint' : (row.change >= 0 ? 'text-secondary' : 'text-tertiary') }}">
										{% if row.change is null %}
											&mdash;
										{% else %}
											{{ row.change >= 0 ? '+' : '' }}{{ (row.change * 100)|number_format(2) }}%
										{% endif %}
									</td>
									<td class="px-4 py-3 font-mono tabular-nums text-right font-medium text-on-surface" id="ytm-{{ bond.ticker }}">{{ (bond.yieldToMaturity * 100)|number_format(2) }}%</td>
									<td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant" title="Modified duration: the percentage price move per 1% parallel yield shift">{{ bond.modifiedDuration|number_format(2) }}</td>
									<td class="px-5 py-3 font-mono tabular-nums text-right">
										{% if holdings[bond.ticker] is defined %}
											<span class="font-medium text-on-surface">{{ holdings[bond.ticker]|number_format }}</span>
										{% else %}
											<span class="text-on-surface-faint">&mdash;</span>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% else %}
			<div class="bg-surface-container-low rounded-lg p-10 border border-outline-variant/20 text-center">
				<p class="text-sm text-on-surface-variant">No issues are outstanding. The desk opens at the first auction.</p>
			</div>
		{% endfor %}

		{% if corporateByIssuer is not empty %}
			<div class="pt-2">
				<h2 class="text-base font-semibold text-on-surface mb-1">Corporate issues</h2>
				<p class="text-xs text-on-surface-variant leading-relaxed max-w-3xl">
					Company debt, read one borrower at a time. A corporate bond is discounted at the sovereign
					curve <em>plus</em> what that company's credit costs, so two issues of the same maturity
					differ by exactly the market's opinion of who is paying. The claim stands ahead of the
					equity: if the issuer fails, the shares go to zero and the bond settles at its recovery.
				</p>
			</div>

			{% for ticker, group in corporateByIssuer %}
				<div class="bg-surface-container-low rounded-lg border border-outline-variant/20 overflow-hidden">
					<div class="px-5 py-3 border-b border-outline-variant/15 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
						<h3 class="text-sm font-semibold text-on-surface flex items-center gap-2">
							<a href="/stock/{{ ticker }}" class="text-primary hover:underline font-mono tracking-wider">{{ ticker }}</a>
							<span class="font-normal text-on-surface-variant">{{ group.issuer.name }}</span>
						</h3>
						<div class="flex items-center gap-4 text-2xs">
							<span class="px-1.5 py-0.5 rounded text-on-surface font-medium border border-outline-variant/25" title="Credit rating, from the issuer's distance to default and its balance sheet">{{ group.rating }}</span>
							<span class="text-on-surface-variant">
								Spread
								<span class="ml-1 font-mono tabular-nums font-medium text-on-surface" title="What this company's credit costs over the sovereign curve">{{ (group.spread * 10000)|number_format(0) }} bps</span>
							</span>
						</div>
					</div>

					<div class="overflow-x-auto">
						<table class="w-full text-left">
							<thead class="text-2xs uppercase tracking-wide text-on-surface-variant bg-surface-container-lowest/60">
								<tr>
									<th scope="col" class="px-5 py-2 font-semibold">Issue</th>
									<th scope="col" class="px-4 py-2 font-semibold text-right">Coupon</th>
									<th scope="col" class="px-4 py-2 font-semibold text-right">Maturity</th>
									<th scope="col" class="px-4 py-2 font-semibold text-right">Price</th>
									<th scope="col" class="px-4 py-2 font-semibold text-right">1M</th>
									<th scope="col" class="px-4 py-2 font-semibold text-right">Yield</th>
									<th scope="col" class="px-4 py-2 font-semibold text-right">Duration</th>
									<th scope="col" class="px-5 py-2 font-semibold text-right">Held</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-outline-variant/10 text-xs sm:text-sm">
								{% for row in group.issues %}
									{% set bond = row.bond %}
									<tr class="relative hover:bg-surface-container-high/30 focus-within:bg-surface-container-high/30 transition-colors group">
										<td class="px-5 py-3">
											<div class="flex items-center gap-2">
												<a href="{{ path('app_bond_view', { ticker: bond.ticker }) }}" class="font-semibold text-primary font-mono outline-none after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:underline-offset-4">{{ bond.ticker }}</a>
												<span class="relative z-10 px-1.5 py-0.5 rounded text-on-surface-variant text-2xs font-medium border border-outline-variant/25" title="Where this claim sits when the issuer fails">Senior</span>
											</div>
										</td>
										<td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant">{{ (bond.couponRate * 100)|number_format(3) }}%</td>
										<td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant" title="Matures {{ bond.maturesAtTime|sim_date }}">
											{{ row.yearsToMaturity|number_format(2) }}y
										</td>
										<td class="px-4 py-3 font-mono tabular-nums text-right font-medium text-on-surface" id="clean-{{ bond.ticker }}" title="Clean price, per {{ bond.faceValue|number_format(0) }} of face">
											{{ bond.cleanPrice|number_format(2) }}
										</td>
										<td class="px-4 py-3 font-mono tabular-nums text-right font-semibold {{ row.change is null ? 'text-on-surface-faint' : (row.change >= 0 ? 'text-secondary' : 'text-tertiary') }}">
											{% if row.change is null %}
												&mdash;
											{% else %}
												{{ row.change >= 0 ? '+' : '' }}{{ (row.change * 100)|number_format(2) }}%
											{% endif %}
										</td>
										<td class="px-4 py-3 font-mono tabular-nums text-right font-medium text-on-surface" id="ytm-{{ bond.ticker }}">{{ (bond.yieldToMaturity * 100)|number_format(2) }}%</td>
										<td class="px-4 py-3 font-mono tabular-nums text-right text-on-surface-variant" title="Modified duration: the percentage price move per 1% parallel yield shift">{{ bond.modifiedDuration|number_format(2) }}</td>
										<td class="px-5 py-3 font-mono tabular-nums text-right">
											{% if holdings[bond.ticker] is defined %}
												<span class="font-medium text-on-surface">{{ holdings[bond.ticker]|number_format }}</span>
											{% else %}
												<span class="text-on-surface-faint">&mdash;</span>
											{% endif %}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			{% endfor %}
		{% endif %}
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{% include 'partials/_chart_libraries.html.twig' with { chartjs: true } %}

	{# Page data for assets/js/pages/bond-ladder.js. JSON rather than a JavaScript object literal,
	   for the same reason the stock page uses one: Twig's HTML escaper mangles a literal. #}
	<script type="application/json" id="aerie-data">
		{{ { curve: curve }|json_encode|raw }}
	</script>

	<script type="module">
		import 'pages/bond-ladder';
	</script>
{% endblock %}
