# Production pacing. Loaded after .env and .env.local when APP_ENV=prod, so a fast dev clock in .env never ships;
# a real environment variable still overrides it.
#
# One simulated year per real week, one tick a second:
#   trading day  ~40 min        quarter        ~42 h (earnings season ~17 h, a report every ~12 min)
#   sim week     ~3.2 h         league season  4 weeks (Season::LENGTH_YEARS = 4)
# Slower: 1209600 ticks a year at 1 s is a year a fortnight. Faster: 302400 is a year in 3.5 days.
#
# Changing SIM_TICKS_PER_YEAR on a running world shifts the tick counter against the clock: restart the ticker once
# with `app:market-ticker --rebase-clock`.
SIM_TICK_INTERVAL_US=1000000
SIM_TICKS_PER_YEAR=604800
