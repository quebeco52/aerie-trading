<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         failOnRisky="true"
         stopOnDefect="true"
         defaultTestSuite="Fast"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <ini name="memory_limit" value="512M" />
        <server name="APP_ENV" value="test" force="true" />
        <env name="APP_ENV" value="test" force="true" />
        <server name="APP_SECRET" value="6c5e75877fba1c8d50e8a719d2b8b93b" force="true" />
        <env name="APP_SECRET" value="6c5e75877fba1c8d50e8a719d2b8b93b" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="PANTHER_APP_ENV" value="test" />
        <server name="PANTHER_DEFAULT_BROWSER" value="selenium" force="true" />
        <server name="PANTHER_WEBDRIVER_URL" value="http://aerie-selenium:4444/wd/hub" force="true" />
        <server name="PANTHER_EXTERNAL_BASE_URI" value="http://aerie-app" force="true" />
    </php>

    <testsuites>
        <!-- Default Fast Suite (< 1.5s): Excludes slow browser Panther E2E tests -->
        <testsuite name="Fast">
            <directory>tests/DTO</directory>
            <directory>tests/Data</directory>
            <directory>tests/Twig</directory>
            <directory>tests/Command</directory>
            <directory>tests/MessageHandler</directory>
            <directory>tests/EventSubscriber</directory>
            <directory>tests/EventListener</directory>
            <directory>tests/Security</directory>
            <directory>tests/Financial</directory>
            <directory>tests/Service</directory>
            <directory>tests/Support</directory>
            <directory>tests/Repository</directory>
            <directory>tests/Controller</directory>
            <!-- Owned by the Realism suite. -->
            <exclude>tests/Service/Politics/PoliticsEngineTest.php</exclude>
            <exclude>tests/Service/Politics/OpinionPollsTest.php</exclude>
            <exclude>tests/Service/Politics/ElectionForecastTest.php</exclude>
            <exclude>tests/Service/Macro/BusinessCycleRealismTest.php</exclude>
            <exclude>tests/Service/Macro/YieldCurveRealismTest.php</exclude>
        </testsuite>

        <!-- Realism: multi-seed long-run runs, 10-60 s each. The full bin/verify runs them one process per file. -->
        <testsuite name="Realism">
            <file>tests/Service/Politics/PoliticsEngineTest.php</file>
            <file>tests/Service/Politics/OpinionPollsTest.php</file>
            <file>tests/Service/Politics/ElectionForecastTest.php</file>
            <file>tests/Service/Macro/BusinessCycleRealismTest.php</file>
            <file>tests/Service/Macro/YieldCurveRealismTest.php</file>
        </testsuite>

        <!-- Unit: no I/O, no kernel, no database. Pure collaborator-free logic. -->
        <testsuite name="Unit">
            <directory>tests/DTO</directory>
            <directory>tests/Data</directory>
            <directory>tests/Twig</directory>
            <directory>tests/Service/Model</directory>
            <directory>tests/Service/Math</directory>
            <file>tests/Service/CapExEngineTest.php</file>
            <file>tests/Service/MarketEngineTest.php</file>
            <file>tests/Service/PortfolioCalculationTest.php</file>
            <file>tests/Service/Market/OptionPricingEngineTest.php</file>
            <file>tests/Service/Market/OptionChainServiceTest.php</file>
            <file>tests/Service/Market/DealerGammaEngineTest.php</file>
            <file>tests/Service/Market/OptionDemandEngineTest.php</file>
            <file>tests/Service/Market/OptionSettlementTest.php</file>
            <file>tests/Service/User/CashLedgerTest.php</file>
            <file>tests/Service/View/OptionChainBuilderTest.php</file>
            <file>tests/Service/Market/OptionDeskCadenceTest.php</file>
            <file>tests/Service/Market/CorporateBondDeskTest.php</file>
            <file>tests/Service/Market/CorporateDefaultServiceTest.php</file>
            <file>tests/Service/Market/IndexCommitteeTest.php</file>
            <file>tests/Service/Market/IndexFundAccountantTest.php</file>
            <file>tests/Service/Market/BulkRowUpdateTest.php</file>
            <file>tests/Service/Market/StockTickColumnsTest.php</file>
            <file>tests/Service/Market/TickCadenceTest.php</file>
            <file>tests/Service/Season/SeasonStatisticsTest.php</file>
            <file>tests/Service/Notification/PlayerNotificationTest.php</file>
            <file>tests/Service/Market/OptionDeskSweepTest.php</file>
            <file>tests/Service/Market/OptionSettlementBatchTest.php</file>
            <file>tests/Service/Market/OptionChainListingTest.php</file>
            <file>tests/EventListener/FlushProfilerTest.php</file>
            <file>tests/EventListener/DeferredWriteAuditTest.php</file>
            <file>tests/Service/Market/SimulationClockTest.php</file>
            <file>tests/Service/Market/HistorySimTimeTest.php</file>
            <file>tests/Service/Corporate/MergerAndAcquisitionGateTest.php</file>
            <file>tests/Service/Corporate/Holdings/AnchorStakeLedgerTest.php</file>
            <file>tests/Service/Corporate/SecuritiesBookServiceTest.php</file>
            <file>tests/Service/Corporate/SecuritiesEquityDisclosureTest.php</file>
            <file>tests/Service/Corporate/SecuritiesMarkIsNotIncomeTest.php</file>
            <file>tests/Service/Corporate/SecuritiesForcedSaleTest.php</file>
            <file>tests/Service/Market/Agent/AttentionRetailStrategyTest.php</file>
            <file>tests/Service/Market/StopOrderTriggerTest.php</file>
            <file>tests/Service/Market/AnalystPriceTargetTest.php</file>
            <file>tests/Service/Market/AuthorizedParticipantTest.php</file>
            <file>tests/Service/View/CompanySnapshotNavTest.php</file>
            <file>tests/Service/View/CompanySnapshotValuationTest.php</file>
            <file>tests/Service/Market/OpeningBoardBuilderTest.php</file>
            <file>tests/Service/Corporate/MacroDriverAttributionTest.php</file>
            <file>tests/Service/View/AnchorPortfolioBuilderTest.php</file>
            <file>tests/Service/Market/ChartRangeTest.php</file>
            <file>tests/Service/Market/ChartBufferWritesTest.php</file>
            <directory>tests/Support</directory>
        </testsuite>

        <testsuite name="Integration">
            <directory>tests/Service</directory>
            <directory>tests/Repository</directory>
            <directory>tests/Command</directory>
            <directory>tests/MessageHandler</directory>
            <directory>tests/EventSubscriber</directory>
            <directory>tests/Security</directory>
            <exclude>tests/Service/Model</exclude>
            <exclude>tests/Service/Math</exclude>
            <!-- Collaborator-free; owned by the Unit suite. -->
            <exclude>tests/Service/CapExEngineTest.php</exclude>
            <exclude>tests/Service/MarketEngineTest.php</exclude>
            <exclude>tests/Service/PortfolioCalculationTest.php</exclude>
            <exclude>tests/Service/Market/OptionPricingEngineTest.php</exclude>
            <exclude>tests/Service/Market/OptionChainServiceTest.php</exclude>
            <exclude>tests/Service/Market/DealerGammaEngineTest.php</exclude>
            <exclude>tests/Service/Market/OptionDemandEngineTest.php</exclude>
            <exclude>tests/Service/Market/OptionSettlementTest.php</exclude>
            <exclude>tests/Service/User/CashLedgerTest.php</exclude>
            <exclude>tests/Service/View/OptionChainBuilderTest.php</exclude>
            <exclude>tests/Service/Market/OptionDeskCadenceTest.php</exclude>
            <exclude>tests/Service/Market/CorporateBondDeskTest.php</exclude>
            <exclude>tests/Service/Market/CorporateDefaultServiceTest.php</exclude>
            <exclude>tests/Service/Market/IndexCommitteeTest.php</exclude>
            <exclude>tests/Service/Market/IndexFundAccountantTest.php</exclude>
            <exclude>tests/Service/View/CompanySnapshotValuationTest.php</exclude>
            <exclude>tests/Service/Market/OpeningBoardBuilderTest.php</exclude>
            <exclude>tests/Service/Market/TickCadenceTest.php</exclude>
            <exclude>tests/Service/Market/ChartBufferWritesTest.php</exclude>
            <exclude>tests/Service/Season/SeasonStatisticsTest.php</exclude>
            <exclude>tests/Service/Notification/PlayerNotificationTest.php</exclude>
            <exclude>tests/Service/Corporate/MacroDriverAttributionTest.php</exclude>
        </testsuite>

        <testsuite name="Functional">
            <directory>tests/Controller</directory>
        </testsuite>

        <testsuite name="Financial">
            <directory>tests/Financial</directory>
        </testsuite>

        <testsuite name="E2E">
            <directory>tests/Panther</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
        <bootstrap class="Symfony\Component\Panther\ServerExtension" />
    </extensions>
</phpunit>
