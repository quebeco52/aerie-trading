#!/usr/bin/env bash
# Runs a command once one of the machine's PHP slots is free, so every session, worktree and harness shares one cap.
#
#   bin/php-slot php -d memory_limit=3G vendor/bin/phpunit --bootstrap var/harness/bootstrap.php --no-configuration X.php
#   bin/php-slot --status    how many slots are taken
#
# A slot is an flock on one file in a directory every sandbox sees; the command inherits the lock and the kernel drops
# it when the command exits, so a killed run never leaks a slot. PHP_SLOTS (default 8: 8 x 3 GB fits the 30 GB box and
# leaves the ticker its cores) and PHP_SLOT_DIR override the defaults.
set -uo pipefail

slots=${PHP_SLOTS:-8}
dir=${PHP_SLOT_DIR:-/tmp/claude-$(id -u)/php-slots}
mkdir -p "$dir"

if [[ ${1:-} == --status ]]; then
    busy=0
    for ((i = 0; i < slots; i++)); do
        flock -n "$dir/$i" true 2>/dev/null || busy=$((busy + 1))
    done
    echo "$busy of $slots PHP slots taken"
    exit 0
fi
(( $# )) || { echo "usage: bin/php-slot <command> [args...] | --status" >&2; exit 2; }

waited=0
while :; do
    for ((i = 0; i < slots; i++)); do
        exec {fd}>>"$dir/$i"
        if flock -n "$fd"; then
            (( waited )) && echo "php-slot: got slot $i after ${waited}s" >&2
            exec "$@"
        fi
        exec {fd}>&-
    done
    sleep 2
    waited=$((waited + 2))
done
