#!/usr/bin/env bash
# Runs a command once one of the machine's PHP slots is free, so every session, worktree and harness shares one cap.
#
#   bin/php-slot php -d memory_limit=3G vendor/bin/phpunit --bootstrap var/harness/bootstrap.php --no-configuration X.php
#   bin/php-slot --status    how many slots are taken
#
# A `php` command also gets opcache and the tracing JIT (see the end of the file).
#
# A slot is an flock on one file in a directory every sandbox sees; the command inherits the lock and the kernel drops
# it when the command exits, so a killed run never leaks a slot. Waiters poll, so a slot goes to whoever asks first, not
# first in line: each Claude session (CLAUDE_CODE_SESSION_ID, subagents included) is held to PHP_SESSION_SLOTS of the
# PHP_SLOTS, so one session's sweep cannot starve another's run. Defaults 12 and 8: harness runs peak at 0.3-0.8 GB
# against 30 GB, and 12 of the 9700X's 16 threads leave the ticker and the database theirs. PHP_SLOT_DIR overrides
# the lock directory.
# The body is one { } group, so bash reads it whole: a run waiting for a slot survives an edit to this file.
{
set -uo pipefail

slots=${PHP_SLOTS:-12}
per_session=${PHP_SESSION_SLOTS:-8}
dir=${PHP_SLOT_DIR:-/tmp/claude-$(id -u)/php-slots}
session=${CLAUDE_CODE_SESSION_ID:-}
mkdir -p "$dir"

count_busy() { # <lock dir> <n>
    local busy=0 i
    for ((i = 0; i < $2; i++)); do
        flock -n "$1/$i" true 2>/dev/null || busy=$((busy + 1))
    done
    echo "$busy"
}

if [[ ${1:-} == --status ]]; then
    line="$(count_busy "$dir" "$slots") of $slots PHP slots taken"
    [[ -n $session && -d $dir/session-$session ]] \
        && line+=", $(count_busy "$dir/session-$session" "$per_session") of $per_session by this session"
    echo "$line"
    exit 0
fi
(( $# )) || { echo "usage: bin/php-slot <command> [args...] | --status" >&2; exit 2; }

# take_lock <lock dir> <n>: holds the first free lock in the dir on a new fd that the command inherits; fails if none.
take_lock() {
    local i fd
    for ((i = 0; i < $2; i++)); do
        exec {fd}>>"$1/$i"
        flock -n "$fd" && return 0
        exec {fd}>&-
    done
    return 1
}

waited=0
if [[ -n $session ]]; then
    mkdir -p "$dir/session-$session"
    until take_lock "$dir/session-$session" "$per_session"; do
        sleep 2
        waited=$((waited + 2))
    done
fi
until take_lock "$dir" "$slots"; do
    sleep 2
    waited=$((waited + 2))
done
(( waited )) && echo "php-slot: got a slot after ${waited}s" >&2
# The CLI ships with opcache and JIT off; the tracing JIT runs a whole-board harness ~1.5x faster with identical output.
# PHP_SLOT_JIT=0 turns it off.
if [[ ${PHP_SLOT_JIT:-1} != 0 && $(basename -- "$1") == php ]]; then
    exec "$1" -d opcache.enable_cli=1 -d opcache.jit=tracing -d opcache.jit_buffer_size=128M "${@:2}"
fi
exec "$@"
}
exit
